// =============================================================================

indicator("OSE-S7 Decision-Support UI v1.0.0-IC3R2", shorttitle = "OSE-S7", overlay = true, max_bars_back = 300, max_boxes_count = 16, max_labels_count = 64, max_lines_count = 16)

// =============================================================================
// 0. CANONICAL FROZEN CONSTANTS — non-configurable, no tuning surface
// =============================================================================
// --- 0.1 session/time basis (SSOT §4.6.1) ---
const string RTH_SESSION = "0930-1600:23456"        // 1=Sunday => 2..6 = Mon..Fri
const string TZ          = "America/New_York"       // IANA string; fixed offsets prohibited

// --- 0.2 slot geometry (SSOT §4.6.4) ---
const int MAXSLOTS = 96      // allocation margin
const int FULLLAST = 77      // last slot of a full 09:30-16:00 session (78 slots)
const int ECLAST   = 41      // last slot of a configured 09:30-13:00 early close (42 slots)

// --- 0.3 session class codes (SSOT §4.6.8 — eight classes) ---
const int C_NODATA    = 0    // NO_DATA_UNKNOWN
const int C_TRUNC     = 1    // DATASET_START_TRUNCATION
const int C_GAP       = 2    // SESSION_DATA_GAP
const int C_EARLY     = 3    // CONFIGURED_EARLY_CLOSE
const int C_SHORT     = 4    // UNEXPECTED_SHORTFALL
const int C_NORMAL    = 5    // NORMAL_SESSION
const int C_FULLCLOSE = 6    // EXPECTED_FULL_CLOSURE            (gap-derived only)
const int C_UNSCHED   = 7    // UNSCHEDULED_HISTORICAL_FULL_CLOSURE (gap-derived only)

// --- 0.4 indicator contract constants (SSOT §4.7.4) ---
// Production form: const, NOT input. H9 exposed these as inputs solely so a
// reviewer could adversarially break a value; that is a harness control and is
// removed here. No tuning surface is authorised in Production.
const int   BB_LEN        = 20      // BB basis = SMA(20)
const float BB_MULT       = 2.0
const int   KC_LEN        = 20      // KC basis = EMA(20)
const float KC_MULT       = 1.5
const bool  KC_USE_TR     = true
const int   HTF_EMA_LEN   = 60
const int   ATR_LEN       = 14      // atrLive = atr(14) ; atrRef = atr(14)[1]
const int   ROC_LEN       = 5
const int   ATR_SHORT_LEN = 5
const int   ATR_LONG_LEN  = 20
const int   TRAIL_EMA_LEN = 9

// --- 0.5 Main-Room timing literals (A02 §8.5.1 · G5-SAT06-TIME-SEMANTIC-DECISION) ---
// Declared per A08 §7 as fixed, non-configurable source constants bound to
// source identity. America/New_York BAR-OPEN clock values, all inclusive.
// M0 DERIVES NO BEHAVIOUR FROM THEM. They are inert at this increment:
// trigger, Observation and queue behaviour arrive at M4/M6.
const int RESEARCH_START_HHMM     = 930    // researchStartTime      09:30 inclusive
const int OBSERVATION_CUTOFF_HHMM = 1555   // observationCutoffTime  15:55 inclusive
const int EXPORT_DRAIN_END_HHMM   = 1555   // exportDrainEndTime     15:55 inclusive

// =============================================================================
// 1. AUTHORISED PRODUCTION INPUTS
//    Groups A-C: operator calendar contract. SSOT §4.6.7 / §4.6.9 assign these
//    to the USER as a conscious acknowledgement. A supervision contract, not a
//    tuning surface.
//    Group D:    the two VWAP-touch tolerance parameters authorized by A13 §2.
//    All inputs become part of exact source/config/run identity. No tuning,
//    sweep, step constraint, mode, override or optimization helper is authorized.
// =============================================================================
gCal = "A · Calendar (operator-maintained · SSOT §4.6.9)"
ecInput = input.string("", "earlyCloseDates  YYYY-MM-DD,...  (09:30-13:00 · 42 slots)", group = gCal)
fcInput = input.string("", "fullClosureDates YYYY-MM-DD[:U],...  (':U' = unscheduled)", group = gCal)

gCov = "B · Calendar coverage — all three mandatory (SSOT §4.6.7)"
covFromStr    = input.string("", "earlyCloseCalendarValidatedFrom    (YYYY-MM-DD)", group = gCov)
covThroughStr = input.string("", "earlyCloseCalendarValidatedThrough (YYYY-MM-DD)", group = gCov)
covAck        = input.bool(false, "earlyCloseCalendarAcknowledged (conscious operator acknowledgement)", group = gCov)

gTol = "C · Frozen session tolerances (SSOT §4.6.8 · §4.7.6)"
internalGapTol   = input.int(2, "internalGapTol (slots)",   minval = 0, maxval = 5,  group = gTol)
slotShortfallTol = input.int(6, "slotShortfallTol (slots)", minval = 0, maxval = 20, group = gTol)

gVwap = "D · VWAP-touch tolerance (M1 · SAT06-A13 §2)"
// EXACT authorized bounds. No extra default, step, mode, override, alternate
// range or optimization helper. These two values are part of run identity.
locTolATR   = input.float(0.25, "locTolATR   (× frozen atrRef -> zone half-width)", minval = 0.15, maxval = 0.40, group = gVwap)
exitTolMult = input.float(2.0,  "exitTolMult (× locTolFrozen -> re-arm distance)", minval = 1.5,  maxval = 3.0,  group = gVwap)

gZone = "E · Static zones (M2 · SAT06-A15 §2)"
// EXACT authorized bounds. No step constraint, mode, override, alternate
// default/range, tuning helper or optimization surface. The inherited locTolATR
// is reused as-is and is neither duplicated nor changed here. disarmDistATR,
// maxLevelDistATR, maxRetestsPerZone and family windows have no M2 consumer and
// are deliberately absent — no dormant input is created for them. The Opening
// Range is fixed to RTH slots 0,1,2, so there is no orMinutes input.
mergeATR        = input.float(0.50, "mergeATR        (× frozen atrRef -> cluster distance)", minval = 0.30, maxval = 0.80, group = gZone)
maxZoneWidthATR = input.float(1.00, "maxZoneWidthATR (× frozen atrRef -> split threshold)", minval = 0.80, maxval = 1.50, group = gZone)
armDistATR      = input.float(0.50, "armDistATR      (× LIVE atrRef -> active-zone radius)", minval = 0.30, maxval = 0.80, group = gZone)
acceptBars      = input.int(2,      "acceptBars      (consecutive closes -> acceptance)",    minval = 1,    maxval = 3,    group = gZone)

// =============================================================================
// 2. HELPERS — exact mutation-owner declaration (R3.1/R3.2)
//    Pine forbids assigning GLOBALS inside functions. That is not the same as
//    purity: a function may still mutate a caller-owned array passed by
//    reference. Each helper below states which it is.
// =============================================================================

// PURE — scalar in, scalar out. No global write, no caller-array mutation.
// "YYYY-MM-DD..." -> YYYYMMDD int ; na if malformed.   [donor: H15 §2]
dnumFromStr(string s) =>
    int r = na
    if str.length(s) >= 10
        float y = str.tonumber(str.substring(s, 0, 4))
        float m = str.tonumber(str.substring(s, 5, 7))
        float d = str.tonumber(str.substring(s, 8, 10))
        if not na(y) and not na(m) and not na(d)
            r := int(y) * 10000 + int(m) * 100 + int(d)
    r

// PURE — scalar in, scalar out. No global write, no caller-array mutation.
// absolute ms -> NY local YYYYMMDD int.                [donor: H15 §2]
dnumFromMs(int ms) =>
    year(ms, TZ) * 10000 + month(ms, TZ) * 100 + dayofmonth(ms, TZ)

// PURE — scalar in, scalar out. No global write, no caller-array mutation.
// SC-04 ANCHOR. Local noon of a YYYYMMDD date.         [donor: H15 §2]
// Noon anchoring guarantees a +/-1h DST offset shift can never move an instant
// onto a neighbouring calendar DATE. It does NOT make fixed +24h millisecond
// stepping calendar-correct: every caller MUST re-anchor each step (see §9.2.2).
noonMs(int d) =>
    timestamp(TZ, int(d / 10000), int(d / 100) % 100, d % 100, 12, 0, 0)

// NOT PURE — INITIALIZATION-ONLY CALLER-ARRAY MUTATOR.
// Writes into the caller-owned arrays ds and us via array.push. It assigns no
// global. Its only authorized call site is the one-time INIT_CONFIG boundary in
// §3; it must never be called from the per-bar pipeline.
// parse "YYYY-MM-DD[:U],..." into a date array + parallel unscheduled-flag array
fillDateList(array<int> ds, array<int> us, string csv) =>
    string clean = str.replace_all(csv, " ", "")
    if str.length(clean) > 0
        array<string> parts = str.split(clean, ",")
        for i = 0 to array.size(parts) - 1
            string p  = array.get(parts, i)
            int    dv = dnumFromStr(p)
            if not na(dv)
                array.push(ds, dv)
                array.push(us, str.contains(p, ":U") ? 1 : 0)
    array.size(ds)

// =============================================================================
// 3. CALENDAR TABLES — INIT_CONFIG boundary (R3.3)
//    Built once from operator input only. No fixture mutation.
//
//    INIT_CONFIG = barstate.isfirst. This is an explicit one-time construction
//    boundary, NOT a Frozen commit gate and NOT part of the decision pipeline.
//    It replaces the v0.1.0 listsBuilt latch: barstate.isfirst is true on exactly
//    the first bar of the dataset, so the block executes exactly once and no
//    persistent guard state is required. Net persistent state: one variable
//    removed, none added.
//
//    WRITE SET AT THIS BOUNDARY: ecDates, ecFlags, fcDates, fcFlags — nothing else.
// =============================================================================
var array<int> ecDates = array.new_int()
var array<int> fcDates = array.new_int()
var array<int> fcFlags = array.new_int()
var array<int> ecFlags = array.new_int()   // parity array; ':U' has no early-close meaning

if barstate.isfirst                                    // [INIT_CONFIG]
    fillDateList(ecDates, ecFlags, ecInput)
    fillDateList(fcDates, fcFlags, fcInput)

covFrom    = dnumFromStr(covFromStr)
covThrough = dnumFromStr(covThroughStr)

// =============================================================================
// 4. GUARDS F1/F2/F3 — PRODUCTION LOUD FAILURE (SSOT §4.7.7)
//    Production behaviour differs from the H9 donor BY AUTHORITY: H9 is a
//    harness and must survive to report, so it degraded to INVALID TEST CONTEXT.
//    SSOT §4.7.7 states runtime.error() is production-only. This IS production.
//    Full disablement: zero signals, zero alerts, zero objects.
// =============================================================================
okF1 = timeframe.isminutes and timeframe.multiplier == 5          // F1 ⛔ TIMEFRAME
okF2 = chart.is_standard                                          // F2 ⛔ NON-STANDARD CHART

// F3 ⛔ SYMBOL. "dr" (ADR) excluded: allowDR is pinned to its Frozen default
// false in source rather than exposed as a parameter. na country => FAIL.
okType    = syminfo.type == "stock" or syminfo.type == "fund"
okCountry = (not na(syminfo.country)) and syminfo.country == "US"
okCcy     = syminfo.currency == "USD"
okF3      = okType and okCountry and okCcy

guardsPass = okF1 and okF2 and okF3

if barstate.isfirst and not guardsPass
    string gmsg = not okF1 ? "⛔ TIMEFRAME — OSE requires a 5-minute chart (SSOT §4.7.7 F1)." : not okF2 ? "⛔ NON-STANDARD CHART — Renko/Range/LineBreak/Kagi/PnF/Heikin-Ashi produce synthetic OHLC (SSOT §4.7.7 F2)." : "⛔ SYMBOL — OSE requires syminfo.type in {stock,fund}, country US, currency USD (SSOT §4.7.7 F3)."
    runtime.error(gmsg)

// =============================================================================
// 5. TIME BASIS AND SLOT KEY (SSOT §4.6.1 · §4.6.4)
// =============================================================================
rthTime      = time(timeframe.period, RTH_SESSION, TZ)          // na outside nominal window
rthTimeClose = time_close(timeframe.period, RTH_SESSION, TZ)

// slotIdx is measured from ABSOLUTE 09:30, never from the first observed bar.
// That is what makes mid-session dataset starts detectable (firstSlot > 0).
sessionOpenMs = timestamp(TZ, year(time, TZ), month(time, TZ), dayofmonth(time, TZ), 9, 30, 0)
minSinceOpen  = na(rthTime) ? na : (rthTime - sessionOpenMs) / 60000.0
slotIdx       = na(minSinceOpen) ? na : int(minSinceOpen / 5)

// =============================================================================
// 6. DATA LAYER — CANONICAL RTH REQUESTS (SSOT §4.7.1 · §4.7.2 · §4.7.3)
// =============================================================================
// adjustment.splits ONLY. Splits break price AND volume continuity (ATR, RVOL
// baseline, level history). Dividends are deliberately NOT adjusted: PDH/PDL are
// BEHAVIOURAL references to prices traders actually saw, not accounting figures.
rthTicker = ticker.new(syminfo.prefix, syminfo.ticker, session.regular, adjustment.splits)

// ---- 6.1 flattened 20-element bundle (SSOT §4.7.3) --------------------------
// ⚠ CRITICAL TRAP: ta.bb and ta.kc return [middle, upper, lower] — MIDDLE FIRST.
// Positions 10 and 13 are the middles. A reorder does NOT produce a compile
// error and silently inverts squeeze semantics. Element order is FROZEN.
// Indicators are calculated INSIDE the request context: computing e.g.
// ta.ema(rthClose,60) outside would consume ~66 forward-filled duplicate bars
// per day on an extended-hours chart and treat them as real samples.
coreBundle() =>
    [bbM, bbU, bbL] = ta.bb(close, BB_LEN, BB_MULT)
    [kcM, kcU, kcL] = ta.kc(close, KC_LEN, KC_MULT, KC_USE_TR)
    [ open, high, low, close, volume,
      ta.vwap(hlc3), ta.ema(close, HTF_EMA_LEN),
      ta.atr(ATR_LEN), ta.atr(ATR_LEN)[1],
      bbM, bbU, bbL, kcM, kcU, kcL,
      ta.roc(close, ROC_LEN), ta.atr(ATR_SHORT_LEN), ta.atr(ATR_LONG_LEN),
      ta.ema(close, TRAIL_EMA_LEN), bar_index ]

// Request 1 of 2 — same timeframe, gaps_on, lookahead_off.
// gaps_on is load-bearing: it is the exchange-data calendar evidence that makes
// actualRthBar sound. With gaps_off a 14:00 bar on a 13:00 early-close day would
// carry forward-filled values and be treated as a new RTH observation.
[rthO, rthH, rthL, rthC, rthV, vwap, htfEma, atrLive, atrRef, bbMid, bbUp, bbLo, kcMid, kcUp, kcLo, roc5, atrShort, atrLong, emaTrail, rthBarIndex] = request.security(rthTicker, timeframe.period, coreBundle(), gaps = barmerge.gaps_on, lookahead = barmerge.lookahead_off)

// Request 2 of 2 — prior CONFIRMED day. The documented-safe idiom is an
// expression offset by >= 1 bar together with lookahead_on: high[1] on a daily
// frame is yesterday's finally-closed data.
[pdh, pdl, pdc] = request.security(rthTicker, "D", [high[1], low[1], close[1]], lookahead = barmerge.lookahead_on)

// request.*() budget: 2 of 40 (SSOT §4.7.1). No further request is authorised.

// ---- 6.2 actualRthBar — the governing condition (SSOT §4.6.2) ---------------
rawRthNonNa  = not na(rthC)                    // requested-context availability
nominalRth   = not na(rthTime)                 // nominal-window membership
actualRthBar = rawRthNonNa and nominalRth      // CANONICAL DUAL GUARD

// ---- 6.3 session-start detection (SSOT §4.6.3) ------------------------------
// Both terms are mandatory. With extended hours OFF the bar before 09:30 is
// yesterday's 15:55 and actualRthBar[1] is true => the day test is required.
// With extended hours ON the previous bar is 09:25 today => not actualRthBar[1]
// is required. bar_index guards make first-bar evaluation deterministic.
dayNY      = dayofmonth(time, TZ)
prevRthBar = bar_index == 0 ? false : actualRthBar[1]
dayChanged = bar_index == 0 ? true  : (na(dayNY[1]) or dayNY != dayNY[1])
newRthDay  = actualRthBar and ((not prevRthBar) or dayChanged)

// NY local calendar date of the current RTH bar, derived from the session clock.
int curDate = na
if not na(rthTime)
    curDate := dnumFromMs(rthTime)

// =============================================================================
// 7. COMMIT GATES (SSOT §4.7.8 · §4.4a.4)
//    Declared here in exact Frozen form so every later module binds to one
//    definition. COMMIT_DECISION(f) requires observationReady(f) and therefore
//    arrives with M4. COMMIT_MANAGE is Stage-8 and is NOT implemented in Stage 6.
//    Three gates, not one: a single gate containing RVOL readiness would make
//    warm-up unreachable, because the RVOL ring must be WRITTEN while readiness
//    is false by definition.
// =============================================================================
COMMIT_DATA = barstate.isconfirmed and actualRthBar and guardsPass

// isRepeatExecution is owned by the execution-sequence guard (INV-30) which has
// no producer in Stage 6; the Stage-6 trade domain is empty by construction.
isRepeatExecution = false
COMMIT_EXPORT     = barstate.isconfirmed and actualRthBar and not isRepeatExecution

// CONFIRMED_DIAG — confirmed guard / data-diagnostic boundary (R3.4).
// NOT a Frozen commit gate and NOT a decision boundary. It is the exact write-set
// label for the two Frozen diagnostics that must observe bars where COMMIT_DATA
// is false: F4 rthDataMissing and the §4.6.2 session.ismarket consistency check.
// F4 MUST NOT be moved under COMMIT_DATA: missing requested RTH data makes
// actualRthBar false BY DEFINITION, so COMMIT_DATA is false exactly on the bars
// where F4 has to fire. Filing F4 under COMMIT_DATA would make it unreachable.
CONFIRMED_DIAG = barstate.isconfirmed and guardsPass

// =============================================================================
// 8. PERSISTENT STATE — M0 OWNERSHIP ONLY
// =============================================================================
// ---- 8.1 in-progress session trackers ----
var array<bool> sesSlotSeen  = array.new_bool(MAXSLOTS, false)
var int  sesDate      = na
var int  sesFirstSlot = na
var int  sesLastSlot  = na
var int  sesObserved  = 0
var bool sesHasData   = false
var bool sesIsEarlyCl = false

// ---- 8.2 prior-session classification facts (consumed by M3 and later) ----
var int anyPriorSessionFlag = 0
var int prevSessDate        = na
var int prevSessFirstSlot   = na
var int prevSessLastSlot    = na
var int prevSessObserved    = na
var int prevSessHoleSpan    = na
var int prevSessMissPrefix  = na
var int prevSessDisqGap     = na
var int prevSessClass       = na
var int prevSessIsEarlyCl   = na

// ---- 8.3 session-class tallies (SSOT §4.6.8) ----
var int cSessions = 0
var int cCls0 = 0
var int cCls1 = 0
var int cCls2 = 0
var int cCls3 = 0
var int cCls4 = 0
var int cCls5 = 0
var int cCls6 = 0
var int cCls7 = 0

// ---- 8.4 Frozen calendar / data invariant counters ----
var int calendarCoverageViolation  = 0   // INV-31
var int unexpectedSessionShortfall = 0   // INV-32
var int unexplainedAbsentWeekday   = 0   // INV-40
var int rthDataMissing             = 0   // F4
var int rthFlagMismatch            = 0   // §4.6.2 diagnostic consistency only

// ---- 8.5 REMOVED AT v0.1.1-M0R (SAT06-M0-ITA-01 · R1) ----
// The following seven internal counters are deleted. Five were H9/H15 harness
// diagnostics or self-referential PASS oracles with no Production consumer; three
// of those additionally permitted execution to continue after a contradiction,
// leaving an invisible count and a possibly clean exportCompleteFlag.
//
//   rawOutsideWindowNonNa     -> deleted. H9-P1 left-edge test diagnostic.
//   actualRthOutsideNominal   -> deleted. Tautology of the dual-guard expression;
//                                static source audit owns that equivalence.
//   slotOutOfRange            -> replaced by runtime.error() at §9.2 slot gate.
//   residualClassGuard        -> replaced by runtime.error() at §9.2.1 classifier.
//   ghostBarsAfterEarlyClose  -> replaced by runtime.error() at §9.2 slot gate.
//   invClosureMisclassFail    -> deleted. Repeated-lookup tautology; INV-38 is
//                                proved by static mapping of the single fi result.
//   invNormalPrefixFail       -> deleted. Self-check of the branch that assigned
//                                C_NORMAL; INV-39 is proved by the explicit
//                                sesFirstSlot == 0 predicate plus static mapping.
//
// The three Frozen calendar counters above and the two Frozen data diagnostics
// (rthDataMissing, rthFlagMismatch) are preserved verbatim with unchanged triggers.

// ---- 8.6 data-layer availability ----
// rthBarsAvailable is the SSOT §4.4a.4 name; H15 calls the identical quantity
// confirmedRthBars. One variable, one owner.
var int rthBarsAvailable = 0

// ---- 8.7 export validity latch ----
// MONOTONIC. Calendar violations clear it. No module may ever restore it to 1.
// M0 owns the calendar-derived contributions (INV-31/INV-32/INV-40) only.
var int exportCompleteFlag = 1

// =============================================================================
// 9. PER-BAR PIPELINE
//    All global mutation is inlined here — Pine forbids assigning globals inside
//    functions. Every mutating block carries its exact owning boundary label and
//    its write set, so an INV-8 audit can be performed from the source alone.
//
//    BOUNDARIES USED BY THIS SOURCE (R3.6):
//      INIT_CONFIG    = barstate.isfirst                       §3 — calendar arrays only
//      CONFIRMED_DIAG = barstate.isconfirmed and guardsPass     §9.1 — F4 + §4.6.2 diagnostic
//      COMMIT_DATA    = CONFIRMED_DIAG and actualRthBar         §9.2 — all session/calendar state
//    INIT_CONFIG and CONFIRMED_DIAG are NOT Frozen commit gates and own no
//    decision. Every semantic mutation remains under COMMIT_DATA.
//    INV-8: no persistent mutation outside a labelled boundary.
// =============================================================================
if CONFIRMED_DIAG

    // ---- 9.1 Frozen data diagnostics ------------------------ [CONFIRMED_DIAG]
    // WRITE SET AT THIS BOUNDARY: rthDataMissing, rthFlagMismatch — nothing else.
    // Both must observe bars on which COMMIT_DATA is false; see the CONFIRMED_DIAG
    // note in §7. Neither is a gate and neither participates in any decision.
    if nominalRth and not rawRthNonNa
        rthDataMissing += 1                     // F4  ⚠ RTH DATA na
    if actualRthBar != session.ismarket
        rthFlagMismatch += 1                    // DIAGNOSTIC ONLY — never a gate

    // ---- 9.2 session registration ------------------------------ [COMMIT_DATA]
    // WRITE SET AT THIS BOUNDARY: rthBarsAvailable, the sesXxx trackers, the
    // prevSessXxx published facts, anyPriorSessionFlag, cSessions, cCls0..cCls7,
    // calendarCoverageViolation, unexpectedSessionShortfall,
    // unexplainedAbsentWeekday, exportCompleteFlag — nothing else.
    if COMMIT_DATA
        rthBarsAvailable += 1

        // ======================= NEW SESSION BOUNDARY =======================
        if na(sesDate) or curDate != sesDate

            // ---- 9.2.0 NON-INCREASING SESSION DATE — loud failure ------------
            // SAT06-M0-ITA-02 / R2. A02 §4.4 prohibits a silent
            // currDate <= prevDate success fallback. Equality is already excluded
            // by the boundary predicate above (curDate != sesDate), so at this
            // point curDate < sesDate is the exact executable form of the
            // prohibited case. Without this gate the gap loop would iterate zero
            // times, the prior session would still be classified and published,
            // and the tracker would be reset backwards to the earlier date — a
            // silent success path that bypasses complete-date accounting while
            // leaving exportCompleteFlag untouched.
            //
            // This gate precedes classification, publication, gap scan and reset.
            // No recovery, no state advance, no counter, no bound, no new state.
            if not na(sesDate) and curDate < sesDate
                runtime.error("⛔ SESSION DATE ORDER — new RTH session date " + str.tostring(curDate) + " precedes the in-progress session date " + str.tostring(sesDate) + ". Non-increasing New York session dates are prohibited (A02 §4.4). No session classified, published, scanned or reset.")

            // ---- 9.2.1 classify the session that just ended (SSOT §4.6.8) ----
            if sesHasData
                int  span         = sesLastSlot - sesFirstSlot + 1
                int  holeSpan     = span - sesObserved
                bool missPrefix   = sesFirstSlot > 0
                bool disqHole     = holeSpan > internalGapTol
                int  expectedLast = sesIsEarlyCl ? ECLAST : FULLLAST
                bool terminalShort = sesLastSlot < (expectedLast - slotShortfallTol)
                bool isFirstDs    = anyPriorSessionFlag == 0

                // Frozen precedence rows 1->2->3->4->5->6 == codes 0->1->2->3->4->5.
                // C_NODATA is unreachable from an OBSERVED session by construction:
                // a session with no actualRthBar produces no boundary at all, and a
                // full closure is resolved by date-gap analysis, not classification.
                // R1.4: no fabricated default. cls stays unassigned until a
                // Frozen precedence row matches; an unmatched state fails loudly
                // instead of publishing a manufactured class.
                int cls = na
                if isFirstDs and missPrefix
                    cls := C_TRUNC
                else if (missPrefix and not isFirstDs) or disqHole
                    cls := C_GAP
                else if sesIsEarlyCl
                    cls := C_EARLY
                else if terminalShort
                    cls := C_SHORT
                else if sesFirstSlot == 0 and not disqHole
                    cls := C_NORMAL
                else
                    // SAT06-M0-ITA-01 / R1.4. The Frozen §4.6.8 precedence rows
                    // are exhaustive over an observed session. Reaching this
                    // branch means the observed facts match no Frozen class, and
                    // no class may be fabricated to keep the run alive.
                    runtime.error("⛔ SESSION CLASSIFICATION — observed session " + str.tostring(sesDate) + " matched no Frozen class (SSOT §4.6.8 precedence rows 1→6). firstSlot=" + str.tostring(sesFirstSlot) + " lastSlot=" + str.tostring(sesLastSlot) + " observed=" + str.tostring(sesObserved) + ". No class published.")

                // INV-39 is proved by the explicit C_NORMAL predicate above
                // (sesFirstSlot == 0) plus static source mapping. The former
                // invNormalPrefixFail self-check re-tested the same branch that
                // had just assigned C_NORMAL and could not independently
                // authenticate the invariant; it is removed at v0.1.1-M0R.

                // INV-32: observed session ending early with no calendar explanation.
                if cls == C_SHORT
                    unexpectedSessionShortfall += 1
                    exportCompleteFlag := 0

                cCls0 += cls == C_NODATA ? 1 : 0
                cCls1 += cls == C_TRUNC  ? 1 : 0
                cCls2 += cls == C_GAP    ? 1 : 0
                cCls3 += cls == C_EARLY  ? 1 : 0
                cCls4 += cls == C_SHORT  ? 1 : 0
                cCls5 += cls == C_NORMAL ? 1 : 0

                // Publish the prior-session facts. M3 derives RVOL admissibility
                // from these; M0 asserts no RVOL eligibility of its own.
                prevSessDate       := sesDate
                prevSessFirstSlot  := sesFirstSlot
                prevSessLastSlot   := sesLastSlot
                prevSessObserved   := sesObserved
                prevSessHoleSpan   := holeSpan
                prevSessMissPrefix := missPrefix ? 1 : 0
                prevSessDisqGap    := disqHole   ? 1 : 0
                prevSessClass      := cls
                prevSessIsEarlyCl  := sesIsEarlyCl ? 1 : 0
                cSessions          += 1

                // ---- 9.2.2 weekday-gap analysis (SSOT §4.6.8a · A02 §4.3) ----
                // A full closure produces ZERO RTH bars, so there is no "session"
                // for Pine to classify. The correct mechanism is DATE-GAP analysis.
                //
                // UNBOUNDED BY ARCHITECTURE (A02 §4.3.9 · §4.4 · Satellite-01
                // Option A). There is deliberately NO iteration counter, NO
                // maxGapScanDays, and NO gapScanTruncated state. Every NY local
                // date strictly between the two session dates is visited exactly
                // once.
                //
                // SC-04: the cursor is re-anchored to the visited date's LOCAL
                // NOON before advancing. Fixed +24h absolute stepping is NOT
                // calendar-correct across a DST boundary; re-anchoring makes the
                // traversal exact in both directions — no skipped date, no
                // duplicated date, no inclusion of the current date.
                //
                // The first dataset session reaches this block only when a prior
                // observed session exists, so it has no predecessor gap to scan.
                int cursor = noonMs(sesDate) + 86400000
                int tCurr  = noonMs(curDate)
                while cursor < tCurr
                    int dv = dnumFromMs(cursor)
                    int dw = dayofweek(cursor, TZ)
                    if dw != dayofweek.sunday and dw != dayofweek.saturday
                        int fi = array.indexof(fcDates, dv)
                        if fi >= 0
                            if array.get(fcFlags, fi) == 1
                                cCls7 += 1                    // UNSCHEDULED (7)
                            else
                                cCls6 += 1                    // EXPECTED (6)
                        else
                            // INV-40. The system reports an unexplained absence;
                            // it must never claim Pine determined the cause.
                            // INV-38 is proved by static source mapping: this
                            // branch is reachable only when fi < 0, i.e. the date
                            // is absent from fcDates, so a known full closure can
                            // never arrive here. The former repeated-lookup
                            // self-check re-queried the same array with the same
                            // key and is removed at v0.1.1-M0R.
                            unexplainedAbsentWeekday += 1
                            exportCompleteFlag := 0
                    cursor := noonMs(dv) + 86400000
                // no truncation branch exists: the loop cannot exit early

                anyPriorSessionFlag := 1

            // ---- 9.2.3 reset trackers for the new session ----
            for s = 0 to MAXSLOTS - 1
                array.set(sesSlotSeen, s, false)
            sesDate      := curDate
            sesFirstSlot := na
            sesLastSlot  := na
            sesObserved  := 0
            sesHasData   := false
            sesIsEarlyCl := array.indexof(ecDates, curDate) >= 0

            // ---- 9.2.4 calendar coverage — evaluated for EVERY session ----
            // INV-31. The lower bound is mandatory, not only ValidatedThrough.
            // Prevention comes only from acknowledged coverage; detection of a
            // shortfall is by definition after the fact.
            if na(covFrom) or na(covThrough) or not covAck or curDate < covFrom or curDate > covThrough
                calendarCoverageViolation += 1
                exportCompleteFlag := 0

        // ======================= SLOT REGISTRATION =======================
        // SAT06-M0-ITA-01 / R1.3. An actual RTH bar outside the Frozen slot
        // range is a data/session contradiction. It fails loudly. The invalid
        // slot is never clamped and never registered: the registration path is
        // structurally unreachable from this branch.
        if na(slotIdx) or slotIdx < 0 or slotIdx >= MAXSLOTS
            runtime.error("⛔ SLOT RANGE — actualRthBar produced slotIdx=" + str.tostring(slotIdx) + " outside [0," + str.tostring(MAXSLOTS - 1) + "] on session " + str.tostring(curDate) + " (SSOT §4.6.4). No slot clamped or registered.")
        else
            // SAT06-M0-ITA-01 / R1.5. A configured early close must yield no bar
            // beyond ECLAST. A bar here means the operator calendar and the
            // exchange data contradict each other. Fail loudly: no bar is
            // synthesized and no bar is suppressed.
            if sesIsEarlyCl and slotIdx > ECLAST
                runtime.error("⛔ CALENDAR/DATA CONTRADICTION — date " + str.tostring(curDate) + " is configured in earlyCloseDates but produced actual RTH slotIdx=" + str.tostring(slotIdx) + " > ECLAST=" + str.tostring(ECLAST) + ". Verify earlyCloseDates against the official exchange calendar (SSOT §4.6.9). No bar synthesized or suppressed.")

            if not array.get(sesSlotSeen, slotIdx)
                array.set(sesSlotSeen, slotIdx, true)
                sesObserved  += 1
                sesFirstSlot := na(sesFirstSlot) ? slotIdx : math.min(sesFirstSlot, slotIdx)
                sesLastSlot  := na(sesLastSlot)  ? slotIdx : math.max(sesLastSlot,  slotIdx)
                sesHasData   := true

// =============================================================================
// 10. M1 — SHARED R1/R2 TOLERANCE SEAM AND SESSION-ENTRY RESET   [COMMIT_DATA]
//     A13 §3. atrRefFrozen and locTolFrozen are THE single shared scalar pair.
//     M2 will consume exactly these; M2 must not create a duplicate tolerance
//     lifecycle. Exactly two write sites exist in this source and no third write
//     or intraday refresh is permitted.
//
//     R1 = the first committed actual-RTH bar of the session (newRthDay).
//     R2 = the confirmed 09:40 bar (slotIdx == 2, since slot 0 = 09:30).
//     Write order at BOTH sites is fixed: atrRefFrozen first, then locTolFrozen
//     derived from it. locTolFrozen never reads atrLive and never reads atrRef
//     directly.
//
//     na DISCIPLINE (A13 §3.4): the assignment is unconditional. If atrRef is na
//     at an authorized freeze point, atrRefFrozen becomes na and locTolFrozen
//     becomes na. That is the required outcome. A `not na(atrRef)` guard is
//     deliberately ABSENT: guarding the write would silently carry the prior
//     session's frozen values forward, which A13 §3.4 prohibits along with
//     atrLive substitution, defaults and last-known-value fallback.
//
//     SAME-COMMIT R1+R2 (A13 §3.5): the two sites are separate `if` statements,
//     never `else if`. On a dataset whose first committed bar is 09:40 both fire
//     on the same commit and both read the same real atrRef. No synthetic
//     history is created and no bar is invented.
//
//     NOT AUTHORIZED HERE (A13 §3.6): no PDH/PDL/ORH/ORL member, cluster, mask,
//     anchor, role, accepted direction, static touch, arm or zone registry.
// =============================================================================
const int ARMED_FOR_TOUCH = 0
const int TOUCHED         = 1

var float atrRefFrozen = na
var float locTolFrozen = na

// Initialised to ARMED_FOR_TOUCH, which is the same value the mandatory
// newRthDay reset assigns. This initialiser is unreachable as semantics: the
// first COMMIT_DATA bar of a dataset is necessarily newRthDay, because
// newRthDay = actualRthBar and ((not prevRthBar) or dayChanged) and no earlier
// actual RTH bar exists, so the reset always precedes the first evaluation.
var int vwapTouchState           = ARMED_FOR_TOUCH
var int vwapPriceTouchCount      = 0
var int vwapZoneMotionTouchCount = 0

if COMMIT_DATA

    // ---- R1 — session entry: freeze, then reset state and counters ----------
    // The reset is placed here so that it provably precedes touch evaluation on
    // the same commit (A13 §4). Counters reset ONLY at newRthDay.
    if newRthDay
        atrRefFrozen             := atrRef
        locTolFrozen             := locTolATR * atrRefFrozen
        vwapTouchState           := ARMED_FOR_TOUCH
        vwapPriceTouchCount      := 0
        vwapZoneMotionTouchCount := 0

    // ---- R2 — confirmed 09:40 refresh --------------------------------------
    // Separate `if`, never `else if`. If slot 2 is absent from the session the
    // refresh simply does not occur and the R1 values stand; no fallback,
    // substitution or deferred refresh is authorized.
    if slotIdx == 2
        atrRefFrozen := atrRef
        locTolFrozen := locTolATR * atrRefFrozen

// =============================================================================
// 11. M1 — UNCONDITIONAL BOUND SERIES AND PER-BAR EVENT DEFAULT
//     A13 §5. These three assignments execute on EVERY chart bar at global
//     scope. They are deliberately NOT inside a conditional block.
//
//     WHY UNCONDITIONAL: a series assigned only inside an `if` retains its last
//     assigned value on bars where the condition is false, so [1] would return a
//     stale bound from an arbitrary earlier bar rather than the immediately
//     previous bar. Assigning explicit na on every non-qualifying bar makes [1]
//     mean exactly "the previous bar's bound, or nothing".
//
//     The bounds are computed AFTER §10, so on an R2 bar the CURRENT bounds use
//     the refreshed tolerance while vwapLower[1] / vwapUpper[1] remain the actual
//     stored series values produced by the prior bar under the OLD tolerance.
//     The previous zone is never recomputed with the current locTolFrozen.
// =============================================================================
boundsAvailable = COMMIT_DATA and not na(vwap) and not na(locTolFrozen)
vwapLower       = boundsAvailable ? vwap - locTolFrozen : na
vwapUpper       = boundsAvailable ? vwap + locTolFrozen : na

// Nonpersistent per-bar event for later flagMask bit 13. Declared without `var`,
// so it is re-initialised to false on every chart bar unconditionally. It is not
// a counter, not persistent state and not an export field.
bool firstBarTouch = false

// =============================================================================
// 12. M1 — VWAP-TOUCH STATE MACHINE                              [COMMIT_DATA]
//     A13 §4/§5/§6. Persistent state is binary: ARMED_FOR_TOUCH or TOUCHED.
//
//     CROSS-SESSION FIREWALL: on an RTH-only chart layout the bar immediately
//     before the new day's 09:30 bar is the prior day's 15:55 bar, which is a
//     committed RTH bar carrying non-na bounds. [1] alone therefore cannot
//     prevent cross-session reuse, so `not newRthDay` is a mandatory term.
//     Consequence: the first RTH intersection of any session is always
//     motion-classified, and R2 bound motion alone can never authenticate a
//     price touch.
// =============================================================================
wouldTouchWithFrozenZone = (not newRthDay) and (not na(vwapLower[1])) and (not na(vwapUpper[1])) and rthH >= vwapLower[1] and rthL <= vwapUpper[1]

if COMMIT_DATA

    // Interval overlap against the CURRENT bounds (A13 §4.2).
    intersectsNow = (not na(vwapLower)) and (not na(vwapUpper)) and rthH >= vwapLower and rthL <= vwapUpper

    // ---- TOUCH ------------------------------------------------------------
    // This `if` MUST execute before the re-arm `if` below and the two MUST NOT
    // be joined by `else if` (A13 §4). Counters change only on an
    // ARMED_FOR_TOUCH -> TOUCHED transition, and exactly one of the two
    // increments per transition, so their sum equals the transition count
    // without any internal PASS flag or transition oracle.
    if vwapTouchState == ARMED_FOR_TOUCH and intersectsNow
        if wouldTouchWithFrozenZone
            vwapPriceTouchCount += 1          // price moved into a stationary zone
        else
            vwapZoneMotionTouchCount += 1     // zone moved onto a stationary bar,
                                              // or the prior bound was unavailable
        if newRthDay
            firstBarTouch := true
        vwapTouchState := TOUCHED

    // ---- RE-ARM -----------------------------------------------------------
    // Separate later `if`. A bar that touches and also clears the exit distance
    // performs ARMED -> TOUCHED -> ARMED and records exactly one touch: the
    // re-arm creates authority for a FUTURE transition, never a second
    // transition on the same bar, because the touch `if` has already run.
    // Reachability: locTolFrozen na implies bounds na implies intersectsNow
    // false, so TOUCHED is unreachable and this comparison cannot fire.
    if vwapTouchState == TOUCHED and math.abs(rthC - vwap) > exitTolMult * locTolFrozen
        vwapTouchState := ARMED_FOR_TOUCH

// =============================================================================
// 13. M2 — STATIC-ZONE IDENTITIES, TYPES AND HELPERS
// =============================================================================

// --- 13.1 fixed member identities (A15 §3) -----------------------------------
const int BIT_PDH = 1
const int BIT_PDL = 2
const int BIT_ORH = 4
const int BIT_ORL = 8
// VWAP holds fixed logical identity bit 16. It is declared ONLY to reserve that
// identity. VWAP remains the separate M1 moving zone and must never enter a
// static member list, mask, cluster, anchor or bound. No M2 statement reads it.
const int BIT_VWAP        = 16
const int STATIC_MASK_MAX = 15   // 1|2|4|8 ; any mask above this is not static

// --- 13.2 state vocabularies (A15 §6) ----------------------------------------
const int SIDE_ABOVE      =  1
const int SIDE_BELOW      = -1
const int SIDE_INSIDE     =  0
const int ROLE_SUPPORT    =  1
const int ROLE_RESISTANCE = -1
const int ROLE_NEUTRAL    =  0
const int DIR_LONG        =  1
const int DIR_SHORT       = -1
const int DIR_NEUTRAL     =  0

// Already-authorized family codes, for the GENERIC ARM KEY ONLY (A15 §7).
// Declaring them authorizes no family predicate. M2 creates no arm.
const int FAM_VWR = 1
const int FAM_LBO = 2
const int FAM_LRT = 3
const int FAM_SQZ = 4

// Exact source-labelled cancellation reasons (A15 §7, §9.4). These are inert
// source labels for static audit, in the same posture as the inherited timing
// literals. They are recorded nowhere at runtime and create no export field,
// no counter and no state.
const string CANCEL_ACCEPT_REVERSED     = "ACCEPT_REVERSED"
const string CANCEL_ZONE_MERGE_CONFLICT = "ZONE_MERGE_CONFLICT"
const string CANCEL_ZONE_REBUILD        = "ZONE_REBUILD"

// --- 13.3 zone registry record (A15 §6) --------------------------------------
// Carries exactly the authorized values. No setupId: M4 will derive
// family*1000 + zoneIdMask*10 + dirCode from the stable mask when family and
// direction exist. No fixture, expected-answer or PASS state exists here.
type Zone
    int   mask           = 0
    int   anchorBit      = 0
    int   anchorPri      = 0
    float anchorPrice    = na
    float lower          = na
    float upper          = na
    int   confluence     = 0
    float minMemberPrice = na
    int   priceSide      = 0
    int   structuralRole = 0
    int   acceptedDir    = 0
    int   acceptBar      = na
    int   aboveRunCount  = 0
    int   belowRunCount  = 0
    int   touchCount     = 0
    bool  insideFlag     = false
    bool  brokenLong     = false
    bool  brokenShort    = false
    int   retestUseLong  = 0
    int   retestUseShort = 0

// --- 13.4 generic arm tuple (A15 §9.4) ---------------------------------------
// The exact authorized tuple, and nothing else. No capacity, quota, global
// selected arm, cancellation counter or execution state.
type Arm
    int family       = 0
    int direction    = 0
    int zoneIdMask   = 0
    int armBar       = na
    int armExpiryBar = na
    int causalOwner  = 0
    // ---- M2 -> M4 INTERFACE EXTENSION (SAT06-A20 §4.2) ----------------------
    // Exactly three added NON-EXPORTED arm-history fields. The real key is still
    // exactly (family, direction, zoneIdMask) and is still unique. armBar,
    // armExpiryBar and every history field belong to ONE WHOLE real arm donor:
    // the R2 re-key/collision constructors below copy all nine fields from the
    // SELECTED donor, with no union, recomputation, min/max blending, reset or
    // field mixing. farEdgeContactSeen and worstAdvEdge are LRT-only history;
    // squeezeReleaseOrd is bound to its own real SQZ key and is never global.
    bool  farEdgeContactSeen = false
    float worstAdvEdge       = na
    int   squeezeReleaseOrd  = na

// --- 13.5 PURE helpers -------------------------------------------------------
// Pine v6 has no bitwise operators. Every mask here is a sum of DISTINCT member
// bits drawn from {1,2,4,8}, and each member contributes at most once, so
// bitwise OR is exactly integer addition and membership is division/modulo.
// PURE — scalar in, scalar out. No global write, no caller-array mutation.
hasBit(int mask, int bit) =>
    na(mask) or na(bit) or bit <= 0 ? false : math.floor(mask / bit) % 2 == 1

// PURE. Anchor priority table of A15 §3: PDH/PDL = 1, ORH/ORL = 2.
anchorPriOf(int bit) =>
    bit == BIT_PDH or bit == BIT_PDL ? 1 : 2

// PURE. Exact A15 §10 distance: 0 inside, lower-price below, price-upper above.
distToZone(float px, float lo, float hi) =>
    na(px) or na(lo) or na(hi) ? na : px < lo ? lo - px : px > hi ? px - hi : 0.0

// PURE. A15 §6 priceSide: ABOVE when close > upper, BELOW when close < lower.
sideOf(float c, float lo, float hi) =>
    na(c) or na(lo) or na(hi) ? na : c > hi ? SIDE_ABOVE : c < lo ? SIDE_BELOW : SIDE_INSIDE

// PURE. Initial structural role from geometry (A15 §6).
roleFromSide(int side) =>
    side == SIDE_ABOVE ? ROLE_SUPPORT : side == SIDE_BELOW ? ROLE_RESISTANCE : ROLE_NEUTRAL

// PURE. Accepted LONG owns SUPPORT, accepted SHORT owns RESISTANCE (A15 §6).
roleFromDir(int dir) =>
    dir == DIR_LONG ? ROLE_SUPPORT : dir == DIR_SHORT ? ROLE_RESISTANCE : ROLE_NEUTRAL

// --- 13.6 deterministic geometry construction (A15 §5) -----------------------
// NOT PURE — sorts the caller-owned member arrays IN PLACE and returns a NEW
// zone array. It assigns no global. Its only call sites are the two authorized
// rebuild points in §15.3 and §15.5.
buildZones(array<float> mP, array<int> mB, float locTol, float atrF, float mergeDist, float maxWidthMult, float refC) =>
    array<Zone> out = array.new<Zone>()
    int n = array.size(mP)

    if n > 0
        // 1. TOTAL-ORDER SORT by (price ascending, member bit ascending).
        //    Selection sort with an EXPLICIT comparator: correctness never
        //    depends on any library sort's behaviour for equal prices (§5.2).
        if n > 1
            for i = 0 to n - 2
                int best = i
                for j = i + 1 to n - 1
                    float pj = array.get(mP, j)
                    float pb = array.get(mP, best)
                    if pj < pb or (pj == pb and array.get(mB, j) < array.get(mB, best))
                        best := j
                if best != i
                    float tp = array.get(mP, i)
                    int   tb = array.get(mB, i)
                    array.set(mP, i, array.get(mP, best))
                    array.set(mB, i, array.get(mB, best))
                    array.set(mP, best, tp)
                    array.set(mB, best, tb)

        // 2. CLUSTERING. Admission compares each later member with the CLUSTER
        //    MINIMUM — the first member of the open cluster, which is the lowest
        //    because the array is sorted — and never with the last admitted
        //    member. That is exactly what forbids chained merging (§5.4).
        //    Clusters are contiguous index ranges over the sorted array.
        array<int> rLo = array.new_int()
        array<int> rHi = array.new_int()
        int cs = 0
        if n > 1
            for i = 1 to n - 1
                if array.get(mP, i) - array.get(mP, cs) > mergeDist
                    array.push(rLo, cs)
                    array.push(rHi, i - 1)
                    cs := i
        array.push(rLo, cs)
        array.push(rHi, n - 1)

        // 3. EXPANDED-WIDTH SPLITTING. Bounded worklist, as A15 §5 authorizes.
        //    With at most four members a cluster needs at most THREE actual
        //    splits to reach singletons, so three passes are structurally
        //    sufficient — this is a structural bound derived from the member
        //    count, not a truncation. Each pass splits the FIRST failing range
        //    in ascending order. Splitting a range depends only on that range,
        //    so the processing order cannot change the final partition: the
        //    result equals the recursive rule's partition exactly. This is NOT
        //    a single-level split — a child produced by a split is retested and
        //    can itself be split on a later pass.
        float maxW = maxWidthMult * atrF
        for pass = 0 to 2
            int target = -1
            for k = 0 to array.size(rLo) - 1
                if target == -1
                    int lo = array.get(rLo, k)
                    int hi = array.get(rHi, k)
                    if hi > lo                         // singleton children are terminal
                        float w = (array.get(mP, hi) + locTol) - (array.get(mP, lo) - locTol)
                        if w > maxW                    // STRICT predicate (§5.8)
                            target := k
            if target >= 0
                int lo = array.get(rLo, target)
                int hi = array.get(rHi, target)
                int   gAt   = lo
                float gBest = -1.0
                for g = lo to hi - 1
                    float gap = array.get(mP, g + 1) - array.get(mP, g)
                    if gap > gBest        // STRICT: on an exact tie the LOWEST-price
                        gBest := gap      // (leftmost) gap is retained (§5.10)
                        gAt   := g
                array.set(rHi, target, gAt)
                array.insert(rLo, target + 1, gAt + 1)
                array.insert(rHi, target + 1, hi)

        // 4. EMIT. Mask, anchor, bounds and confluence are recomputed
        //    INDEPENDENTLY for every final child (§5.11).
        for k = 0 to array.size(rLo) - 1
            int lo = array.get(rLo, k)
            int hi = array.get(rHi, k)
            int   m      = 0
            int   aBit   = 0
            int   aPri   = 0
            float aPrice = na
            for t = lo to hi
                int   b = array.get(mB, t)
                float p = array.get(mP, t)
                m += b                        // distinct bits => sum == bitwise OR
                int   pr = anchorPriOf(b)
                float d  = math.abs(p - refC)
                bool better = aBit == 0
                if not better
                    float dCur = math.abs(aPrice - refC)
                    better := pr < aPri or (pr == aPri and d < dCur) or (pr == aPri and d == dCur and b < aBit)
                if better
                    aBit   := b
                    aPri   := pr
                    aPrice := p
            array.push(out, Zone.new(mask = m, anchorBit = aBit, anchorPri = aPri, anchorPrice = aPrice, lower = array.get(mP, lo) - locTol, upper = array.get(mP, hi) + locTol, confluence = hi - lo + 1, minMemberPrice = array.get(mP, lo)))

    // 5. DETERMINISTIC EVIDENCE ORDER: (minimum member price ascending,
    //    zoneIdMask ascending). Storage order owns no semantics; active-zone
    //    selection is governed only by §15.7.
    int nz = array.size(out)
    if nz > 1
        for i = 0 to nz - 2
            int best = i
            for j = i + 1 to nz - 1
                Zone zj = array.get(out, j)
                Zone zb = array.get(out, best)
                if zj.minMemberPrice < zb.minMemberPrice or (zj.minMemberPrice == zb.minMemberPrice and zj.mask < zb.mask)
                    best := j
            if best != i
                Zone tmp = array.get(out, i)
                array.set(out, i, array.get(out, best))
                array.set(out, best, tmp)
    out

// =============================================================================
// 14. M2 — STATIC-ZONE STATE
// =============================================================================
// Third shared frozen scalar, alongside the INHERITED M1 atrRefFrozen and
// locTolFrozen. M2 declares no duplicate of those two and never writes them.
var float mergeDistFrozen = na

// Opening Range, fixed to the three actual 5-minute RTH slots 0, 1, 2
// (09:30, 09:35, 09:40). There is deliberately no orMinutes input.
var float orHigh    = na
var float orLow     = na
var bool  orSlot0Ok = false
var bool  orSlot1Ok = false
var bool  orSlot2Ok = false
var bool  orReady   = false

var array<Zone> zoneReg  = array.new<Zone>()
var array<Arm>  armStore = array.new<Arm>()

// Derived per commit, never persistent. Declared without `var`, so it defaults
// to na on every chart bar. na means active-zone identity is simply
// unavailable; that is NOT a Risk rejection and M2 implements no opposing-zone
// or R9 behaviour.
int activeZoneIdx = na

// =============================================================================
// 15. M2 — PER-COMMIT STATIC-ZONE PIPELINE                       [COMMIT_DATA]
//     ONE block, so that the A15 §8 atomic order IS the literal source order:
//       15.1  frozen merge distance   R1 / R2 only, after §10 wrote atrRefFrozen
//       15.2  Opening-Range lifecycle reset, slot 0/1/2 accumulation, readiness
//       15.3  R1 geometry             newRthDay, PDH/PDL only, clean init
//       15.4  ONE state update        this commit, against the PRE-R2 registry
//       15.5  R2 staged rebuild       slot 2 and orReady only, then atomic swap
//       15.7  active static zone      after any swap
//     There is no pre-R2 trigger evaluation, no replay, no second static-state
//     update against post-R2 geometry and no geometry-motion touch.
// =============================================================================
if COMMIT_DATA

    // ---- 15.1 frozen merge distance (A15 §4) --------------------------------
    // Exactly two write sites, both at the inherited authorized freeze commits
    // and both placed AFTER §10 has written atrRefFrozen. Separate `if`s, never
    // `else if`, so a first-dataset 09:40 commit writes once through each with
    // the same real atrRef. The assignment is UNGUARDED: if the inherited frozen
    // ATR is na the derived value is na, which is the required outcome. A na
    // guard would silently carry the prior session's geometry forward.
    if newRthDay
        mergeDistFrozen := mergeATR * atrRefFrozen
    if slotIdx == 2
        mergeDistFrozen := mergeATR * atrRefFrozen

    // ---- 15.2 Opening Range (A15 §3) ----------------------------------------
    if newRthDay
        orHigh    := na
        orLow     := na
        orSlot0Ok := false
        orSlot1Ok := false
        orSlot2Ok := false
        orReady   := false

    // Only REAL COMMIT_DATA bars at the exact slots 0, 1 and 2 are consumed.
    bool orSlotUsable = not na(rthH) and not na(rthL)
    if orSlotUsable and (slotIdx == 0 or slotIdx == 1 or slotIdx == 2)
        orHigh := na(orHigh) ? rthH : math.max(orHigh, rthH)
        orLow  := na(orLow)  ? rthL : math.min(orLow,  rthL)
        if slotIdx == 0
            orSlot0Ok := true
        if slotIdx == 1
            orSlot1Ok := true
        if slotIdx == 2
            orSlot2Ok := true

    // orReady can become true ONLY on the slot-2 commit and ONLY when all three
    // exact slots supplied usable high/low values. No partial OR value exists,
    // and there is no later path to true — so no delayed or third rebuild can
    // ever be authorized.
    if slotIdx == 2 and orSlot0Ok and orSlot1Ok and orSlot2Ok
        orReady := true

    bool geomInputsReady = not na(atrRefFrozen) and not na(locTolFrozen) and not na(mergeDistFrozen)

    // ---- 15.3 R1 geometry construction (A15 §4, §6) -------------------------
    if newRthDay
        // Prior-session arms do not survive a session boundary.
        array.clear(armStore)

        array<float> mP1 = array.new_float()
        array<int>   mB1 = array.new_int()
        if not na(pdh)
            array.push(mP1, pdh)
            array.push(mB1, BIT_PDH)
        if not na(pdl)
            array.push(mP1, pdl)
            array.push(mB1, BIT_PDL)

        // Stale geometry is never retained and no default is invented. If the
        // frozen geometry inputs are unavailable the valid-zone set is empty.
        array<Zone> built1 = array.new<Zone>()
        if geomInputsReady
            built1 := buildZones(mP1, mB1, locTolFrozen, atrRefFrozen, mergeDistFrozen, maxZoneWidthATR, rthC)

        // Every new zone begins clean — acceptedDir 0, acceptBar na, both run
        // counters 0, touchCount 0, both broken flags false, both retest counts
        // 0, no inherited arm — from the Zone defaults. Then priceSide and role
        // come from geometry, and insideFlag is initialized from the CURRENT
        // overlap BEFORE any touch-transition counting, so zone creation itself
        // cannot manufacture a touch (§6).
        if array.size(built1) > 0
            for i = 0 to array.size(built1) - 1
                Zone z = array.get(built1, i)
                z.priceSide      := sideOf(rthC, z.lower, z.upper)
                z.structuralRole := roleFromSide(z.priceSide)
                z.insideFlag     := rthH >= z.lower and rthL <= z.upper
        zoneReg := built1

    // ---- 15.4 exactly ONE state update for this commit (A15 §7) -------------
    // Evaluated against the CURRENT, pre-R2 registry. On an R1 commit this is
    // the "process the directional close exactly once" pass; its touch clause is
    // a no-op there because §15.3 already stored the current overlap, which is
    // what owns the no-synthetic-touch result.
    if array.size(zoneReg) > 0
        for i = 0 to array.size(zoneReg) - 1
            Zone z = array.get(zoneReg, i)

            // directional continuity: two counters, an inside close clears both
            if rthC > z.upper
                z.aboveRunCount += 1
                z.belowRunCount := 0
            else if rthC < z.lower
                z.belowRunCount += 1
                z.aboveRunCount := 0
            else
                z.aboveRunCount := 0
                z.belowRunCount := 0

            // priceSide follows the same close and may change every commit
            z.priceSide := sideOf(rthC, z.lower, z.upper)

            // acceptance. acceptBar moves ONLY when acceptedDir actually
            // changes, so it is stable while the accepted direction is stable.
            // An inside close never changes structuralRole by itself.
            int oldDir = z.acceptedDir
            if z.aboveRunCount >= acceptBars and z.acceptedDir != DIR_LONG
                z.acceptedDir    := DIR_LONG
                z.acceptBar      := bar_index
                z.structuralRole := ROLE_SUPPORT
            if z.belowRunCount >= acceptBars and z.acceptedDir != DIR_SHORT
                z.acceptedDir    := DIR_SHORT
                z.acceptBar      := bar_index
                z.structuralRole := ROLE_RESISTANCE

            // CANCEL_ACCEPT_REVERSED. A true reversal — the old accepted
            // direction was nonzero and has flipped — cancels every existing LRT
            // arm held on the OLD direction for this zone. Family code 3 only.
            // No cancellation export field or counter is created.
            if oldDir != DIR_NEUTRAL and z.acceptedDir != oldDir and array.size(armStore) > 0
                array<Arm> keptArms = array.new<Arm>()
                for ai = 0 to array.size(armStore) - 1
                    Arm a = array.get(armStore, ai)
                    if not (a.family == FAM_LRT and a.direction == oldDir and a.zoneIdMask == z.mask)
                        array.push(keptArms, a)
                armStore := keptArms

            // static touch: outside-to-intersection transition only. Consecutive
            // inside or intersecting bars do not recount.
            bool barTouchesZone = rthH >= z.lower and rthL <= z.upper
            if (not z.insideFlag) and barTouchesZone
                z.touchCount += 1
            z.insideFlag := barTouchesZone

    // ---- 15.5 R2 staged rebuild (A15 §8, §9) --------------------------------
    // Authorized ONLY on the confirmed 09:40 commit and ONLY when the exact
    // three-slot OR is genuinely ready. If the dataset began at slot 2 then
    // orReady is false and no Static-Zone R2 occurs, even though §10 already
    // performed M1's own tolerance refresh. No synthetic prior OR bar exists.
    if slotIdx == 2 and orReady

        array<float> mP2 = array.new_float()
        array<int>   mB2 = array.new_int()
        if not na(pdh)
            array.push(mP2, pdh)
            array.push(mB2, BIT_PDH)
        if not na(pdl)
            array.push(mP2, pdl)
            array.push(mB2, BIT_PDL)
        if not na(orHigh)
            array.push(mP2, orHigh)
            array.push(mB2, BIT_ORH)
        if not na(orLow)
            array.push(mP2, orLow)
            array.push(mB2, BIT_ORL)

        array<Zone> staged = array.new<Zone>()
        if geomInputsReady
            staged := buildZones(mP2, mB2, locTolFrozen, atrRefFrozen, mergeDistFrozen, maxZoneWidthATR, rthC)

        // Parent mapping and canonical parent, computed while the OLD registry,
        // the STAGED registry and the mapping all coexist.
        array<int> canonParent = array.new_int()
        array<int> conflictFlg = array.new_int()

        if array.size(staged) > 0
            for si = 0 to array.size(staged) - 1
                Zone nz = array.get(staged, si)

                // parentSet: old zones whose OLD ANCHOR is a member of this new
                // zone. An old zone therefore parents exactly the split child
                // that contains its anchor; every other child is clean.
                array<int> parents = array.new_int()
                if array.size(zoneReg) > 0
                    for oi = 0 to array.size(zoneReg) - 1
                        if hasBit(nz.mask, array.get(zoneReg, oi).anchorBit)
                            array.push(parents, oi)

                // canonicalAnchorParent: exact old-anchor == new-anchor equality
                // first; when no exact equality exists in an otherwise nonempty
                // valid parent set, rank by (old-anchor priority ascending,
                // distance from old-anchor price to the confirmed rebuild rthC
                // ascending, old-anchor bit ascending).
                int canon = -1
                if array.size(parents) > 0
                    for pi = 0 to array.size(parents) - 1
                        int cand = array.get(parents, pi)
                        if canon == -1 and array.get(zoneReg, cand).anchorBit == nz.anchorBit
                            canon := cand
                    if canon == -1
                        for pi = 0 to array.size(parents) - 1
                            int cand = array.get(parents, pi)
                            Zone op = array.get(zoneReg, cand)
                            bool better = canon == -1
                            if not better
                                Zone cz = array.get(zoneReg, canon)
                                float dO = math.abs(op.anchorPrice - rthC)
                                float dC = math.abs(cz.anchorPrice - rthC)
                                better := op.anchorPri < cz.anchorPri or (op.anchorPri == cz.anchorPri and dO < dC) or (op.anchorPri == cz.anchorPri and dO == dC and op.anchorBit < cz.anchorBit)
                            if better
                                canon := cand

                // accepted-direction fold across the parent set
                bool hasLong  = false
                bool hasShort = false
                if array.size(parents) > 0
                    for pi = 0 to array.size(parents) - 1
                        Zone op = array.get(zoneReg, array.get(parents, pi))
                        if op.acceptedDir == DIR_LONG
                            hasLong := true
                        if op.acceptedDir == DIR_SHORT
                            hasShort := true

                bool conflict = hasLong and hasShort
                int  foldDir  = conflict ? DIR_NEUTRAL : hasLong ? DIR_LONG : hasShort ? DIR_SHORT : DIR_NEUTRAL

                // acceptBar comes ONLY from a real parent that actually carries
                // the preserved nonzero direction; the latest non-na when
                // several do. A neutral parent's time can never backdate a
                // nonzero direction and no intermediate time is synthesized.
                int foldBar = na
                if foldDir != DIR_NEUTRAL and array.size(parents) > 0
                    for pi = 0 to array.size(parents) - 1
                        Zone op = array.get(zoneReg, array.get(parents, pi))
                        if op.acceptedDir == foldDir and not na(op.acceptBar)
                            if na(foldBar) or op.acceptBar > foldBar
                                foldBar := op.acceptBar

                nz.acceptedDir := foldDir
                nz.acceptBar   := foldDir == DIR_NEUTRAL ? na : foldBar

                // The canonical parent ALONE owns the scalar touch count and the
                // per-direction broken and retest-use history. Never summed,
                // never unioned, never capped as a synthetic sum, and never
                // reset merely because the mask changed.
                if canon >= 0
                    Zone cp = array.get(zoneReg, canon)
                    nz.touchCount     := cp.touchCount
                    nz.brokenLong     := cp.brokenLong
                    nz.brokenShort    := cp.brokenShort
                    nz.retestUseLong  := cp.retestUseLong
                    nz.retestUseShort := cp.retestUseShort

                // every staged zone resets geometry-specific run counters
                nz.aboveRunCount := 0
                nz.belowRunCount := 0

                // new priceSide from the 09:40 close against the NEW bounds;
                // role from the accepted direction when one survives, NEUTRAL on
                // a true conflict, otherwise from the new side.
                nz.priceSide      := sideOf(rthC, nz.lower, nz.upper)
                nz.structuralRole := conflict ? ROLE_NEUTRAL : foldDir != DIR_NEUTRAL ? roleFromDir(foldDir) : roleFromSide(nz.priceSide)

                array.push(canonParent, canon)
                array.push(conflictFlg, conflict ? 1 : 0)

        // ---- generic arm re-key and cancellation (A15 §9.4) -----------------
        // Performed while the old registry, the staged registry and the parent
        // mapping coexist, and staged into a NEW collection, so key ownership is
        // never mutated while the same changing collection is being used as the
        // donor-order authority. M2 creates no arm, so this store has no
        // producer at this increment; the mechanics are exact and dormant.
        array<Arm> stagedArms  = array.new<Arm>()
        array<int> stagedDonor = array.new_int()
        if array.size(armStore) > 0
            for ai = 0 to array.size(armStore) - 1
                Arm a = array.get(armStore, ai)

                if a.zoneIdMask <= 0 or a.zoneIdMask > STATIC_MASK_MAX
                    // Not a static mask. A future VWR row on the fixed VWAP mask
                    // 16 is not a static parent and is unaffected by R2.
                    array.push(stagedArms, a)
                    array.push(stagedDonor, -1)
                else
                    int op = -1
                    if array.size(zoneReg) > 0
                        for oi = 0 to array.size(zoneReg) - 1
                            if op == -1 and array.get(zoneReg, oi).mask == a.zoneIdMask
                                op := oi
                    int tz = -1
                    if op >= 0 and array.size(staged) > 0
                        int oldAnchor = array.get(zoneReg, op).anchorBit
                        for si = 0 to array.size(staged) - 1
                            if tz == -1 and hasBit(array.get(staged, si).mask, oldAnchor)
                                tz := si

                    // op == -1 or tz == -1  -> CANCEL_ZONE_REBUILD: the old
                    //   anchor identity does not survive into any new zone.
                    // conflictFlg[tz] == 1  -> CANCEL_ZONE_MERGE_CONFLICT: every
                    //   arm affected by a true LONG/SHORT conflict cancels.
                    // Neither pushes anything into the staged collection.
                    if op >= 0 and tz >= 0 and array.get(conflictFlg, tz) != 1
                        int newMask = array.get(staged, tz).mask
                        int rival   = -1
                        if array.size(stagedArms) > 0
                            for qi = 0 to array.size(stagedArms) - 1
                                Arm q = array.get(stagedArms, qi)
                                if rival == -1 and q.family == a.family and q.direction == a.direction and q.zoneIdMask == newMask
                                    rival := qi
                        if rival == -1
                            // noncolliding real arm: follows its authorized
                            // anchor-owning child, atomically re-keyed. One WHOLE
                            // real tuple; armBar, expiry and causal owner move
                            // together and are never mixed across donors.
                            array.push(stagedArms, Arm.new(family = a.family, direction = a.direction, zoneIdMask = newMask, armBar = a.armBar, armExpiryBar = a.armExpiryBar, causalOwner = a.causalOwner, farEdgeContactSeen = a.farEdgeContactSeen, worstAdvEdge = a.worstAdvEdge, squeezeReleaseOrd = a.squeezeReleaseOrd))
                            array.push(stagedDonor, op)
                        else
                            int  rivalDonor = array.get(stagedDonor, rival)
                            int  canonIdx   = array.get(canonParent, tz)
                            bool newWins    = false
                            if canonIdx >= 0 and rivalDonor == canonIdx
                                newWins := false
                            else if canonIdx >= 0 and op == canonIdx
                                newWins := true
                            else
                                Zone zo = array.get(zoneReg, op)
                                Zone zr = array.get(zoneReg, rivalDonor)
                                float dO = math.abs(zo.anchorPrice - rthC)
                                float dR = math.abs(zr.anchorPrice - rthC)
                                newWins := zo.anchorPri < zr.anchorPri or (zo.anchorPri == zr.anchorPri and dO < dR) or (zo.anchorPri == zr.anchorPri and dO == dR and zo.anchorBit < zr.anchorBit)
                            if newWins
                                // the displaced incumbent cancels
                                // CANCEL_ZONE_REBUILD; one whole real tuple
                                // replaces another, never a field-wise blend.
                                array.set(stagedArms, rival, Arm.new(family = a.family, direction = a.direction, zoneIdMask = newMask, armBar = a.armBar, armExpiryBar = a.armExpiryBar, causalOwner = a.causalOwner, farEdgeContactSeen = a.farEdgeContactSeen, worstAdvEdge = a.worstAdvEdge, squeezeReleaseOrd = a.squeezeReleaseOrd))
                                array.set(stagedDonor, rival, op)
                            // else this arm cancels CANCEL_ZONE_REBUILD

        // ---- 15.6 atomic swap -----------------------------------------------
        // Old registry and old keys are replaced by the staged registry and the
        // one surviving key set in a single step. Nothing reads a half-swapped
        // state, and no old key can coexist with its replacement.
        zoneReg  := staged
        armStore := stagedArms

        // Every new insideFlag is initialized from the 09:40 bar against the NEW
        // bounds and NEVER increments touchCount. Geometry motion alone cannot
        // manufacture a touch, and this is not a second state update: no run
        // counter, acceptance, priceSide or touch count is recomputed here.
        if array.size(zoneReg) > 0
            for i = 0 to array.size(zoneReg) - 1
                Zone z = array.get(zoneReg, i)
                z.insideFlag := rthH >= z.lower and rthL <= z.upper

    // ---- 15.7 active static zone (A15 §10) ----------------------------------
    // Candidate radius uses the LIVE inherited atrRef, not a frozen value, and
    // there is no default or last-known substitution. Selection is lexicographic
    // on (distance ascending, confluence descending, anchor priority ascending,
    // zoneIdMask ascending). There is no fifth tie-breaker.
    float armRadius = armDistATR * atrRef
    if array.size(zoneReg) > 0 and not na(armRadius)
        int   bestI = -1
        float bestD = na
        for i = 0 to array.size(zoneReg) - 1
            Zone z = array.get(zoneReg, i)
            float d = distToZone(rthC, z.lower, z.upper)
            if not na(d) and d <= armRadius
                bool better = bestI == -1
                if not better
                    Zone zb = array.get(zoneReg, bestI)
                    better := d < bestD or (d == bestD and z.confluence > zb.confluence) or (d == bestD and z.confluence == zb.confluence and z.anchorPri < zb.anchorPri) or (d == bestD and z.confluence == zb.confluence and z.anchorPri == zb.anchorPri and z.mask < zb.mask)
                if better
                    bestI := i
                    bestD := d
        if bestI >= 0
            activeZoneIdx := bestI

// =============================================================================
// 16. M3 — RVOL CONFIGURATION, STATE AND HELPERS
// =============================================================================

// --- 16.1 non-configurable ring capacity (A17 §2) ----------------------------
// There is deliberately NO rvolLookbackDays input. Capacity is always 20 and it
// INCLUDES the in-progress position, so at most 19 prior positions can ever be
// readable. A 21-position ring, a true 20-prior median, or "19 versus 20 is
// negligible" reasoning is prohibited.
const int RVOL_RING_CAPACITY = 20

// --- 16.2 authorized M3 inputs (A17 §2) --------------------------------------
gRvol = "F · RVOL (M3 · SAT06-A17 §2)"
// EXACT authorized bounds. No step, mode, override, alternate default/range,
// scenario selector, tuning helper or optimization surface. splitDetectFactor,
// RVOL_DISCONTINUITY and any re-warm disable state are outside this bounded
// SC-01..SC-03 increment and are deliberately absent.
rvolMinSlotsPerSession = input.int(40, "rvolMinSlotsPerSession (session admissibility)", minval = 20, maxval = 78, group = gRvol)
rvolMinSessions        = input.int(10, "rvolMinSessions        (warm-up latch)",         minval = 1,  maxval = 20, group = gRvol)
rvolMinSamples         = input.int(5,  "rvolMinSamples         (exact-slot density)",    minval = 1,  maxval = 19, group = gRvol)

// --- 16.3 auditable config fact and first-bar loud guard (A17 §2.3/§2.4) -----
// UI bounds do not replace this source guard: an input can be supplied outside
// its UI range by a saved chart layout or a template, so the source enforces the
// ring-capacity relationship independently. rvolMinSamples is capped at 19
// because the current position is never readable.
rvolConfigOk = rvolMinSessions <= RVOL_RING_CAPACITY and rvolMinSamples <= RVOL_RING_CAPACITY - 1

if barstate.isfirst and not rvolConfigOk
    runtime.error("⛔ RVOL CONFIG — rvolMinSessions must be <= " + str.tostring(RVOL_RING_CAPACITY) + " and rvolMinSamples must be <= " + str.tostring(RVOL_RING_CAPACITY - 1) + ". The ring holds " + str.tostring(RVOL_RING_CAPACITY) + " positions INCLUDING the in-progress session, so at most " + str.tostring(RVOL_RING_CAPACITY - 1) + " prior positions can ever be readable (A17 §2.3, §6.6).")

// --- 16.4 M3 persistent state (A17 §3.1) -------------------------------------
// Flat addressing is exact:  cellIndex = slotIdx * RVOL_RING_CAPACITY + position
// MAXSLOTS (96) is the inherited slot allocation and slotIdx is already guarded
// to [0,95] by the inherited loud slot-range failure, so every cell index lies
// inside [0, 1919].
var array<float> volArr    = array.new_float(MAXSLOTS * RVOL_RING_CAPACITY, na)
var array<float> cumArr    = array.new_float(MAXSLOTS * RVOL_RING_CAPACITY, na)

// Readability of each ring position. Every position starts NON-READABLE; a
// position becomes readable only when its session is finalized as eligible.
var array<bool> ringEligible = array.new_bool(RVOL_RING_CAPACITY, false)

var int   dayRingPos             = 0
var int   rvolSessionsCommitted  = 0     // monotonic warm-up latch, saturates at 20
var int   rvolIneligibleSessions = 0
var int   rvolIneligibleLeakFail = 0
var float sessionCumVol          = na    // current session cumulative volume

// Bounded scratch sample sets, cleared at the start of every commit. At most
// RVOL_RING_CAPACITY - 1 entries can ever be appended.
var array<float> rawSamples = array.new_float()
var array<float> cumSamples = array.new_float()

// --- 16.5 per-bar Research facts (A17 §3.2) ----------------------------------
// Declared WITHOUT var, so every field resets on every chart bar. These are
// current-bar facts, never persistent last-known values: outside COMMIT_DATA and
// whenever the exact readiness or data conditions fail, the value fields are
// explicitly na and no stale value can carry forward.
int   slotSamples           = na
int   cumSlotSamples        = na
bool  rvolSessionsReady     = false
bool  slotSamplesOk         = false
bool  rvolValueReady        = false
bool  rvolF7SessionsWarming = false   // F7 cause: not rvolSessionsReady
bool  rvolF8SlotSparse      = false   // F8 cause: not slotSamplesOk
float relVol                = na      // CANONICAL
float relVolCum             = na      // DIAGNOSTIC / CONTEXT ONLY

// --- 16.6 exact median helper ------------------------------------------------
// NOT PURE — sorts the caller-owned scratch array IN PLACE and returns a scalar.
// It assigns no global. Only §17 calls it, and only on a nonempty array.
// The convention is stated in source rather than inherited from a library:
// ascending order, the central value for odd counts, the mean of the two
// central values for even counts. Correctness therefore never depends on an
// unverified platform tie convention.
rvolMedian(array<float> a) =>
    float m = na
    int   n = array.size(a)
    if n > 0
        if n > 1
            for i = 0 to n - 2
                int best = i
                for j = i + 1 to n - 1
                    if array.get(a, j) < array.get(a, best)
                        best := j
                if best != i
                    float t = array.get(a, i)
                    array.set(a, i, array.get(a, best))
                    array.set(a, best, t)
        int mid = math.floor(n / 2)
        m := n % 2 == 1 ? array.get(a, mid) : (array.get(a, mid - 1) + array.get(a, mid)) / 2.0
    m

// =============================================================================
// 17. M3 — PER-COMMIT RVOL PIPELINE                              [COMMIT_DATA]
//     ONE block, so the A17 §4/§5 order IS the literal source order:
//       17.1  new-session lifecycle   finalize -> rotate -> clear   (newRthDay)
//       17.2  baseline READ           current position excluded unconditionally
//       17.3  prior medians           never called on an empty sample set
//       17.4  current cumulative      na propagates, no nz / zero substitution
//       17.5  current values          relVol canonical, relVolCum diagnostic
//       17.6  current WRITE           strictly after every baseline read
//     M3 is positioned after the inherited M0 session classifier, so on a
//     newRthDay commit the just-finished session has already been published into
//     prevSess*. M3 creates no Observation, Risk result, Q1 score, trigger, arm,
//     queue record or Funnel event, and never alters COMMIT_DATA or acquisition.
// =============================================================================
if COMMIT_DATA

    // ---- 17.1 new-session lifecycle (A17 §4) --------------------------------
    if newRthDay

        if anyPriorSessionFlag == 0
            // A17 §4.1 FIRST DATASET SESSION. There is no prior session to
            // finalize, so nothing is committed, nothing is counted ineligible
            // and the ring does NOT rotate. The in-progress position simply
            // stays non-readable and the accumulator opens at the empty sum.
            array.set(ringEligible, dayRingPos, false)
            sessionCumVol := 0.0

        else
            // A17 §4.2 FINALIZE THE PRIOR OBSERVED SESSION — this is SC-01.
            // Eligibility owns sample ADMISSIBILITY, not merely a counter: an
            // ineligible session's stored cells are destroyed, so they can never
            // become a future baseline. Every term is read from inherited
            // published M0 state; calendar-coverage validity is a separate
            // concern and is deliberately NOT part of this formula.
            //   missing prefix        -> prevSessFirstSlot != 0     -> ineligible
            //   sparse session        -> prevSessObserved  <  min   -> ineligible
            //   disqualifying gap     -> prevSessDisqGap   != 0     -> ineligible
            //   unexplained shortfall -> class C_SHORT             -> ineligible
            //   configured early close-> class C_EARLY             -> ELIGIBLE
            // Class 6 and Class 7 are ABSENT DATES, not observed sessions: they
            // never reach this branch, so they create no ring sample, no
            // finalization, no rotation and no committed-session increment.
            bool priorSessionRvolEligible = prevSessFirstSlot == 0 and prevSessObserved >= rvolMinSlotsPerSession and prevSessDisqGap == 0 and (prevSessClass == C_NORMAL or prevSessClass == C_EARLY)

            if priorSessionRvolEligible
                rvolSessionsCommitted := rvolSessionsCommitted + 1 > RVOL_RING_CAPACITY ? RVOL_RING_CAPACITY : rvolSessionsCommitted + 1
                array.set(ringEligible, dayRingPos, true)
            else
                rvolIneligibleSessions += 1
                for s = 0 to MAXSLOTS - 1
                    int ci = s * RVOL_RING_CAPACITY + dayRingPos
                    array.set(volArr, ci, na)
                    array.set(cumArr, ci, na)
                array.set(ringEligible, dayRingPos, false)

            // A17 §4.3 ROTATE AND CLEAR THE INCOMING POSITION. No stale cell may
            // survive rotation, and the in-progress position is never readable.
            dayRingPos := (dayRingPos + 1) % RVOL_RING_CAPACITY
            for s = 0 to MAXSLOTS - 1
                int ci = s * RVOL_RING_CAPACITY + dayRingPos
                array.set(volArr, ci, na)
                array.set(cumArr, ci, na)
            array.set(ringEligible, dayRingPos, false)
            sessionCumVol := 0.0

    // ---- 17.2 baseline read at the exact slot (A17 §5.1-§5.5) ---------------
    array.clear(rawSamples)
    array.clear(cumSamples)

    for p = 0 to RVOL_RING_CAPACITY - 1
        // The current position is excluded UNCONDITIONALLY, independently of its
        // readability flag. This is the first of two independent guarantees that
        // the current session can never be part of its own baseline; the second
        // is source order, because the current write happens in §17.6.
        if p != dayRingPos
            int   ci   = slotIdx * RVOL_RING_CAPACITY + p
            float rawV = array.get(volArr, ci)
            float cumV = array.get(cumArr, ci)
            if array.get(ringEligible, p)
                if not na(rawV)
                    array.push(rawSamples, rawV)
                if not na(cumV)
                    array.push(cumSamples, cumV)
            else if (not na(rawV)) or (not na(cumV))
                // A non-readable position still holding data is a purge or
                // rotation failure. It is reported loudly in evidence and it
                // invalidates the export; it is never silently consumed.
                rvolIneligibleLeakFail += 1
                exportCompleteFlag     := 0

    slotSamples           := array.size(rawSamples)
    cumSlotSamples        := array.size(cumSamples)
    rvolSessionsReady     := rvolSessionsCommitted >= rvolMinSessions
    slotSamplesOk         := slotSamples >= rvolMinSamples
    rvolValueReady        := rvolSessionsReady and slotSamplesOk
    // SC-02 / SC-03: the two causes stay DISTINCT so a later module can tell
    // "still warming up" from "this exact slot is sparse". Sessions-ready never
    // substitutes for a sparse slot and slot-ready never substitutes for
    // warm-up; there is no partial, default, diagnostic or last-known relVol.
    rvolF7SessionsWarming := not rvolSessionsReady
    rvolF8SlotSparse      := not slotSamplesOk

    // ---- 17.3 prior medians (A17 §5.6) --------------------------------------
    // Computed only from nonempty eligible sample sets. rvolMedian is never
    // invoked on an empty array.
    float rawMedian = na
    if array.size(rawSamples) > 0
        rawMedian := rvolMedian(rawSamples)
    float cumMedian = na
    if array.size(cumSamples) > 0
        cumMedian := rvolMedian(cumSamples)

    // ---- 17.4 current cumulative volume (A17 §5.7) --------------------------
    // Plain addition, so a missing current volume PROPAGATES na through the rest
    // of the session's cumulative figure rather than being silently skipped.
    // There is no nz(), no zero substitution and no last-known value. The
    // session opens at the empty sum 0.0, which is the identity for an
    // accumulation that has consumed no bar, not a substitute for missing data.
    sessionCumVol := sessionCumVol + rthV

    // ---- 17.5 current values (A17 §5.8) -------------------------------------
    // relVol is CANONICAL and is na whenever F7 or F8 is true. relVolCum is
    // DIAGNOSTIC/CONTEXT ONLY: it cannot create a second volume score, a second
    // readiness path, a veto or an acceptance path, and nothing in this source
    // reads it.
    if rvolValueReady and not na(rthV) and not na(rawMedian) and rawMedian > 0
        relVol := rthV / rawMedian

    if rvolValueReady and cumSlotSamples >= rvolMinSamples and not na(sessionCumVol) and not na(cumMedian) and cumMedian > 0
        relVolCum := sessionCumVol / cumMedian

    // ---- 17.6 current write (A17 §5.9) --------------------------------------
    // Strictly after every prior-baseline read and every current calculation.
    // The position written here stays ringEligible = false until its session is
    // finalized as eligible on a later newRthDay commit.
    int curCell = slotIdx * RVOL_RING_CAPACITY + dayRingPos
    array.set(volArr, curCell, rthV)
    array.set(cumArr, curCell, sessionCumVol)

// =============================================================================
