const string S7_ACTIVE_TIP  = "OSE is following this signal; no broker execution is implied."

// --- S7.1a approved SIMPLE design tokens ------------------------------------
// Presentation constants transcribed from the approved SIMPLE design artifact
// OSE-S7-CLAUDE-UI-DESIGN-01 · D1 · REVISION 3. Colour carries structural side
// and salience only (Final UX §17.2 / §8A); it never encodes confidence,
// probability, strength or institutional activity.
const int    S7_EVENT_MARK_CAP = 12
const int    S7_CMP_ROWS       = 5

color s7c_ink    = #131722
color s7c_ink2   = #4b5563
color s7c_mut    = #838a99
color s7c_dim    = #a8aebb
color s7c_sup    = #0a7f6b
color s7c_res    = #a04430
color s7c_bad    = #b3313c
color s7c_ref    = #56708c
color s7c_trail  = #2f3540
color s7c_amb    = #7d4f04
color s7c_warnBg = #fff2d8
color s7c_warnBd = #d98207
color s7c_supBd  = #0e9a80
color s7c_resBd  = #d0503a
color s7c_tp1    = #2f6f9e
color s7c_card   = #ffffff
color s7c_panel  = color.new(#ffffff, 6)
color s7c_hair   = #c6ccd8
color s7c_grid   = #eceef3
color s7c_supFil = color.new(#0e9a80, 91)
color s7c_resFil = color.new(#d0503a, 92)
color s7c_clear  = color.new(#ffffff, 100)

// --- S7.2 PURE presentation helpers ------------------------------------------
s7_famText(int s7_family) =>
    s7_family == FAM_VWR ? "VWR" : s7_family == FAM_LBO ? "LBO" : s7_family == FAM_LRT ? "LRT" : s7_family == FAM_SQZ ? "SQZ" : S7_NA

s7_dirText(int s7_dir) =>
    s7_dir == DIR_LONG ? "LONG" : s7_dir == DIR_SHORT ? "SHORT" : s7_dir == DIR_NEUTRAL ? "NEUTRAL" : S7_NA

s7_zoneText(int s7_mask) =>
    string s7_t = S7_NA
    if not na(s7_mask)
        if s7_mask == BIT_VWAP
            s7_t := "VWAP"
        else if s7_mask > 0 and s7_mask <= STATIC_MASK_MAX
            s7_t := hasBit(s7_mask, BIT_PDH) ? "PDH" : ""
            s7_t := hasBit(s7_mask, BIT_PDL) ? (str.length(s7_t) > 0 ? s7_t + "+PDL" : "PDL") : s7_t
            s7_t := hasBit(s7_mask, BIT_ORH) ? (str.length(s7_t) > 0 ? s7_t + "+ORH" : "ORH") : s7_t
            s7_t := hasBit(s7_mask, BIT_ORL) ? (str.length(s7_t) > 0 ? s7_t + "+ORL" : "ORL") : s7_t
    s7_t

s7_priceText(float s7_v) =>
    na(s7_v) ? S7_NA : str.tostring(s7_v, format.mintick)

s7_numText(float s7_v, string s7_fmt) =>
    na(s7_v) ? S7_NA : str.tostring(s7_v, s7_fmt)

s7_entryText(int s7_classCode) =>
    int s7_d = na(s7_classCode) ? na : int(math.floor(s7_classCode / 10.0)) % 10
    s7_d == EFF_EARLY ? "ENTRY · EARLY" : s7_d == EFF_CONFIRMED ? "ENTRY · CONFIRMED" : s7_d == EFF_EXTENDED ? "ENTRY · EXTENDED" : s7_d == EFF_TOO_LATE ? "ENTRY · TOO LATE" : "ENTRY · " + S7_NA

s7_rejectText(int s7_rj) =>
    s7_rj == RJ_R4 ? "R4 SESSION BLOCKED" : s7_rj == RJ_R5 ? "R5 EVENT DAY BLOCK" : s7_rj == RJ_R6 ? "R6 TOO LATE" : s7_rj == RJ_R7 ? "R7 RISK TOO WIDE" : s7_rj == RJ_R8 ? "R8 RISK TOO TIGHT" : s7_rj == RJ_R9 ? "R9 NO ROOM" : s7_rj == RJ_R10 ? "R10 STOP UNDEFINED" : s7_rj == RJ_R12 ? "R12 STOP TECHNICALLY TOO CLOSE" : s7_rj == RJ_R13 ? "R13 RVOL NOT READY" : S7_NA

// FALSE and NOT APPLICABLE remain distinct (Final UX §42.4)
s7_qGlyph(int s7_flag, int s7_appl, int s7_bit) =>
    string s7_g = S7_NA
    if (not na(s7_flag)) and (not na(s7_appl)) and s7_flag >= 0 and s7_flag <= 31 and s7_appl >= 0 and s7_appl <= 31
        if hasBit(s7_appl, s7_bit)
            s7_g := hasBit(s7_flag, s7_bit) ? "✓" : "×"
    s7_g

s7_qCount(int s7_flag, int s7_appl) =>
    int  s7_ap = 0
    int  s7_ps = 0
    bool s7_ok = (not na(s7_flag)) and (not na(s7_appl)) and s7_flag >= 0 and s7_flag <= 31 and s7_appl >= 0 and s7_appl <= 31
    if s7_ok
        s7_ap := (hasBit(s7_appl, QB_Q1) ? 1 : 0) + (hasBit(s7_appl, QB_Q2) ? 1 : 0) + (hasBit(s7_appl, QB_Q3) ? 1 : 0) + (hasBit(s7_appl, QB_Q4) ? 1 : 0) + (hasBit(s7_appl, QB_Q5) ? 1 : 0)
        s7_ps := ((hasBit(s7_appl, QB_Q1) and hasBit(s7_flag, QB_Q1)) ? 1 : 0) + ((hasBit(s7_appl, QB_Q2) and hasBit(s7_flag, QB_Q2)) ? 1 : 0) + ((hasBit(s7_appl, QB_Q3) and hasBit(s7_flag, QB_Q3)) ? 1 : 0) + ((hasBit(s7_appl, QB_Q4) and hasBit(s7_flag, QB_Q4)) ? 1 : 0) + ((hasBit(s7_appl, QB_Q5) and hasBit(s7_flag, QB_Q5)) ? 1 : 0)
    [s7_ps, s7_ap, s7_ok]

s7_profileRank(string s7_p) =>
    s7_p == "DETAILED" ? S7_PROF_DET : s7_p == "STANDARD" ? S7_PROF_STD : s7_p == "ESSENTIAL" ? S7_PROF_ESS : S7_PROF_OFF

s7_hhmm(int s7_ms) =>
    na(s7_ms) ? S7_NA : str.format_time(s7_ms, "HH:mm", TZ)

s7_clearBoxes(array<box> s7_boxes) =>
    int s7_n = array.size(s7_boxes)
    if s7_n > 0
        for s7_o = 0 to s7_n - 1
            box s7_h = array.get(s7_boxes, s7_n - 1 - s7_o)
            if not na(s7_h)
                box.delete(s7_h)
    array.clear(s7_boxes)

s7_clearLabels(array<label> s7_labels) =>
    int s7_n = array.size(s7_labels)
    if s7_n > 0
        for s7_o = 0 to s7_n - 1
            label s7_h = array.get(s7_labels, s7_n - 1 - s7_o)
            if not na(s7_h)
                label.delete(s7_h)
    array.clear(s7_labels)

s7_regHasMask(array<Zone> s7_reg, int s7_mask) =>
    bool s7_f = false
    int  s7_n = array.size(s7_reg)
    if s7_n > 0
        for s7_i = 0 to s7_n - 1
            Zone s7_z = array.get(s7_reg, s7_i)
            if (not s7_f) and s7_z.mask == s7_mask
                s7_f := true
    s7_f

s7_pushRow(array<string> s7_buf, array<int> s7_sty, string s7_c0, string s7_c1, string s7_c2, string s7_c3, string s7_c4, string s7_c5, int s7_style) =>
    array.push(s7_buf, s7_c0)
    array.push(s7_buf, s7_c1)
    array.push(s7_buf, s7_c2)
    array.push(s7_buf, s7_c3)
    array.push(s7_buf, s7_c4)
    array.push(s7_buf, s7_c5)
    array.push(s7_sty, s7_style)

// --- S7.2a PURE presentation helpers for the approved SIMPLE composition -----
s7_roleText(int s7_role) =>
    s7_role == ROLE_SUPPORT ? "SUPPORT" : s7_role == ROLE_RESISTANCE ? "RESISTANCE" : "NEUTRAL"

// Numeric delta between two EXISTING accepted values in the SAME unit only
// (mission §4.4). Either operand missing -> N/A. Never a synthetic change.
s7_deltaText(float s7_then, float s7_now, string s7_fmt, string s7_suffix) =>
    string s7_d = S7_NA
    if (not na(s7_then)) and (not na(s7_now))
        float s7_v = s7_now - s7_then
        s7_d := (s7_v > 0 ? "+" : "") + str.tostring(s7_v, s7_fmt) + s7_suffix
    s7_d

// Categorical change -> state transition or UNCHANGED (mission §4.4)
s7_transText(int s7_then, int s7_now) =>
    string s7_t = S7_NA
    if (not na(s7_then)) and (not na(s7_now))
        s7_t := s7_then == s7_now ? "UNCHANGED" : s7_dirText(s7_then) + " → " + s7_dirText(s7_now)
    s7_t

// Frozen Q verdict as an alignment STATE. The accepted producer set carries no
// frozen signal-time VWAP-slope value or direction, so the Q5 evidence result
// is the only truthful AT SIGNAL slope fact available (see IC3 return FD-2).
s7_qVerdict(int s7_flag, int s7_appl, int s7_bit) =>
    string s7_v = S7_NA
    if (not na(s7_flag)) and (not na(s7_appl)) and s7_flag >= 0 and s7_flag <= 31 and s7_appl >= 0 and s7_appl <= 31
        if hasBit(s7_appl, s7_bit)
            s7_v := hasBit(s7_flag, s7_bit) ? "ALIGNED" : "NOT ALIGNED"
    s7_v

s7_ratioText(float s7_v) =>
    na(s7_v) ? S7_NA : str.tostring(s7_v, "0.00") + "x"

// UI alias for the accepted tri-state VWAP-slope producer. The cell is renamed
// for the trading surface; the underlying condition is not redefined.
s7_slopeText(int s7_state) =>
    s7_state == DIR_LONG ? "RISING" : s7_state == DIR_SHORT ? "FALLING" : s7_state == DIR_NEUTRAL ? "FLAT" : S7_NA

// --- S7.3 Stage-7 owned state ------------------------------------------------
// S7.3.1 immutable ACTIVE anchor (packet §6.1) — frozen once, never rewritten
var bool  s7_caseActive       = false
var int   s7_caseId           = na
var int   s7_caseFamily       = 0
var int   s7_caseDir          = 0
var int   s7_caseSignalTime   = na
var int   s7_caseSignalOrd    = na
var int   s7_caseSignalSlot   = na
var int   s7_caseObsIdxInBar  = na
var float s7_caseSignalClose  = na
var float s7_caseInitialStop  = na
var float s7_casePlannedRisk  = na
var float s7_caseTp1          = na
var int   s7_caseQFlag        = na
var int   s7_caseQAppl        = na
var bool  s7_caseRiskPass     = false
var int   s7_caseRejectReason = 0
var int   s7_caseClassCode    = na
var int   s7_caseZoneMask     = 0
var int   s7_caseConfluence   = 0
var int   s7_caseTouchCount   = 0
var float s7_caseAtrRefAtObs  = na
var float s7_caseEntryDistATR = na
var float s7_caseSigRelVol    = na
var float s7_caseSigRoc5      = na
var int   s7_caseStartOrd     = na
var int   s7_caseStartTime    = na
var Obs   s7_caseObsRef       = na
// premise lineage
var bool  s7_premiseTrace     = false
var int   s7_premiseMask      = 0
var int   s7_premiseAnchorBit = 0
var int   s7_premiseRole      = 0
var int   s7_premiseAccDir    = 0

// S7.3.2 mutable management state (packet §6.2)
var bool  s7_tp1Reached       = false
var bool  s7_trailUnlocked    = false
var float s7_trailStop        = na
var int   s7_trailVersion     = 0
var float s7_trailPrevLevel   = na
var string s7_trailReason     = ""
var bool  s7_structLost       = false
var bool  s7_warnActive       = false
var bool  s7_candLive         = false
var int   s7_candObsId        = na
var int   s7_candDir          = 0
var int   s7_candFamily       = 0
var int   s7_candTime         = na
var int   s7_candOrd          = na
var Obs   s7_candObsRef       = na
var int   s7_stopTestVer      = na
var int   s7_impulseAlertOrd  = na
var bool  s7_oppWatchPrev     = false
var bool  s7_slopeSupportPrev = false
var bool  s7_caseEndedFlag    = false
var string s7_caseEndReason   = ""

// S7.3.3 bounded current-session history ring (packet §6.4)
var array<string> s7_hist = array.new_string()

// S7.3.4 drawing / session lifecycle
var table        s7_panel        = na
var array<box>   s7_staticBoxes  = array.new<box>()
var array<int>   s7_staticMasks  = array.new_int()
var box          s7_vwapBox      = na
var box          s7_orBox        = na
var array<label> s7_setupLabels  = array.new<label>()
var array<label> s7_watchLabels  = array.new<label>()
var array<int>   s7_watchKeys    = array.new_int()
var label        s7_eventLabel   = na
var line         s7_lineInit     = na
var line         s7_lineTrail    = na
var line         s7_lineTp1      = na
var int          s7_sessionOpen  = na
var int          s7_sessionRight = na
var bool         s7_sessionOn    = false
var int          s7_lastAlertBar = na
var int          s7_prevRows     = 0
var array<int>   s7_roleMasks    = array.new_int()
var array<int>   s7_roleVals     = array.new_int()

// S7.3.5 approved SIMPLE composition surfaces (presentation-only handles)
var table        s7_cardTbl      = na
var table        s7_evTbl        = na
var table        s7_cmpTbl       = na
var line         s7_lineBarrier  = na
var line         s7_lineVwap     = na
var line         s7_lineOrH      = na
var line         s7_lineOrL      = na
var label        s7_lblIs        = na
var label        s7_lblTs        = na
var label        s7_lblTp1       = na
var label        s7_lblBarrier   = na
var label        s7_lblVwap      = na
var label        s7_lblOrH       = na
var label        s7_lblOrL       = na
var array<label> s7_evtMarks     = array.new<label>()
var array<int>   s7_evtMarkKeys  = array.new_int()

// --- S7.4 per-bar accepted facts --------------------------------------------
int  s7_profRank      = s7_profileRank(s7_alertProfile)
bool s7_advanced      = s7_displayDepth == "ADVANCED"
bool s7_commitBar     = actualRthBar and barstate.isconfirmed
int  s7_termSlot      = sesIsEarlyCl ? ECLAST : FULLLAST
bool s7_terminalBar   = s7_commitBar and (not na(slotIdx)) and slotIdx == s7_termSlot
bool s7_termDataMiss  = s7_commitBar and na(slotIdx)
int  s7_obsCount      = rawObsSetClosed ? array.size(rawObsSet) : 0
bool s7_coreReady     = sessionDataReady
bool s7_impulseOn     = (not na(impulseExpiryOrd)) and (not na(currentOrdinal)) and currentOrdinal <= impulseExpiryOrd
bool s7_impulseEdge   = (not na(impulseExpiryOrd)) and (na(impulseExpiryOrd[1]) or impulseExpiryOrd != impulseExpiryOrd[1])
int  s7_armCount      = array.size(armStore)

// event accumulators for THIS committed bar
array<string> s7_evtText = array.new_string()
array<int>    s7_evtProf = array.new_int()
array<int>    s7_evtPri  = array.new_int()
array<string> s7_evtRec  = array.new_string()

// =============================================================================
// S7.5 MANAGEMENT ENGINE — commit-bar only, exact packet §21 statement order
// =============================================================================
if s7_uiEnabled and s7_commitBar

    // --- S7.5.0 session boundary reset (packet §10 / Final UX §35) ----------
    bool s7_calendarAdvance = s7_sessionOn and (not na(s7_sessionOpen)) and sessionOpenMs != s7_sessionOpen
    if newRthDay or s7_calendarAdvance
        s7_caseActive       := false
        s7_caseId           := na
        s7_caseFamily       := 0
        s7_caseDir          := 0
        s7_caseSignalTime   := na
        s7_caseSignalOrd    := na
        s7_caseSignalSlot   := na
        s7_caseObsIdxInBar  := na
        s7_caseSignalClose  := na
        s7_caseInitialStop  := na
        s7_casePlannedRisk  := na
        s7_caseTp1          := na
        s7_caseQFlag        := na
        s7_caseQAppl        := na
        s7_caseRiskPass     := false
        s7_caseRejectReason := 0
        s7_caseClassCode    := na
        s7_caseZoneMask     := 0
        s7_caseConfluence   := 0
        s7_caseTouchCount   := 0
        s7_caseAtrRefAtObs  := na
        s7_caseEntryDistATR := na
        s7_caseSigRelVol    := na
        s7_caseSigRoc5      := na
        s7_caseStartOrd     := na
        s7_caseStartTime    := na
        s7_caseObsRef       := na
        s7_premiseTrace     := false
        s7_premiseMask      := 0
        s7_premiseAnchorBit := 0
        s7_premiseRole      := 0
        s7_premiseAccDir    := 0
        s7_tp1Reached       := false
        s7_trailUnlocked    := false
        s7_trailStop        := na
        s7_trailVersion     := 0
        s7_trailPrevLevel   := na
        s7_trailReason      := ""
        s7_structLost       := false
        s7_warnActive       := false
        s7_candLive         := false
        s7_candObsId        := na
        s7_candDir          := 0
        s7_candFamily       := 0
        s7_candTime         := na
        s7_candOrd          := na
        s7_candObsRef       := na
        s7_stopTestVer      := na
        s7_impulseAlertOrd  := na
        s7_oppWatchPrev     := false
        s7_slopeSupportPrev := false
        s7_caseEndedFlag    := false
        s7_caseEndReason    := ""
        array.clear(s7_hist)
        array.clear(s7_roleMasks)
        array.clear(s7_roleVals)
        s7_clearBoxes(s7_staticBoxes)
        array.clear(s7_staticMasks)
        s7_clearLabels(s7_setupLabels)
        s7_clearLabels(s7_watchLabels)
        array.clear(s7_watchKeys)
        if not na(s7_vwapBox)
            box.delete(s7_vwapBox)
            s7_vwapBox := na
        if not na(s7_orBox)
            box.delete(s7_orBox)
            s7_orBox := na
        if not na(s7_eventLabel)
            label.delete(s7_eventLabel)
            s7_eventLabel := na
        if not na(s7_lineInit)
            line.delete(s7_lineInit)
            s7_lineInit := na
        if not na(s7_lineTrail)
            line.delete(s7_lineTrail)
            s7_lineTrail := na
        if not na(s7_lineTp1)
            line.delete(s7_lineTp1)
            s7_lineTp1 := na
        s7_sessionOpen  := newRthDay ? sessionOpenMs : na
        s7_sessionRight := newRthDay ? rthTimeClose : na
        s7_sessionOn    := newRthDay and (not na(sessionOpenMs)) and (not na(rthTimeClose))
    if s7_sessionOn and (not na(rthTimeClose))
        s7_sessionRight := rthTimeClose

    // --- S7.5.1 expire invalid WATCH / candidate state ----------------------
    // WATCH mirrors the canonical arm registry; Stage 6 owns expiry/cancel, so
    // an arm absent from armStore is already expired and its marker is removed.
    bool s7_oppWatchNow = false
    if s7_caseActive and s7_armCount > 0
        for s7_i = 0 to s7_armCount - 1
            Arm s7_a = array.get(armStore, s7_i)
            if s7_a.direction == -s7_caseDir and s7_a.direction != DIR_NEUTRAL
                s7_oppWatchNow := true

    // MC-03 §9.2 continuity: the candidate lives only while C17 still equals it
    if s7_candLive
        if (not s7_caseActive) or structBias != s7_candDir
            array.push(s7_evtText, "REVERSAL CANDIDATE EXPIRED · " + s7_dirText(s7_candDir))
            array.push(s7_evtProf, S7_PROF_DET)
            array.push(s7_evtPri,  S7_PRI_DETAIL)
            array.push(s7_evtRec,  s7_hhmm(time_close) + " · CANDIDATE EXPIRED · " + s7_dirText(s7_candDir) + " · " + s7_famText(s7_candFamily) + " · #" + str.tostring(s7_candObsId) + " · C17_CONTINUITY_LOST")
            s7_candLive   := false
            s7_candObsId  := na
            s7_candDir    := 0
            s7_candFamily := 0
            s7_candTime   := na
            s7_candOrd    := na
            s7_candObsRef := na

    // --- S7.5.2 record current SETUP / rejection events ---------------------
    if rawObsSetClosed and s7_obsCount > 0
        for s7_i = 0 to s7_obsCount - 1
            Obs s7_o = array.get(rawObsSet, s7_i)
            string s7_id  = na(s7_o.obsId) ? S7_NA : str.tostring(s7_o.obsId)
            string s7_tag = s7_famText(s7_o.family) + " · " + s7_dirText(s7_o.direction)
            if s7_o.riskPass
                bool s7_same = s7_caseActive and s7_o.direction == s7_caseDir
                bool s7_opp  = s7_caseActive and s7_o.direction == -s7_caseDir
                array.push(s7_evtText, "SETUP · " + s7_tag)
                array.push(s7_evtProf, S7_PROF_DET)
                array.push(s7_evtPri,  S7_PRI_DETAIL)
                array.push(s7_evtRec,  s7_hhmm(time_close) + " · SETUP" + (s7_same ? " (SAME-DIR)" : s7_opp ? " (OPPOSITE)" : "") + " · " + s7_dirText(s7_o.direction) + " · " + s7_famText(s7_o.family) + " · #" + s7_id + " · RISK_PASS")
            else
                array.push(s7_evtText, "REJECTED · " + s7_tag + " · " + s7_rejectText(s7_o.rejectReason))
                array.push(s7_evtProf, S7_PROF_DET)
                array.push(s7_evtPri,  S7_PRI_DETAIL)
                array.push(s7_evtRec,  s7_hhmm(time_close) + " · REJECTED · " + s7_dirText(s7_o.direction) + " · " + s7_famText(s7_o.family) + " · #" + s7_id + " · " + s7_rejectText(s7_o.rejectReason))

    // --- S7.5.3 MC-01 deterministic ACTIVE election -------------------------
    // First riskPass Observation in canonical retained order. No sort, no rank,
    // no tie-break. Never on the terminal RTH bar. Never a second live case.
    if (not s7_caseActive) and (not s7_terminalBar) and rawObsSetClosed and s7_obsCount > 0
        int s7_pick = -1
        for s7_i = 0 to s7_obsCount - 1
            Obs s7_o = array.get(rawObsSet, s7_i)
            if s7_pick == -1 and s7_o.riskPass
                s7_pick := s7_i
        if s7_pick >= 0
            Obs s7_a = array.get(rawObsSet, s7_pick)
            s7_caseActive       := true
            s7_caseId           := s7_a.obsId
            s7_caseFamily       := s7_a.family
            s7_caseDir          := s7_a.direction
            s7_caseSignalTime   := s7_a.obsBarTime
            s7_caseSignalOrd    := s7_a.obsOrd
            s7_caseSignalSlot   := s7_a.slotIdx
            s7_caseObsIdxInBar  := s7_a.obsIndexInBar
            s7_caseSignalClose  := s7_a.signalClose
            s7_caseInitialStop  := s7_a.plannedStop
            s7_casePlannedRisk  := s7_a.plannedRisk
            s7_caseTp1          := s7_a.plannedTp1
            s7_caseQFlag        := s7_a.qFlagMask
            s7_caseQAppl        := s7_a.qApplicabilityMask
            s7_caseRiskPass     := s7_a.riskPass
            s7_caseRejectReason := s7_a.rejectReason
            s7_caseClassCode    := s7_a.classCode
            s7_caseZoneMask     := s7_a.zoneIdMask
            s7_caseConfluence   := s7_a.confluence
            s7_caseTouchCount   := s7_a.touchCount
            s7_caseAtrRefAtObs  := s7_a.atrRefAtObs
            s7_caseEntryDistATR := s7_a.entryDistATR
            s7_caseSigRelVol    := s7_a.relVol
            s7_caseSigRoc5      := s7_a.roc5
            s7_caseStartOrd     := currentOrdinal
            s7_caseStartTime    := time_close
            s7_caseObsRef       := s7_a
            s7_tp1Reached       := false
            s7_trailUnlocked    := false
            s7_trailStop        := s7_a.plannedStop
            s7_trailVersion     := 0
            s7_trailPrevLevel   := na
            s7_trailReason      := "INIT_RINV"
            s7_structLost       := false
            s7_warnActive       := false
            s7_caseEndedFlag    := false
            s7_caseEndReason    := ""
            s7_stopTestVer      := na
            // premise resolution (packet §11.1): unique static lineage or N/A
            s7_premiseTrace     := false
            s7_premiseMask      := 0
            s7_premiseAnchorBit := 0
            s7_premiseRole      := 0
            s7_premiseAccDir    := 0
            if s7_a.family != FAM_VWR and s7_a.zoneIdMask > 0 and s7_a.zoneIdMask <= STATIC_MASK_MAX
                int s7_match = 0
                int s7_mi    = -1
                int s7_zn    = array.size(zoneReg)
                if s7_zn > 0
                    for s7_i = 0 to s7_zn - 1
                        Zone s7_z = array.get(zoneReg, s7_i)
                        if s7_z.mask == s7_a.zoneIdMask
                            s7_match += 1
                            s7_mi := s7_i
                if s7_match == 1
                    Zone s7_pz = array.get(zoneReg, s7_mi)
                    s7_premiseTrace     := true
                    s7_premiseMask      := s7_pz.mask
                    s7_premiseAnchorBit := s7_pz.anchorBit
                    s7_premiseRole      := s7_pz.structuralRole
                    s7_premiseAccDir    := s7_pz.acceptedDir
            array.push(s7_evtText, "ACTIVE · " + s7_dirText(s7_caseDir) + " · " + s7_famText(s7_caseFamily))
            array.push(s7_evtProf, S7_PROF_ESS)
            array.push(s7_evtPri,  S7_PRI_ACTIVE)
            array.push(s7_evtRec,  s7_hhmm(time_close) + " · ACTIVE STARTED · " + s7_dirText(s7_caseDir) + " · " + s7_famText(s7_caseFamily) + " · #" + (na(s7_caseId) ? S7_NA : str.tostring(s7_caseId)) + " · ELECTION_FIRST_CANONICAL_RISK_PASS · " + S7_NA + " → " + s7_priceText(s7_caseSignalClose))

    // --- S7.5.4 evaluate existing ACTIVE facts / events ----------------------
    if s7_caseActive
        // structure (packet §11.1) — lineage identity, latched loss (F-03)
        if s7_premiseTrace and (not s7_structLost)
            bool s7_found = false
            bool s7_roleOk = false
            int  s7_zn2 = array.size(zoneReg)
            if s7_zn2 > 0
                for s7_i = 0 to s7_zn2 - 1
                    Zone s7_z = array.get(zoneReg, s7_i)
                    if (not s7_found) and s7_z.mask == s7_premiseMask and s7_z.anchorBit == s7_premiseAnchorBit
                        s7_found  := true
                        s7_roleOk := s7_z.structuralRole == s7_premiseRole and s7_z.acceptedDir == s7_premiseAccDir
            if (not s7_found) or (not s7_roleOk)
                s7_structLost := true
                array.push(s7_evtText, "STRUCTURE LOST · الهيكل مفقود")
                array.push(s7_evtProf, S7_PROF_STD)
                array.push(s7_evtPri,  S7_PRI_STRUCTLOST)
                array.push(s7_evtRec,  s7_hhmm(time_close) + " · STRUCTURE LOST · " + s7_dirText(s7_caseDir) + " · " + s7_famText(s7_caseFamily) + " · #" + str.tostring(s7_caseId) + " · " + (s7_found ? "PREMISE_ROLE_LOST" : "PREMISE_ABSENT") + " · INTACT → LOST")

        // MC-02 DIRECTION WARNING — exact opposite C17 only, NEUTRAL clears
        bool s7_warnNow = structBias == -s7_caseDir and structBias != DIR_NEUTRAL
        if s7_warnNow and (not s7_warnActive)
            s7_warnActive := true
            array.push(s7_evtText, "DIRECTION WARNING")
            array.push(s7_evtProf, S7_PROF_STD)
            array.push(s7_evtPri,  S7_PRI_WARNING)
            array.push(s7_evtRec,  s7_hhmm(time_close) + " · DIRECTION WARNING · " + s7_dirText(s7_caseDir) + " · " + s7_famText(s7_caseFamily) + " · #" + str.tostring(s7_caseId) + " · C17_AGAINST_CASE · " + s7_dirText(s7_caseDir) + " → " + s7_dirText(structBias))
        if (not s7_warnNow) and s7_warnActive
            s7_warnActive := false
            array.push(s7_evtText, "DIRECTION WARNING CLEARED")
            array.push(s7_evtProf, S7_PROF_DET)
            array.push(s7_evtPri,  S7_PRI_DETAIL)
            array.push(s7_evtRec,  s7_hhmm(time_close) + " · WARNING CLEARED · " + s7_dirText(s7_caseDir) + " · " + s7_famText(s7_caseFamily) + " · #" + str.tostring(s7_caseId) + " · C17_NOT_OPPOSITE")

        // MC-03 §9.1 CRITICAL candidate creation
        if (not s7_candLive) and rawObsSetClosed and s7_obsCount > 0
            int s7_cpick = -1
            for s7_i = 0 to s7_obsCount - 1
                Obs s7_o = array.get(rawObsSet, s7_i)
                bool s7_after = (not na(s7_o.obsOrd)) and (not na(s7_caseStartOrd)) and s7_o.obsOrd > s7_caseStartOrd and s7_o.obsId != s7_caseId
                if s7_cpick == -1 and s7_o.riskPass and s7_o.direction == -s7_caseDir and s7_o.direction != DIR_NEUTRAL and structBias == s7_o.direction and s7_after
                    s7_cpick := s7_i
            if s7_cpick >= 0
                Obs s7_c = array.get(rawObsSet, s7_cpick)
                s7_candLive   := true
                s7_candObsId  := s7_c.obsId
                s7_candDir    := s7_c.direction
                s7_candFamily := s7_c.family
                s7_candTime   := s7_c.obsBarTime
                s7_candOrd    := s7_c.obsOrd
                s7_candObsRef := s7_c
                array.push(s7_evtText, "DIRECTION CRITICAL · " + s7_dirText(s7_candDir))
                array.push(s7_evtProf, S7_PROF_ESS)
                array.push(s7_evtPri,  S7_PRI_CRITICAL)
                array.push(s7_evtRec,  s7_hhmm(time_close) + " · DIRECTION CRITICAL · " + s7_dirText(s7_candDir) + " · " + s7_famText(s7_candFamily) + " · #" + (na(s7_candObsId) ? S7_NA : str.tostring(s7_candObsId)) + " · OPPOSITE_RISK_PASSED · case #" + str.tostring(s7_caseId) + " still ACTIVE")

        // TP1 reach (intrabar reach on the confirmed bar) — latched once
        if (not s7_tp1Reached) and (not na(s7_caseTp1))
            bool s7_hit = s7_caseDir == DIR_LONG ? ((not na(rthH)) and rthH >= s7_caseTp1) : ((not na(rthL)) and rthL <= s7_caseTp1)
            if s7_hit
                s7_tp1Reached := true
                array.push(s7_evtText, "TP1 REACHED")
                array.push(s7_evtProf, S7_PROF_ESS)
                array.push(s7_evtPri,  S7_PRI_TP1)
                array.push(s7_evtRec,  s7_hhmm(time_close) + " · TP1 REACHED · " + s7_dirText(s7_caseDir) + " · " + s7_famText(s7_caseFamily) + " · #" + str.tostring(s7_caseId) + " · INTRABAR_REACH · TP1 " + s7_priceText(s7_caseTp1))

        // SLOPE support-loss edge (accepted live tri-state producer only, F-02)
        bool s7_slopeSup = (not na(vwapSlopeState)) and vwapSlopeState == s7_caseDir
        if s7_slopeSupportPrev and (not s7_slopeSup)
            array.push(s7_evtText, "VWAP SLOPE SUPPORT LOST")
            array.push(s7_evtProf, S7_PROF_DET)
            array.push(s7_evtPri,  S7_PRI_DETAIL)
            array.push(s7_evtRec,  s7_hhmm(time_close) + " · SLOPE SUPPORT LOST · " + s7_dirText(s7_caseDir) + " · " + s7_famText(s7_caseFamily) + " · #" + str.tostring(s7_caseId) + " · VWAP_SLOPE_STATE · " + s7_dirText(s7_caseDir) + " → " + s7_dirText(vwapSlopeState))
        s7_slopeSupportPrev := s7_slopeSup

        // adverse / excessive impulse edge (packet §16 STANDARD)
        if s7_impulseEdge and s7_impulseOn and impulseDirState != DIR_NEUTRAL and impulseDirState == -s7_caseDir
            if na(s7_impulseAlertOrd) or s7_impulseAlertOrd != impulseExpiryOrd
                s7_impulseAlertOrd := impulseExpiryOrd
                string s7_impTxt = impulseExcessiveState ? "EXCESSIVE IMPULSE · ADVERSE" : "IMPULSE · ADVERSE"
                array.push(s7_evtText, s7_impTxt)
                array.push(s7_evtProf, S7_PROF_STD)
                array.push(s7_evtPri,  S7_PRI_IMPULSE)
                array.push(s7_evtRec,  s7_hhmm(time_close) + " · " + s7_impTxt + " · " + s7_dirText(impulseDirState) + " · " + s7_famText(s7_caseFamily) + " · #" + str.tostring(s7_caseId) + " · IMPULSE_AGAINST_CASE")

        // opposite WATCH edge (DETAILED)
        if s7_oppWatchNow and (not s7_oppWatchPrev)
            array.push(s7_evtText, "OPPOSITE WATCH · " + s7_dirText(-s7_caseDir))
            array.push(s7_evtProf, S7_PROF_DET)
            array.push(s7_evtPri,  S7_PRI_DETAIL)
            array.push(s7_evtRec,  s7_hhmm(time_close) + " · OPPOSITE WATCH · " + s7_dirText(-s7_caseDir) + " · " + S7_NA + " · #" + str.tostring(s7_caseId) + " · ARM_REGISTRY")
        s7_oppWatchPrev := s7_oppWatchNow

    // non-anchor structural role change (DETAILED) — bounded snapshot compare
    int s7_zn3 = array.size(zoneReg)
    if s7_zn3 > 0 and s7_zn3 <= S7_ROLE_SNAP_CAP
        for s7_i = 0 to s7_zn3 - 1
            Zone s7_z = array.get(zoneReg, s7_i)
            int s7_ri = array.indexof(s7_roleMasks, s7_z.mask)
            if s7_ri >= 0
                int s7_old = array.get(s7_roleVals, s7_ri)
                if s7_old != s7_z.structuralRole
                    array.set(s7_roleVals, s7_ri, s7_z.structuralRole)
                    bool s7_isAnchor = s7_caseActive and s7_premiseTrace and s7_z.mask == s7_premiseMask
                    if s7_caseActive and (not s7_isAnchor)
                        array.push(s7_evtText, "STRUCTURE ROLE CHANGE · " + s7_zoneText(s7_z.mask))
                        array.push(s7_evtProf, S7_PROF_DET)
                        array.push(s7_evtPri,  S7_PRI_DETAIL)
                        array.push(s7_evtRec,  s7_hhmm(time_close) + " · ROLE CHANGE · " + S7_NA + " · " + S7_NA + " · #" + (na(s7_caseId) ? S7_NA : str.tostring(s7_caseId)) + " · NON_ANCHOR_ROLE · " + str.tostring(s7_old) + " → " + str.tostring(s7_z.structuralRole) + " · zone " + s7_zoneText(s7_z.mask))
            else
                if array.size(s7_roleMasks) < S7_ROLE_SNAP_CAP
                    array.push(s7_roleMasks, s7_z.mask)
                    array.push(s7_roleVals, s7_z.structuralRole)
    int s7_rn = array.size(s7_roleMasks)
    if s7_rn > 0
        for s7_o2 = 0 to s7_rn - 1
            int s7_ix = s7_rn - 1 - s7_o2
            if not s7_regHasMask(zoneReg, array.get(s7_roleMasks, s7_ix))
                array.remove(s7_roleMasks, s7_ix)
                array.remove(s7_roleVals, s7_ix)

    // --- S7.5.5 STOP TEST / STOP BREAK against the PRE-RATCHET trail ---------
    bool s7_stopBreak = false
    if s7_caseActive and (not na(s7_trailStop))
        bool s7_touch = s7_caseDir == DIR_LONG ? ((not na(rthL)) and rthL <= s7_trailStop) : ((not na(rthH)) and rthH >= s7_trailStop)
        bool s7_break = s7_caseDir == DIR_LONG ? ((not na(rthC)) and rthC <= s7_trailStop) : ((not na(rthC)) and rthC >= s7_trailStop)
        if s7_break
            s7_stopBreak := true
        else if s7_touch
            if na(s7_stopTestVer) or s7_stopTestVer != s7_trailVersion
                s7_stopTestVer := s7_trailVersion
                array.push(s7_evtText, "STOP TEST — case active")
                array.push(s7_evtProf, S7_PROF_DET)
                array.push(s7_evtPri,  S7_PRI_STOPTEST)
                array.push(s7_evtRec,  s7_hhmm(time_close) + " · STOP TEST · " + s7_dirText(s7_caseDir) + " · " + s7_famText(s7_caseFamily) + " · #" + str.tostring(s7_caseId) + " · TRAIL_TOUCH_v" + str.tostring(s7_trailVersion) + " · TRAIL " + s7_priceText(s7_trailStop))

    // --- S7.5.6 reversal and termination precedence (packet §15A / §9.3) ----
    bool s7_reversalConfirmed = s7_caseActive and s7_candLive and structBias == s7_candDir and s7_structLost and s7_premiseTrace
    bool s7_endedThisBar      = false

    if s7_stopBreak
        s7_endedThisBar  := true
        s7_caseEndReason := "MGMT_INV_BREACH"
        array.push(s7_evtText, "STOP BREAK · CASE ENDED")
        array.push(s7_evtProf, S7_PROF_ESS)
        array.push(s7_evtPri,  S7_PRI_STOPBREAK)
        array.push(s7_evtRec,  s7_hhmm(time_close) + " · STOP BREAK / CASE ENDED · " + s7_dirText(s7_caseDir) + " · " + s7_famText(s7_caseFamily) + " · #" + str.tostring(s7_caseId) + " · MGMT_INV_BREACH · TRAIL " + s7_priceText(s7_trailStop) + " → close " + s7_priceText(rthC))
    if s7_reversalConfirmed
        array.push(s7_evtText, "DIRECTION REVERSED · " + s7_dirText(s7_caseDir) + " → " + s7_dirText(s7_candDir))
        array.push(s7_evtProf, S7_PROF_ESS)
        array.push(s7_evtPri,  S7_PRI_REVERSED)
        array.push(s7_evtRec,  s7_hhmm(time_close) + " · DIRECTION REVERSED · " + s7_dirText(s7_candDir) + " · " + s7_famText(s7_candFamily) + " · #" + str.tostring(s7_caseId) + " · REVERSAL_CONFIRMED · " + s7_dirText(s7_caseDir) + " → " + s7_dirText(s7_candDir))
        if not s7_endedThisBar
            s7_endedThisBar  := true
            s7_caseEndReason := "REVERSAL_CONFIRMED"

    // --- S7.5.7 terminal session boundary (MC-04) ---------------------------
    if s7_caseActive and (not s7_endedThisBar) and s7_terminalBar
        s7_endedThisBar  := true
        s7_caseEndReason := "SESSION_TERMINAL"
        array.push(s7_evtText, "CASE ENDED · SESSION")
        array.push(s7_evtProf, S7_PROF_ESS)
        array.push(s7_evtPri,  S7_PRI_SESSION)
        array.push(s7_evtRec,  s7_hhmm(time_close) + " · CASE ENDED · SESSION · " + s7_dirText(s7_caseDir) + " · " + s7_famText(s7_caseFamily) + " · #" + str.tostring(s7_caseId) + " · SESSION_TERMINAL · slot " + str.tostring(slotIdx))
    if s7_termDataMiss and s7_caseActive
        array.push(s7_evtText, "SESSION TERMINAL DATA MISSING")
        array.push(s7_evtProf, S7_PROF_DET)
        array.push(s7_evtPri,  S7_PRI_DETAIL)
        array.push(s7_evtRec,  s7_hhmm(time_close) + " · SESSION TERMINAL DATA MISSING · " + s7_dirText(s7_caseDir) + " · " + s7_famText(s7_caseFamily) + " · #" + str.tostring(s7_caseId) + " · SLOT_UNAVAILABLE")

    // --- S7.5.8 commit case end exactly once --------------------------------
    if s7_endedThisBar and s7_caseActive
        s7_caseActive    := false
        s7_caseEndedFlag := true
        s7_warnActive    := false
        if not na(s7_lineInit)
            line.delete(s7_lineInit)
            s7_lineInit := na
        if not na(s7_lineTrail)
            line.delete(s7_lineTrail)
            s7_lineTrail := na
        if not na(s7_lineTp1)
            line.delete(s7_lineTp1)
            s7_lineTp1 := na

    // --- S7.5.9 open the qualified opposite case (packet §9.3) --------------
    // Identity is re-verified against the frozen candidate tuple before any
    // anchor field is taken, so no substitution is possible.
    if s7_reversalConfirmed and (not s7_terminalBar) and (not na(s7_candObsRef))
        Obs s7_c2 = s7_candObsRef
        bool s7_idOk = s7_c2.obsId == s7_candObsId and s7_c2.direction == s7_candDir and s7_c2.family == s7_candFamily and s7_c2.obsBarTime == s7_candTime and s7_c2.riskPass
        if s7_idOk
            s7_caseActive       := true
            s7_caseId           := s7_c2.obsId
            s7_caseFamily       := s7_c2.family
            s7_caseDir          := s7_c2.direction
            s7_caseSignalTime   := s7_c2.obsBarTime
            s7_caseSignalOrd    := s7_c2.obsOrd
            s7_caseSignalSlot   := s7_c2.slotIdx
            s7_caseObsIdxInBar  := s7_c2.obsIndexInBar
            s7_caseSignalClose  := s7_c2.signalClose
            s7_caseInitialStop  := s7_c2.plannedStop
            s7_casePlannedRisk  := s7_c2.plannedRisk
            s7_caseTp1          := s7_c2.plannedTp1
            s7_caseQFlag        := s7_c2.qFlagMask
            s7_caseQAppl        := s7_c2.qApplicabilityMask
            s7_caseRiskPass     := s7_c2.riskPass
            s7_caseRejectReason := s7_c2.rejectReason
            s7_caseClassCode    := s7_c2.classCode
            s7_caseZoneMask     := s7_c2.zoneIdMask
            s7_caseConfluence   := s7_c2.confluence
            s7_caseTouchCount   := s7_c2.touchCount
            s7_caseAtrRefAtObs  := s7_c2.atrRefAtObs
            s7_caseEntryDistATR := s7_c2.entryDistATR
            s7_caseSigRelVol    := s7_c2.relVol
            s7_caseSigRoc5      := s7_c2.roc5
            s7_caseStartOrd     := currentOrdinal
            s7_caseStartTime    := time_close
            s7_caseObsRef       := s7_c2
            s7_tp1Reached       := false
            s7_trailUnlocked    := false
            s7_trailStop        := s7_c2.plannedStop
            s7_trailVersion     := 0
            s7_trailPrevLevel   := na
            s7_trailReason      := "INIT_RINV"
            s7_structLost       := false
            s7_warnActive       := false
            s7_caseEndedFlag    := false
            s7_caseEndReason    := ""
            s7_stopTestVer      := na
            s7_slopeSupportPrev := false
            s7_oppWatchPrev     := false
            s7_impulseAlertOrd  := na
            s7_premiseTrace     := false
            s7_premiseMask      := 0
            s7_premiseAnchorBit := 0
            s7_premiseRole      := 0
            s7_premiseAccDir    := 0
            if s7_c2.family != FAM_VWR and s7_c2.zoneIdMask > 0 and s7_c2.zoneIdMask <= STATIC_MASK_MAX
                int s7_m2 = 0
                int s7_i2 = -1
                int s7_zn4 = array.size(zoneReg)
                if s7_zn4 > 0
                    for s7_i = 0 to s7_zn4 - 1
                        Zone s7_z = array.get(zoneReg, s7_i)
                        if s7_z.mask == s7_c2.zoneIdMask
                            s7_m2 += 1
                            s7_i2 := s7_i
                if s7_m2 == 1
                    Zone s7_pz2 = array.get(zoneReg, s7_i2)
                    s7_premiseTrace     := true
                    s7_premiseMask      := s7_pz2.mask
                    s7_premiseAnchorBit := s7_pz2.anchorBit
                    s7_premiseRole      := s7_pz2.structuralRole
                    s7_premiseAccDir    := s7_pz2.acceptedDir
            array.push(s7_evtText, "ACTIVE · " + s7_dirText(s7_caseDir) + " · " + s7_famText(s7_caseFamily))
            array.push(s7_evtProf, S7_PROF_ESS)
            array.push(s7_evtPri,  S7_PRI_ACTIVE)
            array.push(s7_evtRec,  s7_hhmm(time_close) + " · ACTIVE STARTED · " + s7_dirText(s7_caseDir) + " · " + s7_famText(s7_caseFamily) + " · #" + (na(s7_caseId) ? S7_NA : str.tostring(s7_caseId)) + " · REVERSAL_ANCHOR · " + S7_NA + " → " + s7_priceText(s7_caseSignalClose))
    if s7_reversalConfirmed
        s7_candLive   := false
        s7_candObsId  := na
        s7_candDir    := 0
        s7_candFamily := 0
        s7_candTime   := na
        s7_candOrd    := na
        s7_candObsRef := na

    // --- S7.5.10 TRAIL ON unlock and authorized ratchet (packet §14) --------
    if s7_caseActive and (not s7_trailUnlocked) and (not na(s7_caseTp1)) and (not na(rthC))
        bool s7_unlock = s7_caseDir == DIR_LONG ? rthC >= s7_caseTp1 : rthC <= s7_caseTp1
        if s7_unlock
            s7_trailUnlocked := true
            array.push(s7_evtText, "TRAIL ON")
            array.push(s7_evtProf, S7_PROF_DET)
            array.push(s7_evtPri,  S7_PRI_TRAILON)
            array.push(s7_evtRec,  s7_hhmm(time_close) + " · TRAIL ON · " + s7_dirText(s7_caseDir) + " · " + s7_famText(s7_caseFamily) + " · #" + str.tostring(s7_caseId) + " · TP1_UNLOCK · close " + s7_priceText(rthC))

    if s7_caseActive and s7_trailUnlocked and (not na(rthC)) and (not na(s7_trailStop))
        float s7_structCand = na
        int   s7_zn5 = array.size(zoneReg)
        if s7_zn5 > 0
            for s7_i = 0 to s7_zn5 - 1
                Zone s7_z = array.get(zoneReg, s7_i)
                bool s7_geom = (not na(s7_z.lower)) and (not na(s7_z.upper))
                if s7_caseDir == DIR_LONG and s7_geom and s7_z.structuralRole == ROLE_SUPPORT and s7_z.upper < rthC
                    if na(s7_structCand) or s7_z.lower > s7_structCand
                        s7_structCand := s7_z.lower
                if s7_caseDir == DIR_SHORT and s7_geom and s7_z.structuralRole == ROLE_RESISTANCE and s7_z.lower > rthC
                    if na(s7_structCand) or s7_z.upper < s7_structCand
                        s7_structCand := s7_z.upper
        float s7_best = s7_trailStop
        if s7_caseDir == DIR_LONG
            if (not na(s7_caseSignalClose)) and s7_caseSignalClose > s7_best
                s7_best := s7_caseSignalClose
            if (not na(s7_structCand)) and s7_structCand > s7_best
                s7_best := s7_structCand
        else
            if (not na(s7_caseSignalClose)) and s7_caseSignalClose < s7_best
                s7_best := s7_caseSignalClose
            if (not na(s7_structCand)) and s7_structCand < s7_best
                s7_best := s7_structCand
        if s7_best != s7_trailStop
            string s7_reason = ((not na(s7_structCand)) and s7_structCand == s7_best) ? "RATCHET_STRUCTURE" : "RATCHET_SIGNAL_REFERENCE"
            s7_trailPrevLevel := s7_trailStop
            s7_trailStop      := s7_best
            s7_trailVersion   += 1
            s7_trailReason    := s7_reason
            array.push(s7_evtText, "TRAIL UPDATED")
            array.push(s7_evtProf, S7_PROF_DET)
            array.push(s7_evtPri,  S7_PRI_DETAIL)
            array.push(s7_evtRec,  s7_hhmm(time_close) + " · TRAIL UPDATED · " + s7_dirText(s7_caseDir) + " · " + s7_famText(s7_caseFamily) + " · #" + str.tostring(s7_caseId) + " · " + s7_reason + " · " + s7_priceText(s7_trailPrevLevel) + " → " + s7_priceText(s7_trailStop) + " · v" + str.tostring(s7_trailVersion))

    // --- S7.5.11 append bounded current-session history ---------------------
    int s7_evn = array.size(s7_evtRec)
    if s7_evn > 0
        for s7_i = 0 to s7_evn - 1
            array.push(s7_hist, array.get(s7_evtRec, s7_i))
        int s7_over = array.size(s7_hist) - S7_HIST_CAP
        if s7_over > 0
            for s7_i = 0 to s7_over - 1
                array.shift(s7_hist)

// =============================================================================
// S7.6 CURRENT DISPLAY FACTS
// =============================================================================
// ROOM / NEXT BARRIER — lossless reproduction of the accepted C14/R9 opposing
// barrier semantics (IC1R4 lines 2935-2946) using accepted registry facts and
// the accepted PURE selectors. No threshold, buffer, ranking or new authority.
// `sameOwn` uses the anchor zoneIdMask, which for every non-VWR family is the
// arm zoneIdMask by construction (IC1R4 line 3044: vMask = fam == FAM_VWR ?
// BIT_VWAP : a.zoneIdMask). Display and history are the only consumers.
float s7_room     = na
float s7_barrier  = na
if s7_caseActive and (not na(rthC)) and array.size(zoneReg) > 0
    for s7_i = 0 to array.size(zoneReg) - 1
        Zone s7_z = array.get(zoneReg, s7_i)
        bool s7_sameOwn = (s7_caseFamily != FAM_VWR) and s7_z.mask == s7_caseZoneMask
        bool s7_brokenSame = s7_caseDir == DIR_LONG ? s7_z.brokenLong : s7_z.brokenShort
        if (not s7_sameOwn) and (not s7_brokenSame)
            float s7_zn6 = zoneNearOf(s7_caseDir, s7_z.lower, s7_z.upper)
            float s7_rm  = dirDistOf(s7_zn6, rthC, s7_caseDir)
            if (not na(s7_rm)) and s7_rm > 0
                if na(s7_room) or s7_rm < s7_room
                    s7_room    := s7_rm
                    s7_barrier := s7_zn6

// SQUEEZE box precedence (packet §13.2)
bool s7_sqzArmed = false
int  s7_sqzArmDir = DIR_NEUTRAL
if s7_armCount > 0
    for s7_i = 0 to s7_armCount - 1
        Arm s7_a = array.get(armStore, s7_i)
        if (not s7_sqzArmed) and s7_a.family == FAM_SQZ
            s7_sqzArmed  := true
            s7_sqzArmDir := s7_a.direction
string s7_sqzText = "SQUEEZE N/A"
string s7_sqzAr   = "بيانات الانضغاط غير مكتملة"
if sqzCoreReady
    if squeezeRelease
        s7_sqzText := "SQZ RELEASE"
        s7_sqzAr   := "تحرر الانضغاط"
    else if s7_sqzArmed
        s7_sqzText := "SQUEEZE SETUP · " + s7_dirText(s7_sqzArmDir)
        s7_sqzAr   := "فرصة انضغاط تتشكل"
    else if squeezeOn
        s7_sqzText := "SQUEEZE ON"
        s7_sqzAr   := "انضغاط سعري"
    else
        s7_sqzText := "SQUEEZE OFF"
        s7_sqzAr   := "لا يوجد انضغاط"

// STRUCTURE surface
string s7_structText = "N/A"
string s7_structAr   = "غير متاح"
if s7_caseActive and s7_premiseTrace
    s7_structText := s7_structLost ? "LOST" : "INTACT"
    s7_structAr   := s7_structLost ? "الهيكل مفقود" : "الهيكل قائم"

// Evidence strip source: ACTIVE anchor, else the current-bar first Observation.
// The strip is the FROZEN signal-time snapshot (Final UX §11.2). The companion
// value reads below are taken from the SAME frozen record — never from a live
// producer — so live Momentum / RVOL / Slope can never rewrite the strip.
//
// A49 / C-03 — DISPLAYED-OPPORTUNITY ELECTION.
// Exactly one opportunity owns the primary card, the Evidence strip and the
// SIGNAL COMPARISON table at a time, and every column of that table is drawn
// from that one identity. Election order, highest first:
//
//   1  ACTIVE case          — the live managed case owns the surface. Case
//                             election itself is unchanged; this only decides
//                             which already-elected object is displayed.
//   2  current Observation  — a new source-owned opportunity on this bar takes
//                             the context over from any retained ended case,
//                             which then lives on in history custody only.
//   3  retained ended case  — its OWN frozen anchor, never an unrelated
//                             current-bar Observation (A49 F-03).
//
// C-02: the truthful SETUP / REJECTED classification travels with the elected
// snapshot as `s7_stripPass`, so the comparison table can never label a
// risk-rejected Observation SETUP while the primary card calls it REJECTED.
int   s7_stripFlag  = na
int   s7_stripAppl  = na
float s7_stripRvol  = na
float s7_stripRoc5  = na
int   s7_stripZone  = na
int   s7_stripTouch = na
int   s7_stripTime  = na
int   s7_stripFam   = 0
int   s7_stripDir   = 0
bool  s7_stripPass  = false
bool  s7_stripEnded = false
bool  s7_stripHas   = false
if s7_caseActive
    s7_stripFlag  := s7_caseQFlag
    s7_stripAppl  := s7_caseQAppl
    s7_stripRvol  := s7_caseSigRelVol
    s7_stripRoc5  := s7_caseSigRoc5
    s7_stripZone  := s7_caseZoneMask
    s7_stripTouch := s7_caseTouchCount
    s7_stripTime  := s7_caseSignalTime
    s7_stripFam   := s7_caseFamily
    s7_stripDir   := s7_caseDir
    s7_stripPass  := s7_caseRiskPass
    s7_stripHas   := true
else if rawObsSetClosed and s7_obsCount > 0
    Obs s7_o0 = array.get(rawObsSet, 0)
    s7_stripFlag  := s7_o0.qFlagMask
    s7_stripAppl  := s7_o0.qApplicabilityMask
    s7_stripRvol  := s7_o0.relVol
    s7_stripRoc5  := s7_o0.roc5
    s7_stripZone  := s7_o0.zoneIdMask
    s7_stripTouch := s7_o0.touchCount
    s7_stripTime  := s7_o0.obsBarTime
    s7_stripFam   := s7_o0.family
    s7_stripDir   := s7_o0.direction
    s7_stripPass  := s7_o0.riskPass
    s7_stripHas   := true
else if s7_caseEndedFlag and (not na(s7_caseSignalTime))
    s7_stripFlag  := s7_caseQFlag
    s7_stripAppl  := s7_caseQAppl
    s7_stripRvol  := s7_caseSigRelVol
    s7_stripRoc5  := s7_caseSigRoc5
    s7_stripZone  := s7_caseZoneMask
    s7_stripTouch := s7_caseTouchCount
    s7_stripTime  := s7_caseSignalTime
    s7_stripFam   := s7_caseFamily
    s7_stripDir   := s7_caseDir
    s7_stripPass  := s7_caseRiskPass
    s7_stripEnded := true
    s7_stripHas   := true
[s7_qPass, s7_qAppl, s7_qOk] = s7_qCount(s7_stripFlag, s7_stripAppl)

// A49 / C-03 §3.3-3.5 — anchor-bar timing. On the elected opportunity's own
// anchor/signal bar only AT SIGNAL is knowable: no later bar exists yet, so
// SIGNAL CHANGES and SIGNAL STATUS stay unavailable. A live value produced on
// the anchor bar must never be presented as a post-signal change merely
// because the same execution pass can reach it. From the next confirmed bar
// onward both columns populate and keep updating, and neither ever writes back
// to the frozen anchor.
bool s7_atAnchorBar = s7_stripHas and (not na(s7_stripTime)) and s7_stripTime == time
bool s7_cmpLive     = s7_stripHas and (not s7_atAnchorBar)

// lifecycle headline
int    s7_watchCount = 0
int    s7_watchFam   = 0
int    s7_watchDir   = 0
if s7_armCount > 0
    for s7_i = 0 to s7_armCount - 1
        Arm s7_a = array.get(armStore, s7_i)
        s7_watchCount += 1
        if s7_watchCount == 1
            s7_watchFam := s7_a.family
            s7_watchDir := s7_a.direction
int    s7_setupPass = 0
int    s7_setupFam  = 0
int    s7_setupDir  = 0
int    s7_setupRj   = 0
if rawObsSetClosed and s7_obsCount > 0
    for s7_i = 0 to s7_obsCount - 1
        Obs s7_o = array.get(rawObsSet, s7_i)
        if s7_setupFam == 0
            s7_setupFam := s7_o.family
            s7_setupDir := s7_o.direction
            s7_setupRj  := s7_o.rejectReason
        if s7_o.riskPass
            s7_setupPass += 1

string s7_lifeMain = "NO SETUP"
string s7_lifeSide = ""
if s7_caseActive
    s7_lifeMain := "ACTIVE · " + s7_dirText(s7_caseDir) + " · " + s7_famText(s7_caseFamily)
    s7_lifeSide := s7_tp1Reached ? "POST-TP1" : "PRE-TP1"
else if rawObsSetClosed and s7_obsCount > 0
    // A49 / C-02 — the card labels the SAME elected snapshot the comparison
    // table labels, using that snapshot's own riskPass. Previously the card
    // read "SETUP" whenever ANY Observation on the bar passed Risk while the
    // table described Observation 0, so a rejected displayed snapshot could be
    // titled SETUP by one surface and REJECTED by the other. Identity fields
    // already came from the same Observation; only the pass/fail source
    // differed. riskPass itself, Observation production and every predicate
    // are unchanged.
    s7_lifeMain := (s7_stripPass ? "SETUP · " : "REJECTED · ") + s7_famText(s7_stripFam) + " · " + s7_dirText(s7_stripDir)
    s7_lifeSide := s7_stripPass ? "" : s7_rejectText(s7_setupRj)
else if s7_watchCount > 0
    s7_lifeMain := "WATCH · " + s7_famText(s7_watchFam) + " · " + s7_dirText(s7_watchDir)
    s7_lifeSide := s7_watchCount > 1 ? "+" + str.tostring(s7_watchCount - 1) : ""
else if not s7_coreReady
    s7_lifeMain := S7_NOT_READY
    s7_lifeSide := ""
// A49 / C-03 §3.2 — the retained ended case keeps the primary card ONLY while
// it is still the elected display context. The moment a new source-owned
// Observation appears it elects itself (strip election branch 2), the ended
// case hands the surface over and survives in history custody, and the card
// follows the comparison table to that same new opportunity instead of
// contradicting it. Case-end rules and history custody are untouched.
if s7_caseEndedFlag and (not s7_caseActive) and s7_stripEnded
    s7_lifeMain := "CASE ENDED · " + (s7_caseEndReason == "MGMT_INV_BREACH" ? "STOP" : s7_caseEndReason == "REVERSAL_CONFIRMED" ? "REVERSAL" : s7_caseEndReason == "SESSION_TERMINAL" ? "SESSION" : S7_NA)
    s7_lifeSide := ""

// dominant current event (display precedence, profile-independent)
string s7_domText = ""
int    s7_domPri  = -1
int    s7_domN    = array.size(s7_evtPri)
if s7_domN > 0
    for s7_i = 0 to s7_domN - 1
        int s7_p = array.get(s7_evtPri, s7_i)
        if s7_p > s7_domPri
            s7_domPri  := s7_p
            s7_domText := array.get(s7_evtText, s7_i)
    if s7_domN > 1
        s7_domText := s7_domText + "  +" + str.tostring(s7_domN - 1)
// A49 / C-01 — the reversal tuple as the source recorded it, read back from
// this bar's own event ledger. On a confirmed reversal the case is ended and,
// where Gate-4 allows, the opposite case is opened in the SAME execution pass:
// s7_caseDir is re-anchored to the NEW direction and the candidate fields are
// cleared to 0/na. Recomposing the warning from those post-handoff mutable
// fields therefore rendered "<new dir> → NEUTRAL · case ended". Reading the
// recorded event text instead keeps one coherent, source-owned event context.
// No reversal qualification, precedence, priority, termination, opposite-case
// opening, candidate lifecycle or Direction rule is touched, and no new
// persistent producer is created — this is a read of an existing ledger entry.
string s7_revEvtText = ""
if s7_domN > 0
    for s7_i = 0 to s7_domN - 1
        if array.get(s7_evtPri, s7_i) == S7_PRI_REVERSED
            s7_revEvtText := array.get(s7_evtText, s7_i)

string s7_dirEventText = s7_domText
if str.length(s7_dirEventText) == 0
    s7_dirEventText := s7_caseActive and s7_warnActive ? "DIRECTION WARNING" : s7_caseActive and s7_candLive ? "DIRECTION CRITICAL · " + s7_dirText(s7_candDir) : S7_NA

// --- S7.6a approved SIMPLE surface strings -----------------------------------
// Presentation composition only. Every string below is a formatting of an
// already-accepted producer read; no new producer, threshold or state.

// Primary card head — case identity and PRE/POST-TP1 on one line (design D1).
string s7_cardHead = s7_lifeMain
if s7_caseActive and str.length(s7_lifeSide) > 0
    s7_cardHead := s7_lifeMain + " · " + s7_lifeSide

// Warning band — escalating salience without a confidence or urgency score.
bool   s7_cardWarn    = false
string s7_cardWarnTxt = ""
string s7_cardWarnSub = ""
color  s7_cardWarnBg  = s7c_warnBg
color  s7_cardWarnInk = s7c_amb
if str.length(s7_revEvtText) > 0
    s7_cardWarn    := true
    s7_cardWarnTxt := s7_revEvtText
    s7_cardWarnSub := "prior case ended"
    s7_cardWarnBg  := color.new(s7c_bad, 88)
    s7_cardWarnInk := s7c_bad
else if s7_caseActive and s7_candLive
    s7_cardWarn    := true
    s7_cardWarnTxt := "DIRECTION CRITICAL · " + s7_dirText(s7_candDir)
    s7_cardWarnSub := "opposite setup qualified — case still active"
    s7_cardWarnBg  := color.new(s7c_bad, 90)
    s7_cardWarnInk := s7c_bad
else if s7_caseActive and s7_warnActive
    s7_cardWarn    := true
    s7_cardWarnTxt := "DIRECTION WARNING"
    s7_cardWarnSub := "current direction " + s7_dirText(structBias) + " against case " + s7_dirText(s7_caseDir) + " · case remains ACTIVE"

// STRUCTURE glyph — filled INTACT, hollow LOST, hollow dim N/A (design D1).
string s7_structGlyph = s7_structText == "INTACT" ? "●" : "○"
color  s7_structInk   = s7_structText == "INTACT" ? s7c_sup : s7_structText == "LOST" ? s7c_bad : s7c_mut

// Comparison basis note (Final UX §10 order is fixed and may not be reversed).
string s7_cmpNote = "READINESS UNAVAILABLE"
color  s7_cmpNoteInk = s7c_amb
if s7_stripHas
    s7_cmpNote    := "AT SIGNAL " + s7_hhmm(s7_stripTime) + " · FROZEN"
    s7_cmpNoteInk := s7c_mut
else if s7_coreReady
    s7_cmpNote    := "NO SIGNAL SNAPSHOT YET"

// Evidence cell values — frozen signal-time reads only, N/A where the accepted
// producer set carries no value. Nothing here is estimated or reconstructed.
string s7_evBasis  = s7_cmpNote
string s7_evRvolV  = s7_stripHas ? s7_ratioText(s7_stripRvol) : S7_NA
string s7_evMomV   = s7_stripHas ? s7_numText(s7_stripRoc5, "0.0000") : S7_NA
string s7_evLocV   = (s7_stripHas and (not na(s7_stripZone)) and s7_stripZone > 0) ? s7_zoneText(s7_stripZone) : S7_NA
string s7_evFrshV  = (s7_stripHas and (not na(s7_stripTouch))) ? "TOUCH " + str.tostring(s7_stripTouch) : S7_NA
string s7_evSlpV   = s7_stripHas ? s7_qVerdict(s7_stripFlag, s7_stripAppl, QB_Q5) : S7_NA
string s7_evNText  = s7_qOk ? str.tostring(s7_qPass) + "/" + str.tostring(s7_qAppl) : S7_NA

// =============================================================================
// S7.7 EXTERNAL ALERT — one dynamic stream, edge-based, one message per bar
// =============================================================================
string s7_alertMsg   = ""
int    s7_alertPri   = -1
int    s7_alertCount = 0
if s7_profRank > S7_PROF_OFF and array.size(s7_evtProf) > 0
    for s7_i = 0 to array.size(s7_evtProf) - 1
        if array.get(s7_evtProf, s7_i) <= s7_profRank
            s7_alertCount += 1
            if array.get(s7_evtPri, s7_i) > s7_alertPri
                s7_alertPri := array.get(s7_evtPri, s7_i)
                s7_alertMsg := array.get(s7_evtText, s7_i)
string s7_alertBody = ""
if s7_alertCount > 0
    s7_alertBody := "[" + s7_alertProfile + " · " + S7_BUILD + "]\nOSE · " + syminfo.ticker + " · " + s7_hhmm(time_close) + "\n" + s7_alertMsg
    if s7_alertCount > 1
        s7_alertBody := s7_alertBody + "  +" + str.tostring(s7_alertCount - 1)
    if s7_caseActive
        s7_alertBody := s7_alertBody + "\nCASE " + s7_dirText(s7_caseDir) + " · " + s7_famText(s7_caseFamily) + " · " + (s7_tp1Reached ? "POST-TP1" : "PRE-TP1") + " · STRUCTURE " + s7_structText
        s7_alertBody := s7_alertBody + "\nINITIAL STOP " + s7_priceText(s7_caseInitialStop) + " · TRAIL STOP " + s7_priceText(s7_trailStop) + " · TP1 " + s7_priceText(s7_caseTp1)
    if s7_alertPri == S7_PRI_ACTIVE
        s7_alertBody := s7_alertBody + "\n" + S7_ACTIVE_TIP
bool s7_alertFits    = str.length(s7_alertBody) <= S7_ALERT_LIMIT
bool s7_alertDedupOk = (not na(time_close)) and (na(s7_lastAlertBar) or s7_lastAlertBar != time_close)
bool s7_alertGo      = s7_uiEnabled and s7_commitBar and s7_alertCount > 0 and s7_alertFits and s7_alertDedupOk

if s7_alertGo
    alert(s7_alertBody, alert.freq_once_per_bar_close)
    s7_lastAlertBar := time_close

// =============================================================================
// S7.8 RENDER — approved SIMPLE composition · ADVANCED panel preserved
// =============================================================================
// VISUAL AUTHORITY: the approved SIMPLE design artifact
//   OSE-S7-CLAUDE-UI-DESIGN-01 · D1 · REVISION 3
//   (OSE_S7_SIMPLE_Prototype_v3_standalone.html)
// SEMANTIC AUTHORITY: Final UX v1.2. ENGINEERING INVARIANTS: packet §3 / §5.
//
// The approved SIMPLE composition places, on the chart itself:
//   · primary case card                 top centre
//   · SQUEEZE box + Evidence strip      lower left (SQUEEZE above the strip)
//   · SIGNAL COMPARISON table           lower right
//   · every price reference             at its own price with a right-edge label
//
// This block renders that composition. ADVANCED is untouched: when the depth
// input is ADVANCED the IC2 top-right panel is rebuilt verbatim at §S7.8.3 and
// none of the SIMPLE surfaces are drawn. No producer, threshold, predicate,
// export, request, alert or lifecycle rule is read or written differently here;
// this is presentation composition only.
//
// Declared Pine deviations from the artifact are recorded in the IC3 return.
// --- S7.7a compiler-size helpers --------------------------------------------
// IC3R2 C-06. Presentation-only extraction from the global/main body.
// TradingView permits table/drawing reference mutation inside functions; these
// helpers do not reassign any global value variable or call global-only plots.
s7_renderSimple(table s7_cardIn, table s7_evIn, table s7_cmpIn) =>
    // (a) PRIMARY CASE CARD — top centre.
    table.cell(s7_cardIn, 0, 0, s7_cardHead, text_color = s7c_ink, bgcolor = s7c_card, text_size = size.large, text_halign = text.align_left, tooltip = S7_ACTIVE_TIP)
    table.cell(s7_cardIn, 0, 1, s7_cardWarn ? s7_cardWarnTxt + "   " + s7_cardWarnSub : "", text_color = s7_cardWarn ? s7_cardWarnInk : s7c_clear, bgcolor = s7_cardWarn ? s7_cardWarnBg : s7c_card, text_size = size.small, text_halign = text.align_left)
    string s7_metaTxt = "STRUCTURE   " + s7_structGlyph + " " + s7_structText + "   " + s7_structAr
    if str.length(s7_dirEventText) > 0 and s7_dirEventText != S7_NA
        s7_metaTxt := s7_metaTxt + "     │     CURRENT EVENT   " + s7_dirEventText + "   " + s7_hhmm(time_close)
    table.cell(s7_cardIn, 0, 2, s7_metaTxt, text_color = s7_structInk, bgcolor = s7c_card, text_size = size.small, text_halign = text.align_left)

    // (b) SQUEEZE box + EVIDENCE strip — lower left, SQUEEZE above the strip.
    // SQUEEZE keeps its own distinct surface treatment and its own row: it
    // is never a sixth Evidence cell and never becomes Q6 (Final UX §12).
    bool  s7_sqzOff = s7_sqzText == "SQUEEZE OFF"
    bool  s7_sqzNa  = s7_sqzText == "SQUEEZE N/A"
    color s7_sqzBg  = s7_sqzOff ? color.new(#ffffff, 28) : s7c_panel
    color s7_sqzInk = (s7_sqzOff or s7_sqzNa) ? s7c_mut : s7c_ink
    table.cell(s7_evIn, 0, 0, s7_sqzText + "   " + s7_sqzAr, text_color = s7_sqzInk, bgcolor = s7_sqzBg, text_size = size.small, text_halign = text.align_left)
    for s7_c = 1 to 5
        table.cell(s7_evIn, s7_c, 0, "", text_color = s7c_clear, bgcolor = s7c_clear, text_size = size.tiny)
    for s7_c = 0 to 5
        table.cell(s7_evIn, s7_c, 1, "", text_color = s7c_clear, bgcolor = s7c_clear, text_size = size.tiny)

    // Frozen five-cell strip in the exact accepted order, with the frozen
    // signal-time value beneath each glyph. English cell names only — the
    // approved design carries no Arabic inside the compact strip.
    table.cell(s7_evIn, 0, 2, "EVIDENCE  " + s7_evNText, text_color = s7c_ink, bgcolor = s7c_panel, text_size = size.small, text_halign = text.align_left)
    table.cell(s7_evIn, 0, 3, s7_evBasis, text_color = s7c_mut, bgcolor = s7c_panel, text_size = size.tiny, text_halign = text.align_left)
    string s7_g1 = s7_qGlyph(s7_stripFlag, s7_stripAppl, QB_Q1)
    string s7_g2 = s7_qGlyph(s7_stripFlag, s7_stripAppl, QB_Q2)
    string s7_g3 = s7_qGlyph(s7_stripFlag, s7_stripAppl, QB_Q3)
    string s7_g4 = s7_qGlyph(s7_stripFlag, s7_stripAppl, QB_Q4)
    string s7_g5 = s7_qGlyph(s7_stripFlag, s7_stripAppl, QB_Q5)
    table.cell(s7_evIn, 1, 2, s7_g1 + " RVOL",  text_color = s7_g1 == "✓" ? s7c_sup : s7_g1 == "×" ? s7c_bad : s7c_mut, bgcolor = s7c_panel, text_size = size.small)
    table.cell(s7_evIn, 2, 2, s7_g2 + " MOM",   text_color = s7_g2 == "✓" ? s7c_sup : s7_g2 == "×" ? s7c_bad : s7c_mut, bgcolor = s7c_panel, text_size = size.small)
    table.cell(s7_evIn, 3, 2, s7_g3 + " LOC",   text_color = s7_g3 == "✓" ? s7c_sup : s7_g3 == "×" ? s7c_bad : s7c_mut, bgcolor = s7c_panel, text_size = size.small)
    table.cell(s7_evIn, 4, 2, s7_g4 + " FRESH", text_color = s7_g4 == "✓" ? s7c_sup : s7_g4 == "×" ? s7c_bad : s7c_mut, bgcolor = s7c_panel, text_size = size.small)
    table.cell(s7_evIn, 5, 2, s7_g5 + " SLOPE", text_color = s7_g5 == "✓" ? s7c_sup : s7_g5 == "×" ? s7c_bad : s7c_mut, bgcolor = s7c_panel, text_size = size.small)
    table.cell(s7_evIn, 1, 3, s7_evRvolV, text_color = s7_evRvolV == S7_NA ? s7c_mut : s7c_ink, bgcolor = s7c_panel, text_size = size.tiny)
    table.cell(s7_evIn, 2, 3, s7_evMomV,  text_color = s7_evMomV  == S7_NA ? s7c_mut : s7c_ink, bgcolor = s7c_panel, text_size = size.tiny)
    table.cell(s7_evIn, 3, 3, s7_evLocV,  text_color = s7_evLocV  == S7_NA ? s7c_mut : s7c_ink, bgcolor = s7c_panel, text_size = size.tiny)
    table.cell(s7_evIn, 4, 3, s7_evFrshV, text_color = s7_evFrshV == S7_NA ? s7c_mut : s7c_ink, bgcolor = s7c_panel, text_size = size.tiny)
    table.cell(s7_evIn, 5, 3, s7_evSlpV,  text_color = s7_evSlpV  == S7_NA ? s7c_mut : s7c_ink, bgcolor = s7c_panel, text_size = size.tiny)

    // (c) SIGNAL COMPARISON — lower right. Fixed semantic order
    // AT SIGNAL → SIGNAL CHANGES → SIGNAL STATUS; never reversed.
    table.cell(s7_cmpIn, 0, 0, "SIGNAL COMPARISON", text_color = s7c_ink2, bgcolor = s7c_panel, text_size = size.tiny, text_halign = text.align_left)
    table.cell(s7_cmpIn, 1, 0, "", text_color = s7c_clear, bgcolor = s7c_panel, text_size = size.tiny)
    table.cell(s7_cmpIn, 2, 0, "", text_color = s7c_clear, bgcolor = s7c_panel, text_size = size.tiny)
    table.cell(s7_cmpIn, 3, 0, s7_cmpNote, text_color = s7_cmpNoteInk, bgcolor = s7c_panel, text_size = size.tiny, text_halign = text.align_right)
    table.cell(s7_cmpIn, 0, 1, "METRIC",    text_color = s7c_mut, bgcolor = s7c_panel, text_size = size.tiny, text_halign = text.align_left)
    table.cell(s7_cmpIn, 1, 1, "AT SIGNAL", text_color = s7c_mut, bgcolor = s7c_panel, text_size = size.tiny, text_halign = text.align_left)
    table.cell(s7_cmpIn, 2, 1, "CHANGES",   text_color = s7c_mut, bgcolor = s7c_panel, text_size = size.tiny, text_halign = text.align_left)
    table.cell(s7_cmpIn, 3, 1, "STATUS",    text_color = s7c_mut, bgcolor = s7c_panel, text_size = size.tiny, text_halign = text.align_left)

    // AT SIGNAL holds immutable original-signal facts only. CHANGES holds a
    // numeric delta only between two existing accepted values in the same
    // unit, or a categorical state transition / UNCHANGED. Nothing here
    // creates a Signal Strength, Confidence or Trade Health change.
    // A49 / C-03 — all three columns are drawn from the ONE elected
    // opportunity: AT SIGNAL from its frozen snapshot (s7_strip*), CHANGES
    // and STATUS only once `s7_cmpLive` says a bar later than its anchor
    // bar exists. Identities can therefore never be mixed across columns.
    string s7_liveRvol = rvolF8SlotSparse ? "NOT READY" : s7_ratioText(relVol)
    string s7_r1a = s7_stripHas  ? s7_dirText(s7_stripDir) : S7_NA
    string s7_r1b = s7_cmpLive   ? s7_transText(s7_stripDir, structBias) : S7_NA
    string s7_r2b = (s7_cmpLive and (not rvolF8SlotSparse)) ? s7_deltaText(s7_stripRvol, relVol, "0.00", "x") : S7_NA
    string s7_r3b = s7_cmpLive   ? s7_deltaText(s7_stripRoc5, roc5, "0.0000", "") : S7_NA
    string s7_s1c = s7_cmpLive   ? s7_dirText(structBias) : S7_NA
    string s7_s2c = s7_cmpLive   ? s7_liveRvol : S7_NA
    string s7_s3c = s7_cmpLive   ? s7_numText(roc5, "0.0000") : S7_NA
    string s7_s4c = s7_cmpLive   ? s7_slopeText(vwapSlopeState) : S7_NA
    table.cell(s7_cmpIn, 0, 2, "DIRECTION", text_color = s7c_ink2, bgcolor = s7c_panel, text_size = size.tiny, text_halign = text.align_left)
    table.cell(s7_cmpIn, 1, 2, s7_r1a, text_color = s7_r1a == S7_NA ? s7c_mut : s7c_ink2, bgcolor = s7c_panel, text_size = size.tiny, text_halign = text.align_left)
    table.cell(s7_cmpIn, 2, 2, s7_r1b, text_color = s7_r1b == S7_NA or s7_r1b == "UNCHANGED" ? s7c_mut : s7c_ink, bgcolor = s7c_panel, text_size = size.tiny, text_halign = text.align_left)
    table.cell(s7_cmpIn, 3, 2, s7_s1c, text_color = s7_s1c == S7_NA ? s7c_mut : s7c_ink, bgcolor = s7c_panel, text_size = size.tiny, text_halign = text.align_left)
    table.cell(s7_cmpIn, 0, 3, "RVOL", text_color = s7c_ink2, bgcolor = s7c_panel, text_size = size.tiny, text_halign = text.align_left)
    table.cell(s7_cmpIn, 1, 3, s7_evRvolV, text_color = s7_evRvolV == S7_NA ? s7c_mut : s7c_ink2, bgcolor = s7c_panel, text_size = size.tiny, text_halign = text.align_left)
    table.cell(s7_cmpIn, 2, 3, s7_r2b, text_color = s7_r2b == S7_NA ? s7c_mut : s7c_ink, bgcolor = s7c_panel, text_size = size.tiny, text_halign = text.align_left)
    table.cell(s7_cmpIn, 3, 3, s7_s2c, text_color = s7_s2c == S7_NA ? s7c_mut : s7c_ink, bgcolor = s7c_panel, text_size = size.tiny, text_halign = text.align_left)
    table.cell(s7_cmpIn, 0, 4, "MOM · ROC5", text_color = s7c_ink2, bgcolor = s7c_panel, text_size = size.tiny, text_halign = text.align_left)
    table.cell(s7_cmpIn, 1, 4, s7_evMomV, text_color = s7_evMomV == S7_NA ? s7c_mut : s7c_ink2, bgcolor = s7c_panel, text_size = size.tiny, text_halign = text.align_left)
    table.cell(s7_cmpIn, 2, 4, s7_r3b, text_color = s7_r3b == S7_NA ? s7c_mut : s7c_ink, bgcolor = s7c_panel, text_size = size.tiny, text_halign = text.align_left)
    table.cell(s7_cmpIn, 3, 4, s7_s3c, text_color = s7_s3c == S7_NA ? s7c_mut : s7c_ink, bgcolor = s7c_panel, text_size = size.tiny, text_halign = text.align_left)
    // AT SIGNAL slope is the frozen Q5 evidence STATE. The accepted producer
    // set carries no frozen signal-time slope value or direction, so no
    // same-unit delta exists and CHANGES stays N/A rather than invented.
    table.cell(s7_cmpIn, 0, 5, "VWAP SLOPE", text_color = s7c_ink2, bgcolor = s7c_panel, text_size = size.tiny, text_halign = text.align_left)
    table.cell(s7_cmpIn, 1, 5, s7_evSlpV, text_color = s7_evSlpV == S7_NA ? s7c_mut : s7c_ink2, bgcolor = s7c_panel, text_size = size.tiny, text_halign = text.align_left)
    table.cell(s7_cmpIn, 2, 5, S7_NA, text_color = s7c_mut, bgcolor = s7c_panel, text_size = size.tiny, text_halign = text.align_left)
    table.cell(s7_cmpIn, 3, 5, s7_s4c, text_color = s7_s4c == S7_NA ? s7c_mut : s7c_ink, bgcolor = s7c_panel, text_size = size.tiny, text_halign = text.align_left)
    // EVENT row appears only where a signal snapshot exists.
    // A49 / C-02 — the elected snapshot's OWN riskPass decides SETUP vs
    // REJECTED. No Observation production, riskPass value, setup/rejection
    // predicate, threshold or decision authority is changed; the already
    // owned classification is simply carried instead of assumed.
    string s7_r5a = s7_stripHas ? (s7_stripPass ? "SETUP · " : "REJECTED · ") + s7_famText(s7_stripFam) : ""
    string s7_r5b = s7_cmpLive  ? (s7_trailUnlocked ? "TRAIL ON" : s7_tp1Reached ? "TP1 REACHED" : S7_NA) : (s7_stripHas ? S7_NA : "")
    string s7_r5c = s7_cmpLive  ? s7_dirEventText : (s7_stripHas ? S7_NA : "")
    table.cell(s7_cmpIn, 0, 6, s7_stripHas ? "EVENT" : "", text_color = s7c_ink2, bgcolor = s7c_panel, text_size = size.tiny, text_halign = text.align_left)
    table.cell(s7_cmpIn, 1, 6, s7_r5a, text_color = s7c_ink2, bgcolor = s7c_panel, text_size = size.tiny, text_halign = text.align_left)
    table.cell(s7_cmpIn, 2, 6, s7_r5b, text_color = s7_r5b == S7_NA ? s7c_mut : s7c_ink, bgcolor = s7c_panel, text_size = size.tiny, text_halign = text.align_left)
    table.cell(s7_cmpIn, 3, 6, s7_r5c, text_color = s7c_ink, bgcolor = s7c_panel, text_size = size.tiny, text_halign = text.align_left)

s7_renderAdvanced(table s7_panelIn, int s7_prevRowsIn) =>
    array<string> s7_buf = array.new_string()
    array<int>    s7_sty = array.new_int()

    s7_pushRow(s7_buf, s7_sty, "OSE-S7 " + S7_BUILD, s7_displayDepth, "ALERTS " + s7_alertProfile, "", "", "RESEARCH ONLY", 1)
    s7_pushRow(s7_buf, s7_sty, s7_lifeMain, s7_lifeSide, "", "", "", s7_hhmm(time_close), 1)
    s7_pushRow(s7_buf, s7_sty, "STRUCTURE", s7_structText, s7_structAr, "", "", "", 0)
    int s7_evSty = s7_domPri >= S7_PRI_REVERSED ? 4 : s7_domPri >= S7_PRI_STOPBREAK ? 4 : s7_domPri >= S7_PRI_CRITICAL ? 3 : s7_domPri >= S7_PRI_WARNING ? 2 : 0
    s7_pushRow(s7_buf, s7_sty, s7_dirEventText, "", "", "", "", "C17 " + s7_dirText(structBias), s7_evSty)
    s7_pushRow(s7_buf, s7_sty, "RVOL", "MOM", "LOC", "FRESH", "SLOPE", "", 1)
    s7_pushRow(s7_buf, s7_sty, "الحجم النسبي", "الزخم", "الموقع", "حداثة الفرصة", "ميل VWAP", "", 5)
    s7_pushRow(s7_buf, s7_sty, s7_qGlyph(s7_stripFlag, s7_stripAppl, QB_Q1), s7_qGlyph(s7_stripFlag, s7_stripAppl, QB_Q2), s7_qGlyph(s7_stripFlag, s7_stripAppl, QB_Q3), s7_qGlyph(s7_stripFlag, s7_stripAppl, QB_Q4), s7_qGlyph(s7_stripFlag, s7_stripAppl, QB_Q5), s7_qOk ? "EVIDENCE " + str.tostring(s7_qPass) + "/" + str.tostring(s7_qAppl) : "EVIDENCE " + S7_NA, 0)
    s7_pushRow(s7_buf, s7_sty, "", "", "", "", "", s7_qOk ? "الأدلة " + str.tostring(s7_qPass) + " من " + str.tostring(s7_qAppl) : S7_NA, 5)
    s7_pushRow(s7_buf, s7_sty, "INITIAL STOP", s7_priceText(s7_caseInitialStop), "TRAIL STOP", s7_priceText(s7_trailStop), "TP1", s7_priceText(s7_caseTp1), 0)
    s7_pushRow(s7_buf, s7_sty, "ROOM", s7_numText(s7_room, format.mintick), "NEXT BARRIER", s7_priceText(s7_barrier), "", "", 0)
    s7_pushRow(s7_buf, s7_sty, "SQUEEZE", s7_sqzText, s7_sqzAr, "", "", "", 0)
    if not s7_coreReady
        s7_pushRow(s7_buf, s7_sty, S7_NOT_READY, "session", sessionDataReady ? "READY" : "NOT READY", "bars", str.tostring(rthBarsAvailable), "", 2)

    if s7_advanced
        s7_pushRow(s7_buf, s7_sty, "AT SIGNAL", "وقت الإشارة", "", "", "", "", 1)
        s7_pushRow(s7_buf, s7_sty, "case #" + (na(s7_caseId) ? S7_NA : str.tostring(s7_caseId)), s7_famText(s7_caseFamily), s7_dirText(s7_caseDir), s7_hhmm(s7_caseSignalTime), "slot " + (na(s7_caseSignalSlot) ? S7_NA : str.tostring(s7_caseSignalSlot)), "idx " + (na(s7_caseObsIdxInBar) ? S7_NA : str.tostring(s7_caseObsIdxInBar)), 0)
        s7_pushRow(s7_buf, s7_sty, "signal close", s7_priceText(s7_caseSignalClose), "INITIAL STOP", s7_priceText(s7_caseInitialStop), "STOP DIST · مسافة الوقف", s7_numText(s7_casePlannedRisk, format.mintick), 0)
        s7_pushRow(s7_buf, s7_sty, "TP1", s7_priceText(s7_caseTp1), "TP1 MOVE · مسافة TP1", (na(s7_caseTp1) or na(s7_caseSignalClose)) ? S7_NA : s7_priceText(math.abs(s7_caseTp1 - s7_caseSignalClose)), s7_entryText(s7_caseClassCode), "", 0)
        s7_pushRow(s7_buf, s7_sty, "zone", s7_zoneText(s7_caseZoneMask), "confluence", str.tostring(s7_caseConfluence), "touch", str.tostring(s7_caseTouchCount), 0)
        s7_pushRow(s7_buf, s7_sty, "atrRefAtObs", s7_numText(s7_caseAtrRefAtObs, "0.0000"), "entryDistATR", s7_numText(s7_caseEntryDistATR, "0.0000"), "premise", s7_premiseTrace ? s7_zoneText(s7_premiseMask) + " · bit " + str.tostring(s7_premiseAnchorBit) : "N/A", 0)
        s7_pushRow(s7_buf, s7_sty, "SIGNAL CHANGES", "منذ الإشارة", "", "", "", "", 1)
        s7_pushRow(s7_buf, s7_sty, "direction", s7_dirText(s7_caseDir) + " → " + s7_dirText(structBias), "structure", s7_caseActive and s7_premiseTrace ? ("INTACT → " + s7_structText) : "N/A", "", "", 0)
        s7_pushRow(s7_buf, s7_sty, "TP1 milestone", s7_tp1Reached ? "REACHED" : "not reached", "TRAIL ON", s7_trailUnlocked ? "ON" : "locked", "TRAIL v" + str.tostring(s7_trailVersion), s7_trailVersion > 0 ? s7_priceText(s7_trailPrevLevel) + " → " + s7_priceText(s7_trailStop) + " · " + s7_trailReason : "INIT_RINV", 0)
        s7_pushRow(s7_buf, s7_sty, "CURRENT SLOT RVOL", s7_numText(s7_caseSigRelVol, "0.00") + " → " + s7_numText(relVol, "0.00"), "ROC5", s7_numText(s7_caseSigRoc5, "0.0000") + " → " + s7_numText(roc5, "0.0000"), "", "", 0)
        s7_pushRow(s7_buf, s7_sty, "ROOM", s7_numText(s7_room, format.mintick), "NEXT BARRIER", s7_priceText(s7_barrier), "", "", 0)
        s7_pushRow(s7_buf, s7_sty, "SIGNAL STATUS", "الآن", "", "", "", "", 1)
        s7_pushRow(s7_buf, s7_sty, s7_caseActive ? "ACTIVE" : "ENDED", s7_dirText(s7_caseDir), s7_caseActive ? (s7_tp1Reached ? "POST-TP1" : "PRE-TP1") : s7_caseEndReason, "STRUCTURE", s7_structText, s7_caseActive ? "" : "case closed", 0)
        s7_pushRow(s7_buf, s7_sty, "C17 direction", s7_dirText(structBias), "VWAP SLOPE", s7_dirText(vwapSlopeState) + " · " + s7_numText(vwapSlopeRaw, "0.0000"), "IMPULSE", s7_impulseOn ? (impulseExcessiveState ? "EXCESSIVE · " + s7_dirText(impulseDirState) : "IMPULSE · " + s7_dirText(impulseDirState)) : S7_NA, 0)
        s7_pushRow(s7_buf, s7_sty, "TRAIL STOP", s7_priceText(s7_trailStop), "reason", s7_trailReason, "reversal candidate", s7_candLive ? s7_dirText(s7_candDir) + " · #" + str.tostring(s7_candObsId) : S7_NA, 0)
        s7_pushRow(s7_buf, s7_sty, "RESEARCH RISK / ENTRY", "", "", "", "", "", 1)
        s7_pushRow(s7_buf, s7_sty, "risk", s7_caseRiskPass ? "RISK PASS" : ((not na(s7_caseId)) ? "REJECTED · " + s7_rejectText(s7_caseRejectReason) : S7_NA), "entry", s7_entryText(s7_caseClassCode), "readiness", "VWR " + (commonSetupReady ? "R" : "NR") + " · LBO/LRT " + (staticCoreReady ? "R" : "NR") + " · SQZ " + (sqzCoreReady ? "R" : "NR"), 0)
        s7_pushRow(s7_buf, s7_sty, "MOVEMENT & PARTICIPATION", "", "", "", "", "", 1)
        s7_pushRow(s7_buf, s7_sty, "CURRENT SLOT RVOL", (rvolF8SlotSparse ? "NOT READY" : s7_numText(relVol, "0.00")), "الحجم النسبي للفترة الحالية", "CUMULATIVE RVOL · SESSION TO DATE", (rvolF7SessionsWarming ? "NOT READY" : s7_numText(relVolCum, "0.00")), "الحجم النسبي التراكمي منذ الافتتاح", 0)
        s7_pushRow(s7_buf, s7_sty, "ROC5", s7_numText(roc5, "0.0000"), "VWAP SLOPE", s7_dirText(vwapSlopeState), "ADX", s7_numText(adxVal, "0.00"), 0)
        s7_pushRow(s7_buf, s7_sty, "ATR % · DIAGNOSTIC", s7_numText(atrPctVal, "0.0000"), "ATR RATIO · DIAGNOSTIC", s7_numText(atrRatioVal, "0.0000"), "EFFICIENCY RATIO", s7_numText(efficiencyRatio, "0.0000"), 0)
        s7_pushRow(s7_buf, s7_sty, "FORWARD RESEARCH", "research / review only", "", "", "", "", 1)
        float s7_fwdRefRisk = na
        float s7_fwdRefPx   = na
        int   s7_fwdBars    = na
        float s7_fwdMfe12   = na
        float s7_fwdMae12   = na
        if not na(s7_caseObsRef)
            s7_fwdRefRisk := s7_caseObsRef.referenceRisk
            s7_fwdRefPx   := s7_caseObsRef.refPrice
            s7_fwdBars    := s7_caseObsRef.forwardBarsAvailable
            s7_fwdMfe12   := s7_caseObsRef.mfeUsd12
            s7_fwdMae12   := s7_caseObsRef.maeUsd12
        s7_pushRow(s7_buf, s7_sty, "REFERENCE RISK", s7_numText(s7_fwdRefRisk, format.mintick), "Forward-reference denominator", "refPrice", s7_priceText(s7_fwdRefPx), "bars " + (na(s7_fwdBars) ? S7_NA : str.tostring(s7_fwdBars)), 0)
        s7_pushRow(s7_buf, s7_sty, "MFE@12", s7_numText(s7_fwdMfe12, format.mintick), "MAE@12", s7_numText(s7_fwdMae12, format.mintick), "not P/L", "", 0)
        int s7_hn = array.size(s7_hist)
        string s7_h1 = S7_NA
        string s7_h2 = S7_NA
        string s7_h3 = S7_NA
        string s7_h4 = S7_NA
        string s7_h5 = S7_NA
        string s7_h6 = S7_NA
        string s7_h7 = S7_NA
        string s7_h8 = S7_NA
        string s7_h9 = S7_NA
        string s7_h10 = S7_NA
        if s7_hn > 0
            s7_h1 := array.get(s7_hist, s7_hn - 1)
        if s7_hn > 1
            s7_h2 := array.get(s7_hist, s7_hn - 2)
        if s7_hn > 2
            s7_h3 := array.get(s7_hist, s7_hn - 3)
        if s7_hn > 3
            s7_h4 := array.get(s7_hist, s7_hn - 4)
        if s7_hn > 4
            s7_h5 := array.get(s7_hist, s7_hn - 5)
        if s7_hn > 5
            s7_h6 := array.get(s7_hist, s7_hn - 6)
        if s7_hn > 6
            s7_h7 := array.get(s7_hist, s7_hn - 7)
        if s7_hn > 7
            s7_h8 := array.get(s7_hist, s7_hn - 8)
        if s7_hn > 8
            s7_h9 := array.get(s7_hist, s7_hn - 9)
        if s7_hn > 9
            s7_h10 := array.get(s7_hist, s7_hn - 10)
        s7_pushRow(s7_buf, s7_sty, "HISTORY", s7_h1, s7_h2, s7_h3, s7_h4, s7_h5, 1)
        s7_pushRow(s7_buf, s7_sty, "", s7_h6, s7_h7, s7_h8, s7_h9, s7_h10, 5)

    int s7_rows = array.size(s7_sty)
    if s7_rows > S7_TABLE_ROWS
        s7_rows := S7_TABLE_ROWS
    if s7_rows > 0
        for s7_r = 0 to s7_rows - 1
            int   s7_st  = array.get(s7_sty, s7_r)
            color s7_bg  = s7_st == 1 ? color.new(color.black, 0) : s7_st == 2 ? color.new(color.orange, 70) : s7_st == 3 ? color.new(color.orange, 40) : s7_st == 4 ? color.new(color.red, 35) : color.new(color.black, 12)
            color s7_tx  = s7_st == 5 ? color.new(color.silver, 15) : color.white
            string s7_tip = s7_r == 8 ? S7_STOP_TIP : s7_r == 1 ? S7_ACTIVE_TIP : ""
            for s7_c = 0 to S7_TABLE_COLS - 1
                table.cell(s7_panelIn, s7_c, s7_r, array.get(s7_buf, s7_r * S7_TABLE_COLS + s7_c), text_color = s7_tx, bgcolor = s7_bg, text_size = size.tiny, tooltip = s7_tip)
    if s7_prevRowsIn > s7_rows
        for s7_r = s7_rows to s7_prevRowsIn - 1
            for s7_c = 0 to S7_TABLE_COLS - 1
                table.cell(s7_panelIn, s7_c, s7_r, "", text_color = color.new(color.white, 100), bgcolor = color.new(color.black, 100), text_size = size.tiny)
    s7_rows

bool s7_simple = not s7_advanced

if not s7_uiEnabled
    if not na(s7_panel)
        table.delete(s7_panel)
        s7_panel := na
    if not na(s7_cardTbl)
        table.delete(s7_cardTbl)
        s7_cardTbl := na
    if not na(s7_evTbl)
        table.delete(s7_evTbl)
        s7_evTbl := na
    if not na(s7_cmpTbl)
        table.delete(s7_cmpTbl)
        s7_cmpTbl := na
    s7_clearBoxes(s7_staticBoxes)
    array.clear(s7_staticMasks)
    s7_clearLabels(s7_setupLabels)
    s7_clearLabels(s7_watchLabels)
    array.clear(s7_watchKeys)
    s7_clearLabels(s7_evtMarks)
    array.clear(s7_evtMarkKeys)
    if not na(s7_vwapBox)
        box.delete(s7_vwapBox)
        s7_vwapBox := na
    if not na(s7_orBox)
        box.delete(s7_orBox)
        s7_orBox := na
    if not na(s7_eventLabel)
        label.delete(s7_eventLabel)
        s7_eventLabel := na
    if not na(s7_lineInit)
        line.delete(s7_lineInit)
        s7_lineInit := na
    if not na(s7_lineTrail)
        line.delete(s7_lineTrail)
        s7_lineTrail := na
    if not na(s7_lineTp1)
        line.delete(s7_lineTp1)
        s7_lineTp1 := na
    if not na(s7_lineBarrier)
        line.delete(s7_lineBarrier)
        s7_lineBarrier := na
    if not na(s7_lineVwap)
        line.delete(s7_lineVwap)
        s7_lineVwap := na
    if not na(s7_lineOrH)
        line.delete(s7_lineOrH)
        s7_lineOrH := na
    if not na(s7_lineOrL)
        line.delete(s7_lineOrL)
        s7_lineOrL := na
    if not na(s7_lblIs)
        label.delete(s7_lblIs)
        s7_lblIs := na
    if not na(s7_lblTs)
        label.delete(s7_lblTs)
        s7_lblTs := na
    if not na(s7_lblTp1)
        label.delete(s7_lblTp1)
        s7_lblTp1 := na
    if not na(s7_lblBarrier)
        label.delete(s7_lblBarrier)
        s7_lblBarrier := na
    if not na(s7_lblVwap)
        label.delete(s7_lblVwap)
        s7_lblVwap := na
    if not na(s7_lblOrH)
        label.delete(s7_lblOrH)
        s7_lblOrH := na
    if not na(s7_lblOrL)
        label.delete(s7_lblOrL)
        s7_lblOrL := na
    s7_sessionOn    := false
    s7_sessionOpen  := na
    s7_sessionRight := na
    s7_prevRows     := 0
else
    // --- S7.8.0 depth-scoped surface lifecycle ------------------------------
    // Exactly one depth owns the screen at a time. Switching depth destroys the
    // other depth's surfaces so the two compositions can never co-render.
    if s7_advanced
        if na(s7_panel)
            s7_panel := table.new(position.top_right, S7_TABLE_COLS, S7_TABLE_ROWS, border_width = 1)
        if not na(s7_cardTbl)
            table.delete(s7_cardTbl)
            s7_cardTbl := na
        if not na(s7_evTbl)
            table.delete(s7_evTbl)
            s7_evTbl := na
        if not na(s7_cmpTbl)
            table.delete(s7_cmpTbl)
            s7_cmpTbl := na
    else
        if not na(s7_panel)
            table.delete(s7_panel)
            s7_panel := na
            s7_prevRows := 0
        if na(s7_cardTbl)
            s7_cardTbl := table.new(position.top_center, 1, 3, bgcolor = s7c_card, border_width = 0, frame_width = 1, frame_color = s7c_ink)
        if na(s7_evTbl)
            s7_evTbl := table.new(position.bottom_left, 6, 4, bgcolor = s7c_clear, border_width = 0)
        if na(s7_cmpTbl)
            s7_cmpTbl := table.new(position.bottom_right, 4, 2 + S7_CMP_ROWS, bgcolor = s7c_panel, border_width = 0, frame_width = 1, frame_color = s7c_hair)

    // --- S7.8.1 chart objects (confirmed bars only) ------------------------
    if barstate.isconfirmed
        // main structural zones — bands. Structural side only, never strength.
        bool s7_staticOk = array.size(zoneReg) <= S7_STATIC_BOX_CAP and s7_sessionOn and (not na(s7_sessionOpen)) and (not na(s7_sessionRight))
        if not s7_staticOk
            s7_clearBoxes(s7_staticBoxes)
            array.clear(s7_staticMasks)
        else
            int s7_ex = array.size(s7_staticMasks)
            if s7_ex > 0
                for s7_o3 = 0 to s7_ex - 1
                    int s7_ix2 = s7_ex - 1 - s7_o3
                    if not s7_regHasMask(zoneReg, array.get(s7_staticMasks, s7_ix2))
                        box s7_gone = array.get(s7_staticBoxes, s7_ix2)
                        if not na(s7_gone)
                            box.delete(s7_gone)
                        array.remove(s7_staticBoxes, s7_ix2)
                        array.remove(s7_staticMasks, s7_ix2)
            int s7_zn7 = array.size(zoneReg)
            if s7_zn7 > 0
                for s7_i = 0 to s7_zn7 - 1
                    Zone s7_z = array.get(zoneReg, s7_i)
                    bool s7_ok2 = s7_z.mask > 0 and s7_z.mask <= STATIC_MASK_MAX and (not na(s7_z.lower)) and (not na(s7_z.upper)) and s7_z.lower <= s7_z.upper
                    if s7_ok2
                        int s7_li = array.indexof(s7_staticMasks, s7_z.mask)
                        box s7_bx = na
                        if s7_li >= 0
                            s7_bx := array.get(s7_staticBoxes, s7_li)
                        else
                            s7_bx := box.new(left = s7_sessionOpen, top = s7_z.upper, right = s7_sessionRight, bottom = s7_z.lower, xloc = xloc.bar_time, bgcolor = color.new(color.gray, 90), border_color = color.new(color.gray, 60), text_color = color.silver, text_size = size.tiny)
                            array.push(s7_staticBoxes, s7_bx)
                            array.push(s7_staticMasks, s7_z.mask)
                        // approved band palette: buy-side green family, sell-side
                        // red family, neutral gray family (Final UX §17.2)
                        color s7_side = s7_simple ? (s7_z.structuralRole == ROLE_SUPPORT ? s7c_supFil : s7_z.structuralRole == ROLE_RESISTANCE ? s7c_resFil : color.new(color.gray, 92)) : (s7_z.structuralRole == ROLE_SUPPORT ? color.new(color.green, 90) : s7_z.structuralRole == ROLE_RESISTANCE ? color.new(color.red, 90) : color.new(color.gray, 90))
                        color s7_edge = s7_simple ? (s7_z.structuralRole == ROLE_SUPPORT ? s7c_supBd : s7_z.structuralRole == ROLE_RESISTANCE ? s7c_resBd : s7c_dim) : (s7_z.structuralRole == ROLE_SUPPORT ? color.new(color.green, 55) : s7_z.structuralRole == ROLE_RESISTANCE ? color.new(color.red, 55) : color.new(color.gray, 55))
                        bool s7_isActiveZone = (not na(activeZoneIdx)) and activeZoneIdx == s7_i
                        box.set_left(s7_bx, s7_sessionOpen)
                        box.set_right(s7_bx, s7_sessionRight)
                        box.set_top(s7_bx, s7_z.upper)
                        box.set_bottom(s7_bx, s7_z.lower)
                        box.set_bgcolor(s7_bx, s7_side)
                        box.set_border_color(s7_bx, s7_isActiveZone ? (s7_simple ? s7c_ink : color.new(color.silver, 10)) : s7_edge)
                        box.set_border_width(s7_bx, s7_isActiveZone ? 2 : 1)
                        // readable structural naming instead of internal wording
                        box.set_text(s7_bx, s7_simple ? s7_zoneText(s7_z.mask) + " · " + s7_roleText(s7_z.structuralRole) : s7_zoneText(s7_z.mask) + " · confluence " + str.tostring(s7_z.confluence))
                        box.set_text_color(s7_bx, s7_simple ? (s7_z.structuralRole == ROLE_SUPPORT ? s7c_sup : s7_z.structuralRole == ROLE_RESISTANCE ? s7c_res : s7c_mut) : color.silver)

        // VWAP — thin neutral reference (Final UX §17.1). SIMPLE renders the
        // approved single dashed line at the VWAP price with a right-edge
        // label; ADVANCED keeps the IC2 accepted-zone band unchanged.
        bool s7_vwapBand = (not s7_simple) and s7_sessionOn and (not na(vwapLower)) and (not na(vwapUpper)) and vwapLower <= vwapUpper
        if s7_vwapBand
            if na(s7_vwapBox)
                s7_vwapBox := box.new(left = s7_sessionOpen, top = vwapUpper, right = s7_sessionRight, bottom = vwapLower, xloc = xloc.bar_time, bgcolor = color.new(color.silver, 92), border_color = color.new(color.silver, 60), text = "VWAP", text_color = color.silver, text_size = size.tiny)
            box.set_left(s7_vwapBox, s7_sessionOpen)
            box.set_right(s7_vwapBox, s7_sessionRight)
            box.set_top(s7_vwapBox, vwapUpper)
            box.set_bottom(s7_vwapBox, vwapLower)
        else
            if not na(s7_vwapBox)
                box.delete(s7_vwapBox)
                s7_vwapBox := na
        bool s7_vwapLine = s7_simple and s7_sessionOn and (not na(vwap)) and (not na(s7_sessionOpen)) and (not na(s7_sessionRight))
        if s7_vwapLine
            if na(s7_lineVwap)
                s7_lineVwap := line.new(x1 = s7_sessionOpen, y1 = vwap, x2 = s7_sessionRight, y2 = vwap, xloc = xloc.bar_time, color = s7c_dim, width = 1, style = line.style_dashed)
            line.set_xy1(s7_lineVwap, s7_sessionOpen, vwap)
            line.set_xy2(s7_lineVwap, s7_sessionRight, vwap)
            if na(s7_lblVwap)
                s7_lblVwap := label.new(x = s7_sessionRight, y = vwap, text = "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left, color = s7c_clear, textcolor = s7c_mut, size = size.tiny)
            label.set_xy(s7_lblVwap, s7_sessionRight, vwap)
            label.set_text(s7_lblVwap, "VWAP · NEUTRAL REFERENCE  " + s7_priceText(vwap))
        else
            if not na(s7_lineVwap)
                line.delete(s7_lineVwap)
                s7_lineVwap := na
            if not na(s7_lblVwap)
                label.delete(s7_lblVwap)
                s7_lblVwap := na

        // Opening range — SIMPLE renders the approved secondary references as
        // thin lines at their own price; ADVANCED keeps the IC2 band.
        bool s7_orBand = (not s7_simple) and s7_sessionOn and orReady and (not na(orHigh)) and (not na(orLow)) and orLow <= orHigh
        if s7_orBand
            if na(s7_orBox)
                s7_orBox := box.new(left = s7_sessionOpen, top = orHigh, right = s7_sessionRight, bottom = orLow, xloc = xloc.bar_time, bgcolor = color.new(color.silver, 94), border_color = color.new(color.silver, 55), text = "OR", text_color = color.silver, text_size = size.tiny)
            box.set_left(s7_orBox, s7_sessionOpen)
            box.set_right(s7_orBox, s7_sessionRight)
            box.set_top(s7_orBox, orHigh)
            box.set_bottom(s7_orBox, orLow)
        else
            if not na(s7_orBox)
                box.delete(s7_orBox)
                s7_orBox := na
        bool s7_orLines = s7_simple and s7_sessionOn and orReady and (not na(orHigh)) and (not na(orLow)) and orLow <= orHigh and (not na(s7_sessionOpen)) and (not na(s7_sessionRight))
        if s7_orLines
            if na(s7_lineOrH)
                s7_lineOrH := line.new(x1 = s7_sessionOpen, y1 = orHigh, x2 = s7_sessionRight, y2 = orHigh, xloc = xloc.bar_time, color = s7c_dim, width = 1, style = line.style_solid)
            line.set_xy1(s7_lineOrH, s7_sessionOpen, orHigh)
            line.set_xy2(s7_lineOrH, s7_sessionRight, orHigh)
            if na(s7_lblOrH)
                s7_lblOrH := label.new(x = s7_sessionRight, y = orHigh, text = "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left, color = s7c_clear, textcolor = s7c_mut, size = size.tiny)
            label.set_xy(s7_lblOrH, s7_sessionRight, orHigh)
            label.set_text(s7_lblOrH, "OPENING RANGE HIGH  " + s7_priceText(orHigh))
            if na(s7_lineOrL)
                s7_lineOrL := line.new(x1 = s7_sessionOpen, y1 = orLow, x2 = s7_sessionRight, y2 = orLow, xloc = xloc.bar_time, color = s7c_dim, width = 1, style = line.style_solid)
            line.set_xy1(s7_lineOrL, s7_sessionOpen, orLow)
            line.set_xy2(s7_lineOrL, s7_sessionRight, orLow)
            if na(s7_lblOrL)
                s7_lblOrL := label.new(x = s7_sessionRight, y = orLow, text = "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left, color = s7c_clear, textcolor = s7c_mut, size = size.tiny)
            label.set_xy(s7_lblOrL, s7_sessionRight, orLow)
            label.set_text(s7_lblOrL, "OPENING RANGE LOW  " + s7_priceText(orLow))
        else
            if not na(s7_lineOrH)
                line.delete(s7_lineOrH)
                s7_lineOrH := na
            if not na(s7_lblOrH)
                label.delete(s7_lblOrH)
                s7_lblOrH := na
            if not na(s7_lineOrL)
                line.delete(s7_lineOrL)
                s7_lineOrL := na
            if not na(s7_lblOrL)
                label.delete(s7_lblOrL)
                s7_lblOrL := na

        // WATCH markers — hollow, amber, non-command (Final UX §18.1). Keyed to
        // the canonical Arm registry; removed the moment the Arm expires.
        int s7_wn = array.size(s7_watchKeys)
        if s7_wn > 0
            for s7_o4 = 0 to s7_wn - 1
                int s7_wi = s7_wn - 1 - s7_o4
                int s7_key = array.get(s7_watchKeys, s7_wi)
                bool s7_still = false
                if s7_armCount > 0
                    for s7_i = 0 to s7_armCount - 1
                        Arm s7_a = array.get(armStore, s7_i)
                        if (not s7_still) and (s7_a.family * 1000 + (s7_a.direction + 1) * 100 + s7_a.zoneIdMask) == s7_key
                            s7_still := true
                if not s7_still
                    label s7_wl = array.get(s7_watchLabels, s7_wi)
                    if not na(s7_wl)
                        label.delete(s7_wl)
                    array.remove(s7_watchLabels, s7_wi)
                    array.remove(s7_watchKeys, s7_wi)
        if s7_armCount > 0 and (not na(rthC)) and ((not s7_simple) or (not na(rthL)))
            for s7_i = 0 to s7_armCount - 1
                Arm s7_a = array.get(armStore, s7_i)
                int s7_key2 = s7_a.family * 1000 + (s7_a.direction + 1) * 100 + s7_a.zoneIdMask
                if array.indexof(s7_watchKeys, s7_key2) < 0 and array.size(s7_watchKeys) < S7_WATCH_LABEL_CAP
                    string s7_wtxt = (s7_simple ? "▵ " : "") + "WATCH · " + s7_famText(s7_a.family) + " · " + s7_dirText(s7_a.direction)
                    label s7_nl = label.new(x = time_close, y = s7_simple ? rthL : rthC, text = s7_wtxt, xloc = xloc.bar_time, yloc = yloc.price, style = s7_simple ? label.style_label_up : label.style_label_lower_left, color = s7_simple ? color.new(#fff5e2, 10) : color.new(color.orange, 85), textcolor = s7_simple ? s7c_amb : color.new(color.orange, 15), size = size.tiny)
                    array.push(s7_watchLabels, s7_nl)
                    array.push(s7_watchKeys, s7_key2)

        // SETUP markers — filled, stronger than WATCH, no broker-entry arrow
        // and no BUY/SELL imperative (Final UX §18.2). Bounded FIFO.
        if rawObsSetClosed and s7_obsCount > 0
            for s7_i = 0 to s7_obsCount - 1
                Obs s7_o = array.get(rawObsSet, s7_i)
                if (not na(s7_o.obsBarTime)) and (not na(s7_o.signalClose))
                    if array.size(s7_setupLabels) >= S7_SETUP_LABEL_CAP
                        label s7_old2 = array.shift(s7_setupLabels)
                        if not na(s7_old2)
                            label.delete(s7_old2)
                    string s7_stxt = (s7_simple ? "▴ " : "") + (s7_o.riskPass ? "SETUP · " : "REJECTED · ") + s7_famText(s7_o.family) + " · " + s7_dirText(s7_o.direction)
                    label s7_sl = label.new(x = s7_o.obsBarTime, y = s7_o.signalClose, text = s7_stxt, xloc = xloc.bar_time, yloc = yloc.price, style = s7_simple ? label.style_label_up : label.style_label_left, color = s7_simple ? (s7_o.riskPass ? s7c_grid : color.new(s7c_grid, 45)) : (s7_o.riskPass ? color.new(color.gray, 15) : color.new(color.gray, 70)), textcolor = s7_simple ? (s7_o.riskPass ? s7c_ink : s7c_mut) : (s7_o.riskPass ? color.white : color.new(color.silver, 30)), size = size.tiny)
                    array.push(s7_setupLabels, s7_sl)

        // Management event markers — SIMPLE only. One marker at the transition
        // bar for the highest-value accepted event committed on that bar; never
        // a persistent per-bar label (mission §4.6). Bounded FIFO.
        if s7_simple
            if not na(s7_eventLabel)
                label.delete(s7_eventLabel)
                s7_eventLabel := na
            bool s7_markable = s7_domPri >= S7_PRI_TRAILON and str.length(s7_domText) > 0 and (not na(rthH)) and (not na(rthL))
            if s7_markable and array.indexof(s7_evtMarkKeys, time) < 0
                if array.size(s7_evtMarks) >= S7_EVENT_MARK_CAP
                    label s7_oldm = array.shift(s7_evtMarks)
                    if not na(s7_oldm)
                        label.delete(s7_oldm)
                    array.shift(s7_evtMarkKeys)
                // Placement follows the approved design, not the numeric rank:
                // case-progress milestones sit below the bar, adverse and
                // barrier events above it. Rank order is non-monotonic here
                // (ACTIVE 50 sits between WARNING 45 and TP1 55), so the two
                // below-bar milestones are named explicitly.
                bool  s7_above = not (s7_domPri == S7_PRI_TRAILON or s7_domPri == S7_PRI_ACTIVE)
                bool  s7_sev   = s7_domPri >= S7_PRI_STOPBREAK or s7_domPri == S7_PRI_CRITICAL
                bool  s7_caut  = s7_domPri == S7_PRI_STRUCTLOST or s7_domPri == S7_PRI_WARNING
                color s7_mInk  = s7_sev ? s7c_bad : s7_caut ? s7c_amb : s7_domPri == S7_PRI_TP1 ? s7c_ref : s7c_ink
                color s7_mBg   = s7_sev ? color.new(s7c_bad, 88) : s7_caut ? s7c_warnBg : s7c_grid
                label s7_nm = label.new(x = time, y = s7_above ? rthH : rthL, text = (s7_above ? "▾ " : "▴ ") + s7_domText + "  " + s7_hhmm(time_close), xloc = xloc.bar_time, yloc = yloc.price, style = s7_above ? label.style_label_down : label.style_label_up, color = s7_mBg, textcolor = s7_mInk, size = size.tiny)
                array.push(s7_evtMarks, s7_nm)
                array.push(s7_evtMarkKeys, time)
        else
            s7_clearLabels(s7_evtMarks)
            array.clear(s7_evtMarkKeys)
            // ADVANCED keeps the IC2 single current-major-event label verbatim
            if not na(s7_eventLabel)
                label.delete(s7_eventLabel)
                s7_eventLabel := na
            if s7_domPri >= S7_PRI_STRUCTLOST and (not na(rthC))
                color s7_evc = s7_domPri >= S7_PRI_REVERSED ? color.new(color.red, 10) : s7_domPri >= S7_PRI_STOPBREAK ? color.new(color.red, 25) : s7_domPri >= S7_PRI_CRITICAL ? color.new(color.orange, 15) : color.new(color.orange, 45)
                s7_eventLabel := label.new(x = time_close, y = rthC, text = s7_domText, xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_up, color = s7_evc, textcolor = color.white, size = size.small)

        // Protection / target geometry — rendered at the actual chart price.
        // Sources are unchanged: INITIAL STOP is the immutable original R-INV,
        // TRAIL STOP the current MGMT-INV, TP1 the original planned TP1. No
        // value is fabricated: each line exists only where its accepted value
        // exists for the current case, so WATCH / NO SETUP draws none of them.
        if s7_caseActive and s7_sessionOn and (not na(s7_caseStartTime)) and (not na(s7_sessionRight))
            if na(s7_lineInit) and (not na(s7_caseInitialStop))
                s7_lineInit := line.new(x1 = s7_caseStartTime, y1 = s7_caseInitialStop, x2 = s7_sessionRight, y2 = s7_caseInitialStop, xloc = xloc.bar_time, color = color.new(color.silver, 40), width = 1, style = line.style_dotted)
            if na(s7_lineTrail) and (not na(s7_trailStop))
                s7_lineTrail := line.new(x1 = s7_caseStartTime, y1 = s7_trailStop, x2 = s7_sessionRight, y2 = s7_trailStop, xloc = xloc.bar_time, color = color.new(color.silver, 10), width = 1, style = line.style_solid)
            if na(s7_lineTp1) and (not na(s7_caseTp1))
                s7_lineTp1 := line.new(x1 = s7_caseStartTime, y1 = s7_caseTp1, x2 = s7_sessionRight, y2 = s7_caseTp1, xloc = xloc.bar_time, color = color.new(color.silver, 25), width = 1, style = line.style_dashed)
            if not na(s7_lineInit)
                line.set_xy1(s7_lineInit, s7_caseStartTime, s7_caseInitialStop)
                line.set_xy2(s7_lineInit, s7_sessionRight, s7_caseInitialStop)
                line.set_color(s7_lineInit, s7_simple ? s7c_dim : color.new(color.silver, 40))
                line.set_width(s7_lineInit, 1)
                // A49 / C-04 — SIMPLE keeps its approved dashed INITIAL STOP;
                // ADVANCED keeps IC2's inherited dotted style. Value, producer,
                // coordinates, lifecycle and colour semantics are untouched.
                line.set_style(s7_lineInit, s7_simple ? line.style_dashed : line.style_dotted)
            if not na(s7_lineTrail)
                line.set_xy1(s7_lineTrail, s7_caseStartTime, s7_trailStop)
                line.set_xy2(s7_lineTrail, s7_sessionRight, s7_trailStop)
                line.set_color(s7_lineTrail, s7_simple ? s7c_trail : color.new(color.silver, 10))
                line.set_width(s7_lineTrail, s7_simple ? 2 : 1)
                line.set_style(s7_lineTrail, line.style_solid)
            if not na(s7_lineTp1)
                line.set_xy1(s7_lineTp1, s7_caseStartTime, s7_caseTp1)
                line.set_xy2(s7_lineTp1, s7_sessionRight, s7_caseTp1)
                line.set_color(s7_lineTp1, s7_simple ? s7c_tp1 : color.new(color.silver, 25))
                line.set_width(s7_lineTp1, s7_simple ? 2 : 1)
                line.set_style(s7_lineTp1, line.style_dashed)
        else
            if not na(s7_lineInit)
                line.delete(s7_lineInit)
                s7_lineInit := na
            if not na(s7_lineTrail)
                line.delete(s7_lineTrail)
                s7_lineTrail := na
            if not na(s7_lineTp1)
                line.delete(s7_lineTp1)
                s7_lineTp1 := na

        // Right-edge price labels — SIMPLE only, one per existing reference.
        bool s7_planLbl = s7_simple and s7_caseActive and s7_sessionOn and (not na(s7_sessionRight))
        if s7_planLbl and (not na(s7_caseInitialStop))
            if na(s7_lblIs)
                s7_lblIs := label.new(x = s7_sessionRight, y = s7_caseInitialStop, text = "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left, color = s7c_clear, textcolor = s7c_dim, size = size.tiny, tooltip = S7_STOP_TIP)
            label.set_xy(s7_lblIs, s7_sessionRight, s7_caseInitialStop)
            label.set_text(s7_lblIs, "INITIAL STOP  " + s7_priceText(s7_caseInitialStop))
        else
            if not na(s7_lblIs)
                label.delete(s7_lblIs)
                s7_lblIs := na
        if s7_planLbl and (not na(s7_trailStop))
            if na(s7_lblTs)
                s7_lblTs := label.new(x = s7_sessionRight, y = s7_trailStop, text = "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left, color = s7c_clear, textcolor = s7c_trail, size = size.tiny, tooltip = S7_STOP_TIP)
            label.set_xy(s7_lblTs, s7_sessionRight, s7_trailStop)
            label.set_text(s7_lblTs, "TRAIL STOP  " + s7_priceText(s7_trailStop) + (s7_trailVersion > 0 ? " · RATCHET v" + str.tostring(s7_trailVersion) : ""))
        else
            if not na(s7_lblTs)
                label.delete(s7_lblTs)
                s7_lblTs := na
        if s7_planLbl and (not na(s7_caseTp1))
            if na(s7_lblTp1)
                s7_lblTp1 := label.new(x = s7_sessionRight, y = s7_caseTp1, text = "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left, color = s7c_clear, textcolor = s7c_tp1, size = size.tiny)
            label.set_xy(s7_lblTp1, s7_sessionRight, s7_caseTp1)
            label.set_text(s7_lblTp1, "TP1  " + s7_priceText(s7_caseTp1) + (s7_tp1Reached ? " · REACHED" : ""))
        else
            if not na(s7_lblTp1)
                label.delete(s7_lblTp1)
                s7_lblTp1 := na

        // NEXT BARRIER — structural reference, never TP2. ROOM rides on the
        // same label as structural distance; it is never its own price line.
        bool s7_barLine = s7_simple and s7_sessionOn and (not na(s7_barrier)) and (not na(s7_sessionOpen)) and (not na(s7_sessionRight))
        if s7_barLine
            if na(s7_lineBarrier)
                s7_lineBarrier := line.new(x1 = s7_sessionOpen, y1 = s7_barrier, x2 = s7_sessionRight, y2 = s7_barrier, xloc = xloc.bar_time, color = s7c_res, width = 1, style = line.style_solid)
            line.set_xy1(s7_lineBarrier, s7_sessionOpen, s7_barrier)
            line.set_xy2(s7_lineBarrier, s7_sessionRight, s7_barrier)
            if na(s7_lblBarrier)
                s7_lblBarrier := label.new(x = s7_sessionRight, y = s7_barrier, text = "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left, color = s7c_clear, textcolor = s7c_res, size = size.tiny)
            label.set_xy(s7_lblBarrier, s7_sessionRight, s7_barrier)
            label.set_text(s7_lblBarrier, "NEXT BARRIER  " + s7_priceText(s7_barrier) + " · ROOM " + s7_numText(s7_room, format.mintick))
        else
            if not na(s7_lineBarrier)
                line.delete(s7_lineBarrier)
                s7_lineBarrier := na
            if not na(s7_lblBarrier)
                label.delete(s7_lblBarrier)
                s7_lblBarrier := na

    // --- S7.8.2 approved SIMPLE composition --------------------------------
    // Rendered on the last bar only: a table shows exactly one state, so
    // historical-bar writes are redundant runtime cost. No Stage-7 state,
    // event, alert or drawing lifecycle depends on this gate.
    if s7_simple and barstate.islast and (not na(s7_cardTbl))
        s7_renderSimple(s7_cardTbl, s7_evTbl, s7_cmpTbl)

    // --- S7.8.3 ADVANCED panel — IC2 behaviour preserved verbatim ----------
    if s7_advanced and barstate.islast and (not na(s7_panel))
        s7_prevRows := s7_renderAdvanced(s7_panel, s7_prevRows)

// =============================================================================
// END — OSE-S7-DECISION-SUPPORT-UI-v1.0.0-IC3R2.pine
// =============================================================================
