// =============================================================================
// 19. M4 — CONFIGURATION, CONSTANTS, SUPPLEMENTAL REQUEST, TYPES, STATE, HELPERS
//     SAT06-A20. Everything below is ADDITIVE. The only inherited executable
//     edits in this child are the §4.2 Arm-interface extension at §13.4 and the
//     two whole-donor Arm.new re-key constructors at §15.5, which now carry the
//     three added arm-history fields intact. No other inherited executable line
//     is altered, reordered, renamed or "improved".
// =============================================================================

// --- 19.1 authorized M4 inputs (A20 §2.1) — exactly 22 -----------------------
// EXACT authorized defaults and bounds. No step, mode, alternate default/range,
// optimizer, scenario selector, answer helper or additional input. Group G is
// declared here for the same reason group F is declared at §16.2: inherited
// input order is preserved and no earlier input site is disturbed.
gTrg = "G · M4 triggers / Risk / Observation (SAT06-A20 §2.1)"
bodyRatioMin          = input.float(0.50,  "bodyRatioMin",          minval = 0.35, maxval = 0.65, group = gTrg)
closeLocMin           = input.float(0.60,  "closeLocMin",           minval = 0.50, maxval = 0.80, group = gTrg)
maxTrigDistATR        = input.float(0.75,  "maxTrigDistATR",        minval = 0.50, maxval = 1.25, group = gTrg)
disarmDistATR         = input.float(1.00,  "disarmDistATR",         minval = 0.70, maxval = 1.50, group = gTrg)
maxRetestsPerZone     = input.int(2,       "maxRetestsPerZone",     minval = 1,    maxval = 3,    group = gTrg)
stopBufATR            = input.float(0.15,  "stopBufATR",            minval = 0.05, maxval = 0.35, group = gTrg)
impulseATRmult        = input.float(1.50,  "impulseATRmult",        minval = 1.20, maxval = 2.00, group = gTrg)
impulseTooLateATR     = input.float(2.50,  "impulseTooLateATR",     minval = 2.00, maxval = 3.50, group = gTrg)
impulseWindowBars     = input.int(6,       "impulseWindowBars",     minval = 3,    maxval = 10,   group = gTrg)
effEarlyMax           = input.float(0.25,  "effEarlyMax",           minval = 0.15, maxval = 0.35, group = gTrg)
effConfirmedMax       = input.float(0.75,  "effConfirmedMax",       minval = 0.60, maxval = 0.90, group = gTrg)
effExtendedMax        = input.float(1.25,  "effExtendedMax",        minval = 1.00, maxval = 1.50, group = gTrg)
maxRiskATR            = input.float(1.50,  "maxRiskATR",            minval = 1.00, maxval = 2.00, group = gTrg)
minTickMultiple       = input.int(4,       "minTickMultiple",       minval = 2,    maxval = 8,    group = gTrg)
relVolStrong          = input.float(1.50,  "relVolStrong",          minval = 1.20, maxval = 2.00, group = gTrg)
rocMin                = input.float(0.15,  "rocMin",                minval = 0.05, maxval = 0.35, group = gTrg)
vwapSlopeMinATR       = input.float(0.15,  "vwapSlopeMinATR",       minval = 0.05, maxval = 0.35, group = gTrg)
gapSmallATR           = input.float(0.50,  "gapSmallATR",           minval = 0.30, maxval = 0.80, group = gTrg)
gapLargeATR           = input.float(1.50,  "gapLargeATR",           minval = 1.00, maxval = 2.50, group = gTrg)
maxObservationsPerBar = input.int(12,      "maxObservationsPerBar", minval = 8,    maxval = 16,   group = gTrg)
eventDayBlock         = input.bool(false,  "eventDayBlock",                                       group = gTrg)
eventDates            = input.string("",   "eventDates  YYYYMMDD,...  (New York local dates)",    group = gTrg)

// --- 19.2 non-configurable M4 source constants (A20 §2.2) --------------------
// Production form: const, NOT input. None of these is exposed as a tuning
// surface and none acquires an alternate value anywhere in this source.
const float  MAX_APPROACH_ATR         = 1.00
const int    RETEST_WINDOW_BARS       = 12
const int    ARM_EXPIRY_VWR           = 6
const int    ARM_EXPIRY_LBO           = 8
const int    ARM_EXPIRY_LRT           = 4
const int    ARM_EXPIRY_SQZ           = 8
const int    SQZ_RELEASE_VALID_BARS   = 2
const int    SQZ_STOP_LOOKBACK        = 3
const float  RR_TARGET_1              = 1.50
const float  MIN_RISK_ATR             = 0.30
const bool   R8_ENABLED               = false
const string MIDDAY_POLICY            = "ALLOW"
const int    BLOCK_OPENING_MIN        = 15
const int    BLOCK_CLOSING_MIN        = 30
const bool   OBS_RECORD_RISK_REJECTED = true
const bool   TRUNCATION_INTENTIONAL   = false
const bool   ADX_ER_MODULES_ENABLED   = false
const int    MIN_SCORE_TO_TRADE       = 0

// CONSUMER STATEMENT (A21 disclosure). MIN_RISK_ATR is the R8 threshold and R8
// is disabled by R8_ENABLED = false, so MIN_RISK_ATR is declared and INERT at
// M4 — exactly the posture the inherited timing literals held at M0.
// ADX_ER_MODULES_ENABLED and MIN_SCORE_TO_TRADE are likewise declared and inert:
// no readiness, arm, trigger, Risk, quality, EQA or selection statement reads
// them. OBS_RECORD_RISK_REJECTED is realized structurally — §21.9 creates one
// raw Observation for every actual trigger before Risk is evaluated.

// --- 19.2a exact minute-of-day timing derived from the fixed constants -------
// Derived in MINUTES-SINCE-NY-MIDNIGHT, never by HHMM arithmetic: 1600 - 30 is
// 1570 in HHMM space and 15:30 only in minute space. RESEARCH_START_HHMM and
// OBSERVATION_CUTOFF_HHMM are activated here for the first time (A20 §2.2);
// EXPORT_DRAIN_END_HHMM remains INERT and is owned later by M6.
researchStartMin     = int(RESEARCH_START_HHMM / 100) * 60 + RESEARCH_START_HHMM % 100          // 09:30 -> 570
observationCutoffMin = int(OBSERVATION_CUTOFF_HHMM / 100) * 60 + OBSERVATION_CUTOFF_HHMM % 100  // 15:55 -> 955
firstFillMin         = 9 * 60 + 30 + BLOCK_OPENING_MIN                                          // 09:45 -> 585
lastFillCutoffMin    = 16 * 60 - BLOCK_CLOSING_MIN                                              // 15:30 -> 930

// --- 19.2b M4 code vocabularies ---------------------------------------------
// dirCode MUST be a nonnegative single digit: classCode is the POSITIONAL form
// family*1000 + dirCode*100 + efficiencyClass*10 + gapCode, and A20 §6.2 states
// the offline decode gapSigned = classCode%10-2. A signed -1 would destroy the
// thousands and hundreds positions. A20 does not state the digit, so the exact
// mapping below is declared, disclosed (A21 finding N-01) and used nowhere else.
const int DIRCODE_LONG  = 1
const int DIRCODE_SHORT = 2

const int EFF_EARLY     = 1
const int EFF_CONFIRMED = 2
const int EFF_EXTENDED  = 3
const int EFF_TOO_LATE  = 4

// rejectReason codes ARE the Frozen R-numbers. 0 means riskPass. R1/R2 are
// guard-reserved and unreachable, R3 never reaches a record, R11 does not exist.
const int RJ_NONE = 0
const int RJ_R4   = 4     // SESSION_BLOCKED
const int RJ_R5   = 5     // EVENT_DAY_BLOCK
const int RJ_R6   = 6     // TOO_LATE
const int RJ_R7   = 7     // RISK_TOO_WIDE
const int RJ_R8   = 8     // RISK_TOO_TIGHT — disabled by R8_ENABLED
const int RJ_R9   = 9     // NO_ROOM
const int RJ_R10  = 10    // STOP_UNDEFINED
const int RJ_R12  = 12    // STOP_TECHNICALLY_TOO_CLOSE
const int RJ_R13  = 13    // RVOL_NOT_READY

// Initial analytical flag bits (A20 §13.3). Bits 4-7 and 11 are M6 forward /
// outcome facts and are NEVER set here. No bit outside 0-13 exists.
const int FLG_VWAPCONF   = 1        // bit 0
const int FLG_DEEPRETEST = 2        // bit 1  — predicate issued by A23 R1
const int FLG_PRIORARM   = 4        // bit 2
const int FLG_SAMEBAR    = 8        // bit 3
const int FLG_TRUNCATED  = 256      // bit 8
const int FLG_ISEARLYCL  = 512      // bit 9
const int FLG_SESSEARLY  = 1024     // bit 10
const int FLG_GAPUNDEF   = 4096     // bit 12
const int FLG_FIRSTTOUCH = 8192     // bit 13

// Quality bits, Q1 at bit 0 through Q5 at bit 4 (A20 §11).
const int QB_Q1 = 1
const int QB_Q2 = 2
const int QB_Q3 = 4
const int QB_Q4 = 8
const int QB_Q5 = 16

// =============================================================================
// 19.3 SUPPLEMENTAL RTH ADX / ER REQUEST — Request 3 of 3          (A20 §3)
//     The ONLY new request in this child. It reuses the inherited canonical
//     rthTicker, timeframe.period, gaps_on and lookahead_off. It returns exactly
//     two series in the exact authorized order. The primary 20-element tuple at
//     §6.1 is byte-identical and unmoved; the confirmed-daily request at §6.2 is
//     byte-identical and unmoved.
//
//     ta.adx() is PROHIBITED. adxVal is the THIRD returned value of ta.dmi(14,14).
//     ER is the exact A20 formula. A zero or unavailable denominator is
//     mathematically undefined and yields na — the guard below states that
//     outcome explicitly instead of relying on an unverified platform
//     divide-by-zero convention. It is not an alternate formula.
// =============================================================================
adxErBundle() =>
    [_diPlus, _diMinus, adxV] = ta.dmi(14, 14)
    float erNum = math.abs(close - close[10])
    float erDen = math.sum(math.abs(close - close[1]), 10)
    float erV   = na(erDen) or erDen == 0 ? na : erNum / erDen
    [adxV, erV]

[adxVal, efficiencyRatio] = request.security(rthTicker, timeframe.period, adxErBundle(), gaps = barmerge.gaps_on, lookahead = barmerge.lookahead_off)

// request.*() budget: 3 of 40 (SSOT §4.7.1). No fourth request is authorised.
// adxVal and efficiencyRatio are copied into every raw Observation whenever
// mathematically available. They have ZERO consumers: no readiness term, no arm
// predicate, no trigger predicate, no Risk reason, no quality bit, no EQA input
// and no selection input reads either series anywhere in this source.

// =============================================================================
// 19.4 RAW OBSERVATION RECORD                                     (A20 §13.2)
//     One record has one identity. Every field is a SCALAR: no array, no Zone
//     handle and no Arm handle is stored, so no shared mutable handle can alias
//     analytical fields across records. M4 owns every analytical write below.
//     M5 may later write ONLY selectionStatus and arbitrationReason. M6 may
//     later write ONLY referenceRisk, refPrice, the MFE/MAE fields,
//     forwardBarsAvailable and the M6 forward flag bits 4-7 and 11.
// =============================================================================
type Obs
    // identity / context
    int   obsId                    = na
    int   obsBarTime               = na
    int   obsOrd                   = na
    int   slotIdx                  = na
    int   obsIndexInBar            = na
    int   family                   = 0
    int   direction                = 0
    int   dirCode                  = 0
    int   classCode                = na
    int   gapCode                  = na
    // Risk
    bool  riskPass                 = false
    int   rejectReason             = 0
    float plannedStop              = na
    float plannedRisk              = na
    float plannedTp1               = na
    float signalClose              = na
    float atrRefAtObs              = na
    float entryDistATR             = na
    float refLevel                 = na
    // zone / quality
    int   zoneIdMask               = 0
    int   confluence               = 0
    int   touchCount               = 0
    int   qFlagMask                = 0
    int   qApplicabilityMask       = 0
    int   vwapPriceTouchCount      = 0
    int   vwapZoneMotionTouchCount = 0
    // flags
    int   flagMask                 = 0
    // context values
    float relVol                   = na
    float relVolCum                = na
    float roc5                     = na
    float atrPct                   = na
    float atrRatio                 = na
    float adxVal                   = na
    float efficiencyRatio          = na
    // M5-owned future tags — initialized once to zero, never written by M4 again
    int   selectionStatus          = 0
    int   arbitrationReason        = 0
    // M6-owned future placeholders — initialized to na, never written by M4
    float referenceRisk            = na
    float refPrice                 = na
    float mfeUsd1                  = na
    float mfeUsd2                  = na
    float mfeUsd4                  = na
    float mfeUsd8                  = na
    float mfeUsd12                 = na
    float maeUsd1                  = na
    float maeUsd2                  = na
    float maeUsd4                  = na
    float maeUsd8                  = na
    float maeUsd12                 = na
    int   forwardBarsAvailable     = na
    // M6-owned INTERNAL queue / lifecycle state         (SAT06-A29 §3.3)
    // These six fields are queue / lifecycle state ONLY. They are NOT part of
    // the Frozen 38 exported record fields, are NOT new export titles and do
    // NOT alter stable identity. ONLY §24 writes them.
    // queueState's literal default 0 IS QUEUE_NOT_ADMITTED as declared at §24.3.
    // The literal is used here because Pine requires a constant to be declared
    // before its use as a field default, and the M6 vocabulary belongs with the
    // M6 module — every other default in this type is likewise a literal.
    // refCaptureDone is LOAD-BEARING: the first later same-session bar OWNS the
    // reference attempt even if its rthO is na, and a later bar may NEVER
    // silently substitute its own open as the reference.
    int   queueState               = 0      // 0 == QUEUE_NOT_ADMITTED (§24.3)
    int   readyAtOrd               = na
    int   forwardBarsSeen          = 0
    bool  refCaptureDone           = false
    float runningMfe               = na
    float runningMae               = na

// =============================================================================
// 19.5 M4 PERSISTENT STATE                                        (A20 §4.3)
//     The minimum state needed by the already-authorized semantics and nothing
//     else. There is NO global selected arm or setup, NO execution / position /
//     cooldown / quota state, NO second zone registry, NO second RVOL score, NO
//     expected manifest, NO PASS flag, NO export title, NO plot and NO unbounded
//     history store.
// =============================================================================
// M4 INIT_CONFIG boundary. Separate from the inherited §3 block so that no
// inherited executable line is touched. barstate.isfirst executes exactly once.
// WRITE SET AT THIS BOUNDARY: evDates — nothing else.
var array<int> evDates = array.new_int()
if barstate.isfirst                                    // [M4_INIT_CONFIG]
    string evClean = str.replace_all(eventDates, " ", "")
    if str.length(evClean) > 0
        array<string> evParts = str.split(evClean, ",")
        for i = 0 to array.size(evParts) - 1
            string ep = array.get(evParts, i)
            int    ev = na
            if str.length(ep) == 8
                float ey = str.tonumber(str.substring(ep, 0, 4))
                float em = str.tonumber(str.substring(ep, 4, 6))
                float ed = str.tonumber(str.substring(ep, 6, 8))
                if not na(ey) and not na(em) and not na(ed)
                    ev := int(ey) * 10000 + int(em) * 100 + int(ed)
            if not na(ev)
                array.push(evDates, ev)

// MR-M4-03 VWR requalification — separate per direction, same session only.
var bool vwrRequalLong  = false
var bool vwrRequalShort = false
var int  vwrAdvLong     = 0
var int  vwrAdvShort    = 0

// Last committed structural-bias mismatch CHART BAR INDEX per direction. Held in
// the same bar_index domain as the inherited Zone.acceptBar so LRT continuity is
// proved without a replay scan and without a second zone-history store.
var int lastBiasMismatchBarLong  = na
var int lastBiasMismatchBarShort = na

// Impulse custody. Expiry ordinal form, not a countdown: an event at ordinal e
// stays active for exactly impulseWindowBars committed RTH observations
// INCLUDING e, i.e. while currentOrdinal <= e + impulseWindowBars - 1.
var int  impulseDirState        = DIR_NEUTRAL
var int  impulseExpiryOrd       = na
var bool impulseExcessiveState  = false

// Session gap context, frozen on the first actual RTH commit of the session.
var float rthOpenToday         = na
var float atrRefAtSessionOpen  = na
var int   gapCodeSession       = 2      // neutral code until the session opens
var bool  gapUndefinedSession  = true

// Raw current-event Observation store and the bounded staging collection needed
// for canonical order and the deterministic upstream cap. Both are cleared at
// the start of EVERY confirmed bar, so no stale row can survive.
var array<Obs> rawObsSet = array.new<Obs>()
var array<Obs> stagedObs = array.new<Obs>()

// Owned at the creation boundary (A20 §4.3). These two are the ONLY cumulative
// M4 counters. M4 implements NO cumulative Funnel counter — that is M7.
var int truncatedObservationCountTotal   = 0
var int maxTruncatedObservationsOnAnyBar = 0

// =============================================================================
// 19.6 M4 PURE HELPERS — exact mutation-owner declaration
//      Every helper below is PURE: scalar or read-only-array in, scalar out.
//      None assigns a global and none mutates a caller-owned collection.
// =============================================================================
// PURE. Directional distance dir*(a-b). na in -> na out; dir 0 -> na.
dirDistOf(float a, float b, int dir) =>
    na(a) or na(b) or dir == 0 ? na : dir * (a - b)

// PURE. Adverse bar edge for a direction: LONG holds the low, SHORT the high.
advEdgeOf(int dir, float h, float l) =>
    dir == DIR_LONG ? l : dir == DIR_SHORT ? h : na

// PURE. Favourable bar edge for a direction.
favEdgeOf(int dir, float h, float l) =>
    dir == DIR_LONG ? h : dir == DIR_SHORT ? l : na

// PURE. Far zone edge in the direction of travel: LONG upper, SHORT lower.
// This is fixed by the inherited LBO break semantics, not chosen here.
zoneFarOf(int dir, float lo, float hi) =>
    dir == DIR_LONG ? hi : dir == DIR_SHORT ? lo : na

// PURE. Near zone edge: LONG lower, SHORT upper.
zoneNearOf(int dir, float lo, float hi) =>
    dir == DIR_LONG ? lo : dir == DIR_SHORT ? hi : na

// PURE. STRICT directional worst-of-two used inside STOP formulas only.
// na in -> na out, so an undefined stop reaches R10 instead of being widened,
// substituted or silently repaired.
dirWorstStrict(float a, float b, int dir) =>
    na(a) or na(b) or dir == 0 ? na : dir == DIR_LONG ? math.min(a, b) : math.max(a, b)

// PURE. TOLERANT directional accumulator used ONLY to extend an arm's own
// worstAdvEdge history across successive committed bars. It never appears in a
// stop formula and it never substitutes a missing current value with a default.
dirWorstAccum(float stored, float cur, int dir) =>
    na(cur) ? stored : na(stored) ? cur : dir == DIR_LONG ? math.min(stored, cur) : math.max(stored, cur)

// PURE. Directional close location. Zero range -> 0.0 (A20 §4.1).
closeLocOf(int dir, float h, float l, float c) =>
    na(h) or na(l) or na(c) or (h - l) <= 0 or dir == 0 ? 0.0 : dir == DIR_LONG ? (c - l) / (h - l) : (h - c) / (h - l)

// PURE. Positional direction digit for classCode.
dirCodeOf(int dir) =>
    dir == DIR_LONG ? DIRCODE_LONG : dir == DIR_SHORT ? DIRCODE_SHORT : 0

// PURE. Canonical within-bar family rank: LRT, VWR, LBO, SQZ (A20 §13.1).
famRankOf(int fam) =>
    fam == FAM_LRT ? 0 : fam == FAM_VWR ? 1 : fam == FAM_LBO ? 2 : 3

// PURE. First registry index carrying an exact mask, or -1. Reads the caller's
// array; mutates nothing.
zoneIdxOfMask(array<Zone> reg, int m) =>
    int r = -1
    if array.size(reg) > 0
        for i = 0 to array.size(reg) - 1
            if r == -1 and array.get(reg, i).mask == m
                r := i
    r

// PURE. First arm index carrying an exact real key, or -1. Reads only.
armIdxOfKey(array<Arm> st, int fam, int dir, int m) =>
    int r = -1
    if array.size(st) > 0
        for i = 0 to array.size(st) - 1
            Arm q = array.get(st, i)
            if r == -1 and q.family == fam and q.direction == dir and q.zoneIdMask == m
                r := i
    r

// PURE. A candidate whose mask contains ORH or ORL requires orReady (A20 §5.1).
// hasBit(16,4) and hasBit(16,8) are both false, so the fixed VWAP mask 16 is
// never an OR candidate.
orOkForMask(int m, bool orRdy) =>
    (not hasBit(m, BIT_ORH) and not hasBit(m, BIT_ORL)) or orRdy

// PURE. Absolute ms -> New York local minute of day.
nyMinOf(int ms) =>
    na(ms) ? na : hour(ms, TZ) * 60 + minute(ms, TZ)

// =============================================================================
// 20. M4 — DERIVED PER-BAR FACTS                                  (A20 §4.1)
//     UNCONDITIONAL GLOBAL SCOPE, exactly as §11 established for the M1 bound
//     series and for the same reason: a value assigned only inside an `if`
//     retains its last assigned value on bars where the condition is false, so
//     [1] would return a stale fact from an arbitrary earlier bar. Every fact
//     below is assigned on EVERY chart bar, so it is always the CURRENT bar's
//     fact or explicit na. There is no last-known substitution, no nz(), no
//     chart-session OHLC substitute and no hidden readiness gate.
//
//     COMMIT-ORDER POSITION: this section is placed AFTER §15 (M2 R2 swap) and
//     AFTER §17 (M3 read/calculate/write), so it IS commit-order step 4 of
//     A20 §7.1 — context derived after every inherited M0-M3 mutation site.
//     It writes NO persistent state and NO inherited fact.
// =============================================================================

// ---- 20.1 ordinal domain ----------------------------------------------------
// currentOrdinal is the inherited RTH-context bar index, which advances by
// exactly one per committed RTH bar. Arm windows use it and never use elapsed
// wall-clock time or queue order. The explicit cast states the integer domain
// rather than depending on an unverified tuple-element type.
int currentOrdinal = na(rthBarIndex) ? na : int(rthBarIndex)

// ---- 20.2 structural bias — completed RTH history only ----------------------
// Any required na makes it neutral. No partial or last-known bias exists.
int structBias = DIR_NEUTRAL
if (not na(rthC[1])) and (not na(htfEma[1])) and (not na(htfEma[4]))
    if rthC[1] > htfEma[1] and htfEma[1] > htfEma[4]
        structBias := DIR_LONG
    else if rthC[1] < htfEma[1] and htfEma[1] < htfEma[4]
        structBias := DIR_SHORT

// ---- 20.3 VWAP slope state --------------------------------------------------
// Mathematically unavailable -> na, which makes Q5 NON-APPLICABLE rather than
// FAILED and never suppresses an Observation.
float vwapSlopeRaw = (na(vwap[1]) or na(vwap[7]) or na(atrRef) or atrRef == 0) ? na : (vwap[1] - vwap[7]) / atrRef
int   vwapSlopeState = na
if not na(vwapSlopeRaw)
    vwapSlopeState := vwapSlopeRaw >= vwapSlopeMinATR ? DIR_LONG : vwapSlopeRaw <= -vwapSlopeMinATR ? DIR_SHORT : DIR_NEUTRAL

// ---- 20.4 bar geometry ------------------------------------------------------
int   bodyDir      = (na(rthC) or na(rthO)) ? na : rthC > rthO ? 1 : rthC < rthO ? -1 : 0
float barRangeRth  = (na(rthH) or na(rthL)) ? na : rthH - rthL
bool  zeroRangeBar = (not na(barRangeRth)) and barRangeRth == 0
// rthH == rthL sets bodyRatio to zero AND is an independent no-trigger term at
// §21.9, so a zero-range bar can never fire even if a threshold were relaxed.
float bodyRatio    = (na(barRangeRth) or barRangeRth <= 0 or na(rthC) or na(rthO)) ? 0.0 : math.abs(rthC - rthO) / barRangeRth

// True range from the CURRENT RTH OHLC and the PREVIOUS RTH close. STRICT: an
// unavailable previous RTH close yields na, which makes the impulse comparison
// false. No high-low fallback and no chart-session substitute is used.
float trueRangeRth = (na(rthH) or na(rthL) or na(rthC[1])) ? na : math.max(rthH - rthL, math.max(math.abs(rthH - rthC[1]), math.abs(rthL - rthC[1])))

// ---- 20.5 volatility context ------------------------------------------------
float atrPctVal   = (na(atrLive) or na(rthC) or rthC == 0) ? na : atrLive / rthC * 100
float atrRatioVal = (na(atrShort) or na(atrLong) or atrLong == 0) ? na : atrShort / atrLong

// ---- 20.6 squeeze state and the REAL release --------------------------------
// squeezeOn must be assigned unconditionally at global scope so that squeezeOn[1]
// is exactly the previous chart bar's state and never an arbitrary earlier one.
bool squeezeOn      = (not na(bbUp)) and (not na(kcUp)) and (not na(bbLo)) and (not na(kcLo)) and bbUp < kcUp and bbLo > kcLo
bool squeezeRelease = squeezeOn[1] and not squeezeOn

// ---- 20.7 MR-M4-01 VWAP / static confluence — no substitute allowed ---------
// vwapConfluence is true IFF at least one CURRENT zone in zoneReg overlaps the
// CURRENT VWAP interval, INCLUSIVELY. Every current static zone participates.
// PROHIBITED AND ABSENT: active-zone-only selection, anchor distance, ATR
// radius, mergeDistFrozen, extra tolerance, static/VWAP identity merging.
// Unavailable bounds cannot authenticate an overlap, so the result is false.
bool vwapConfluence = false
if (not na(vwapLower)) and (not na(vwapUpper)) and array.size(zoneReg) > 0
    for i = 0 to array.size(zoneReg) - 1
        Zone zc = array.get(zoneReg, i)
        if (not vwapConfluence) and (not na(zc.lower)) and (not na(zc.upper)) and vwapLower <= zc.upper and vwapUpper >= zc.lower
            vwapConfluence := true

// ---- 20.8 exact readiness (A20 §5.1) ----------------------------------------
// Missing RVOL, ROC, VWAP slope, ADX or ER NEVER appears in these terms and
// therefore never suppresses Observation creation.
bool sessionDataReady = actualRthBar and (not na(rthO)) and (not na(rthH)) and (not na(rthL)) and (not na(rthC)) and (not na(rthV)) and (not na(atrRef)) and (not na(atrLive)) and rthBarsAvailable >= 15
bool commonSetupReady = sessionDataReady and (not na(vwap)) and (not na(htfEma)) and rthBarsAvailable >= 64
// LBO / LRT core. The per-candidate ORH/ORL term is applied at the candidate
// site via orOkForMask(), because it depends on that candidate's own mask.
bool staticCoreReady  = commonSetupReady and array.size(zoneReg) > 0 and (not na(pdh)) and (not na(pdl))
bool sqzCoreReady     = staticCoreReady and (not na(bbMid)) and (not na(bbUp)) and (not na(bbLo)) and (not na(kcMid)) and (not na(kcUp)) and (not na(kcLo)) and rthBarsAvailable >= 21

// executionReady(f) = observationReady(f) and rvolSessionsReady and slotSamplesOk.
// Published as per-bar facts. RVOL owns ONLY Q1 applicability and the last Risk
// reason R13; it owns no readiness that could suppress a record.
bool rvolGateOk        = rvolSessionsReady and slotSamplesOk
bool executionReadyVWR = commonSetupReady and rvolGateOk
bool executionReadyLBO = staticCoreReady  and rvolGateOk
bool executionReadyLRT = staticCoreReady  and rvolGateOk
bool executionReadySQZ = sqzCoreReady     and rvolGateOk

// R3 is NOT a raw Observation. These are the per-bar blocked facts a later M7
// can count. No cumulative counter is created here.
bool r3BlockedVWR = actualRthBar and not commonSetupReady
bool r3BlockedLBO = actualRthBar and not staticCoreReady
bool r3BlockedLRT = actualRthBar and not staticCoreReady
bool r3BlockedSQZ = actualRthBar and not sqzCoreReady

// ---- 20.9 research acquisition window and R4 fill timing (A20 §5.2) ---------
// There is NO hidden 15:20 trigger cutoff. Acquisition runs through the 15:55
// bar-open inclusive; fill eligibility is a SEPARATE fact owned only by R4.
int  barOpenMin       = nyMinOf(rthTime)
int  nextFillMin      = nyMinOf(rthTimeClose)     // this bar's RTH close == next bar's open
bool inResearchWindow = actualRthBar and (not na(barOpenMin)) and barOpenMin >= researchStartMin and barOpenMin <= observationCutoffMin
bool fillEligible     = (not na(nextFillMin)) and nextFillMin >= firstFillMin and nextFillMin < lastFillCutoffMin
// MIDDAY_POLICY is fixed to ALLOW, so this term is a fixed false and creates no
// current R4 branch. It is written as a source-visible derivation rather than a
// hard-coded false so the constant has a stated consumer.
bool middayBlocked    = MIDDAY_POLICY != "ALLOW"

// ---- 20.10 per-bar published cohort facts ----------------------------------
// Declared WITHOUT var, so each resets on every chart bar. These expose the
// COMPLETE staged trigger/risk counts so a later M7 can own raw Funnel counters
// without reconstructing them from a truncated retained cohort.
int stagedTriggerCountThisBar     = 0
int stagedRiskPassCountThisBar    = 0
int stagedRiskRejectCountThisBar  = 0
int retainedObsCountThisBar       = 0
int truncatedObsCountThisBar      = 0
int r3BlockedCandidatesThisBar    = 0
bool rawObsSetClosed              = false

// =============================================================================
// 21. M4 — ORDERED PER-COMMIT PIPELINE
//     ONE block, so the A20 §7.1 commit order IS the literal source order:
//       21.1   1  clear the current raw / staging Observation cohort
//       21.2   2  not actualRthBar -> clear same-session custody, no Observation
//       21.3   3  newRthDay        -> reset custody, gap context, dir trackers
//       21.4   4  context derived after inherited M0-M3 mutations (impulse here,
//                 all non-persistent facts already derived at §20)
//       21.5   5  remove arms whose exact cancellation/expiry condition is true
//       21.6   6  update required VWR requalification progress
//       21.7   7  update existing LRT/SQZ arm history from THIS committed bar
//       21.8   8  create missing real arms, never replacing/extending a key
//       21.9   9  evaluate every active arm's actual trigger, stage every raw
//                 row, then impose canonical within-bar order
//       21.10 10  apply trigger-derived family state ONLY after set closure
//       21.11 11  deterministic upstream cap, then declare rawObsSet CLOSED
//
//     There is no second trigger pass, no R2 replay, no pre-R2 trigger
//     evaluation and no post-closure analytical rewrite.
//
//     BOUNDARIES USED (R3.6):
//       CONFIRMED_DIAG = barstate.isconfirmed and guardsPass   steps 1-2
//       COMMIT_DATA    = CONFIRMED_DIAG and actualRthBar       steps 3-11
//     Step 2 MUST observe bars where COMMIT_DATA is false — that is exactly the
//     session firewall — so CONFIRMED_DIAG is the correct outer boundary, in
//     the same posture §9.1 uses for F4.
// =============================================================================
if CONFIRMED_DIAG

    // ---- 21.1 step 1 — clear the cohort ------------------------ [CONFIRMED_DIAG]
    // WRITE SET: rawObsSet, stagedObs — nothing else. No stale row survives a bar.
    array.clear(rawObsSet)
    array.clear(stagedObs)

    // ---- 21.2 step 2 — non-actual RTH bar ---------------------- [CONFIRMED_DIAG]
    // Same-session arm, VWR and impulse custody is destroyed. No Observation is
    // created on this path by construction: steps 3-11 are all under COMMIT_DATA.
    if not actualRthBar
        array.clear(armStore)
        vwrRequalLong         := false
        vwrRequalShort        := false
        vwrAdvLong            := 0
        vwrAdvShort           := 0
        impulseDirState       := DIR_NEUTRAL
        impulseExpiryOrd      := na
        impulseExcessiveState := false

    if COMMIT_DATA

        // ---- 21.3 step 3 — newRthDay reset ---------------------- [COMMIT_DATA]
        // armStore is cleared here as an IDEMPOTENT restatement of the inherited
        // M2 §15.3 clear, which executes earlier on this same commit. Clearing an
        // already-empty array is provably zero-semantic-change and it makes the
        // M4 session firewall complete from M4's own source path.
        if newRthDay
            array.clear(armStore)
            vwrRequalLong            := false
            vwrRequalShort           := false
            vwrAdvLong               := 0
            vwrAdvShort              := 0
            impulseDirState          := DIR_NEUTRAL
            impulseExpiryOrd         := na
            impulseExcessiveState    := false
            lastBiasMismatchBarLong  := na
            lastBiasMismatchBarShort := na

            // Session gap context frozen on the FIRST actual RTH commit. The real
            // atrRef at session open is used, never atrLive and never a later
            // refreshed value. Gap class is DIAGNOSTIC ONLY: no trigger, Risk or
            // score consumer reads it. It reaches evidence only as the final
            // digit of classCode and through flag bit 12.
            rthOpenToday        := rthO
            atrRefAtSessionOpen := atrRef
            float gapAtrVal = (na(rthOpenToday) or na(pdc) or na(atrRefAtSessionOpen) or atrRefAtSessionOpen == 0) ? na : (rthOpenToday - pdc) / atrRefAtSessionOpen
            if na(gapAtrVal)
                gapCodeSession      := 2
                gapUndefinedSession := true
            else
                gapUndefinedSession := false
                gapCodeSession      := gapAtrVal <= -gapLargeATR ? 0 : gapAtrVal <= -gapSmallATR ? 1 : gapAtrVal < gapSmallATR ? 2 : gapAtrVal < gapLargeATR ? 3 : 4

        // ---- 21.4 step 4 — impulse custody (A20 §10) ------------ [COMMIT_DATA]
        // Impulse is context / arming METADATA. It is not a fifth family, not a
        // level, not a trigger, not a score point and not a persistent history
        // store. Its only effects are the EXTENDED minimum, the TOO_LATE override
        // and R6 — all applied AFTER the distance classification, and LRT is
        // exempt from the downgrade.
        bool impulseBarNow = (not na(trueRangeRth)) and (not na(atrRef)) and trueRangeRth > impulseATRmult * atrRef
        bool impulseExcNow = (not na(trueRangeRth)) and (not na(atrRef)) and trueRangeRth > impulseTooLateATR * atrRef
        if impulseBarNow
            impulseDirState       := na(bodyDir) ? DIR_NEUTRAL : bodyDir
            impulseExpiryOrd      := currentOrdinal + impulseWindowBars - 1
            impulseExcessiveState := impulseExcNow
        bool impulseActive = (not na(impulseExpiryOrd)) and (not na(currentOrdinal)) and currentOrdinal <= impulseExpiryOrd

        // ---- 21.5 step 5 — cancellation and expiry (A20 §7.2) --- [COMMIT_DATA]
        // armStore is rebuilt through a STABLE SNAPSHOT: nothing is removed while
        // the changing donor collection is being iterated. currentOrdinal ==
        // armExpiryBar is NOT expired — the expiry commit is included.
        // No cancellation field or counter is created; the inherited cancellation
        // vocabulary is preserved for later M7 accounting.
        float disarmDist  = disarmDistATR * atrRef
        float vwrLossDist = 2.0 * MAX_APPROACH_ATR * atrRef
        if array.size(armStore) > 0
            array<Arm> keptM4 = array.new<Arm>()
            for ai = 0 to array.size(armStore) - 1
                Arm a = array.get(armStore, ai)
                bool cancel = false

                // EXPIRED
                if na(a.armExpiryBar) or na(currentOrdinal) or currentOrdinal > a.armExpiryBar
                    cancel := true

                // CONTEXT_FLIP — a neutral bias is a mismatch for every arm
                if (not cancel) and structBias != a.direction
                    cancel := true

                // VWR location loss: still on the adverse side AND beyond twice
                // the approach distance, with no reclaim.
                if (not cancel) and a.family == FAM_VWR
                    float ddV = dirDistOf(rthC, vwap, a.direction)
                    float adV = (na(rthC) or na(vwap)) ? na : math.abs(rthC - vwap)
                    if (not na(ddV)) and (not na(adV)) and (not na(vwrLossDist)) and ddV <= 0 and adV > vwrLossDist
                        cancel := true

                // static LOCATION_LOST and the family-specific conditions
                if (not cancel) and a.family != FAM_VWR
                    int zi = zoneIdxOfMask(zoneReg, a.zoneIdMask)
                    if zi < 0
                        cancel := true                       // owning mask no longer exists
                    else
                        Zone zc2 = array.get(zoneReg, zi)
                        float dz = distToZone(rthC, zc2.lower, zc2.upper)
                        if na(dz) or na(disarmDist) or dz > disarmDist
                            cancel := true                   // location can no longer be authenticated
                        else
                            if a.family == FAM_LBO
                                int  needRole = a.direction == DIR_LONG ? ROLE_RESISTANCE : ROLE_SUPPORT
                                bool brokenD  = a.direction == DIR_LONG ? zc2.brokenLong : zc2.brokenShort
                                if zc2.structuralRole != needRole or brokenD
                                    cancel := true
                            if a.family == FAM_LRT
                                int  usedD  = a.direction == DIR_LONG ? zc2.retestUseLong : zc2.retestUseShort
                                bool winOver = na(zc2.acceptBar) or (bar_index - zc2.acceptBar) > RETEST_WINDOW_BARS
                                if zc2.acceptedDir != a.direction or winOver or usedD >= maxRetestsPerZone
                                    cancel := true
                            if a.family == FAM_SQZ
                                if (not na(a.squeezeReleaseOrd)) and squeezeOn
                                    cancel := true

                if not cancel
                    array.push(keptM4, a)
            armStore := keptM4

        // ---- 21.6 step 6 — VWR requalification progress (A20 §9)  [COMMIT_DATA]
        // Two adverse closes must be CONSECUTIVE. Equality at VWAP is ADVERSE.
        // A favourable close resets progress to zero. The second consecutive
        // adverse commit clears the requirement, and that clearing commit can
        // never itself be a favourable VWR trigger because it is adverse.
        // An undefined close/VWAP relation grants no progress and cannot clear.
        // No cumulative non-consecutive count, bypass, cross-direction sharing
        // or cross-session custody exists.
        if vwrRequalLong
            float ddL = dirDistOf(rthC, vwap, DIR_LONG)
            if na(ddL)
                vwrAdvLong := 0
            else if ddL <= 0
                vwrAdvLong += 1
                if vwrAdvLong >= 2
                    vwrRequalLong := false
                    vwrAdvLong    := 0
            else
                vwrAdvLong := 0
        if vwrRequalShort
            float ddS = dirDistOf(rthC, vwap, DIR_SHORT)
            if na(ddS)
                vwrAdvShort := 0
            else if ddS <= 0
                vwrAdvShort += 1
                if vwrAdvShort >= 2
                    vwrRequalShort := false
                    vwrAdvShort    := 0
            else
                vwrAdvShort := 0

        // ---- 21.6a structural-bias mismatch trackers ------------ [COMMIT_DATA]
        // Set on EVERY COMMIT_DATA in the inherited bar_index domain, so LRT bias
        // continuity is proved against Zone.acceptBar without any replay or
        // history scan. Only the NON-matching direction is stamped, so the armed
        // direction's tracker is never disturbed by the same commit that arms it.
        if structBias != DIR_LONG
            lastBiasMismatchBarLong := bar_index
        if structBias != DIR_SHORT
            lastBiasMismatchBarShort := bar_index

        // ---- 21.7 step 7 — LRT / SQZ arm history (A20 §7.4/§7.5)  [COMMIT_DATA]
        // Every arm still present here is ACTIVE, because step 5 already removed
        // the expired and cancelled ones. History is therefore only ever extended
        // from real committed bars inside the arm's OWN active window, against the
        // zone geometry PRESENT WHEN THE BAR IS CONSUMED. Nothing is replayed
        // against later R2 geometry and nothing is recomputed after R2.
        if array.size(armStore) > 0
            for ai = 0 to array.size(armStore) - 1
                Arm a = array.get(armStore, ai)
                if a.family == FAM_LRT
                    int zi = zoneIdxOfMask(zoneReg, a.zoneIdMask)
                    if zi >= 0
                        Zone zh = array.get(zoneReg, zi)
                        float aeH = advEdgeOf(a.direction, rthH, rthL)
                        // raw price extreme: LONG retains the lowest adverse edge,
                        // SHORT the highest. No ATR buffer is folded in here.
                        a.worstAdvEdge := dirWorstAccum(a.worstAdvEdge, aeH, a.direction)
                        float zfH = zoneFarOf(a.direction, zh.lower, zh.upper)
                        float fcH = dirDistOf(zfH, aeH, a.direction)
                        if (not na(fcH)) and fcH >= 0
                            a.farEdgeContactSeen := true
                // A real keyed release is written ONLY into real ACTIVE SQZ arm
                // keys. It is never a global flag and it can never revive or
                // extend an expired arm, because expired arms are already gone.
                if a.family == FAM_SQZ and squeezeRelease
                    a.squeezeReleaseOrd := currentOrdinal

        // ---- 21.8 step 8 — create missing real arms (A20 §7.3) -- [COMMIT_DATA]
        // At most ONE arm per key (family, direction, zoneIdMask). Recreating an
        // already-existing key is a NO-OP: armBar never slides, expiry is never
        // extended and history is never reset. Every arming predicate requires
        // structBias == dir, so the armed direction is exactly structBias and a
        // neutral bias arms nothing.
        int dirArm = structBias
        if dirArm != DIR_NEUTRAL
            float approachDist = MAX_APPROACH_ATR * atrRef
            float armRadiusM4  = armDistATR * atrRef

            // -- VWR, logical owner 16 -------------------------------------
            bool  requalNowArm = dirArm == DIR_LONG ? vwrRequalLong : vwrRequalShort
            float ddArmV = dirDistOf(rthC, vwap, dirArm)
            float adArmV = (na(rthC) or na(vwap)) ? na : math.abs(rthC - vwap)
            if (not requalNowArm) and (not na(ddArmV)) and (not na(adArmV)) and (not na(approachDist)) and ddArmV <= 0 and adArmV <= approachDist
                if armIdxOfKey(armStore, FAM_VWR, dirArm, BIT_VWAP) == -1
                    array.push(armStore, Arm.new(family = FAM_VWR, direction = dirArm, zoneIdMask = BIT_VWAP, armBar = currentOrdinal, armExpiryBar = currentOrdinal + ARM_EXPIRY_VWR, causalOwner = BIT_VWAP, farEdgeContactSeen = false, worstAdvEdge = na, squeezeReleaseOrd = na))

            // -- LBO, ONLY the current activeZoneIdx -----------------------
            // Barrier role is EXACT: LONG requires ROLE_RESISTANCE, SHORT requires
            // ROLE_SUPPORT.
            if not na(activeZoneIdx)
                Zone zb = array.get(zoneReg, activeZoneIdx)
                int   needRoleB = dirArm == DIR_LONG ? ROLE_RESISTANCE : ROLE_SUPPORT
                bool  brokenB   = dirArm == DIR_LONG ? zb.brokenLong : zb.brokenShort
                float dzB       = distToZone(rthC, zb.lower, zb.upper)
                float ddVwB     = dirDistOf(rthC, vwap, dirArm)
                if zb.structuralRole == needRoleB and (not brokenB) and (not na(dzB)) and (not na(armRadiusM4)) and dzB <= armRadiusM4 and (not na(ddVwB)) and ddVwB > 0 and orOkForMask(zb.mask, orReady)
                    if armIdxOfKey(armStore, FAM_LBO, dirArm, zb.mask) == -1
                        array.push(armStore, Arm.new(family = FAM_LBO, direction = dirArm, zoneIdMask = zb.mask, armBar = currentOrdinal, armExpiryBar = currentOrdinal + ARM_EXPIRY_LBO, causalOwner = zb.anchorBit, farEdgeContactSeen = false, worstAdvEdge = na, squeezeReleaseOrd = na))

            // -- LRT, EVERY qualifying current static zone -----------------
            // New arm history is initialized exactly as appropriate to its
            // CREATION BAR: the creation bar is inside the arm's own active
            // window, so its adverse edge and its far-edge contact against the
            // creation-bar geometry are the arm's first history facts.
            if array.size(zoneReg) > 0
                int lmmArm = dirArm == DIR_LONG ? lastBiasMismatchBarLong : lastBiasMismatchBarShort
                for zi = 0 to array.size(zoneReg) - 1
                    Zone zr = array.get(zoneReg, zi)
                    int  usedR  = dirArm == DIR_LONG ? zr.retestUseLong : zr.retestUseShort
                    bool inWinR = (not na(zr.acceptBar)) and (bar_index - zr.acceptBar) <= RETEST_WINDOW_BARS
                    bool interR = (not na(rthH)) and (not na(rthL)) and (not na(zr.lower)) and (not na(zr.upper)) and rthH >= zr.lower and rthL <= zr.upper
                    bool contR  = na(lmmArm) or ((not na(zr.acceptBar)) and lmmArm < zr.acceptBar)
                    if zr.acceptedDir == dirArm and inWinR and usedR < maxRetestsPerZone and interR and contR
                        if armIdxOfKey(armStore, FAM_LRT, dirArm, zr.mask) == -1
                            float ae0 = advEdgeOf(dirArm, rthH, rthL)
                            float zf0 = zoneFarOf(dirArm, zr.lower, zr.upper)
                            float fc0 = dirDistOf(zf0, ae0, dirArm)
                            array.push(armStore, Arm.new(family = FAM_LRT, direction = dirArm, zoneIdMask = zr.mask, armBar = currentOrdinal, armExpiryBar = currentOrdinal + ARM_EXPIRY_LRT, causalOwner = zr.anchorBit, farEdgeContactSeen = (not na(fc0)) and fc0 >= 0, worstAdvEdge = ae0, squeezeReleaseOrd = na))

            // -- SQZ, ONLY the current activeZoneIdx, on PRIOR squeeze -----
            // SAT06-A23 R2 restores the Frozen prior-state gate. The bar must
            // have been in squeeze on the PREVIOUS chart bar; the current bar's
            // squeeze state is not the gate. Consequences, all intended:
            //   · the first commit of a squeeze has squeezeOn[1] false and
            //     therefore arms nothing — the boundary does not expand;
            //   · a release commit r has squeezeOn[1] true, so a SQZ arm CAN be
            //     created on r and is born holding its OWN keyed release ordinal;
            //   · that new arm still cannot trigger on r, because armBar equals
            //     currentOrdinal and priorArm is strictly a.armBar < ordinal;
            //   · it may trigger on r+1 while active; r+2 is outside
            //     SQZ_RELEASE_VALID_BARS and is invalid.
            // Ownership, distance, unique key, expiry, mask and causal owner are
            // the existing current-bar values and are unchanged.
            if squeezeOn[1] and not na(activeZoneIdx)
                Zone zs = array.get(zoneReg, activeZoneIdx)
                float dzS = distToZone(rthC, zs.lower, zs.upper)
                if (not na(dzS)) and (not na(armRadiusM4)) and dzS <= armRadiusM4
                    if armIdxOfKey(armStore, FAM_SQZ, dirArm, zs.mask) == -1
                        array.push(armStore, Arm.new(family = FAM_SQZ, direction = dirArm, zoneIdMask = zs.mask, armBar = currentOrdinal, armExpiryBar = currentOrdinal + ARM_EXPIRY_SQZ, causalOwner = zs.anchorBit, farEdgeContactSeen = false, worstAdvEdge = na, squeezeReleaseOrd = squeezeRelease ? currentOrdinal : na))

        // ---- 21.9 step 9 — actual triggers and preliminary raw rows  [COMMIT_DATA]
        // Every actual trigger creates exactly ONE preliminary raw record, even
        // when Risk rejects it. Risk NEVER suppresses a record.
        if array.size(armStore) > 0
            for ai = 0 to array.size(armStore) - 1
                Arm a = array.get(armStore, ai)
                int  fam = a.family
                int  dir = a.direction
                bool priorArm = (not na(a.armBar)) and (not na(currentOrdinal)) and a.armBar < currentOrdinal

                // ---- family readiness for THIS EXACT candidate ----------
                bool fReady = false
                if fam == FAM_VWR
                    fReady := commonSetupReady
                else if fam == FAM_SQZ
                    fReady := sqzCoreReady and orOkForMask(a.zoneIdMask, orReady)
                else
                    fReady := staticCoreReady and orOkForMask(a.zoneIdMask, orReady)
                if not fReady
                    r3BlockedCandidatesThisBar += 1

                // ---- owning geometry, copied as SCALARS ----------------
                int   zIdx     = fam == FAM_VWR ? -1 : zoneIdxOfMask(zoneReg, a.zoneIdMask)
                bool  haveZone = zIdx >= 0
                float zLo      = na
                float zHi      = na
                float zAnchor  = na
                int   zConf    = 0
                int   zTouch   = 0
                int   zAccDir  = 0
                int   zAccBar  = na
                if haveZone
                    Zone zt = array.get(zoneReg, zIdx)
                    zLo     := zt.lower
                    zHi     := zt.upper
                    zAnchor := zt.anchorPrice
                    zConf   := zt.confluence
                    zTouch  := zt.touchCount
                    zAccDir := zt.acceptedDir
                    zAccBar := zt.acceptBar
                float zFar  = fam == FAM_VWR ? na : zoneFarOf(dir, zLo, zHi)
                float zNear = fam == FAM_VWR ? na : zoneNearOf(dir, zLo, zHi)

                // ---- entry reference and efficiency distance -----------
                float vRefLevel = na
                if fam == FAM_VWR
                    vRefLevel := vwap
                else if fam == FAM_SQZ
                    vRefLevel := zAnchor
                else
                    vRefLevel := zFar
                float vEntryDist = (na(atrRef) or atrRef == 0) ? na : dirDistOf(rthC, vRefLevel, dir) / atrRef
                float vCloseLoc  = closeLocOf(dir, rthH, rthL, rthC)

                // ---- the common predicate (A20 §8) --------------------
                // Zero-range bars never trigger, as an INDEPENDENT term.
                bool common = actualRthBar and fReady and inResearchWindow and structBias == dir and (not na(bodyDir)) and bodyDir == dir and (not zeroRangeBar) and bodyRatio >= bodyRatioMin and vCloseLoc >= closeLocMin and (not na(vEntryDist)) and vEntryDist <= maxTrigDistATR

                bool  trig  = false
                float pStop = na

                if common
                    if fam == FAM_VWR
                        float d0V = dirDistOf(rthC, vwap, dir)
                        float d1V = dirDistOf(rthC[1], vwap[1], dir)
                        bool  reqV = dir == DIR_LONG ? vwrRequalLong : vwrRequalShort
                        if priorArm and (not reqV) and (not na(d0V)) and (not na(d1V)) and d0V > 0 and d1V <= 0
                            trig := true
                            float aeC = advEdgeOf(dir, rthH, rthL)
                            float aeP = advEdgeOf(dir, rthH[1], rthL[1])
                            float wV  = dirWorstStrict(aeC, aeP, dir)
                            pStop := (na(wV) or na(atrLive)) ? na : wV - dir * stopBufATR * atrLive
                    else if fam == FAM_LBO
                        float d0B = dirDistOf(rthC, zFar, dir)
                        float d1B = dirDistOf(rthC[1], zFar, dir)
                        if haveZone and (not na(d0B)) and (not na(d1B)) and d0B > 0 and d1B <= 0
                            trig := true
                            pStop := (na(zNear) or na(atrLive)) ? na : zNear - dir * stopBufATR * atrLive
                    else if fam == FAM_LRT
                        float d0L   = dirDistOf(rthC, zFar, dir)
                        bool  accOk = haveZone and zAccDir == dir and (not na(zAccBar)) and (bar_index - zAccBar) <= RETEST_WINDOW_BARS
                        float aeL   = advEdgeOf(dir, rthH, rthL)
                        float fcL   = dirDistOf(zFar, aeL, dir)
                        bool  contactOk = a.farEdgeContactSeen or ((not na(fcL)) and fcL >= 0)
                        if priorArm and accOk and contactOk and (not na(d0L)) and d0L > 0
                            trig := true
                            // whole-donor worst adverse edge, never a blend
                            pStop := (na(a.worstAdvEdge) or na(atrLive)) ? na : a.worstAdvEdge - dir * stopBufATR * atrLive
                    else if fam == FAM_SQZ
                        float d0S = dirDistOf(rthC, bbMid, dir)
                        bool  relOk = (not na(a.squeezeReleaseOrd)) and (not na(currentOrdinal)) and currentOrdinal >= a.squeezeReleaseOrd and currentOrdinal <= a.squeezeReleaseOrd + SQZ_RELEASE_VALID_BARS - 1
                        if priorArm and relOk and (not na(d0S)) and d0S > 0
                            trig := true
                            // RTH series only over SQZ_STOP_LOOKBACK, no future or
                            // chart-session substitute
                            float lbS = na
                            if dir == DIR_LONG
                                lbS := (na(rthL) or na(rthL[1]) or na(rthL[2])) ? na : math.min(rthL, math.min(rthL[1], rthL[2]))
                            else
                                lbS := (na(rthH) or na(rthH[1]) or na(rthH[2])) ? na : math.max(rthH, math.max(rthH[1], rthH[2]))
                            float wS = dirWorstStrict(lbS, zNear, dir)
                            pStop := (na(wS) or na(atrLive)) ? na : wS - dir * stopBufATR * atrLive

                if trig
                    // ---- efficiency class, then the impulse override ---
                    int effCls = vEntryDist <= effEarlyMax ? EFF_EARLY : vEntryDist <= effConfirmedMax ? EFF_CONFIRMED : vEntryDist <= effExtendedMax ? EFF_EXTENDED : EFF_TOO_LATE
                    bool impSameDir = impulseActive and impulseDirState == dir and fam != FAM_LRT
                    if impSameDir and effCls < EFF_EXTENDED
                        effCls := EFF_EXTENDED
                    if impSameDir and impulseExcessiveState
                        effCls := EFF_TOO_LATE

                    // ---- exact Risk values (A20 §12) ------------------
                    float riskDistRaw = (na(pStop) or na(rthC)) ? na : math.abs(rthC - pStop)
                    float vPlannedRisk = riskDistRaw
                    float vPlannedTp1  = (na(rthC) or na(vPlannedRisk)) ? na : rthC + dir * RR_TARGET_1 * vPlannedRisk

                    // ---- opposing-zone room, current geometry only ----
                    // LONG takes the nearest qualifying zone ABOVE entryRef, SHORT
                    // the nearest BELOW. The record's own static zone is excluded;
                    // a zone already broken in the same direction is excluded. If
                    // none exists, room stays na and R9 does not fire.
                    float room = na
                    if array.size(zoneReg) > 0
                        for oi = 0 to array.size(zoneReg) - 1
                            Zone zo = array.get(zoneReg, oi)
                            bool sameOwn    = (fam != FAM_VWR) and zo.mask == a.zoneIdMask
                            bool brokenSame = dir == DIR_LONG ? zo.brokenLong : zo.brokenShort
                            if (not sameOwn) and (not brokenSame)
                                float znO = zoneNearOf(dir, zo.lower, zo.upper)
                                float rmO = dirDistOf(znO, rthC, dir)
                                if (not na(rmO)) and rmO > 0
                                    if na(room) or rmO < room
                                        room := rmO

                    // ---- ORDERED RISK, ONE OWNER, FIRST MATCH ---------
                    // R1 -> R2 -> R3 -> R4 -> R5 -> R10 -> R12 -> R7 -> R8 -> R6
                    //    -> R9 -> R13
                    // R1/R2 are guard-reserved and unreachable — M4 never emits
                    // them. R3 is owned by readiness BEFORE trigger evaluation and
                    // therefore creates no Observation. There is no R11 and no
                    // second rejection owner.
                    int rj = RJ_NONE
                    if rj == RJ_NONE and ((not fillEligible) or (not actualRthBar) or middayBlocked or sesIsEarlyCl)
                        rj := RJ_R4
                    if rj == RJ_NONE and (eventDayBlock or ((not na(curDate)) and array.indexof(evDates, curDate) >= 0))
                        rj := RJ_R5
                    if rj == RJ_NONE and na(pStop)
                        rj := RJ_R10
                    if rj == RJ_NONE and (not na(riskDistRaw)) and riskDistRaw < minTickMultiple * syminfo.mintick
                        rj := RJ_R12
                    if rj == RJ_NONE and (not na(riskDistRaw)) and (not na(atrLive)) and atrLive > 0 and riskDistRaw / atrLive > maxRiskATR
                        rj := RJ_R7
                    if rj == RJ_NONE and R8_ENABLED
                        rj := RJ_R8
                    if rj == RJ_NONE and (vEntryDist > effExtendedMax or (impulseActive and impulseDirState == dir and impulseExcessiveState and fam != FAM_LRT))
                        rj := RJ_R6
                    if rj == RJ_NONE and (not na(room)) and (not na(riskDistRaw)) and room < RR_TARGET_1 * riskDistRaw
                        rj := RJ_R9
                    if rj == RJ_NONE and not rvolGateOk
                        rj := RJ_R13

                    // ---- quality masks — DIAGNOSTIC ONLY (A20 §11) ----
                    // Applicability is SEPARATE from failure. No qScore, no
                    // applicable count, no normalized score, no tier and no gating
                    // result is created. ADX and ER are outside both masks.
                    int qFlag = 0
                    int qAppl = 0
                    if not na(relVol)
                        qAppl += QB_Q1
                        if relVol >= relVolStrong
                            qFlag += QB_Q1
                    if not na(roc5)
                        qAppl += QB_Q2
                        if math.sign(roc5) == dir and math.abs(roc5) >= rocMin
                            qFlag += QB_Q2
                    qAppl += QB_Q3
                    if fam == FAM_VWR
                        if vwapConfluence
                            qFlag += QB_Q3
                    else
                        if zConf >= 2
                            qFlag += QB_Q3
                    qAppl += QB_Q4
                    if fam == FAM_VWR
                        if vwapPriceTouchCount == 1
                            qFlag += QB_Q4
                    else
                        if zTouch == 1
                            qFlag += QB_Q4
                    if not na(vwapSlopeState)
                        qAppl += QB_Q5
                        if vwapSlopeState == dir
                            qFlag += QB_Q5

                    // ---- initial analytical flag bits (A20 §13.3) -----
                    // Bit 1 deepRetest: SAT06-A23 R1 issues the exact Frozen
                    // predicate that A20 named but never defined, closing A21
                    // finding F-01. It is LRT-ONLY: the adverse edge of THIS
                    // trigger commit must have reached the owning static zone's
                    // near edge in the direction of travel. Equality at zoneNear
                    // counts as reached. Current geometry only — never
                    // worstAdvEdge, never farEdgeContactSeen, never replayed
                    // geometry, never a stored selector, never an ATR tolerance.
                    // na directional distance leaves the bit unset.
                    // The bit is a RECORDED ATTRIBUTE ONLY. It does not
                    // participate in arming, the actual trigger predicate, Risk,
                    // quality, ordering, truncation or set closure.
                    // Bit 8 is added at §21.11 once truncation is known.
                    int fMask = 0
                    float deepDist = fam == FAM_LRT ? dirDistOf(zNear, advEdgeOf(dir, rthH, rthL), dir) : na
                    if (not na(deepDist)) and deepDist >= 0
                        fMask += FLG_DEEPRETEST
                    if vwapConfluence
                        fMask += FLG_VWAPCONF
                    if priorArm
                        fMask += FLG_PRIORARM
                    if not priorArm
                        fMask += FLG_SAMEBAR
                    if sesIsEarlyCl
                        fMask += FLG_ISEARLYCL
                        fMask += FLG_SESSEARLY
                    if gapUndefinedSession
                        fMask += FLG_GAPUNDEF
                    if firstBarTouch
                        fMask += FLG_FIRSTTOUCH

                    // ---- stage exactly one raw record -----------------
                    bool vRiskPass = rj == RJ_NONE
                    int vDirCode   = dirCodeOf(dir)
                    int vClassCode = fam * 1000 + vDirCode * 100 + effCls * 10 + gapCodeSession
                    int vMask      = fam == FAM_VWR ? BIT_VWAP : a.zoneIdMask
                    int vConf      = fam == FAM_VWR ? 1 : zConf
                    int vTouch     = fam == FAM_VWR ? vwapPriceTouchCount : zTouch
                    int vSlot      = slotIdx
                    int vTime      = rthTime
                    int vOrd       = currentOrdinal
                    float vRelVol  = relVol
                    float vRelCum  = relVolCum
                    float vRoc5    = roc5
                    float vAdx     = adxVal
                    float vEr      = efficiencyRatio
                    int vPTouch    = vwapPriceTouchCount
                    int vZTouch    = vwapZoneMotionTouchCount
                    array.push(stagedObs, Obs.new(obsBarTime = vTime, obsOrd = vOrd, slotIdx = vSlot, family = fam, direction = dir, dirCode = vDirCode, classCode = vClassCode, gapCode = gapCodeSession, riskPass = vRiskPass, rejectReason = rj, plannedStop = pStop, plannedRisk = vPlannedRisk, plannedTp1 = vPlannedTp1, signalClose = rthC, atrRefAtObs = atrRef, entryDistATR = vEntryDist, refLevel = vRefLevel, zoneIdMask = vMask, confluence = vConf, touchCount = vTouch, qFlagMask = qFlag, qApplicabilityMask = qAppl, vwapPriceTouchCount = vPTouch, vwapZoneMotionTouchCount = vZTouch, flagMask = fMask, relVol = vRelVol, relVolCum = vRelCum, roc5 = vRoc5, atrPct = atrPctVal, atrRatio = atrRatioVal, adxVal = vAdx, efficiencyRatio = vEr))

        // ---- 21.9a canonical within-bar order (A20 §13.1) ------- [COMMIT_DATA]
        // EXACT order: LRT ascending mask, then VWR mask 16, then LBO ascending
        // mask, then SQZ ascending mask. Imposed by an EXPLICIT total-order
        // selection sort on (familyRank, zoneIdMask, dirCode), so the result can
        // never depend on zoneReg storage order, armStore order or any library
        // sort's behaviour for equal keys. The dirCode term completes the total
        // order for a case that is structurally unreachable: the common predicate
        // requires structBias == dir, and structBias is a single value, so two
        // opposite-direction rows can never share one bar.
        int nStg = array.size(stagedObs)
        if nStg > 1
            for i = 0 to nStg - 2
                int bestS = i
                for j = i + 1 to nStg - 1
                    Obs oj = array.get(stagedObs, j)
                    Obs ob = array.get(stagedObs, bestS)
                    int rj2 = famRankOf(oj.family)
                    int rb2 = famRankOf(ob.family)
                    if rj2 < rb2 or (rj2 == rb2 and oj.zoneIdMask < ob.zoneIdMask) or (rj2 == rb2 and oj.zoneIdMask == ob.zoneIdMask and oj.dirCode < ob.dirCode)
                        bestS := j
                if bestS != i
                    Obs tmpO = array.get(stagedObs, i)
                    array.set(stagedObs, i, array.get(stagedObs, bestS))
                    array.set(stagedObs, bestS, tmpO)

        // ---- 21.10 step 10 — trigger-derived family state ------- [COMMIT_DATA]
        // Applied ONLY after the COMPLETE raw set is staged, so one trigger can
        // never suppress another arm before set closure. These effects occur for
        // an ACTUAL trigger regardless of the Risk result, and they are applied
        // over the complete staged cohort, before the evidence-retention cap.
        // No arm is consumed, globally selected or replaced.
        // WRITE SET INTO INHERITED STATE: Zone.brokenLong / Zone.brokenShort /
        // Zone.retestUseLong / Zone.retestUseShort — nothing else.
        if array.size(stagedObs) > 0
            for si = 0 to array.size(stagedObs) - 1
                Obs o = array.get(stagedObs, si)
                if o.family == FAM_VWR
                    if o.direction == DIR_LONG
                        vwrRequalLong := true
                        vwrAdvLong    := 0
                    else
                        vwrRequalShort := true
                        vwrAdvShort    := 0
                if o.family == FAM_LBO
                    int ziB = zoneIdxOfMask(zoneReg, o.zoneIdMask)
                    if ziB >= 0
                        Zone zbk = array.get(zoneReg, ziB)
                        if o.direction == DIR_LONG
                            zbk.brokenLong := true
                        else
                            zbk.brokenShort := true
                if o.family == FAM_LRT
                    int ziL = zoneIdxOfMask(zoneReg, o.zoneIdMask)
                    if ziL >= 0
                        Zone zrt = array.get(zoneReg, ziL)
                        if o.direction == DIR_LONG
                            zrt.retestUseLong += 1
                        else
                            zrt.retestUseShort += 1

        // ---- 21.11 step 11 — deterministic upstream cap and closure  [COMMIT_DATA]
        // The COMPLETE actual trigger set is evaluated and staged FIRST. Only then
        // is the cap applied, and it retains the FIRST N records in the canonical
        // order above. Queue arrival and capacity decide nothing.
        // WRITE SET INTO INHERITED STATE: exportCompleteFlag — nothing else.
        int stagedN   = array.size(stagedObs)
        int passN     = 0
        if stagedN > 0
            for i = 0 to stagedN - 1
                if array.get(stagedObs, i).riskPass
                    passN += 1
        int retainedN = stagedN > maxObservationsPerBar ? maxObservationsPerBar : stagedN
        int excessN   = stagedN - retainedN
        bool truncNow = excessN > 0
        if truncNow
            truncatedObservationCountTotal += excessN
            if excessN > maxTruncatedObservationsOnAnyBar
                maxTruncatedObservationsOnAnyBar := excessN
            // TRUNCATION_INTENTIONAL is false, so completeness is cleared. The
            // inherited latch is MONOTONIC and is never restored.
            if not TRUNCATION_INTENTIONAL
                exportCompleteFlag := 0
        if retainedN > 0
            for i = 0 to retainedN - 1
                Obs o = array.get(stagedObs, i)
                o.obsIndexInBar := i
                o.obsId         := cSessions * 100000 + slotIdx * 100 + i
                if truncNow
                    o.flagMask := o.flagMask + FLG_TRUNCATED
                array.push(rawObsSet, o)

        // Published per-bar cohort facts. The STAGED counts describe the complete
        // trigger set BEFORE the cap, so a later M7 owns raw Funnel counters
        // without reconstructing them from a truncated retained cohort. M4
        // implements no cumulative Funnel counter of its own.
        stagedTriggerCountThisBar    := stagedN
        stagedRiskPassCountThisBar   := passN
        stagedRiskRejectCountThisBar := stagedN - passN
        retainedObsCountThisBar      := retainedN
        truncatedObsCountThisBar     := excessN

        // The retained raw set is CLOSED. No arm, no global selection and no
        // execution state may suppress a retained record. M5, not M4, will later
        // tag this closed set.
        rawObsSetClosed := true

// =============================================================================
// 22. M5 — H19 SEMANTIC SEAM: CLOSED-SET SNAPSHOT AND TWO-FIELD TAGGING
//     (SAT06-A26 §3)
//
//     ONE additive block. It is placed AFTER §21 so the literal source order IS
//     the commit order:
//       construct -> canonical order -> family effects -> cap -> CLOSE -> tag
//     and it executes only where M4 has already CLOSED the retained raw set on
//     the SAME committed bar.
//
//     M5 OWNS EXACTLY TWO WRITE SITES IN THIS WHOLE SOURCE, both at §22.4:
//       Obs.selectionStatus
//       Obs.arbitrationReason
//     Nothing else is written. M5 adds NO input, request, count-producing call,
//     record field, exported global field, persistent state, numbered invariant,
//     diagnostic counter, Funnel counter, export call/title, queue, forward
//     field, order, position, cooldown or quota.
//
//     stagedObs is NOT the M5 input and is NEVER read here. The M5 input is the
//     CLOSED rawObsSet and nothing else.
//
//     M5 does NOT add, remove, replace, sort, suppress, duplicate or reorder a
//     rawObsSet row; does NOT read, clear, replace, select, consume or mutate
//     armStore or zoneReg; does NOT rerun readiness, trigger, Risk, quality,
//     truncation or family-state logic; and creates NO global selected arm or
//     setup and NO arbitration comparator. Every active-arm-derived Observation
//     therefore coexists through set closure — M5 cannot suppress one before a
//     comparison, and in Stage 6 the eligible execution set is empty so no
//     comparison is invoked at all.
// =============================================================================

// ---- 22.1 immutable Stage-6 execution boundary ------------------- (A26 §3.2)
// ONE auditable, NON-CONFIGURABLE source constant. It is NOT an input, NOT a
// default-with-override, NOT a range, NOT a mode and NOT a tuning surface, and
// it adds no state. Declared in exactly the posture the accepted parent already
// uses for R8_ENABLED and TRUNCATION_INTENTIONAL at §19.2, so the boundary has a
// stated source-visible consumer at §22.3 instead of a hard-coded answer.
//
// Because this boundary is an immutable false:
//   · the execution-eligible set is EMPTY before arbitration;
//   · NO selectedSetupId is produced or persisted;
//   · NO status 1 and NO status 3-7 path exists anywhere in this source;
//   · priorArmFlag stays analytical evidence only and cannot create status 7;
//   · position, cooldown, quota, order, trade and Stage-8 facts do not exist.
const bool STAGE6_EXECUTION_ENABLED = false

// ---- 22.2 Stage-6 selection code vocabulary ---------------------- (A26 §3.2)
// A26 §3.2 permits literal status constants OR source constants and states that
// neither choice may add state. These are compile-time consts with no storage,
// declared in the same form as the §19.2b RJ_* reject vocabulary. Only these two
// status values are producible by this source, so the truth table at §22.3 is
// closed by construction.
const int SEL_NOT_SELECTED  = 0     // NOT_SELECTED  — Risk rejected
const int SEL_EXEC_DISABLED = 2     // EXEC_DISABLED — Risk passed, exec disabled
const int ARB_NONE          = 0     // no arbitration was invoked

// M5 executes ONLY after rawObsSetClosed == true, on the SAME committed bar.
// rawObsSetClosed is the inherited per-bar (non-var) fact set at §21.11. It is
// READ here and never written. On any bar where the set was not closed, this
// entire block is inert and no row exists to tag.
if rawObsSetClosed

    // ---- 22.3 pass 1 — ONE coherent scalarized snapshot -------- (A26 §3.3)
    // Cardinality is snapshotted ONCE at M5 entry and BOTH passes use that one
    // value, so pass 2 runs over exactly the same cardinality as pass 1.
    //
    // The COMPLETE M5 per-row analytical read surface is exactly ONE scalar —
    // riskPass — and the whole surface is read into ephemeral local scalar
    // storage BEFORE the first tag write at §22.4. No Zone, Arm or Obs handle is
    // bound to a local here, stored, or handed to any helper as a mutable
    // analytical input; M5 declares no helper at all. No analytical field is
    // written even temporarily and there is NO mutate-then-restore path.
    //
    // The two tag arrays are declared WITHOUT var, so a fresh pair is created on
    // every invocation of this block. They are local ephemeral storage, never
    // persistent history and never a record field.
    int m5CohortN = array.size(rawObsSet)
    array<int> m5TagStatus = array.new_int(m5CohortN, SEL_NOT_SELECTED)
    array<int> m5TagReason = array.new_int(m5CohortN, ARB_NONE)

    // EMPTY-SET GUARD. An unguarded `for i = 0 to n - 1` with n == 0 becomes
    // `0 to -1`, which Pine executes DESCENDING and would manufacture iterations
    // against an empty set. Both passes carry this guard, so an empty cohort
    // runs no loop and no row is manufactured.
    if m5CohortN > 0
        for i = 0 to m5CohortN - 1
            // PURE SCALAR READ. The row handle is not bound to a local and does
            // not survive this expression. Same access shape the parent already
            // uses over stagedObs at §21.11.
            bool m5RiskPass = array.get(rawObsSet, i).riskPass

            // Execution eligibility BEFORE any arbitration. The boundary is an
            // immutable false, so this conjunction is false for EVERY row and
            // the eligible set is empty by construction. It is written as a
            // source-visible derivation rather than a hard-coded answer, so the
            // status below is produced BY the boundary and not by a constant
            // fixture — the same posture §20.9 uses for middayBlocked.
            bool m5Eligible = m5RiskPass and STAGE6_EXECUTION_ENABLED

            // A26 §3.4 truth table, applied UNCONDITIONALLY with respect to
            // execution eligibility:
            //   riskPass == false -> 0 / 0   NOT_SELECTED   (Risk rejected)
            //   riskPass == true  -> 2 / 0   EXEC_DISABLED
            // Only SEL_NOT_SELECTED and SEL_EXEC_DISABLED are producible, so
            // status 1 and statuses 3-7 are structurally unreachable. A row
            // rejected as R13 RVOL_NOT_READY takes the first line: it stays in
            // the cohort and is tagged 0 / 0. RVOL not-ready never suppresses a
            // raw Observation.
            int m5Status = (m5RiskPass and not m5Eligible) ? SEL_EXEC_DISABLED : SEL_NOT_SELECTED
            int m5Reason = ARB_NONE

            // Every index 0..m5CohortN-1 is written here unconditionally, so no
            // array.new_int initial value can ever reach an Observation.
            array.set(m5TagStatus, i, m5Status)
            array.set(m5TagReason, i, m5Reason)

    // ---- 22.4 pass 2 — the ONLY M5 write sites ----------------- (A26 §3.5)
    // Both tag fields are written EXPLICITLY for every closed row, including
    // Risk-rejected rows whose initialized values already happen to be 0 / 0.
    //
    // This pass is NOT conditioned on a nonempty eligible set. Conditioning it
    // that way is prohibited: it would leave every risk-passed row falsely at
    // status 0.
    //
    // WRITE SET: Obs.selectionStatus, Obs.arbitrationReason — nothing else. Row
    // identity, row order, cohort cardinality and every analytical, Risk,
    // quality, flag, context, forward, queue, arm, zone, session, RVOL,
    // truncation, Funnel and export field are untouched.
    if m5CohortN > 0
        for i = 0 to m5CohortN - 1
            Obs oTag = array.get(rawObsSet, i)
            oTag.selectionStatus   := array.get(m5TagStatus, i)
            oTag.arbitrationReason := array.get(m5TagReason, i)

// ---- 22.5 M6 seam — NOT IMPLEMENTED AND NOT CLAIMED --------------- (A26 §4)
// After §22.4 the FULLY TAGGED rawObsSet remains in place, at its M4 canonical
// order and its M4 cardinality, available to a LATER M6 admission block placed
// after this one. No pending/ready queue, shard, forward measurement, promotion,
// drain, FIFO, overflow or export custody exists in this source, and none is
// claimed.
//
// Derived Stage-6 consequences of the §22.1 immutable false, stated for the
// record ONLY — neither quantity is computed, counted, stored or exported here,
// because cumulative Funnel counting is M7:
//   candidatesCreated = count(riskPass and selectionStatus == 1) = 0
//   execNotSelected   = count(riskPass and selectionStatus == 2) = riskPassed
// Risk-rejected rows are NOT execNotSelected.

// =============================================================================
// 23. ARGUMENT-SHAPE AND INVENTORY LEDGER — M5
// =============================================================================
//  count-producing constructs in this source:
//    plot        : 1   (the inherited §18 structural placeholder, unchanged)
//    plotshape   : 0
//    plotchar    : 0
//    plotcandle  : 0
//    plotbar     : 0
//    plotarrow   : 0
//    fill        : 0
//    hline       : 0
//    bgcolor     : 0
//    barcolor    : 0
//    alertcondition : 0
//  ---------------------------------------------------------------------------
//  M5 candidate argument-shape count : 1
//  delta vs parent v0.5.1-M4R        : +0  (M5 adds no count-producing call)
//  Ratified platform budget          : 64
//  Mandatory export calls (M8)       : 52
//  Headroom after M5                 : 63
//
//  INPUT LEDGER      : 16 inherited + 22 M4 + 0 M5 = 38
//  REQUEST LEDGER    : 3 of 40
//    1  primary 20-element RTH bundle   §6.1  gaps_on   lookahead_off  UNCHANGED
//    2  confirmed daily PDH/PDL/PDC     §6.1  lookahead_on             UNCHANGED
//    3  supplemental RTH ADX/ER         §19.3 gaps_on   lookahead_off  NEW AT M4
//  RECORD FIELDS     : Obs 49 UNCHANGED · Arm 9 UNCHANGED · Zone UNCHANGED.
//                      M5 adds no record field and no exported global field.
//  PERSISTENT STATE  : M5 adds none. Its ONLY storage is the two non-var local
//                      int arrays recreated on every invocation at §22.3.
//  M5 WRITE SET      : Obs.selectionStatus and Obs.arbitrationReason at §22.4 —
//                      nothing else in this source.
//  EXPORT SURFACE    : none. M5 adds no export call, title, plot, drawing,
//                      table, alert or label.
// =============================================================================

// =============================================================================
// 24. M6 — FORWARD QUEUE, SHARD ROUTING, FORWARD OUTCOMES, PROMOTION,
//     OVERFLOW, FIFO AND DRAIN                              (SAT06-A29 §3-§7)
//
//     PLACEMENT. This block is placed AFTER the §22.4 M5 tag writes and AFTER
//     the §23 M5 historical ledger, and BEFORE the running §25 M6 ledger. That
//     is the same convention M5 used when it left the §18 M3 ledger frozen in
//     place and appended a NEW running ledger at the end: the LAST ledger in the
//     source is the running one, every earlier ledger is historical, and no
//     inherited comment is renumbered, rewritten or removed. §23 therefore
//     contains no executable line and the A29 §10.8 phase order below is the
//     literal source order.
//
//     ENTRY CONTRACT. M6 consumes the CLOSED and FULLY TAGGED rawObsSet. It
//     never re-runs readiness, arming, triggers, Risk, quality, truncation or
//     M5 tagging, never suppresses, reorders, duplicates or removes a raw
//     Observation from the cohort, and never re-reads the Observation bar as
//     forward data.
//
//     ADMISSION IS UNCONDITIONAL WITHIN THE SHARD. Risk-rejected status-0 rows
//     and risk-passed status-2 rows route identically (A29 §4.2). EQA and Risk
//     may not suppress Forward Queue custody. The ONLY reasons a row does not
//     enter this shard's queue are (a) its shard key is not this run's index —
//     in which case NOTHING happens to it here, it is neither dropped nor
//     counted — or (b) pending capacity is already exhausted, which is a LOUD
//     overflow that clears exportCompleteFlag.
//
//     M6 WRITE SET, WHOLE SOURCE:
//       Obs.queueState, Obs.readyAtOrd, Obs.forwardBarsSeen, Obs.refCaptureDone,
//       Obs.runningMfe, Obs.runningMae               (the six §19.4 M6 fields)
//       Obs.refPrice, Obs.referenceRisk, Obs.mfeUsd{1,2,4,8,12},
//       Obs.maeUsd{1,2,4,8,12}, Obs.forwardBarsAvailable, Obs.flagMask
//                                                    (the inherited M6 placeholders)
//       fwdQueue, droppedObservationCount, queueOverflowEvents   (M6 persistent)
//       exportCompleteFlag                           (CLEAR TO 0 ONLY, never restore)
//       pendingDepth, readyDepth, drainedObs, drainedThisBar     (nonpersistent)
//     Nothing else in this source is written by M6. No analytical field, no arm,
//     no zone, no session fact, no RVOL state, no truncation counter, no M5 tag,
//     no Funnel counter.
//
//     FIREWALL (A29 §8). No synthetic Observation, COUNT_ONLY mode, scenario
//     selector, fixture timestamp, Monday drain fixture, expected shard answer,
//     poison mode, run token, internal PASS oracle, evidence plot, manifest
//     reader, fourth request, alert, drawing, table, label or 53rd exported
//     field. No M7 Funnel/INV-7 counter, no M8 export call or title, no M9
//     validity helper, no strategy/order/position/cooldown/quota/trade state and
//     no Stage-8 mechanic.
// =============================================================================

// ---- 24.1 authorized M6 inputs (A29 §3.1) — exactly 2 -----------------------
// EXACT authorized defaults and bounds. No step, mode, clamp, modulo correction,
// alternate default/range, auto-sizing, COUNT_ONLY run, run token or optimizer.
// Group H is declared here for the same reason group F is declared at §16.2 and
// group G at §19.1: inherited input order is preserved and no earlier input site
// is disturbed. BOTH values bind exact source/config/run identity.
gShard = "H · M6 export shard (SAT06-A29 §3.1)"
exportShardCount = input.int(1, "exportShardCount", minval = 1, maxval = 8, group = gShard)
exportShardIndex = input.int(0, "exportShardIndex", minval = 0, maxval = 7, group = gShard)

// ---- 24.2 auditable config fact and first-bar loud guard (A29 §3.1) ---------
// UI bounds do NOT replace this source guard: an input can be supplied outside
// its UI range by a saved chart layout or a template, and the two ranges are
// independently satisfiable in a combination that is still invalid — e.g.
// count = 2 with index = 5 is inside both UI ranges and routes NOTHING. Loud
// failure, never a clamp and never a modulo correction: silently repairing the
// index would make a run claim shard coverage it does not have. Same posture the
// inherited rvolConfigOk guard uses at §16.3.
shardConfigOk = exportShardIndex < exportShardCount

if barstate.isfirst and not shardConfigOk
    runtime.error("⛔ SHARD CONFIG — exportShardIndex must be STRICTLY LESS THAN exportShardCount. Received exportShardIndex=" + str.tostring(exportShardIndex) + " and exportShardCount=" + str.tostring(exportShardCount) + ". Shard keys are shardSeed % exportShardCount and therefore occupy exactly 0.." + str.tostring(exportShardCount - 1) + ", so this index can never match a routed record and the run would export an empty shard while appearing healthy (SAT06-A29 §3.1). No clamp, modulo correction or auto-sizing is authorized.")

// ---- 24.3 non-configurable M6 source constants (A29 §3.2) -------------------
// Production form: const, NOT input. None of these is exposed as a tuning
// surface and none acquires an alternate value anywhere in this source.
const int PENDING_QUEUE_CAP = 160
const int READY_QUEUE_CAP   = 256
const int BUCKET_MS         = 300000
const int FWD_MAX_HORIZON   = 12

// Queue lifecycle vocabulary. Compile-time consts with no storage, declared in
// the same form as the §19.2b RJ_* reject vocabulary and the §22.2 SEL_* codes.
// QUEUE_NOT_ADMITTED is 0 and is the literal §19.4 default of Obs.queueState.
const int QUEUE_NOT_ADMITTED = 0
const int QUEUE_PENDING      = 1
const int QUEUE_READY        = 2
const int QUEUE_DRAINED      = 3
const int QUEUE_DROPPED      = 4

// M6 forward / outcome flag bits. Bits 4-7 and 11 are the ONLY bits this module
// may set. The inherited analytical bits 0-3, 8-10, 12 and 13 declared at §19.2b
// are NEVER cleared, recomputed or re-derived here.
const int FLG_REF_UNAVAILABLE = 16      // bit 4
const int FLG_REF_INVALID     = 32      // bit 5
const int FLG_GAP_STOP        = 64      // bit 6
const int FLG_GAP_TP1         = 128     // bit 7
const int FLG_AMBIGUOUS       = 2048    // bit 11

// ---- 24.3a inclusive drain minute derived from the inherited literal --------
// SINGLE TIME AUTHORITY. Derived in MINUTES-SINCE-NY-MIDNIGHT from the inherited
// §0.5 literal EXPORT_DRAIN_END_HHMM, exactly as §19.2a derives researchStartMin
// and observationCutoffMin from their own literals. EXPORT_DRAIN_END_HHMM was
// declared INERT at M0 and receives its FIRST behavioral consumer here.
//
// AUTHORITY-DISTINCT, NOT A DUPLICATE. observationCutoffMin also evaluates to
// 955, because OBSERVATION_CUTOFF_HHMM and EXPORT_DRAIN_END_HHMM currently carry
// the same literal. They are DIFFERENT authorities — acquisition cutoff versus
// export drain boundary — and the drain gate below reads ONLY this one. Reusing
// observationCutoffMin would silently bind drain behaviour to the acquisition
// authority. No input and no second time authority is created.
exportDrainEndMin = int(EXPORT_DRAIN_END_HHMM / 100) * 60 + EXPORT_DRAIN_END_HHMM % 100   // 15:55 -> 955

// ---- 24.4 PURE idempotent flag-set helper (A29 §3.2) -----------------------
// PURE — scalar in, scalar out. No global write, no caller-array mutation.
// Reuses the inherited §13.5 hasBit membership test, so an ALREADY-SET bit is
// returned UNCHANGED. Addition therefore happens at most once per bit and can
// never carry into a neighbouring bit. na mask, na bit or a non-positive bit
// returns the mask untouched rather than manufacturing a value.
flagSetOf(int mask, int bit) =>
    na(mask) or na(bit) or bit <= 0 ? mask : hasBit(mask, bit) ? mask : mask + bit

// ---- 24.5 M6 persistent state (A29 §3.4) -----------------------------------
// EXACTLY three persistent objects. ONE append-ordered queue store and the two
// cumulative overflow authorities. No second queue, no unbounded drained
// history, no diagnostic counter, no PASS flag, no expected manifest.
//
// BOUNDED BY CONSTRUCTION: a row is admitted only while PENDING depth < 160 and
// promoted only while READY depth < 256, and DROPPED rows are compacted out on
// the same commit, so array.size(fwdQueue) can never exceed 160 + 256 = 416.
var array<Obs> fwdQueue                 = array.new<Obs>()
var int        droppedObservationCount  = 0
var int        queueOverflowEvents      = 0

// ---- 24.6 nonpersistent published per-bar facts (A29 §3.4) ------------------
// Declared WITHOUT var, so every one of them resets on EVERY chart bar. The
// drained-record surface is the FUTURE M8 READ SEAM — it is not an export call,
// carries no title, and is na on every bar that drains nothing.
int  pendingDepth   = 0
int  readyDepth     = 0
Obs  drainedObs     = na
bool drainedThisBar = false

// =============================================================================
// 24.7 M6 — ORDERED PER-COMMIT PIPELINE
//      ONE block, so the A29 §10.8 phase order IS the literal source order:
//        24.7.1  ADMIT       shard-route the closed cohort, pending-cap boundary
//        24.7.2  FORWARD     strict later same-session measurement only
//        24.7.3  TERMINALIZE
//                / PROMOTE   in-place, creation order, ready-cap boundary
//        24.7.4  COMPACT     post-pass removal of DROPPED rows only
//        24.7.5  DRAIN       at most ONE READY FIFO head, through 15:55 inclusive
//
//      BOUNDARY USED: COMMIT_EXPORT, the inherited §7 gate
//        COMMIT_EXPORT = barstate.isconfirmed and actualRthBar and not isRepeatExecution
//
//      ADMISSION carries the ADDITIONAL inherited rawObsSetClosed condition.
//      That is the exact executable form of A29 §4.2 "after M5 has completed":
//      rawObsSetClosed is the same fact that gates the §22 M5 block, so binding
//      admission to it makes "the cohort is closed AND already tagged" a source
//      condition rather than an assumed ordering. It also closes a theoretical
//      double-admission path — COMMIT_EXPORT omits guardsPass while the §21.1
//      cohort clear runs under CONFIRMED_DIAG, which includes it — even though
//      that path is unreachable because a failed guard raises runtime.error on
//      barstate.isfirst. FORWARD, PROMOTE, COMPACT and DRAIN are deliberately
//      NOT gated on cohort closure: carried READY custody must drain on later
//      valid RTH bars whether or not this bar produced a cohort.
// =============================================================================
if COMMIT_EXPORT

    // ---- 24.7.1 phase 1 — ADMIT ------------------------------- [COMMIT_EXPORT]
    // WRITE SET: fwdQueue, droppedObservationCount, queueOverflowEvents,
    //            exportCompleteFlag (clear only), and the six M6 fields of an
    //            admitted row — nothing else.
    if rawObsSetClosed
        int m6CohortN = array.size(rawObsSet)

        // EMPTY-SET GUARD, the same posture §22.3 carries: an unguarded
        // `for i = 0 to n - 1` with n == 0 becomes `0 to -1`, which Pine
        // executes DESCENDING and would manufacture iterations against an
        // empty set.
        if m6CohortN > 0

            // EXACT PENDING DEPTH BEFORE ANY ADMISSION ON THIS BAR. Counted
            // once from the store, then advanced ONLY by successful admissions.
            // Nothing else in this phase changes PENDING membership, so the
            // running value is exact at every capacity test. It is deliberately
            // NEVER decremented by a promotion: promotion is phase 3, and A29
            // §4.2 forbids rescuing a capacity-rejected row because same-bar
            // promotion would free space later.
            int m6PendNow = 0
            int m6QN0     = array.size(fwdQueue)
            if m6QN0 > 0
                for qi = 0 to m6QN0 - 1
                    if array.get(fwdQueue, qi).queueState == QUEUE_PENDING
                        m6PendNow += 1

            // Traverse the CURRENT rawObsSet in its EXISTING canonical
            // Observation order (§21.9a). No re-sort, no re-rank, no selection.
            for i = 0 to m6CohortN - 1
                Obs oA = array.get(rawObsSet, i)

                // ---- 24.7.1a exact shard routing (A29 §4.1) ----------------
                // The EXTERNALLY REVERSIBLE stable key is
                //   (syminfo.tickerid, obsBarTime, family, dirCode, zoneIdMask)
                // and NO new stable-key field is stored or exported. obsId is
                // run-local ordering identity ONLY and never enters shard math;
                // neither does sessionSeq, a range start, an array index, a
                // fixture value or an expected route.
                //
                // Integral arithmetic BEFORE the modulus, with EXPLICIT positive
                // truncation. obsBarTime is a positive absolute-ms bar-open
                // stamp, so int() truncation toward zero IS floor here. A 5-min
                // bar open divides BUCKET_MS exactly, so the bucket carries no
                // truncation ambiguity.
                //
                // POSITIONAL SOUNDNESS: family occupies {1..4}, dirCode {1,2}
                // and zoneIdMask {1..15} for static families plus the fixed
                // BIT_VWAP = 16, so every term stays inside its own decimal
                // field and no term can bleed into another.
                int m6Bucket    = int(oA.obsBarTime / BUCKET_MS)
                int m6ShardSeed = m6Bucket * 10000 + oA.family * 1000 + oA.dirCode * 100 + oA.zoneIdMask
                int m6ShardKey  = m6ShardSeed % exportShardCount

                // A NONMATCHING ROW IS NOT A DROP. It is routed to another shard
                // run and must produce NO admission, NO capacity consumption, NO
                // drop/overflow counter, NO FIFO participation and NO write of
                // any kind here. The absence of an else branch IS that contract.
                if m6ShardKey == exportShardIndex

                    // ---- 24.7.1b pending-cap boundary (A29 §4.2) ------------
                    // Capacity is assessed IMMEDIATELY, before any same-bar
                    // promotion. At cap the NEWEST attempted row is rejected —
                    // never an already-admitted earlier row — and BOTH cumulative
                    // authorities increment ONCE for the one attempt.
                    if m6PendNow >= PENDING_QUEUE_CAP
                        droppedObservationCount += 1
                        queueOverflowEvents     += 1
                        // The inherited latch is MONOTONIC. M6 CLEARS it and
                        // never restores it to 1.
                        exportCompleteFlag      := 0
                    else
                        // ---- 24.7.1c exact admission values (A29 §4.2) ------
                        // sessionLastSlot is taken from the inherited session
                        // classification. FULLLAST is NEVER substituted for a
                        // configured early close and no final slot is ever
                        // inferred retrospectively from an unexplained absence.
                        //
                        // The terminal slot is expressed as an explicit ternary
                        // rather than math.min so the integer domain is stated in
                        // source, the same posture §21.11 uses for retainedN.
                        int m6SessionLastSlot = sesIsEarlyCl ? ECLAST : FULLLAST
                        int m6HorizonSlot     = oA.slotIdx + FWD_MAX_HORIZON
                        int m6TerminalSlot    = m6HorizonSlot < m6SessionLastSlot ? m6HorizonSlot : m6SessionLastSlot
                        int m6FwdCapacity     = m6TerminalSlot - oA.slotIdx

                        // TRANSFER BY HANDLE. M5 is the final analytical writer
                        // and M6 is the sole post-tag owner, so the exact tagged
                        // record object is carried intact — no blend, no default
                        // substitution, no field loss and no partial copy. After
                        // this push no later mutation through rawObsSet is
                        // authorized, and §21.1 clearing rawObsSet next bar does
                        // NOT destroy the object: fwdQueue holds the reference.
                        oA.queueState      := QUEUE_PENDING
                        oA.readyAtOrd      := oA.obsOrd + m6FwdCapacity
                        oA.forwardBarsSeen := 0
                        oA.refCaptureDone  := false
                        oA.runningMfe      := na
                        oA.runningMae      := na
                        array.push(fwdQueue, oA)
                        m6PendNow += 1

    // ---- 24.7.2 phase 2 — FORWARD MEASUREMENT ----------------- [COMMIT_EXPORT]
    // STRICT OWNERSHIP AND AGE GATE (A29 §5.1). All four conditions required:
    //   queueState == QUEUE_PENDING
    //   current NY session date == NY date of obsBarTime
    //   currentOrdinal > obsOrd
    //   rthTime      > obsBarTime
    // The Observation bar itself is therefore NEVER forward-readable: a row
    // admitted on this bar has obsOrd == currentOrdinal, so the age term is
    // false and it consumes none of its own open or range. READY, DRAINED,
    // DROPPED and prior-session PENDING rows receive NO later forward write; a
    // prior-session PENDING row stranded by invalid or incomplete data stays
    // pending and invalidates terminal completeness — a later session may not
    // mature, extend, backfill or repair it.
    //
    // Only the canonical same-timeframe RTH rthO/rthH/rthL are read. No
    // chart-session OHLC, no next-day open, no after-hours data, no fourth
    // request.
    //
    // WRITE SET: refCaptureDone, refPrice, referenceRisk, flagMask bits 5/6/7
    //            and 11, forwardBarsSeen, runningMfe, runningMae, and the
    //            mfeUsd/maeUsd horizons — nothing else.
    int m6FwdN = array.size(fwdQueue)
    if m6FwdN > 0
        for i = 0 to m6FwdN - 1
            Obs oF = array.get(fwdQueue, i)
            if oF.queueState == QUEUE_PENDING
                bool fSameSess = (not na(curDate)) and (not na(oF.obsBarTime)) and curDate == dnumFromMs(oF.obsBarTime)
                bool fAgeOk    = (not na(currentOrdinal)) and (not na(oF.obsOrd)) and currentOrdinal > oF.obsOrd
                bool fTimeOk   = (not na(rthTime)) and (not na(oF.obsBarTime)) and rthTime > oF.obsBarTime
                if fSameSess and fAgeOk and fTimeOk

                    // ---- 24.7.2a first later same-session bar (A29 §5.2) ----
                    // refCaptureDone is LOAD-BEARING: this bar OWNS the
                    // reference attempt even if its rthO is na. A later bar may
                    // NEVER silently substitute its open. There is no fallback
                    // to signal close, to a last-known price and no zero.
                    if not oF.refCaptureDone
                        oF.refCaptureDone := true
                        oF.refPrice       := rthO
                        oF.referenceRisk  := (not na(rthO)) and (not na(oF.plannedStop)) ? math.abs(rthO - oF.plannedStop) : na

                        // dirDistOf(a, b, dir) is the inherited PURE
                        // dir * (a - b): na in -> na out, dir 0 -> na. Each
                        // predicate therefore requires ALL operands non-na by
                        // construction, with no na substitution anywhere.
                        float fdStop = dirDistOf(oF.refPrice, oF.plannedStop, oF.direction)
                        float fdTp1  = dirDistOf(oF.refPrice, oF.plannedTp1,  oF.direction)

                        bool fGapStop = (not na(fdStop)) and fdStop <= 0
                        bool fGapTp1  = (not na(fdTp1))  and fdTp1  >= 0

                        // referenceRisk == na ALONE does NOT invent bit 5. The
                        // existing Risk / reject fields retain ownership of an
                        // undefined planned stop (RJ_R10 STOP_UNDEFINED).
                        bool fRefInvalid = fGapStop or ((not na(oF.referenceRisk)) and oF.referenceRisk < minTickMultiple * syminfo.mintick)

                        if fGapStop
                            oF.flagMask := flagSetOf(oF.flagMask, FLG_GAP_STOP)
                        if fGapTp1
                            oF.flagMask := flagSetOf(oF.flagMask, FLG_GAP_TP1)
                        if fRefInvalid
                            oF.flagMask := flagSetOf(oF.flagMask, FLG_REF_INVALID)

                    // ---- 24.7.2b incremental MFE/MAE (A29 §5.3) -------------
                    // EVERY strict later same-session bar, INCLUDING the
                    // reference bar itself, increments forwardBarsSeen exactly
                    // once. The increment is unconditional within this gate and
                    // is not suppressed by an na reference: the horizon count
                    // describes bars OWNED, not bars that happened to measure.
                    oF.forwardBarsSeen := oF.forwardBarsSeen + 1

                    // Favourable edge is LONG high / SHORT low. Adverse edge is
                    // LONG low / SHORT high. Both come from the inherited PURE
                    // §19.6 helpers, so the direction mapping is not restated.
                    float fFavE = favEdgeOf(oF.direction, rthH, rthL)
                    float fAdvE = advEdgeOf(oF.direction, rthH, rthL)
                    float fBarMfe = dirDistOf(fFavE, oF.refPrice, oF.direction)
                    float fBarMae = dirDistOf(oF.refPrice, fAdvE, oF.direction)

                    // Running maxima over EVERY AVAILABLE bar value seen so far.
                    // An unavailable (na) bar value is SKIPPED, never substituted
                    // with zero, with the previous value or with a default.
                    if not na(fBarMfe)
                        oF.runningMfe := (na(oF.runningMfe) or fBarMfe > oF.runningMfe) ? fBarMfe : oF.runningMfe
                    if not na(fBarMae)
                        oF.runningMae := (na(oF.runningMae) or fBarMae > oF.runningMae) ? fBarMae : oF.runningMae

                    // Horizon writes at EXACTLY 1, 2, 4, 8 and 12 owned forward
                    // bars. forwardBarsSeen can never exceed fwdCapacity, which
                    // is capped at FWD_MAX_HORIZON = 12 by §24.7.1c, so no
                    // horizon beyond 12 exists to write. Horizons never reached
                    // remain na. Dollar MFE/MAE stays VALID even when bit 5
                    // refInvalid is set — an invalid reference risk does not
                    // invalidate a measured dollar excursion.
                    if oF.forwardBarsSeen == 1
                        oF.mfeUsd1  := oF.runningMfe
                        oF.maeUsd1  := oF.runningMae
                    if oF.forwardBarsSeen == 2
                        oF.mfeUsd2  := oF.runningMfe
                        oF.maeUsd2  := oF.runningMae
                    if oF.forwardBarsSeen == 4
                        oF.mfeUsd4  := oF.runningMfe
                        oF.maeUsd4  := oF.runningMae
                    if oF.forwardBarsSeen == 8
                        oF.mfeUsd8  := oF.runningMfe
                        oF.maeUsd8  := oF.runningMae
                    if oF.forwardBarsSeen == 12
                        oF.mfeUsd12 := oF.runningMfe
                        oF.maeUsd12 := oF.runningMae

                    // ---- 24.7.2c neutral ambiguity attribute (A29 §5.3) -----
                    // Both planned levels inside the INCLUSIVE [rthL, rthH]
                    // range on this forward bar means bar-internal path order is
                    // unknowable at this timeframe. Recorded ONCE via the
                    // idempotent setter. It changes NO MFE/MAE value, NO Risk
                    // field, NO lifecycle transition and NO drain result, and it
                    // creates no counter and no export field.
                    bool fAmbiguous = (not na(oF.plannedStop)) and (not na(oF.plannedTp1)) and (not na(rthL)) and (not na(rthH)) and oF.plannedStop >= rthL and oF.plannedStop <= rthH and oF.plannedTp1 >= rthL and oF.plannedTp1 <= rthH
                    if fAmbiguous
                        oF.flagMask := flagSetOf(oF.flagMask, FLG_AMBIGUOUS)

    // ---- 24.7.3 phase 3 — TERMINALIZE / PROMOTE --------------- [COMMIT_EXPORT]
    // The scan walks the append-ordered store in CREATION order. Append order IS
    // obsId order: §21.11 assigns obsId = cSessions*100000 + slotIdx*100 + i, and
    // admission pushes rows in cohort order, bar by bar, so index ascending is
    // obsId ascending for every row in this store.
    //
    // NO array removal, insertion, sorting or index-changing mutation happens
    // ANYWHERE in this scan. Promotion is strictly IN PLACE. Because the scan is
    // in creation order, EARLIER records win scarce READY capacity.
    //
    // WRITE SET: queueState, forwardBarsAvailable, flagMask bit 4, refPrice,
    //            referenceRisk, the ten MFE/MAE horizons (zero-horizon contract
    //            only), droppedObservationCount, queueOverflowEvents,
    //            exportCompleteFlag (clear only) — nothing else.
    int m6PromN = array.size(fwdQueue)
    if m6PromN > 0

        // EXACT READY DEPTH BEFORE ANY PROMOTION ON THIS BAR, then advanced only
        // by successful promotions. Nothing else in this phase changes READY
        // membership — the single drain is phase 5 — so the running value is
        // exact at every capacity test.
        int m6ReadyNow = 0
        for i = 0 to m6PromN - 1
            if array.get(fwdQueue, i).queueState == QUEUE_READY
                m6ReadyNow += 1

        for i = 0 to m6PromN - 1
            Obs oP = array.get(fwdQueue, i)
            if oP.queueState == QUEUE_PENDING

                // ---- 24.7.3a exact terminal predicate (A29 §6.1) -----------
                // The STORED readyAtOrd is compared with the CURRENT commit
                // ordinal — never with the record's own immutable creation
                // ordinal used as if it were a current value. Same-session
                // ownership is required, so a carried prior-session PENDING row
                // can never terminalize on a later session even though
                // currentOrdinal is globally monotonic and has long passed its
                // readyAtOrd.
                bool pSameSess = (not na(curDate)) and (not na(oP.obsBarTime)) and curDate == dnumFromMs(oP.obsBarTime)
                bool pTerminal = pSameSess and (not na(oP.readyAtOrd)) and (not na(currentOrdinal)) and oP.readyAtOrd <= currentOrdinal

                if pTerminal

                    // ---- 24.7.3b zero-horizon final-slot contract (A29 §6.2)
                    // readyAtOrd == obsOrd means fwdCapacity was 0: the row was
                    // created ON the session's final slot — 77 of a normal
                    // session or 41 of an ACCEPTED CONFIGURED early close — and
                    // is terminally determinable in its CREATION commit even
                    // though strict forward age is false for it.
                    //
                    // It reads NO Observation-bar price as forward data and NO
                    // next-session open. The five explicit na writes below are
                    // provable NO-OPS — the strict forward gate never fired for
                    // this row, so nothing could have written them — and exist
                    // so the A29 §6.2 contract is source-visible rather than
                    // inferred from an absence.
                    if oP.readyAtOrd == oP.obsOrd
                        oP.forwardBarsAvailable := 0
                        oP.flagMask      := flagSetOf(oP.flagMask, FLG_REF_UNAVAILABLE)
                        oP.refPrice      := na
                        oP.referenceRisk := na
                        oP.mfeUsd1       := na
                        oP.mfeUsd2       := na
                        oP.mfeUsd4       := na
                        oP.mfeUsd8       := na
                        oP.mfeUsd12      := na
                        oP.maeUsd1       := na
                        oP.maeUsd2       := na
                        oP.maeUsd4       := na
                        oP.maeUsd8       := na
                        oP.maeUsd12      := na
                    else
                        // ORDINARY TERMINAL ROW. Every not-yet-reached horizon
                        // is left na. Forward fields are never reassigned after
                        // the row leaves PENDING, and the state transition below
                        // is what makes that structural.
                        oP.forwardBarsAvailable := oP.forwardBarsSeen

                    // ---- 24.7.3c ready-cap boundary (A29 §6.3) -------------
                    // At cap the NEWEST terminal promotion attempt is rejected —
                    // never an earlier already-READY row — and BOTH cumulative
                    // authorities increment ONCE. Earlier order is preserved
                    // because the rejection touches only this row's state.
                    if m6ReadyNow < READY_QUEUE_CAP
                        oP.queueState := QUEUE_READY
                        m6ReadyNow    += 1
                    else
                        oP.queueState            := QUEUE_DROPPED
                        droppedObservationCount  += 1
                        queueOverflowEvents      += 1
                        exportCompleteFlag       := 0

    // ---- 24.7.4 phase 4 — DROP COMPACTION --------------------- [COMMIT_EXPORT]
    // A SEPARATE POST-PASS, deliberately NOT part of the §24.7.3 promotion scan.
    // ONLY QUEUE_DROPPED rows are removed and the relative order of every
    // remaining row is preserved. The traversal is DESCENDING, so a removal can
    // never shift an unvisited index and can never skip another eligible record
    // — the exact failure an ascending removal would produce.
    //
    // The `> 0` guard is load-bearing: with an empty store `for i = -1 to 0`
    // would count UP and index -1.
    //
    // WRITE SET: fwdQueue membership — nothing else. No field of any surviving
    //            row is touched.
    int m6CompN = array.size(fwdQueue)
    if m6CompN > 0
        for i = m6CompN - 1 to 0
            if array.get(fwdQueue, i).queueState == QUEUE_DROPPED
                array.remove(fwdQueue, i)

    // ---- 24.7.5 phase 5 — DRAIN ------------------------------- [COMMIT_EXPORT]
    // Runs AFTER all admissions, forward updates, promotions and drop
    // compaction. The window is COMMIT_EXPORT and barOpenMin <= 15:55 INCLUSIVE,
    // read from the single §24.3a drain authority.
    //
    // An older PENDING row does NOT block a younger READY row: the head search
    // skips every non-READY state. Among READY rows the OLDEST creation/obsId
    // row is the sole FIFO head, and CSV physical position is not an identity
    // authority. A final-slot zero-horizon row receives NO special priority and
    // NO categorical same-commit ban — it drains in its creation commit only if
    // it is the ordinary FIFO head after all promotions.
    //
    // EXACTLY ONE row per commit. Pine has no break statement, so the head is
    // found with the inherited sentinel idiom: §15.5 uses the identical `== -1`
    // guard shape in its R2 re-key search.
    //
    // WRITE SET: queueState of the drained row, fwdQueue membership, drainedObs,
    //            drainedThisBar — nothing else.
    if (not na(barOpenMin)) and barOpenMin <= exportDrainEndMin
        int m6DrainN = array.size(fwdQueue)
        int m6HeadIdx = -1
        if m6DrainN > 0
            for i = 0 to m6DrainN - 1
                if m6HeadIdx == -1 and array.get(fwdQueue, i).queueState == QUEUE_READY
                    m6HeadIdx := i
        if m6HeadIdx >= 0
            Obs oD = array.get(fwdQueue, m6HeadIdx)
            oD.queueState  := QUEUE_DRAINED
            drainedObs     := oD
            drainedThisBar := true
            // Removed from PERSISTENT custody. The handle survives on the
            // nonpersistent surface above for exactly this bar, which is the
            // future M8 read seam. No drained history is retained.
            array.remove(fwdQueue, m6HeadIdx)

// ---- 24.8 authoritative current depths (A29 §7) ------------------------------
// Derived from the queue store AFTER the complete M6 phase order, on EVERY bar —
// including bars with no drain and bars that are not COMMIT_EXPORT at all, where
// they simply describe the carried persistent state. They are therefore always
// POST-DRAIN and never a stale pre-phase snapshot.
//
// SHARD-RUN LOCAL. A nonmatching row was routed to another shard run: it is
// neither dropped nor counted in these depths.
//
// STATIC CONSERVATION for the current shard, reconstructible from the write
// sites above and NOT authenticated by any hidden equality or PASS counter:
//   admitted matching records
//     = current pending + current ready + drained records + ready-overflow drops
// Pending-cap rejected rows are ATTEMPTED but never admitted, so they are not
// terms of that identity; both overflow types increment the SAME two cumulative
// authorities.
int m6DepthN = array.size(fwdQueue)
if m6DepthN > 0
    for i = 0 to m6DepthN - 1
        int m6QS = array.get(fwdQueue, i).queueState
        if m6QS == QUEUE_PENDING
            pendingDepth += 1
        if m6QS == QUEUE_READY
            readyDepth += 1

// =============================================================================
// 25. ARGUMENT-SHAPE AND INVENTORY LEDGER — M6   (running ledger; §18 and §23
//     are the frozen historical M3 and M5 ledgers and are not renumbered)
// =============================================================================
//  count-producing constructs in this source:
//    plot        : 1   (the inherited §18 structural placeholder, unchanged)
//    plotshape   : 0
//    plotchar    : 0
//    plotcandle  : 0
//    plotbar     : 0
//    plotarrow   : 0
//    fill        : 0
//    hline       : 0
//    bgcolor     : 0
//    barcolor    : 0
//    alertcondition : 0
//  ---------------------------------------------------------------------------
//  M6 candidate argument-shape count : 1
//  delta vs parent v0.6.0-M5         : +0  (M6 adds no count-producing call)
//  Ratified platform budget          : 64
//  Mandatory export calls (M8)       : 52
//  Headroom after M6                 : 63
//
//  INPUT LEDGER      : 16 inherited + 22 M4 + 0 M5 + 2 M6 = 40
//                      NEW AT M6: exportShardCount, exportShardIndex (§24.1)
//  REQUEST LEDGER    : 3 of 40 — UNCHANGED. M6 adds NO fourth request.
//    1  primary 20-element RTH bundle   §6.1  gaps_on   lookahead_off  UNCHANGED
//    2  confirmed daily PDH/PDL/PDC     §6.1  lookahead_on             UNCHANGED
//    3  supplemental RTH ADX/ER         §19.3 gaps_on   lookahead_off  UNCHANGED
//  RECORD FIELDS     : Obs 55 (49 inherited + 6 M6 internal lifecycle fields at
//                      §19.4) · Arm 9 UNCHANGED · Zone UNCHANGED.
//                      The six M6 fields are INTERNAL queue/lifecycle state.
//                      They are NOT part of the Frozen 38 exported record
//                      fields, are NOT new export titles and do NOT alter stable
//                      identity.
//  PERSISTENT STATE  : M6 adds EXACTLY three — fwdQueue, droppedObservationCount,
//                      queueOverflowEvents (§24.5). Store bounded at 416.
//  NONPERSISTENT     : pendingDepth, readyDepth, drainedObs, drainedThisBar
//                      (§24.6), all reset every bar.
//  DERIVED CONFIG    : shardConfigOk (§24.2), exportDrainEndMin (§24.3a).
//  INHERITED WRITE   : exportCompleteFlag — CLEARED TO 0 on queue overflow only,
//                      never restored to 1. No other inherited state is written.
//  EXPORT SURFACE    : none. M6 adds no export call, title, plot, drawing,
//                      table, alert or label. The drained-record surface is a
//                      read seam for M8, not an export.
//  FIRST CONSUMER    : EXPORT_DRAIN_END_HHMM, declared INERT at M0, acquires its
//                      first behavioral consumer at §24.3a / §24.7.5.
// =============================================================================

// =============================================================================
// 26. M7 — CUMULATIVE FUNNEL ACCOUNTING, INV-43 AND THE TWO INV-7 IDENTITIES
//     (SAT06-A32 §3-§7)
//
//     PLACEMENT. This block is placed AFTER the complete §24 M6 module and
//     AFTER the §25 M6 ledger, and BEFORE the running §27 M7 ledger. That is
//     exactly the convention M5 and M6 already used: the LAST ledger in the
//     source is the running one, every earlier ledger is historical, and no
//     inherited comment is renumbered, rewritten or removed. §25 contains no
//     executable line, so the A32 §4 placement is satisfied WITHOUT relocating
//     a single inherited statement or comment. The "running ledger"
//     parenthetical inside the §25 title is INHERITED VERBATIM and is now
//     historical; §27 is the running ledger.
//
//     ENTRY CONTRACT. M7 executes only where M4 has CLOSED the complete staged
//     set, M5 has completed retained-row tagging and M6 has had its accepted
//     opportunity, on the SAME committed bar. It performs ONE READ-ONLY pass
//     over the COMPLETE PRE-CAP stagedObs universe and writes NOTHING except
//     its own nine cumulative integer counters.
//
//     COMPLETE-UNIVERSE RULE (A32 §5.1). Every raw Funnel event total is
//     reconstructed from stagedObs or from the accepted complete per-bar
//     boundary facts published at §21.11 — NEVER from rawObsSet, fwdQueue, the
//     current shard, drainedObs, a queue depth, an admission result, a drop, a
//     promotion or a drain. Upstream truncation invalidates complete-export
//     acceptance, but it must NOT make a trigger or Risk event disappear here:
//     a 13-trigger bar capped to 12 retained rows contributes 13 trigger and 13
//     Observation events to M7 and is NEVER silently redefined as a 12-event
//     bar. array.size(rawObsSet) is read at exactly ONE site in this whole
//     module, as a bounded cohort-integrity cross-check, and is never a term of
//     any Funnel total or of either identity. M7 does not tag, admit, restore
//     or export a truncated row.
//
//     NON-SELF-AUTHENTICATION (A32 §7). The two audit counters are
//     CORROBORATIVE ONLY. Neither a zero audit count nor a holding identity
//     proves the complete trigger universe, and neither counter is ever read as
//     a gate, selector or PASS authority anywhere in this source. Establishing
//     the complete exported record universe is future B3 authority — external
//     manifest, decoded decisionCode, complete shard-union reconciliation, zero
//     terminal loss and both per-record EQA directions.
//
//     M7 WRITE SET, WHOLE SOURCE: triggersFired, observationsRecorded,
//     riskRejected, riskPassed, candidatesCreated, execNotSelected,
//     familyDataBlocked, invFunnelFail, invObsSuppressedFail — nothing else.
//     No Obs / Arm / Zone field, no stagedObs / rawObsSet / fwdQueue membership
//     or order, no exportCompleteFlag, no queue counter or depth, no M4/M5
//     count, no M6 lifecycle state, no input and no session / RVOL / calendar
//     state. M7 does NOT repair a row, suppress an Observation, delete, sort or
//     deduplicate, and there is NO mutate-and-restore path.
//
//     FIREWALL (A32 §8). No production input, no fourth request, no plot,
//     drawing, table, label, alert, export call or 53rd field, no Obs/Arm/Zone
//     field, no queue / shard / admission / capacity / promotion / FIFO / drain
//     / forward / terminalization change, no M8 export logic, no M9 PASS or
//     custody helper, no strategy/order/position/cooldown/quota/trade or
//     Stage-8 mechanic, no persistent array, per-reason array, per-family
//     array, status histogram, history buffer, PASS latch, validity state,
//     manifest, second Observation store, run token, fixture, poison, oracle,
//     expected-answer helper or answer-aware code path.
// =============================================================================

// ---- 26.1 the EXACTLY NINE M7 cumulative counters (A32 §3.1) ----------------
// Persistent, initialized once to zero and NEVER reset by session, day or bar.
// All nine are INTERNAL Stage-6 audit / accounting state: none is an input, an
// Obs / Arm / Zone field, an exported global, an export title or a member of
// the mandatory 52-field surface, and none is a gate, selector or PASS
// authority. Declared in exactly the posture the inherited §19.5 M4 counters
// and the §24.5 M6 counters already use.
//
// NO per-reason array, per-family array, status histogram, history buffer, PASS
// latch, validity state, manifest or second Observation store exists here. The
// accepted parent publishes the BOUNDED AGGREGATE R3 fact
// r3BlockedCandidatesThisBar, so familyDataBlocked owns exactly that cumulative
// aggregate and NO family distribution is reconstructed.
var int triggersFired        = 0
var int observationsRecorded = 0
var int riskRejected         = 0
var int riskPassed           = 0
var int candidatesCreated    = 0
var int execNotSelected      = 0
var int familyDataBlocked    = 0
var int invFunnelFail        = 0
var int invObsSuppressedFail = 0

// =============================================================================
// 26.2 M7 — ORDERED PER-CLOSED-BAR SEQUENCE
//      ONE block, so the A32 §5-§6 order IS the literal source order:
//        26.2.1  READ        one read-only pass over the COMPLETE staged set
//        26.2.2  ACCUMULATE  the seven cumulative Funnel owners, once
//        26.2.3  AUDIT       per-bar cross-checks, INV-43 and both INV-7
//                            identities, AFTER the cumulative writes
//
//      BOUNDARY USED: rawObsSetClosed — the inherited per-bar (non-var) fact
//      set at §21.11, which is the accepted same-bar statement that M4 has
//      completed the full staged set, M5 has completed retained-row tagging and
//      M6 has had its accepted opportunity. It is the SAME fact that gates the
//      §22 M5 block and §24.7.1 M6 admission. It is READ here and NEVER
//      written. M7 reads no bar on which the set is not closed and never
//      synthesizes an empty closure.
// =============================================================================
if rawObsSetClosed

    // ---- 26.2.1 phase 1 — READ-ONLY pass over the COMPLETE universe -------
    // WRITE SET: none. Not one Observation field, collection, membership,
    // ordering, inherited scalar or M6 lifecycle fact is written in this phase.
    int m7StagedN = array.size(stagedObs)

    // Per-bar local accumulators, declared WITHOUT var inside this block, so a
    // fresh set exists on every invocation and nothing survives the bar. They
    // are local arithmetic only — no persistent collection is created.
    int  m7PassLocal   = 0
    int  m7RejLocal    = 0
    int  m7CandLocal   = 0
    int  m7ExecNsLocal = 0
    int  m7RetLocal    = 0
    int  m7TruncLocal  = 0
    bool m7RowAuditBad = false

    // EMPTY-COHORT GUARD, the same posture §22.3 and §24.7.1 already carry: an
    // unguarded `for i = 0 to n - 1` with n == 0 becomes `0 to -1`, which Pine
    // executes DESCENDING and would manufacture iterations against an empty
    // set. An empty stagedObs is VALID; it must perform zero iterations and
    // manufacture no row and no event.
    if m7StagedN > 0
        for i = 0 to m7StagedN - 1
            // PURE SCALAR READS. No row handle is bound to a local and none
            // survives its own expression, so no write path through a record is
            // representable and no mutate-then-restore path exists. Same access
            // shape §22.3 uses over rawObsSet and §21.11 uses over stagedObs.
            bool m7RiskPass = array.get(stagedObs, i).riskPass
            int  m7Reason   = array.get(stagedObs, i).rejectReason
            int  m7Status   = array.get(stagedObs, i).selectionStatus
            int  m7ArbReas  = array.get(stagedObs, i).arbitrationReason
            bool m7HasId    = not na(array.get(stagedObs, i).obsId)
            bool m7HasIdx   = not na(array.get(stagedObs, i).obsIndexInBar)

            // ---- exact per-row Risk reconstruction (A32 §5.2) --------------
            // Accepted rejection reasons are EXACTLY {4,5,6,7,8,9,10,12,13}.
            // Reserved 1, 2, 3 and 11 are NOT accepted Risk outcomes.
            bool m7RejReason  = m7Reason == RJ_R4 or m7Reason == RJ_R5 or m7Reason == RJ_R6 or m7Reason == RJ_R7 or m7Reason == RJ_R8 or m7Reason == RJ_R9 or m7Reason == RJ_R10 or m7Reason == RJ_R12 or m7Reason == RJ_R13
            bool m7ReasonNone = m7Reason == RJ_NONE

            // The exact row contract is riskPass == true IFF reason == 0, and
            // riskPass == false IFF the reason is an accepted rejection. A
            // nonzero reason with riskPass=true, a zero reason with
            // riskPass=false, a reserved reason or any out-of-range reason is an
            // M7 audit violation. M7 RECORDS the violation; it NEVER repairs
            // the row.
            bool m7RiskRowBad = (m7RiskPass and not m7ReasonNone) or ((not m7RiskPass) and not m7RejReason)

            // Counted INDEPENDENTLY — never as an if/else on riskPass — so a
            // contract-violating row cannot be silently normalized into exactly
            // one event and then hide inside a holding aggregate. R13 is an
            // ORDINARY recorded Risk rejection for Funnel ownership: it remains
            // in the Observation universe and is counted exactly once here.
            if m7RiskPass
                m7PassLocal += 1
            if m7RejReason
                m7RejLocal += 1

            // ---- exact selection-event reconstruction (A32 §5.3) -----------
            // Derived from the row's ACTUAL fields. The outer riskPass term is
            // MANDATORY: a risk-rejected status-0 row must NEVER enter
            // execNotSelected. Status 1 is counted FROM THE FIELD and is not
            // hard-coded to zero. Any status outside 0..7 enters NEITHER
            // authorized selection set and is flagged below.
            bool m7StatusOk  = m7Status >= 0 and m7Status <= 7
            bool m7CandEvent = m7RiskPass and m7Status == 1
            bool m7ExecNsEvt = m7RiskPass and m7StatusOk and m7Status != 1
            if m7CandEvent
                m7CandLocal += 1
            if m7ExecNsEvt
                m7ExecNsLocal += 1

            // ---- retained / truncated identity (A32 §5.4) ------------------
            // retained  := obsId AND obsIndexInBar both non-na
            // truncated := BOTH na
            // exactly one na is an audit violation and is neither.
            bool m7Retained  = m7HasId and m7HasIdx
            bool m7Truncated = (not m7HasId) and (not m7HasIdx)
            if m7Retained
                m7RetLocal += 1
            if m7Truncated
                m7TruncLocal += 1

            // ---- exact M5 complement on RETAINED rows (A32 §5.4) ----------
            //   riskPass=true  -> selectionStatus 2, arbitrationReason 0
            //   riskPass=false -> selectionStatus 0, arbitrationReason 0
            // Status 1 and statuses 3..7 are therefore PROHIBITED on a retained
            // Stage-6 row. This PER-RECORD complement is REQUIRED even when both
            // aggregate INV-7 identities still hold: a risk-passed retained row
            // carrying status 0 and a risk-rejected retained row carrying status
            // 2 are exactly the hidden mis-tags the aggregates cannot see.
            bool m7RetTagBad = m7Retained and ((m7RiskPass and (m7Status != SEL_EXEC_DISABLED or m7ArbReas != ARB_NONE)) or ((not m7RiskPass) and (m7Status != SEL_NOT_SELECTED or m7ArbReas != ARB_NONE)))

            // A TRUNCATED staged row is verified ONLY against the accepted
            // untagged initialization state 0 / 0. Status 2 is NOT demanded from
            // a risk-passed truncated row, because that row never entered the
            // closed retained set M5 owns. Its risk-passed status 0 still
            // belongs to the generic execNotSelected set above for complete raw
            // accounting, and the inherited §21.11 truncation authority
            // independently keeps the run non-complete. M7 neither restores nor
            // re-tags it.
            bool m7TruncTagBad = m7Truncated and (m7Status != SEL_NOT_SELECTED or m7ArbReas != ARB_NONE)

            // Any nonzero arbitrationReason is an audit violation on ANY row.
            // ONE latch for the whole bar: multiple bad rows never multiply an
            // audit counter.
            if m7RiskRowBad or (not m7StatusOk) or m7ArbReas != ARB_NONE or (not (m7Retained or m7Truncated)) or m7RetTagBad or m7TruncTagBad
                m7RowAuditBad := true

    // ---- 26.2.2 phase 2 — the SEVEN cumulative Funnel owners --------------
    // Updated ONCE on this closed bar, after the complete read-only pass.
    // WRITE SET: exactly these seven counters — nothing else.
    //
    // triggersFired consumes the COMPLETE PRE-CAP staged trigger count published
    // at §21.11 and observationsRecorded consumes the COMPLETE staged
    // cardinality. Neither is ever a retained, queued, shard-matched, promoted
    // or drained count.
    //
    // familyDataBlocked is SEPARATE from triggersFired. R3 prevents trigger
    // evaluation and creates NO Observation and NO Risk or selection event, so
    // it can never appear in any other counter or in either INV-7 identity.
    triggersFired        += stagedTriggerCountThisBar
    observationsRecorded += m7StagedN
    riskRejected         += m7RejLocal
    riskPassed           += m7PassLocal
    candidatesCreated    += m7CandLocal
    execNotSelected      += m7ExecNsLocal
    familyDataBlocked    += r3BlockedCandidatesThisBar

    // ---- 26.2.3 phase 3 — per-bar cross-checks and the identities ---------
    // Evaluated AFTER the cumulative writes, so INV-43 and both INV-7 forms read
    // the POST-UPDATE cumulative values on this same closed bar.
    // WRITE SET: invFunnelFail, invObsSuppressedFail — at most ONE increment
    // each, however many rows or checks are bad on this bar.
    bool m7ChkTrig  = m7StagedN == stagedTriggerCountThisBar
    bool m7ChkPass  = m7PassLocal == stagedRiskPassCountThisBar
    bool m7ChkRej   = m7RejLocal == stagedRiskRejectCountThisBar
    bool m7ChkSplit = stagedRiskPassCountThisBar + stagedRiskRejectCountThisBar == stagedTriggerCountThisBar
    bool m7ChkLocal = m7PassLocal + m7RejLocal == m7StagedN
    bool m7ChkSel   = m7CandLocal + m7ExecNsLocal == m7PassLocal
    bool m7ChkRet   = m7RetLocal == retainedObsCountThisBar
    bool m7ChkTrunc = m7TruncLocal == truncatedObsCountThisBar
    bool m7ChkParts = m7StagedN == m7RetLocal + m7TruncLocal

    // THE ONLY rawObsSet READ IN §26. Bounded cohort-integrity cross-check
    // ONLY: it confirms the retained cohort M5 tagged has the canonical
    // cardinality, and it is NEVER a Funnel event total.
    bool m7ChkCohort = array.size(rawObsSet) == retainedObsCountThisBar

    bool m7BarChecksOk = m7ChkTrig and m7ChkPass and m7ChkRej and m7ChkSplit and m7ChkLocal and m7ChkSel and m7ChkRet and m7ChkTrunc and m7ChkParts and m7ChkCohort

    // INV-43  observationsRecorded == triggersFired, per bar AND cumulative.
    // A per-bar INV-43 failure is ALSO a per-bar cross-check failure, so it
    // legitimately increments BOTH audit counters exactly once. That is the A32
    // §6.3 routing, not a double increment of one counter.
    bool m7Inv43Bar = m7StagedN == stagedTriggerCountThisBar
    bool m7Inv43Cum = observationsRecorded == triggersFired
    if not (m7Inv43Bar and m7Inv43Cum)
        invObsSuppressedFail += 1

    // INV-7①  riskRejected + riskPassed            == triggersFired
    // INV-7②  candidatesCreated + execNotSelected  == riskPassed
    bool m7Inv7a = riskRejected + riskPassed == triggersFired
    bool m7Inv7b = candidatesCreated + execNotSelected == riskPassed

    if m7RowAuditBad or (not m7BarChecksOk) or (not m7Inv7a) or (not m7Inv7b)
        invFunnelFail += 1

// =============================================================================
// 27. ARGUMENT-SHAPE AND INVENTORY LEDGER — M7   (running ledger; §18, §23 and
//     §25 are the frozen historical M3, M5 and M6 ledgers and are neither
//     renumbered nor rewritten. The "running ledger" parenthetical inside the
//     §25 title is inherited verbatim and is superseded by this ledger.)
// =============================================================================
//  count-producing constructs in this source:
//    plot        : 1   (the inherited §18 structural placeholder, unchanged)
//    plotshape   : 0
//    plotchar    : 0
//    plotcandle  : 0
//    plotbar     : 0
//    plotarrow   : 0
//    fill        : 0
//    hline       : 0
//    bgcolor     : 0
//    barcolor    : 0
//    alertcondition : 0
//  ---------------------------------------------------------------------------
//  M7 candidate argument-shape count : 1
//  delta vs parent v0.7.0-M6         : +0  (M7 adds no count-producing call)
//  Ratified platform budget          : 64
//  Mandatory export calls (M8)       : 52
//  Headroom after M7                 : 63
//
//  INPUT LEDGER      : 16 inherited + 22 M4 + 0 M5 + 2 M6 + 0 M7 = 40 UNCHANGED
//  REQUEST LEDGER    : 3 of 40 — UNCHANGED. M7 adds NO fourth request.
//    1  primary 20-element RTH bundle   §6.1  gaps_on   lookahead_off  UNCHANGED
//    2  confirmed daily PDH/PDL/PDC     §6.1  lookahead_on             UNCHANGED
//    3  supplemental RTH ADX/ER         §19.3 gaps_on   lookahead_off  UNCHANGED
//  RECORD FIELDS     : Obs 55 UNCHANGED · Arm 9 UNCHANGED · Zone 20 UNCHANGED.
//                      M7 adds no record field and no exported global field.
//  PERSISTENT STATE  : M7 adds EXACTLY NINE persistent int scalars (§26.1) and
//                      ZERO persistent collections. No array, latch, run token,
//                      manifest or second Observation store.
//  NONPERSISTENT     : the §26.2 locals only — m7StagedN, six local counters,
//                      the row-audit latch and the check booleans. All are
//                      recreated on every invocation and none survives the bar.
//  M7 WRITE SET      : the nine §26.1 counters — nothing else in this source.
//                      No Obs / Arm / Zone field, no stagedObs / rawObsSet /
//                      fwdQueue membership or order, no exportCompleteFlag, no
//                      queue counter or depth, no M4/M5 count, no M6 lifecycle
//                      state, no input, no session / RVOL / calendar state.
//  INHERITED WRITE   : NONE. M7 writes no inherited state at all — it does not
//                      clear, set or restore exportCompleteFlag.
//  EXPORT SURFACE    : none. M7 adds no export call, title, plot, drawing,
//                      table, alert or label. The nine counters are internal
//                      audit / accounting state and are not part of the
//                      mandatory 52-field surface.
//  UNIVERSE SOURCE   : stagedObs and the §21.11 per-bar boundary facts ONLY.
//                      rawObsSet is read at exactly ONE site (§26.2.3) as a
//                      bounded cohort cross-check. fwdQueue, pendingDepth,
//                      readyDepth, drainedObs, drainedThisBar,
//                      droppedObservationCount and queueOverflowEvents are read
//                      NOWHERE in §26.
//  AUDIT STATUS      : invFunnelFail and invObsSuppressedFail are CORROBORATIVE
//                      ONLY. They are never reset, never gates, never selectors
//                      and never PASS authorities, and neither a zero count nor
//                      a holding identity may be described as proving the
//                      complete trigger or exported record universe (A32 §7).
//  STILL OPEN        : the temporary inherited §18 plot retains its M8 removal
//                      obligation. M8 is NOT authorized by A32.
// =============================================================================

// =============================================================================
// 28. M8 — EXACT 52-FIELD EXPORT SURFACE                          (SAT06-A35)
//
//     PLACEMENT. This block is placed AFTER the complete §26 M7 module and
//     AFTER the §27 M7 ledger, exactly the convention M5, M6 and M7 already
//     used: the LAST ledger in the source is the running one, every earlier
//     ledger is historical, and no inherited comment is renumbered or removed.
//     §27 contains no executable line, so this placement moves NOT ONE
//     inherited statement. M8 therefore reads strictly AFTER the §24.7.5 M6
//     drain publication, AFTER the §24.8 authoritative post-phase depths and
//     AFTER the §26.2 M7 read-only accounting pass. No inherited phase moves.
//
//     ENTRY CONTRACT. M8 is a PURE EXPORT PROJECTION. It derives one
//     nonpersistent per-bar fact, projects the ONE drained record published by
//     M6 into 38 nonpersistent scalars, and emits exactly 52 global-scope plot
//     calls. It computes no decision, admits nothing, promotes nothing, drains
//     nothing, repairs nothing and terminalizes nothing.
//
//     M8 WRITE SET, WHOLE SOURCE: m8HasDrainedRecord and the 38 §28.2
//     projection scalars — NOTHING ELSE. M8 writes NO field of drainedObs or of
//     any other Obs; no stagedObs, rawObsSet or fwdQueue membership or order;
//     no drainedObs, drainedThisBar, pendingDepth or readyDepth; no
//     exportCompleteFlag and no queue, Funnel, calendar or RVOL counter; no
//     Arm, Zone, session, request, input or source/config state.
//
//     NO PERSISTENT STATE. Not one declaration below uses var. There is no
//     persistent value, collection, latch, history, counter, validity flag, run
//     token or expected-answer helper anywhere in this module. That is what
//     makes stale-row repetition STRUCTURALLY UNREPRESENTABLE rather than
//     merely unobserved: a repeat would require storage that does not exist.
//
//     FIREWALL (A35 §10). No input, range, default, parameter, request, tuple
//     element, timeframe, ticker, gap mode or lookahead mode · no Obs, Arm or
//     Zone field or constructor · no Observation acquisition, readiness, arm,
//     trigger, Risk, quality, EQA or Funnel change · no queue identity,
//     sharding, admission, capacity, forward measurement, terminalization,
//     promotion, compaction, FIFO or drain change · no calendar, RVOL, VWAP,
//     Static-Zone, session or completeness change · no M9 integration, custody
//     or PASS helper · no strategy.*, order, position, cooldown, quota, trade
//     lifecycle, closed-trade processing or any Stage-8 mechanic · no fixture,
//     scenario selector, poison, oracle, expected-answer helper, external
//     manifest reader, run token, diagnostic plot, alert, drawing, table or
//     label · no compile, runtime, B3, H18 FINAL, XCSV-01 or XCAL-01 claim.
// =============================================================================

// ---- 28.1 the ONE coherent one-drained-record gate ---------------- (A35 §4.1)
// EXACTLY the A35 §4.1 conjunction, declared WITHOUT var so it is recomputed
// from scratch on EVERY chart bar. This is the SOLE gate for all 38 record
// fields: no field-specific availability test is ever used as a second row
// gate, so field mixing across records is unrepresentable.
//
// FAIL-CLOSED. If the accepted M6 facts were ever inconsistent — drainedThisBar
// true with an na handle, or a non-na handle with drainedThisBar false — the
// conjunction is false, M8 emits NO record row, and it creates NO repair, NO
// counter and NO alternate identity. It does not "recover" a row.
bool m8HasDrainedRecord = drainedThisBar and not na(drainedObs)

// ---- 28.2 nonpersistent per-bar record projections ---------- (A35 §3.2/§4.2)
// EXACTLY 38 scalars, one per exported record field, every one declared WITHOUT
// var and initialized to TYPED na on EVERY chart bar.
//
// na — NOT ZERO — IS THE INITIALIZER, AND THAT IS LOAD-BEARING. Eight of these
// fields (flagMask, zoneIdMask, confluence, touchCount, qFlagMask,
// qApplicabilityMask, vwapPriceTouchCount, vwapZoneMotionTouchCount) carry a
// literal 0 DEFAULT in the §19.4 Obs type, and selectionStatus /
// arbitrationReason likewise. Initializing any projection to 0 would publish a
// categorical zero on a NO-DRAIN bar and manufacture a phantom Observation that
// no queue counter would contradict. Every one therefore starts as na.
//
// The names are m8-prefixed because several exported field names collide with
// existing global identifiers in this source — adxVal, efficiencyRatio and roc5
// are §6.1/§19.3 request tuple elements. A35 §5 permits a differing local
// projection name and forbids only a changed VALUE; no value is changed.
int   m8ObsId                    = na
int   m8ObsBarTime               = na
int   m8SlotIdx                  = na
int   m8ClassCode                = na
int   m8DecisionCode             = na
int   m8FlagMask                 = na
int   m8ZoneIdMask               = na
int   m8Confluence               = na
int   m8TouchCount               = na
int   m8QFlagMask                = na
int   m8QApplicabilityMask       = na
int   m8VwapPriceTouchCount      = na
int   m8VwapZoneMotionTouchCount = na
float m8PlannedStop              = na
float m8PlannedRisk              = na
float m8ReferenceRisk            = na
float m8RefPrice                 = na
float m8SignalClose              = na
float m8AtrRefAtObs              = na
float m8EntryDistATR             = na
float m8RelVol                   = na
float m8RelVolCum                = na
float m8Roc5                     = na
float m8AtrPct                   = na
float m8AtrRatio                 = na
float m8AdxVal                   = na
float m8EfficiencyRatio          = na
float m8MfeUsd1                  = na
float m8MfeUsd2                  = na
float m8MfeUsd4                  = na
float m8MfeUsd8                  = na
float m8MfeUsd12                 = na
float m8MaeUsd1                  = na
float m8MaeUsd2                  = na
float m8MaeUsd4                  = na
float m8MaeUsd8                  = na
float m8MaeUsd12                 = na
int   m8ForwardBarsAvailable     = na

// ---- 28.3 ONE guarded scalar-copy block ------------------------- (A35 §4.1)
// ONE block, ONE gate, ONE handle. Every one of the 37 direct copies and the
// one packed field below reads the SAME drainedObs handle inside the SAME
// conditional, so all 38 values are guaranteed to describe ONE record. No field
// of an na object is ever accessed: the §28.1 conjunction has already
// established not na(drainedObs) before this block can run.
//
// PURE READ. Every statement is `<local> := drainedObs.<field>`. drainedObs is
// on the LEFT of nothing. The row is not mutated, re-tagged, requeued, retained
// or copied into any store.
//
// na PRESERVATION (A35 §9 false-FAIL). An unavailable continuous field of an
// AVAILABLE drained row — refPrice, referenceRisk, a horizon MFE/MAE, relVol,
// relVolCum, adxVal, efficiencyRatio — is copied AS na. There is no nz, no
// zero substitution, no last-known carry and no default anywhere below.
if m8HasDrainedRecord
    m8ObsId                    := drainedObs.obsId
    m8ObsBarTime               := drainedObs.obsBarTime
    m8SlotIdx                  := drainedObs.slotIdx
    m8ClassCode                := drainedObs.classCode
    // ---- the ONE packed field (A35 §4.3) ------------------------------------
    // Packed from the SAME drainedObs handle as every other field in this
    // block, with the EXACT multipliers and the EXACT term order stated by
    // A35 §4.3. It is NEVER stored in Obs, no source field is mutated, no code
    // is normalized and NO default is substituted on a no-drain bar — outside
    // this gate m8DecisionCode simply remains na.
    //
    // The four source domains are CLOSED by construction in this source and
    // every one fits its positional field, so the A35 §4.3 offline decode is
    // exactly reversible:
    //   riskPass          in {false, true}                      -> 1 digit
    //   rejectReason      in {0,4,5,6,7,8,9,10,12,13}  (§19.2b) -> 2 digits
    //   selectionStatus   in {0, 2}                    (§22.2)  -> 1 digit
    //   arbitrationReason in {0}                       (§22.2)  -> 1 digit
    // Maximum representable value here is 1*10000 + 13*100 + 2*10 + 0 = 11320.
    m8DecisionCode             := (drainedObs.riskPass ? 1 : 0) * 10000 + drainedObs.rejectReason * 100 + drainedObs.selectionStatus * 10 + drainedObs.arbitrationReason
    m8FlagMask                 := drainedObs.flagMask
    m8ZoneIdMask               := drainedObs.zoneIdMask
    m8Confluence               := drainedObs.confluence
    m8TouchCount               := drainedObs.touchCount
    m8QFlagMask                := drainedObs.qFlagMask
    m8QApplicabilityMask       := drainedObs.qApplicabilityMask
    m8VwapPriceTouchCount      := drainedObs.vwapPriceTouchCount
    m8VwapZoneMotionTouchCount := drainedObs.vwapZoneMotionTouchCount
    m8PlannedStop              := drainedObs.plannedStop
    m8PlannedRisk              := drainedObs.plannedRisk
    m8ReferenceRisk            := drainedObs.referenceRisk
    m8RefPrice                 := drainedObs.refPrice
    m8SignalClose              := drainedObs.signalClose
    m8AtrRefAtObs              := drainedObs.atrRefAtObs
    m8EntryDistATR             := drainedObs.entryDistATR
    m8RelVol                   := drainedObs.relVol
    m8RelVolCum                := drainedObs.relVolCum
    m8Roc5                     := drainedObs.roc5
    m8AtrPct                   := drainedObs.atrPct
    m8AtrRatio                 := drainedObs.atrRatio
    m8AdxVal                   := drainedObs.adxVal
    m8EfficiencyRatio          := drainedObs.efficiencyRatio
    m8MfeUsd1                  := drainedObs.mfeUsd1
    m8MfeUsd2                  := drainedObs.mfeUsd2
    m8MfeUsd4                  := drainedObs.mfeUsd4
    m8MfeUsd8                  := drainedObs.mfeUsd8
    m8MfeUsd12                 := drainedObs.mfeUsd12
    m8MaeUsd1                  := drainedObs.maeUsd1
    m8MaeUsd2                  := drainedObs.maeUsd2
    m8MaeUsd4                  := drainedObs.maeUsd4
    m8MaeUsd8                  := drainedObs.maeUsd8
    m8MaeUsd12                 := drainedObs.maeUsd12
    m8ForwardBarsAvailable     := drainedObs.forwardBarsAvailable

// ---- 28.4 RECORD EXPORTS — ordinals 1-38 ------------------------ (A35 §5.1)
// Exact constant titles, exact A35 §5.1 order, one numeric series each,
// display.data_window, NO color argument and no other count-producing argument
// shape. No title is concatenated, aliased, prefixed, suffixed, case-changed,
// whitespace-changed or duplicated, and the @ punctuation in the ten horizon
// titles is preserved literally.
//
// On EVERY bar where m8HasDrainedRecord is false, all 38 of these series are na
// by §28.2 construction. That is the CORRECT no-drain surface, not a missing
// row: the H18 preflight bar_index+n placeholder values are prohibited here and
// appear nowhere in this source.
plot(m8ObsId,                    title = "obsId",                    display = display.data_window)
plot(m8ObsBarTime,               title = "obsBarTime",               display = display.data_window)
plot(m8SlotIdx,                  title = "slotIdx",                  display = display.data_window)
plot(m8ClassCode,                title = "classCode",                display = display.data_window)
plot(m8DecisionCode,             title = "decisionCode",             display = display.data_window)
plot(m8FlagMask,                 title = "flagMask",                 display = display.data_window)
plot(m8ZoneIdMask,               title = "zoneIdMask",               display = display.data_window)
plot(m8Confluence,               title = "confluence",               display = display.data_window)
plot(m8TouchCount,               title = "touchCount",               display = display.data_window)
plot(m8QFlagMask,                title = "qFlagMask",                display = display.data_window)
plot(m8QApplicabilityMask,       title = "qApplicabilityMask",       display = display.data_window)
plot(m8VwapPriceTouchCount,      title = "vwapPriceTouchCount",      display = display.data_window)
plot(m8VwapZoneMotionTouchCount, title = "vwapZoneMotionTouchCount", display = display.data_window)
plot(m8PlannedStop,              title = "plannedStop",              display = display.data_window)
plot(m8PlannedRisk,              title = "plannedRisk",              display = display.data_window)
plot(m8ReferenceRisk,            title = "referenceRisk",            display = display.data_window)
plot(m8RefPrice,                 title = "refPrice",                 display = display.data_window)
plot(m8SignalClose,              title = "signalClose",              display = display.data_window)
plot(m8AtrRefAtObs,              title = "atrRefAtObs",              display = display.data_window)
plot(m8EntryDistATR,             title = "entryDistATR",             display = display.data_window)
plot(m8RelVol,                   title = "relVol",                   display = display.data_window)
plot(m8RelVolCum,                title = "relVolCum",                display = display.data_window)
plot(m8Roc5,                     title = "roc5",                     display = display.data_window)
plot(m8AtrPct,                   title = "atrPct",                   display = display.data_window)
plot(m8AtrRatio,                 title = "atrRatio",                 display = display.data_window)
plot(m8AdxVal,                   title = "adxVal",                   display = display.data_window)
plot(m8EfficiencyRatio,          title = "efficiencyRatio",          display = display.data_window)
plot(m8MfeUsd1,                  title = "mfeUsd@1",                 display = display.data_window)
plot(m8MfeUsd2,                  title = "mfeUsd@2",                 display = display.data_window)
plot(m8MfeUsd4,                  title = "mfeUsd@4",                 display = display.data_window)
plot(m8MfeUsd8,                  title = "mfeUsd@8",                 display = display.data_window)
plot(m8MfeUsd12,                 title = "mfeUsd@12",                display = display.data_window)
plot(m8MaeUsd1,                  title = "maeUsd@1",                 display = display.data_window)
plot(m8MaeUsd2,                  title = "maeUsd@2",                 display = display.data_window)
plot(m8MaeUsd4,                  title = "maeUsd@4",                 display = display.data_window)
plot(m8MaeUsd8,                  title = "maeUsd@8",                 display = display.data_window)
plot(m8MaeUsd12,                 title = "maeUsd@12",                display = display.data_window)
plot(m8ForwardBarsAvailable,     title = "forwardBarsAvailable",     display = display.data_window)

// ---- 28.5 GLOBAL EXPORTS — ordinals 39-52 ----------------------- (A35 §5.2)
// NEVER record-gated. Not one of the fourteen calls below is conditioned on
// m8HasDrainedRecord, drainedThisBar, COMMIT_EXPORT or a queue depth: they
// publish their CURRENT authoritative values on EVERY bar, including bars that
// drain nothing.
//
// DIRECT READS ONLY (A35 §6.1). M8 does not recompute, latch, reset, repair,
// aggregate or terminalize any of them:
//   · pendingDepth / readyDepth are the §24.8 CURRENT POST-DRAIN depths and are
//     exported as carried custody. Nonzero is CURRENT STATE, not corruption,
//     and is never repaired to zero here;
//   · exportCompleteFlag is exported as its CURRENT monotonic §8.7 value. It is
//     read only. This is NOT a new M8 PASS computation;
//   · the cumulative counters remain cumulative, and shard-run local exactly
//     where their parent semantics already say so;
//   · exportShardIndex is the CURRENT configured §24.1 input value, not a
//     reconstructed key.
//
// EXACT STAGE-6 EMPTY TRADE DOMAIN (A35 §6.2). This Stage-6 indicator contains
// no closed-trade processor and no exit-attribution producer, so
// exitAttributionFailures, trimmedTradeDataLoss and closedTradeBacklog are
// EXACTLY numeric zero on every bar and every run. They are supplied as LITERAL
// 0 with NO mutable identifier, NO producer, NO strategy call, NO closed-trade
// read and NO applicability flag. Zero here is the exact value of an EMPTY
// DOMAIN and is SPECIFICALLY NOT evidence that a Stage-8 processor ran, nor a
// claim that H13 or H14 was exercised.
plot(pendingDepth,                   title = "pendingDepth",                   display = display.data_window)
plot(readyDepth,                     title = "readyDepth",                     display = display.data_window)
plot(droppedObservationCount,        title = "droppedObservationCount",        display = display.data_window)
plot(queueOverflowEvents,            title = "queueOverflowEvents",            display = display.data_window)
plot(exportCompleteFlag,             title = "exportCompleteFlag",             display = display.data_window)
plot(0,                              title = "exitAttributionFailures",        display = display.data_window)
plot(0,                              title = "trimmedTradeDataLoss",           display = display.data_window)
plot(exportShardIndex,               title = "exportShardIndex",               display = display.data_window)
plot(truncatedObservationCountTotal, title = "truncatedObservationCountTotal", display = display.data_window)
plot(0,                              title = "closedTradeBacklog",             display = display.data_window)
plot(calendarCoverageViolation,      title = "calendarCoverageViolation",      display = display.data_window)
plot(unexpectedSessionShortfall,     title = "unexpectedSessionShortfall",     display = display.data_window)
plot(unexplainedAbsentWeekday,       title = "unexplainedAbsentWeekday",       display = display.data_window)
plot(rvolSessionsCommitted,          title = "rvolSessionsCommitted",          display = display.data_window)

// =============================================================================
// 29. ARGUMENT-SHAPE AND INVENTORY LEDGER — M8   (running ledger; §18, §23, §25
//     and §27 are the frozen historical M3, M5, M6 and M7 ledgers and are
//     neither renumbered nor rewritten. The "running ledger" parenthetical
//     inside the §27 title is inherited verbatim and is superseded by this
//     ledger. §18 carries a comment-only scaffold-release note authorized by
//     A35 §3.1 and its recorded counts are historical M3 counts.)
// =============================================================================
//  SOURCE-DERIVED CANDIDATE LEDGER, ENUMERATED BY CALL AND ARGUMENT SHAPE:
//
//    construct         calls   argument shape                      multiplier
//    ---------------   -----   ---------------------------------   ----------
//    plot                 52   series + const title + display,          1 each
//                              NO color argument, so NO series-color
//                              multiplier on ANY of the 52
//    plotshape             0   —                                             0
//    plotchar              0   —                                             0
//    plotcandle            0   —                                             0
//    plotbar               0   —                                             0
//    plotarrow             0   —                                             0
//    fill                  0   —                                             0
//    hline                 0   —                                             0
//    bgcolor               0   —                                             0
//    barcolor              0   —                                             0
//    alertcondition        0   —                                             0
//  ---------------------------------------------------------------------------
//  M8 candidate argument-shape count : 52
//  delta vs parent v0.8.0-M7         : +51  (+52 mandatory exports, -1 released
//                                            structural placeholder)
//  Ratified platform ceiling         : 64
//  NOMINAL RESERVE after M8          : 12
//
//  THIS IS A SOURCE-DERIVED CANDIDATE LEDGER ONLY. H18 PREFLIGHT = PASS remains
//  HISTORICAL. H18 FINAL = OPEN. Only a later B3 compiler/platform result bound
//  to these exact frozen source bytes may close H18 FINAL. Nothing in this
//  source is a compile, load, runtime, XCSV-01 or XCAL-01 claim, and a
//  source-derived 52-count must never be presented as either.
//
//  EXPORT TITLE LEDGER : 52 unique exact titles — 38 record + 14 global.
//                        Placeholder titles: 0. Aliases: 0. Duplicates: 0.
//                        Ordinals 1-38 are the A35 §5.1 record manifest in
//                        exact order; ordinals 39-52 are the A35 §5.2 global
//                        manifest in exact order. The @ punctuation in the ten
//                        mfeUsd@n / maeUsd@n titles is literal.
//  NOT EXPORTED        : obsOrd, obsIndexInBar, family, direction, dirCode,
//                        gapCode, riskPass, rejectReason, selectionStatus,
//                        arbitrationReason, plannedTp1, refLevel and the six
//                        M6 queue-lifecycle fields (queueState, readyAtOrd,
//                        forwardBarsSeen, refCaptureDone, runningMfe,
//                        runningMae). No 53rd title exists. The authorized
//                        recoverable content of riskPass, rejectReason,
//                        selectionStatus and arbitrationReason is carried by
//                        the packed decisionCode; the remainder is
//                        intentionally internal.
//  INPUT LEDGER        : 16 inherited + 22 M4 + 0 M5 + 2 M6 + 0 M7 + 0 M8
//                        = 40 UNCHANGED
//  REQUEST LEDGER      : 3 of 40 — UNCHANGED. M8 adds NO fourth request.
//    1  primary 20-element RTH bundle   §6.1  gaps_on   lookahead_off  UNCHANGED
//    2  confirmed daily PDH/PDL/PDC     §6.1  lookahead_on             UNCHANGED
//    3  supplemental RTH ADX/ER         §19.3 gaps_on   lookahead_off  UNCHANGED
//  RECORD FIELDS       : Obs 55 UNCHANGED · Arm 9 UNCHANGED · Zone 20 UNCHANGED.
//                        M8 adds no record field and no constructor.
//  PERSISTENT STATE    : M8 adds ZERO. No var declaration exists in §28. No
//                        persistent scalar, collection, latch, history,
//                        counter, validity flag, run token or expected-answer
//                        helper.
//  NONPERSISTENT       : m8HasDrainedRecord plus the 38 §28.2 projection
//                        scalars. All 39 are recreated on EVERY chart bar and
//                        none survives the bar.
//  M8 WRITE SET        : those 39 nonpersistent locals — nothing else in this
//                        source. No Obs / Arm / Zone field, no stagedObs /
//                        rawObsSet / fwdQueue membership or order, no
//                        drainedObs / drainedThisBar / pendingDepth /
//                        readyDepth, no exportCompleteFlag, no queue / Funnel /
//                        calendar / RVOL counter, no input and no
//                        session / request / source / config state.
//  INHERITED WRITE     : NONE. M8 writes no inherited state at all.
//  INHERITED EXECUTABLE
//  CHANGE              : EXACTLY TWO DELETED LINES — the §18 structural
//                        placeholder declaration and its plot. No other
//                        inherited executable line is added, removed,
//                        reordered, renamed or altered, so the executable-only
//                        projection of this source equals the parent's minus
//                        those two lines and plus the appended §28 block.
//  INDICATOR TITLE     : inherited BYTE-IDENTICAL. M8 does not rename the
//                        indicator, add a second indicator declaration or use a
//                        title as a versioning surface.
//  ONE-ROW GUARANTEE   : all 38 record values derive under the ONE §28.1 gate
//                        from the ONE drainedObs handle inside the ONE §28.3
//                        block. No second gate, no field-specific availability
//                        test, no prior handle and no queue-head re-read.
//  NO-DRAIN GUARANTEE  : on every bar with no drain all 38 record outputs are
//                        na — INCLUDING every categorical and mask field — and
//                        all 14 globals still publish current values. Stale-row
//                        repetition is STRUCTURALLY UNREPRESENTABLE: repeating
//                        would require persistent storage, and §28 declares
//                        none.
//  EMPTY TRADE DOMAIN  : ordinals 44, 45 and 48 are literal numeric 0 on every
//                        bar and every run, with no mutable producer and no
//                        trade-state dependency. Zero is the exact empty-domain
//                        value and is NOT evidence of Stage-8 exercise.
//  STILL OPEN          : H18 FINAL · B3 compile/runtime · XCSV-01 · XCAL-01 ·
//                        M9 integration and final integrated acceptance. NONE
//                        is claimed, implied or self-ratified here. M9 remains
//                        UNAUTHORIZED until the ITA accepts this exact source.
// =============================================================================

// =============================================================================
// 30. M9 INTEGRATION / CUSTODY LEDGER — v1.0.0-RC1   (running ledger; §18, §23,
//     §25, §27 and §29 are the frozen historical M3, M5, M6, M7 and M8 ledgers
//     and are NEITHER renumbered NOR rewritten. §30 supersedes §29 as the
//     running ledger in exactly the way §29 superseded §27. The §29 closing
//     line "M9 remains UNAUTHORIZED until the ITA accepts this exact source"
//     was TRUE OF M8 AT THE TIME OF WRITING and was DISCHARGED by SAT06-A37
//     acceptance of the M8 source followed by the SAT06-A38 bounded M9 grant;
//     it is preserved verbatim as history rather than edited.)
//     THIS SECTION DECLARES NO PINE CONSTRUCT. It contains no directive,
//     annotation, declaration, expression, helper, flag, latch or value. It is
//     comment text only and is NOT readable by the compiled program.
// =============================================================================
//
//  30.1  ACCEPTED MODULE MAP, M0 THROUGH M9
//  ---------------------------------------------------------------------------
//    M0   guards, canonical RTH request, session ownership, slot arithmetic,
//         observed-session classification and the complete New York local-date
//         calendar traversal (C_NODATA .. C_UNSCHED), plus SC-04 local-noon
//         re-anchoring on every visited date.        CLOSED  (A11 / M0R)
//    M1   VWAP logical-zone touch state and the two DISTINCT touch counters,
//         price-touch and zone-motion-touch, with explicit current-bound na
//         guards.                                     CLOSED  (SAT06-A14)
//    M2   deterministic Static Zones: membership, stable bit identity,
//         clustering and split determinism, R1/R2 rebuild, canonical
//         whole-parent transfer, role / acceptance / touch state and the
//         generic arm store. VWAP identity 16 NEVER enters a static mask.
//                                                     CLOSED  (SAT06-A16)
//    M3   RVOL 20-position ring, 19-prior-position read surface, SC-01
//         admissibility with purge, SC-02 / SC-03 distinct causes, warm-up,
//         slot sample sufficiency, read-before-write, canonical relVol and
//         DIAGNOSTIC-ONLY relVolCum.                  CLOSED  (SAT06-A19)
//    M4   family readiness, real arm lifecycle, VWR / LBO / LRT / SQZ triggers,
//         ordered Risk, quality masks, raw Observations, canonical within-bar
//         ordering and deterministic truncation.      CLOSED  (A22 / A25 / M4R)
