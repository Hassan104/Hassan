// ---- relocated functions (dependency order) ----
export hasBit(int mask, int bit) =>
    na(mask) or na(bit) or bit <= 0 ? false : math.floor(mask / bit) % 2 == 1

// ---- private copy of vp_zoneText (same code as the Companion v2 export;
//      kept local so OSE_CORE_LIB needs no library-to-library import) ----
vp_zoneText(int vp_mask) =>
    string vp_t = "—"
    if not na(vp_mask)
        if vp_mask == 16
            vp_t := "VWAP"
        else if vp_mask > 0 and vp_mask <= 15
            // Same four members, same PDH / PDL / ORH / ORL order, same "+"
            // join; only the four structurally identical branches are folded
            // into one bounded pass.
            vp_t := ""
            array<int>    vp_zb = array.from(1, 2, 4, 8)
            array<string> vp_zn = array.from("YDAY HIGH", "YDAY LOW", "OPEN HIGH", "OPEN LOW")
            for vp_i = 0 to 3
                if hasBit(vp_mask, array.get(vp_zb, vp_i))
                    vp_t := (str.length(vp_t) > 0 ? vp_t + "+" : "") + array.get(vp_zn, vp_i)
    vp_t

anchorPriOf(int bit) =>
    bit == BIT_PDH or bit == BIT_PDL ? 1 : 2

export distToZone(float px, float lo, float hi) =>
    na(px) or na(lo) or na(hi) ? na : px < lo ? lo - px : px > hi ? px - hi : 0.0

export sideOf(float c, float lo, float hi) =>
    na(c) or na(lo) or na(hi) ? na : c > hi ? SIDE_ABOVE : c < lo ? SIDE_BELOW : SIDE_INSIDE

export roleFromSide(int side) =>
    side == SIDE_ABOVE ? ROLE_SUPPORT : side == SIDE_BELOW ? ROLE_RESISTANCE : ROLE_NEUTRAL

export roleFromDir(int dir) =>
    dir == DIR_LONG ? ROLE_SUPPORT : dir == DIR_SHORT ? ROLE_RESISTANCE : ROLE_NEUTRAL

export dirDistOf(float a, float b, int dir) =>
    na(a) or na(b) or dir == 0 ? na : dir * (a - b)

export advEdgeOf(int dir, float h, float l) =>
    dir == DIR_LONG ? l : dir == DIR_SHORT ? h : na

export favEdgeOf(int dir, float h, float l) =>
    dir == DIR_LONG ? h : dir == DIR_SHORT ? l : na

export zoneFarOf(int dir, float lo, float hi) =>
    dir == DIR_LONG ? hi : dir == DIR_SHORT ? lo : na

export zoneNearOf(int dir, float lo, float hi) =>
    dir == DIR_LONG ? lo : dir == DIR_SHORT ? hi : na

export closeLocOf(int dir, float h, float l, float c) =>
    na(h) or na(l) or na(c) or (h - l) <= 0 or dir == 0 ? 0.0 : dir == DIR_LONG ? (c - l) / (h - l) : (h - c) / (h - l)

export dirWorstStrict(float a, float b, int dir) =>
    na(a) or na(b) or dir == 0 ? na : dir == DIR_LONG ? math.min(a, b) : math.max(a, b)

export dirWorstAccum(float stored, float cur, int dir) =>
    na(cur) ? stored : na(stored) ? cur : dir == DIR_LONG ? math.min(stored, cur) : math.max(stored, cur)

export armIdxOfKey(array<Arm> st, int fam, int dir, int m) =>
    int r = -1
    if array.size(st) > 0
        for i = 0 to array.size(st) - 1
            Arm q = array.get(st, i)
            if r == -1 and q.family == fam and q.direction == dir and q.zoneIdMask == m
                r := i
    r

export zoneIdxOfMask(array<Zone> reg, int m) =>
    int r = -1
    if array.size(reg) > 0
        for i = 0 to array.size(reg) - 1
            if r == -1 and array.get(reg, i).mask == m
                r := i
    r

export flagSetOf(int mask, int bit) =>
    na(mask) or na(bit) or bit <= 0 ? mask : hasBit(mask, bit) ? mask : mask + bit

export dnumFromStr(string s) =>
    int r = na
    if str.length(s) >= 10
        float y = str.tonumber(str.substring(s, 0, 4))
        float m = str.tonumber(str.substring(s, 5, 7))
        float d = str.tonumber(str.substring(s, 8, 10))
        if not na(y) and not na(m) and not na(d)
            r := int(y) * 10000 + int(m) * 100 + int(d)
    r

export fillDateList(array<int> ds, array<int> us, string csv) =>
    string clean = str.replace_all(csv, " ", "")
    if str.length(clean) > 0
        array<string> parts = str.split(clean, ",")
        for i = 0 to array.size(parts) - 1
            string p  = array.get(parts, i)
            int    dv = dnumFromStr(p)
            if not na(dv)
                array.push(ds, dv)
                array.push(us, str.contains(p, ":U") ? 1 : 0)
    array.size(ds)

export buildZones(array<float> mP, array<int> mB, float locTol, float atrF, float mergeDist, float maxWidthMult, float refC) =>
    array<Zone> out = array.new<Zone>()
    int n = array.size(mP)

    if n > 0
        // 1. TOTAL-ORDER SORT by (price ascending, member bit ascending).
        //    Selection sort with an EXPLICIT comparator: correctness never
        //    depends on any library sort's behaviour for equal prices (§5.2).
        if n > 1
            for i = 0 to n - 2
                int best = i
                for j = i + 1 to n - 1
                    float pj = array.get(mP, j)
                    float pb = array.get(mP, best)
                    if pj < pb or (pj == pb and array.get(mB, j) < array.get(mB, best))
                        best := j
                if best != i
                    float tp = array.get(mP, i)
                    int   tb = array.get(mB, i)
                    array.set(mP, i, array.get(mP, best))
                    array.set(mB, i, array.get(mB, best))
                    array.set(mP, best, tp)
                    array.set(mB, best, tb)

        // 2. CLUSTERING. Admission compares each later member with the CLUSTER
        //    MINIMUM — the first member of the open cluster, which is the lowest
        //    because the array is sorted — and never with the last admitted
        //    member. That is exactly what forbids chained merging (§5.4).
        //    Clusters are contiguous index ranges over the sorted array.
        array<int> rLo = array.new_int()
        array<int> rHi = array.new_int()
        int cs = 0
        if n > 1
            for i = 1 to n - 1
                if array.get(mP, i) - array.get(mP, cs) > mergeDist
                    array.push(rLo, cs)
                    array.push(rHi, i - 1)
                    cs := i
        array.push(rLo, cs)
        array.push(rHi, n - 1)

        // 3. EXPANDED-WIDTH SPLITTING. Bounded worklist, as A15 §5 authorizes.
        //    With at most four members a cluster needs at most THREE actual
        //    splits to reach singletons, so three passes are structurally
        //    sufficient — this is a structural bound derived from the member
        //    count, not a truncation. Each pass splits the FIRST failing range
        //    in ascending order. Splitting a range depends only on that range,
        //    so the processing order cannot change the final partition: the
        //    result equals the recursive rule's partition exactly. This is NOT
        //    a single-level split — a child produced by a split is retested and
        //    can itself be split on a later pass.
        float maxW = maxWidthMult * atrF
        for pass = 0 to 2
            int target = -1
            for k = 0 to array.size(rLo) - 1
                if target == -1
                    int lo = array.get(rLo, k)
                    int hi = array.get(rHi, k)
                    if hi > lo                         // singleton children are terminal
                        float w = (array.get(mP, hi) + locTol) - (array.get(mP, lo) - locTol)
                        if w > maxW                    // STRICT predicate (§5.8)
                            target := k
            if target >= 0
                int lo = array.get(rLo, target)
                int hi = array.get(rHi, target)
                int   gAt   = lo
                float gBest = -1.0
                for g = lo to hi - 1
                    float gap = array.get(mP, g + 1) - array.get(mP, g)
                    if gap > gBest        // STRICT: on an exact tie the LOWEST-price
                        gBest := gap      // (leftmost) gap is retained (§5.10)
                        gAt   := g
                array.set(rHi, target, gAt)
                array.insert(rLo, target + 1, gAt + 1)
                array.insert(rHi, target + 1, hi)

        // 4. EMIT. Mask, anchor, bounds and confluence are recomputed
        //    INDEPENDENTLY for every final child (§5.11).
        for k = 0 to array.size(rLo) - 1
            int lo = array.get(rLo, k)
            int hi = array.get(rHi, k)
            int   m      = 0
            int   aBit   = 0
            int   aPri   = 0
            float aPrice = na
            for t = lo to hi
                int   b = array.get(mB, t)
                float p = array.get(mP, t)
                m += b                        // distinct bits => sum == bitwise OR
                int   pr = anchorPriOf(b)
                float d  = math.abs(p - refC)
                bool better = aBit == 0
                if not better
                    float dCur = math.abs(aPrice - refC)
                    better := pr < aPri or (pr == aPri and d < dCur) or (pr == aPri and d == dCur and b < aBit)
                if better
                    aBit   := b
                    aPri   := pr
                    aPrice := p
            array.push(out, Zone.new(mask = m, anchorBit = aBit, anchorPri = aPri, anchorPrice = aPrice, lower = array.get(mP, lo) - locTol, upper = array.get(mP, hi) + locTol, confluence = hi - lo + 1, minMemberPrice = array.get(mP, lo)))

    // 5. DETERMINISTIC EVIDENCE ORDER: (minimum member price ascending,
    //    zoneIdMask ascending). Storage order owns no semantics; active-zone
    //    selection is governed only by §15.7.
    int nz = array.size(out)
    if nz > 1
        for i = 0 to nz - 2
            int best = i
            for j = i + 1 to nz - 1
                Zone zj = array.get(out, j)
                Zone zb = array.get(out, best)
                if zj.minMemberPrice < zb.minMemberPrice or (zj.minMemberPrice == zb.minMemberPrice and zj.mask < zb.mask)
                    best := j
            if best != i
                Zone tmp = array.get(out, i)
                array.set(out, i, array.get(out, best))
                array.set(out, best, tmp)
    out

export s7_famText(int s7_family) =>
    s7_family == FAM_VWR ? "VWR" : s7_family == FAM_LBO ? "LBO" : s7_family == FAM_LRT ? "LRT" : s7_family == FAM_SQZ ? "SQZ" : S7_NA

export s7_dirText(int s7_dir) =>
    s7_dir == DIR_LONG ? "LONG" : s7_dir == DIR_SHORT ? "SHORT" : s7_dir == DIR_NEUTRAL ? "NEUTRAL" : S7_NA

export s7_priceText(float s7_v) =>
    na(s7_v) ? S7_NA : str.tostring(s7_v, format.mintick)

s7_numText(float s7_v, string s7_fmt) =>
    na(s7_v) ? S7_NA : str.tostring(s7_v, s7_fmt)

export s7_hhmm(int s7_ms) =>
    na(s7_ms) ? S7_NA : str.format_time(s7_ms, "HH:mm", TZ)

export s7_rejectText(int s7_rj) =>
    s7_rj == RJ_R4 ? "R4 SESSION BLOCKED" : s7_rj == RJ_R5 ? "R5 EVENT DAY BLOCK" : s7_rj == RJ_R6 ? "R6 TOO LATE" : s7_rj == RJ_R7 ? "R7 RISK TOO WIDE" : s7_rj == RJ_R8 ? "R8 RISK TOO TIGHT" : s7_rj == RJ_R9 ? "R9 NO ROOM" : s7_rj == RJ_R10 ? "R10 STOP UNDEFINED" : s7_rj == RJ_R12 ? "R12 STOP TECHNICALLY TOO CLOSE" : s7_rj == RJ_R13 ? "R13 RVOL NOT READY" : S7_NA

s7_deltaText(float s7_then, float s7_now, string s7_fmt, string s7_suffix) =>
    string s7_d = S7_NA
    if (not na(s7_then)) and (not na(s7_now))
        float s7_v = s7_now - s7_then
        s7_d := (s7_v > 0 ? "+" : "") + str.tostring(s7_v, s7_fmt) + s7_suffix
    s7_d

s7_slopeText(int s7_state) =>
    s7_state == DIR_LONG ? "RISING" : s7_state == DIR_SHORT ? "FALLING" : s7_state == DIR_NEUTRAL ? "FLAT" : S7_NA

s7_ratioText(float s7_v) =>
    na(s7_v) ? S7_NA : str.tostring(s7_v, "0.00") + "x"

export vp_dir(int vp_d) =>
    vp_d == DIR_LONG ? "CALL" : vp_d == DIR_SHORT ? "PUT" : vp_d == DIR_NEUTRAL ? "NEUTRAL" : VP_NA

export vp_fam(int vp_f) =>
    vp_f == FAM_VWR ? "VWAP RECLAIM" : vp_f == FAM_LBO ? "BREAKOUT" : vp_f == FAM_LRT ? "RETEST" : vp_f == FAM_SQZ ? "SQZ" : VP_NA

vp_entry(int vp_classCode) =>
    int vp_e = na(vp_classCode) ? na : int(math.floor(vp_classCode / 10.0)) % 10
    vp_e == EFF_EARLY ? "EARLY" : vp_e == EFF_CONFIRMED ? "READY" : vp_e == EFF_EXTENDED ? "EXTENDED" : vp_e == EFF_TOO_LATE ? "TOO LATE" : VP_NA

export vp_riskReason(int vp_rj) =>
    vp_rj == RJ_R4 ? "SESSION BLOCKED" : vp_rj == RJ_R5 ? "EVENT DAY BLOCK" : vp_rj == RJ_R6 ? "TOO LATE" : vp_rj == RJ_R7 ? "RISK TOO WIDE" : vp_rj == RJ_R8 ? "RISK TOO TIGHT" : vp_rj == RJ_R9 ? "NO ROOM" : vp_rj == RJ_R10 ? "STOP UNDEFINED" : vp_rj == RJ_R12 ? "STOP TOO CLOSE" : vp_rj == RJ_R13 ? "RVOL NOT READY" : VP_NA

export vp_roleToken(int vp_role) =>
    vp_role == ROLE_SUPPORT ? " · S" : vp_role == ROLE_RESISTANCE ? " · R" : ""

export vp_refName(int vp_bit) =>
    vp_bit == BIT_PDH ? "YDAY HIGH" : vp_bit == BIT_PDL ? "YDAY LOW" : vp_bit == BIT_ORH ? "OPEN HIGH" : vp_bit == BIT_ORL ? "OPEN LOW" : VP_NA

export vp_mix(color vp_base, color vp_tint, float vp_pct) =>
    color.rgb(color.r(vp_base) + (color.r(vp_tint) - color.r(vp_base)) * vp_pct,
      color.g(vp_base) + (color.g(vp_tint) - color.g(vp_base)) * vp_pct,
      color.b(vp_base) + (color.b(vp_tint) - color.b(vp_base)) * vp_pct, 0)

vp_a14Of(color vp_t, Theme TH) =>
    // theme prologue: re-bind palette to the parent names (body unchanged)
    color VPS_A14AMB = TH.VPS_A14AMB
    color VPS_A14MUT = TH.VPS_A14MUT
    color VPS_A14RED = TH.VPS_A14RED
    color VPS_A14REF = TH.VPS_A14REF
    color VPS_A14SUP = TH.VPS_A14SUP
    color s7c_amb = TH.s7c_amb
    color s7c_ref = TH.s7c_ref
    color s7c_res = TH.s7c_res
    color s7c_sup = TH.s7c_sup
    vp_t == s7c_ref ? VPS_A14REF : vp_t == s7c_amb ? VPS_A14AMB : vp_t == s7c_sup ? VPS_A14SUP : vp_t == s7c_res ? VPS_A14RED : VPS_A14MUT

