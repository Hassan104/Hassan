// ---- canonical record types (verbatim; exported so Main shares identity) ----
export type Zone
    int   mask           = 0
    int   anchorBit      = 0
    int   anchorPri      = 0
    float anchorPrice    = na
    float lower          = na
    float upper          = na
    int   confluence     = 0
    float minMemberPrice = na
    int   priceSide      = 0
    int   structuralRole = 0
    int   acceptedDir    = 0
    int   acceptBar      = na
    int   aboveRunCount  = 0
    int   belowRunCount  = 0
    int   touchCount     = 0
    bool  insideFlag     = false
    bool  brokenLong     = false
    bool  brokenShort    = false
    int   retestUseLong  = 0
    int   retestUseShort = 0

export type Arm
    int family       = 0
    int direction    = 0
    int zoneIdMask   = 0
    int armBar       = na
    int armExpiryBar = na
    int causalOwner  = 0
    // ---- M2 -> M4 INTERFACE EXTENSION (SAT06-A20 §4.2) ----------------------
    // Exactly three added NON-EXPORTED arm-history fields. The real key is still
    // exactly (family, direction, zoneIdMask) and is still unique. armBar,
    // armExpiryBar and every history field belong to ONE WHOLE real arm donor:
    // the R2 re-key/collision constructors below copy all nine fields from the
    // SELECTED donor, with no union, recomputation, min/max blending, reset or
    // field mixing. farEdgeContactSeen and worstAdvEdge are LRT-only history;
    // squeezeReleaseOrd is bound to its own real SQZ key and is never global.
    bool  farEdgeContactSeen = false
    float worstAdvEdge       = na
    int   squeezeReleaseOrd  = na

export type Obs
    // identity / context
    int   obsId                    = na
    int   obsBarTime               = na
    int   obsOrd                   = na
    int   slotIdx                  = na
    int   obsIndexInBar            = na
    int   family                   = 0
    int   direction                = 0
    int   dirCode                  = 0
    int   classCode                = na
    int   gapCode                  = na
    // Risk
    bool  riskPass                 = false
    int   rejectReason             = 0
    float plannedStop              = na
    float plannedRisk              = na
    float plannedTp1               = na
    float signalClose              = na
    float atrRefAtObs              = na
    float entryDistATR             = na
    float refLevel                 = na
    // zone / quality
    int   zoneIdMask               = 0
    int   confluence               = 0
    int   touchCount               = 0
    int   qFlagMask                = 0
    int   qApplicabilityMask       = 0
    int   vwapPriceTouchCount      = 0
    int   vwapZoneMotionTouchCount = 0
    // flags
    int   flagMask                 = 0
    // context values
    float relVol                   = na
    float relVolCum                = na
    float roc5                     = na
    float atrPct                   = na
    float atrRatio                 = na
    float adxVal                   = na
    float efficiencyRatio          = na
    // M5-owned future tags — initialized once to zero, never written by M4 again
    int   selectionStatus          = 0
    int   arbitrationReason        = 0
    // M6-owned future placeholders — initialized to na, never written by M4
    float referenceRisk            = na
    float refPrice                 = na
    float mfeUsd1                  = na
    float mfeUsd2                  = na
    float mfeUsd4                  = na
    float mfeUsd8                  = na
    float mfeUsd12                 = na
    float maeUsd1                  = na
    float maeUsd2                  = na
    float maeUsd4                  = na
    float maeUsd8                  = na
    float maeUsd12                 = na
    int   forwardBarsAvailable     = na
    // M6-owned INTERNAL queue / lifecycle state         (SAT06-A29 §3.3)
    // These six fields are queue / lifecycle state ONLY. They are NOT part of
    // the Frozen 38 exported record fields, are NOT new export titles and do
    // NOT alter stable identity. ONLY §24 writes them.
    // queueState's literal default 0 IS QUEUE_NOT_ADMITTED as declared at §24.3.
    // The literal is used here because Pine requires a constant to be declared
    // before its use as a field default, and the M6 vocabulary belongs with the
    // M6 module — every other default in this type is likewise a literal.
    // refCaptureDone is LOAD-BEARING: the first later same-session bar OWNS the
    // reference attempt even if its rthO is na, and a later bar may NEVER
    // silently substitute its own open as the reference.
    int   queueState               = 0      // 0 == QUEUE_NOT_ADMITTED (§24.3)
    int   readyAtOrd               = na
    int   forwardBarsSeen          = 0
    bool  refCaptureDone           = false
    float runningMfe               = na
    float runningMae               = na

