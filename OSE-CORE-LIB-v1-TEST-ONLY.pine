v4_panelCell(table t, int col, int row, int span, string value, color ink, color background, bool heading, int v4_font) =>
    if span > 1
        table.merge_cells(t, col, row, col + span - 1, row)
    table.cell_set_text(t, col, row, value)
    table.cell_set_text_color(t, col, row, ink)
    table.cell_set_bgcolor(t, col, row, background)
    // Tooltips are non-authoritative presentation metadata and are intentionally
    // omitted in this resource-reduction child; all governed facts remain visible.
    if heading
        table.cell_set_text_size(t, col, row, v4_font + 1)

opt_cell(table t, int col, int row, string value, color ink, color background, float width, int v4_font) =>
    table.cell(t, col, row, value, width = width, text_color = ink, bgcolor = background, text_size = v4_font, text_halign = text.align_center)

v4_eventSummary(string value) =>
    str.replace_all(array.get(str.split(value, " · "), 0), " — case active", "")

export v4_matrix(table t, int col, int row, int span, bool overlay, array<string> texts, array<color> inks, array<color> backgrounds, Theme TH, int v4_font, bool v4_hasObs, Obs v4_obs, color v4_sectionHead, string v4_signalOverlay, string v4_snapshotLabel) =>
    // theme prologue: re-bind palette to the parent names (body unchanged)
    color s7c_amb = TH.s7c_amb
    color s7c_card = TH.s7c_card
    color s7c_ink2 = TH.s7c_ink2
    int w1 = span == 4 ? 1 : 4
    int w2 = span == 4 ? 1 : 3
    array<int> widths = array.from(w1, w2, w2, span - w1 - 2 * w2)
    array<int> offsets = array.from(0, w1, w1 + w2, w1 + 2 * w2)
    array<string> heads = overlay ? array.from("SIGNAL", "AT", "Δ", "NOW") : array.from("SIGNAL", "AT SIGNAL", "CHANGE", "NOW")
    array<string> shortNames = array.from("ROC5", "RVOL", "ADX", "RSI", "STOP")
    bool ghost = overlay and v4_signalOverlay == "GHOST"
    string ident = v4_snapshotLabel + (v4_hasObs ? " · #" + str.tostring(v4_obs.obsId) + " · " + vp_dir(v4_obs.direction) + " · " + vp_fam(v4_obs.family) : "")
    for c = 0 to 3
        int x = col + array.get(offsets, c)
        v4_panelCell(t, x, row, array.get(widths, c), array.get(heads, c), ghost ? color.new(s7c_ink2, 25) : s7c_ink2, overlay ? color.new(s7c_amb, ghost ? 94 : 84) : v4_sectionHead, false, v4_font)
        table.cell_set_tooltip(t, x, row, ident)
        for r = 0 to 4
            int n = r * 4 + c
            string value = overlay and c == 0 ? array.get(shortNames, r) : array.get(texts, n)
            color ink = array.get(inks, n)
            color bg = array.get(backgrounds, n)
            v4_panelCell(t, x, row + 1 + r, array.get(widths, c), value, ghost ? color.new(ink, 25) : ink, overlay ? color.new(s7c_card, ghost ? 96 : 12) : bg, false, v4_font)
            if overlay and c == 0
                table.cell_set_tooltip(t, x, row + 1 + r, array.get(texts, n) + " · " + ident)

export v4_matrixTruth(Theme TH, float rf1_outRsi, float rf1_outRsiAtSignal, bool rf1_outSignalCaptured, bool s7_caseActive, int s7_caseId, float s7_trailStop, int s7_trailVersion, bool v4_hasObs, bool v4_matrixLive, Obs v4_obs) =>
    // theme prologue: re-bind palette to the parent names (body unchanged)
    color VPS_A14AMB = TH.VPS_A14AMB
    color VPS_A14RED = TH.VPS_A14RED
    color VPS_A14REF = TH.VPS_A14REF
    color VPS_A14SUP = TH.VPS_A14SUP
    color VPS_Q0 = TH.VPS_Q0
    color VPS_Q4MUT = TH.VPS_Q4MUT
    color VPS_Q4RED = TH.VPS_Q4RED
    color VPS_X32REF = TH.VPS_X32REF
    color VPS_X32SUP = TH.VPS_X32SUP
    color s7c_amb = TH.s7c_amb
    color s7c_bad = TH.s7c_bad
    color s7c_card = TH.s7c_card
    color s7c_ink = TH.s7c_ink
    color s7c_ink2 = TH.s7c_ink2
    color s7c_mut = TH.s7c_mut
    color s7c_ref = TH.s7c_ref
    color s7c_res = TH.s7c_res
    color s7c_sup = TH.s7c_sup
    array<string> texts = array.new_string()
    array<color> inks = array.new_color()
    array<color> backgrounds = array.new_color()
    bool live = v4_matrixLive
    // 5 STOP REFERENCE — AT SIGNAL is the immutable original STOP and keeps its
    // red STOP identity; CHANGE is a signed price distance, NOT profit or loss.
    bool  sameCase  = s7_caseActive and v4_hasObs and (not na(s7_caseId)) and v4_obs.obsId == s7_caseId
    float stopNow   = sameCase ? s7_trailStop : na
    bool  stopMoved = sameCase and s7_trailVersion > 0

    // The five approved rows, described as data. Row order, units, anchor
    // immutability and per-column colour ownership are exactly as before; only
    // the repeated render branch is consolidated.
    //   1 ROC5 — the NOW cell keeps a restrained signed TEXT identity. No live
    //     momentum-support producer exists, so no A / X state and no raw ROC5
    //     threshold is attached to it.
    //   2 RVOL · 5m SLOT — always C19. C60 is never substituted here.
    //   4 RSI — the row EXISTS NOW. No RSI producer and no same-case RSI anchor
    //     snapshot exist, so all three columns read —. Nothing is calculated
    //     here and no current RSI is ever attached to an old case.
    array<string> vp_rN = array.from("ROC5", "RVOL · 5m SLOT", "ADX", "RSI", "STOP REFERENCE")
    array<float>  vp_rO = array.from(v4_hasObs ? v4_obs.roc5 : na, v4_hasObs ? v4_obs.relVol : na, v4_hasObs ? v4_obs.adxVal : na, rf1_outRsiAtSignal, v4_hasObs ? v4_obs.plannedStop : na)
    array<float>  vp_rC = array.from(roc5, relVol, adxVal, rf1_outRsi, stopNow)
    array<string> vp_rF = array.from("0.0000", "0.00", "0.00", "0.0", format.mintick)
    array<string> vp_rS = array.from("%", "x", "", "", "")
    array<string> vp_rU = array.from(" pp", "x", "", " pts", "")
    array<bool>   vp_rL = array.from(live, live, live, live and rf1_outSignalCaptured, sameCase)
    array<color>  vp_rNm = array.from(s7c_ink2, s7c_ink2, s7c_ink2, s7c_ink2, s7c_bad)
    array<color>  vp_rOi = array.from(s7c_ink2, s7c_ink2, s7c_ink2, s7c_ink2, s7c_bad)
    array<color>  vp_rOb = array.from(VPS_Q4MUT, VPS_Q4MUT, VPS_Q4MUT, VPS_Q4MUT, VPS_Q4RED)
    array<color>  vp_rNi = array.from(na(roc5) ? s7c_mut : roc5 > 0 ? s7c_sup : roc5 < 0 ? s7c_res : s7c_ink, vp_c19Tint(relVol, TH), vp_adxTint(adxVal, TH), s7c_mut, stopMoved ? s7c_ref : s7c_bad)
    array<color>  vp_rNo = array.from(s7c_mut, s7c_mut, s7c_mut, s7c_mut, s7c_bad)
    array<color>  vp_rNb = array.from(VPS_Q0, vp_c19Bg(relVol, TH), vp_adxBg(adxVal, TH), VPS_Q4MUT, stopMoved ? VPS_A14REF : VPS_Q0)
    for vp_r = 0 to 4
        string vp_f  = array.get(vp_rF, vp_r)
        float  vp_o  = array.get(vp_rO, vp_r)
        float  vp_n  = array.get(vp_rC, vp_r)
        bool   vp_lv = array.get(vp_rL, vp_r)
        // `live` is the accepted next-confirmed-bar gate: on the elected
        // opportunity's own anchor bar CHANGE and NOW stay unavailable, because
        // no later bar exists yet (A49 / C-03 §3.3-3.5). Neither column ever
        // writes back to the frozen anchor.
        array<string> vp_cT = array.from(array.get(vp_rN, vp_r),
          na(vp_o) ? VP_NA : str.tostring(vp_o, vp_f) + array.get(vp_rS, vp_r),
          vp_lv ? s7_deltaText(vp_o, vp_n, vp_f, array.get(vp_rU, vp_r)) : VP_NA,
          vp_lv ? (na(vp_n) ? VP_NA : str.tostring(vp_n, vp_f) + array.get(vp_rS, vp_r)) : VP_NA)
        array<color> vp_cI = array.from(array.get(vp_rNm, vp_r), array.get(vp_rOi, vp_r), s7c_ink2,
          vp_lv ? array.get(vp_rNi, vp_r) : array.get(vp_rNo, vp_r))
        array<color> vp_cB = array.from(s7c_card, array.get(vp_rOb, vp_r), VPS_Q0,
          vp_lv ? array.get(vp_rNb, vp_r) : VPS_Q4MUT)
        for vp_c = 0 to 3
            array.push(texts, array.get(vp_cT, vp_c))
            array.push(inks, array.get(vp_cI, vp_c))
            array.push(backgrounds, array.get(vp_cB, vp_c))
    [texts, inks, backgrounds]

export v4_liveBand(table t, int row, Theme TH, bool actualRthBar, float atrLive, float atrPctVal, float atrRatioVal, int impulseDirState, bool impulseExcessiveState, float rf1_outDelta, string rf1_outDeltaClassification, string rf1_outDeltaCoverage, float rf1_outDeltaNegative, float rf1_outDeltaPositive, string rf1_outDeltaReconciliation, float rf1_outDeltaUnclassified, float rf1_outDiMinus, float rf1_outDiPlus, float rf1_outMacdHistogram, float rf1_outMacdLine, float rf1_outMacdSignal, string rf1_outPhase, float rf1_outPoc, string rf1_outProfileParentQuality, float rf1_outRsi, float rf1_outSessionCvd, string rf1_outSessionDeltaQuality, float rf1_outVah, float rf1_outVal, int s7_candDir, bool s7_candLive, bool s7_caseActive, int s7_caseDir, bool s7_coreReady, bool s7_impulseOn, string s7_revEvtText, bool s7_warnActive, int structBias, int v4_font, float vwap, float vwapSlopeRaw, int vwapSlopeState) =>
    // theme prologue: re-bind palette to the parent names (body unchanged)
    color VPS_A14AMB = TH.VPS_A14AMB
    color VPS_A14MUT = TH.VPS_A14MUT
    color VPS_A14RED = TH.VPS_A14RED
    color VPS_A14REF = TH.VPS_A14REF
    color VPS_A14SUP = TH.VPS_A14SUP
    color VPS_Q0 = TH.VPS_Q0
    color VPS_Q4MUT = TH.VPS_Q4MUT
    color VPS_X32AMB = TH.VPS_X32AMB
    color VPS_X32MUT = TH.VPS_X32MUT
    color VPS_X32RED = TH.VPS_X32RED
    color VPS_X32REF = TH.VPS_X32REF
    color VPS_X32SUP = TH.VPS_X32SUP
    color VPS_X36RED = TH.VPS_X36RED
    color s7c_amb = TH.s7c_amb
    color s7c_bad = TH.s7c_bad
    color s7c_ink = TH.s7c_ink
    color s7c_ink2 = TH.s7c_ink2
    color s7c_mut = TH.s7c_mut
    color s7c_ref = TH.s7c_ref
    color s7c_res = TH.s7c_res
    color s7c_sup = TH.s7c_sup
    // Ten conceptual cells stay in the approved order. Only RVOL keeps a
    // two-part internal split so C19 and C60 retain independent P-02/P-03
    // salience. ADX/+DI/-DI and ATR/ATR%/RATIO are compacted inside their
    // owning conceptual cells; no information or producer is removed.
    float vp_rsiNow = rf1_outRsi

    string vp_vwapV = "VWAP\n" + s7_priceText(vwap) + "\n" + s7_slopeText(vwapSlopeState) + " " + s7_numText(vwapSlopeRaw, "0.000")
    color vp_vwapTnt = s7c_ink
    color vp_vwapBg = VPS_Q0
    if s7_caseActive and not na(vwapSlopeState)
        bool vp_vsup = vwapSlopeState == s7_caseDir
        vp_vwapV := "VWAP " + (vp_vsup ? VP_I_PASS : VP_I_FAIL) + "\n" + s7_priceText(vwap) + "\n" + s7_slopeText(vwapSlopeState) + " " + s7_numText(vwapSlopeRaw, "0.000")
        vp_vwapTnt := vp_vsup ? s7c_sup : s7c_amb
        vp_vwapBg := vp_vsup ? VPS_A14SUP : VPS_A14AMB

    color vp_atrTn = vp_atrTint(atrRatioVal, TH)
    color vp_atrBk = vp_atrBg(atrRatioVal, TH)

    string vp_impV = "OFF"
    color vp_impTnt = s7c_mut
    color vp_impBg = VPS_Q0
    if not s7_coreReady
        vp_impV := not actualRthBar ? VP_I_LOCALNA : VP_I_WARM
        vp_impBg := VPS_Q4MUT
    else if s7_impulseOn
        bool vp_impUp = impulseDirState == DIR_LONG
        bool vp_impDn = impulseDirState == DIR_SHORT
        vp_impV := (impulseExcessiveState ? "IMP+" : "IMP") + (vp_impUp ? " ↑" : vp_impDn ? " ↓" : "")
        vp_impTnt := vp_impUp ? s7c_sup : vp_impDn ? s7c_res : s7c_mut
        vp_impBg := impulseExcessiveState ? (vp_impUp ? VPS_X32SUP : vp_impDn ? VPS_X32RED : VPS_X32MUT) : (vp_impUp ? VPS_A14SUP : vp_impDn ? VPS_A14RED : VPS_A14MUT)
        if s7_caseActive and impulseDirState != DIR_NEUTRAL and impulseDirState == -s7_caseDir
            vp_impV += "\n" + VP_I_WARN + " AGAINST CASE"
            vp_impTnt := s7c_amb

    string vp_daV = VP_NA
    color vp_daTnt = s7c_mut
    color vp_daBg = VPS_Q0
    if str.length(s7_revEvtText) > 0
        vp_daV := VP_I_HARD + " " + VP_I_WARN + " " + vp_dir(s7_caseActive ? s7_caseDir : structBias)
        vp_daTnt := s7c_bad
        vp_daBg := VPS_X36RED
    else if s7_caseActive and s7_candLive
        vp_daV := VP_I_WARN + VP_I_ESC + " REVERSAL WATCH\n" + vp_dir(s7_candDir)
        vp_daTnt := s7c_amb
        vp_daBg := VPS_X32AMB
    else if s7_caseActive and s7_warnActive
        vp_daV := "AGAINST CASE"
        vp_daTnt := s7c_amb
        vp_daBg := VPS_A14AMB
    else if s7_caseActive
        vp_daV := "WITH CASE"
        vp_daTnt := s7c_ink2

    // Ten conceptual cells occupy the full width. RVOL alone has two actual
    // columns at 2:1 width so NOW and SESSION stay independently colored.
    array<string> vp_v = array.from(
      "RSI\n" + s7_numText(vp_rsiNow, "0.0") + "\n30 / 70",
      "MACD HIST\n" + s7_numText(rf1_outMacdHistogram, "0.000") + "\nMACD " + s7_numText(rf1_outMacdLine, "0.000") + " · SIG " + s7_numText(rf1_outMacdSignal, "0.000"),
      "ADX\n" + s7_numText(adxVal, "0.0") + "\n+DI " + s7_numText(rf1_outDiPlus, "0.0") + " · -DI " + s7_numText(rf1_outDiMinus, "0.0"),
      "RVOL NOW\n" + s7_ratioText(relVol) + "\nRVOL " + VP_NA,
      "SESSION\n" + s7_ratioText(relVolCum),
      "VOLUME DELTA\n" + s7_numText(rf1_outDelta, format.volume) + "\nEST. " + (rf1_outDeltaCoverage == "COMPLETE" and rf1_outDeltaReconciliation == "MATCH" ? (rf1_outDeltaClassification == "CLASSIFIED" ? "" : "UNCLASS.") : "PARTIAL / NA"),
      vp_vwapV,
      "VOLUME\nPROFILE EST.\nPOC " + s7_priceText(rf1_outPoc) + " · VAH " + s7_priceText(rf1_outVah) + "\nVAL " + s7_priceText(rf1_outVal),
      "ATR\n" + s7_numText(atrLive, format.mintick) + "\nATR% " + s7_numText(atrPctVal, "0.00") + "%\nRATIO " + s7_numText(atrRatioVal, "0.00"),
      "IMPULSE\n" + vp_impV,
      "DIRECTION\nALERT\n" + vp_daV + "\n" + s7_hhmm(time_close))
    array<color> vp_i = array.from(s7c_mut, s7c_mut, vp_adxTint(adxVal, TH), vp_c19Tint(relVol, TH), vp_c60Tint(relVolCum, TH), s7c_mut, vp_vwapTnt, s7c_mut, vp_atrTn, vp_impTnt, vp_daTnt)
    array<color> vp_b = array.from(VPS_Q4MUT, VPS_Q4MUT, vp_adxBg(adxVal, TH), vp_c19Bg(relVol, TH), vp_c60Bg(relVolCum, TH), VPS_Q4MUT, vp_vwapBg, VPS_Q4MUT, vp_atrBk, vp_impBg, vp_daBg)
    for vp_n = 0 to 10
        v4_panelCell(t, vp_n, row, 1, array.get(vp_v, vp_n), array.get(vp_i, vp_n), array.get(vp_b, vp_n), false, v4_font)
    table.cell_set_tooltip(t, 5, row, "Estimated price-direction delta (1m). " + rf1_outPhase + "\nCoverage: " + rf1_outDeltaCoverage + " / reconciliation: " + rf1_outDeltaReconciliation + "\nPositive: " + s7_numText(rf1_outDeltaPositive, format.volume) + " / negative: " + s7_numText(rf1_outDeltaNegative, format.volume) + " / unclassified: " + s7_numText(rf1_outDeltaUnclassified, format.volume) + "\nSession CVD: " + s7_numText(rf1_outSessionCvd, format.volume) + " / " + rf1_outSessionDeltaQuality)
    table.cell_set_tooltip(t, 7, row, "Estimated OHLCV profile. Parent quality: " + rf1_outProfileParentQuality + ". Session completeness is not certified by R1.\nHistogram: committed session, at most 120 display groups; orange = POC, blue = value area. Levels use original bins. Requires 11 eligible calibration sessions.")

export v4_workspace(table t, Theme TH, bool commonSetupReady, float orHigh, float orLow, bool orReady, float pdh, float pdl, float s7_barrier, int s7_candFamily, bool s7_candLive, int s7_candObsId, int s7_candTime, bool s7_caseActive, string s7_caseEndReason, bool s7_caseEndedFlag, int s7_caseId, float s7_caseInitialStop, float s7_caseTp1, array<string> s7_evtText, int s7_premiseMask, bool s7_premiseTrace, float s7_room, bool s7_tp1Reached, string s7_trailReason, float s7_trailStop, bool s7_trailUnlocked, int s7_trailVersion, bool sqzCoreReady, bool staticCoreReady, int v4_barrierRole, string v4_cMode, array<V4Coverage> v4_coverage, array<V4Event> v4_events, int v4_font, bool v4_hasObs, Obs v4_obs, string v4_reviewHorizon, color v4_sectionHead, string vp_zoneBounds, string vp_zoneName, int vp_zoneRole) =>
    // theme prologue: re-bind palette to the parent names (body unchanged)
    color VPS_A14AMB = TH.VPS_A14AMB
    color VPS_A14REF = TH.VPS_A14REF
    color VPS_Q0 = TH.VPS_Q0
    color VPS_Q4MUT = TH.VPS_Q4MUT
    color VPS_X32REF = TH.VPS_X32REF
    color s7c_amb = TH.s7c_amb
    color s7c_bad = TH.s7c_bad
    color s7c_ink = TH.s7c_ink
    color s7c_ink2 = TH.s7c_ink2
    color s7c_mut = TH.s7c_mut
    color s7c_ref = TH.s7c_ref
    bool review = v4_cMode == "REVIEW"
    bool ownsCase = v4_hasObs and not na(s7_caseId) and v4_obs.obsId == s7_caseId
    string phase = ownsCase ? (s7_tp1Reached ? "AFTER TP1" : "BEFORE TP1") : VP_NA
    array<string> labels = array.new_string()
    array<string> values = array.new_string()
    array<string> historyTips = array.new_string(5, "")
    if review
        string ended = ownsCase and s7_caseEndedFlag ? (s7_caseEndReason == "MGMT_INV_BREACH" ? "STOP BREAK" : s7_caseEndReason == "REVERSAL_CONFIRMED" ? "REVERSAL CONFIRMED" : s7_caseEndReason == "SESSION_TERMINAL" ? "SESSION END" : VP_NA) : VP_NA
        labels := array.from("CASE / TIME", "FAMILY / SIDE", "SIGNAL / REF", "PLAN / REF RISK", "ENDED / PHASE", "", "", "", "", "", "MFE / MAE · @" + v4_reviewHorizon, "EFFICIENCY · AT / NOW", "ENTRY · ATR", "ATR% / RATIO · AT", "FORWARD · SEEN / AVAILABLE")
        array<float> mfes = v4_hasObs ? array.from(v4_obs.mfeUsd1, v4_obs.mfeUsd2, v4_obs.mfeUsd4, v4_obs.mfeUsd8, v4_obs.mfeUsd12) : array.new_float(5, na)
        array<float> maes = v4_hasObs ? array.from(v4_obs.maeUsd1, v4_obs.maeUsd2, v4_obs.maeUsd4, v4_obs.maeUsd8, v4_obs.maeUsd12) : array.new_float(5, na)
        int horizon = v4_reviewHorizon == "1" ? 0 : v4_reviewHorizon == "2" ? 1 : v4_reviewHorizon == "4" ? 2 : v4_reviewHorizon == "8" ? 3 : 4
        values := array.from(
          v4_hasObs ? "#" + str.tostring(v4_obs.obsId) + " · " + s7_hhmm(v4_obs.obsBarTime) : VP_NA,
          v4_hasObs ? vp_fam(v4_obs.family) + " · " + vp_dir(v4_obs.direction) : VP_NA,
          s7_priceText(v4_hasObs ? v4_obs.signalClose : na) + " / " + s7_priceText(v4_hasObs ? v4_obs.refPrice : na),
          s7_priceText(v4_hasObs ? v4_obs.plannedRisk : na) + " / " + s7_priceText(v4_hasObs ? v4_obs.referenceRisk : na),
          ended + " / " + phase, VP_NA, VP_NA, VP_NA, VP_NA, VP_NA,
          s7_priceText(array.get(mfes, horizon)) + " / " + s7_priceText(array.get(maes, horizon)),
          s7_numText(v4_hasObs ? v4_obs.efficiencyRatio : na, "0.000") + " / " + s7_numText(efficiencyRatio, "0.000"),
          s7_numText(v4_hasObs ? v4_obs.entryDistATR : na, "0.000"),
          s7_numText(v4_hasObs ? v4_obs.atrPct : na, "0.00") + "% / " + s7_numText(v4_hasObs ? v4_obs.atrRatio : na, "0.00") + "x",
          v4_hasObs ? str.tostring(v4_obs.forwardBarsSeen) + " / " + (na(v4_obs.forwardBarsAvailable) ? VP_NA : str.tostring(v4_obs.forwardBarsAvailable)) : VP_NA)
        // Same retained ledger and descending candle sort as the parent. Never
        // rewrite records or create history from the current analytical state.
        if array.size(v4_events) > 0
            array<int> stamps = array.new_int()
            for i = 0 to array.size(v4_events) - 1
                array.push(stamps, array.get(v4_events, i).candle)
            array<int> indices = array.sort_indices(stamps, order.descending)
            for i = 0 to math.min(5, array.size(indices)) - 1
                V4Event e = array.get(v4_events, array.get(indices, i))
                array.set(labels, 5 + i, str.format_time(e.candle, "MM-dd HH:mm", TZ))
                array.set(values, 5 + i, v4_eventSummary(e.title))
                array.set(historyTips, i, e.title + "\n" + e.detail)
    else
        string change = VP_NA
        if array.size(s7_evtText) > 0
            for i = 0 to array.size(s7_evtText) - 1
                string eventText = array.get(s7_evtText, i)
                if str.startswith(eventText, "VWAP " + VP_I_FAIL)
                    change := "SLOPE SUPPORT LOST"
        float move = v4_hasObs and not na(v4_obs.plannedTp1) and not na(v4_obs.signalClose) ? math.abs(v4_obs.plannedTp1 - v4_obs.signalClose) : na
        labels := array.from("PHASE", "STOP / STOP+", "TP1 / TP+", "STOP+ UPDATE", "PLANNED TP1 MOVE", "ACTIVE ZONE", "ROOM", "YDAY HIGH / LOW", "OPEN HIGH / LOW", "ZONE BOUNDS", "RISK DETAIL", "STRUCTURE DETAIL", "REVERSAL DETAIL", "VWAP CHANGE", "READINESS · VWR / BR-RT / SQZ")
        values := array.from(
          s7_caseActive ? phase + (s7_trailUnlocked ? " · STOP+ ON" : "") : VP_NA,
          s7_priceText(s7_caseActive ? s7_caseInitialStop : na) + " / " + s7_priceText(s7_caseActive ? s7_trailStop : na),
          s7_priceText(s7_caseActive ? s7_caseTp1 : na) + (s7_caseActive and s7_tp1Reached ? " " + VP_I_PASS : "") + " / " + s7_priceText(s7_barrier) + (na(s7_barrier) ? "" : vp_roleToken(v4_barrierRole)),
          s7_caseActive ? "v" + str.tostring(s7_trailVersion) + " · " + s7_trailReason : VP_NA,
          s7_priceText(move),
          vp_zoneName + vp_roleToken(vp_zoneRole), s7_priceText(s7_room),
          s7_priceText(pdh) + " / " + s7_priceText(pdl),
          orReady ? s7_priceText(orHigh) + " / " + s7_priceText(orLow) : VP_NA,
          vp_zoneBounds,
          v4_hasObs ? (v4_obs.riskPass ? "STOP DIST " + s7_priceText(v4_obs.plannedRisk) : vp_riskReason(v4_obs.rejectReason)) : VP_NA,
          v4_hasObs ? vp_zoneText(v4_obs.zoneIdMask) + " · " + str.tostring(v4_obs.confluence) + " refs" : VP_NA,
          s7_caseActive and s7_candLive ? "#" + str.tostring(s7_candObsId) + " · " + vp_fam(s7_candFamily) + " · " + s7_hhmm(s7_candTime) : VP_NA,
          change,
          (commonSetupReady ? VP_I_PASS : VP_I_WARM) + " / " + (staticCoreReady ? VP_I_PASS : VP_I_WARM) + " / " + (sqzCoreReady ? VP_I_PASS : VP_I_WARM))
    // C: five cards across, three bands down. Labels and values use adjacent
    // physical rows, sharing exactly the six rows occupied by B. A's unmerged
    // first row supplies real widths to every column; no sizing/spacer row.
    array<int> order = review ? array.from(0, 1, 2, 3, 4, 10, 11, 12, 13, 14, 5, 6, 7, 8, 9) : array.from(0, 1, 2, 5, 6, 7, 8, 10, 11, 12, 3, 4, 9, 13, 14)
    array<int> cols = array.from(4, 6, 7, 8, 9)
    array<int> spans = array.from(2, 1, 1, 1, 2)
    int dropped = 0
    if review and array.size(v4_coverage) > 0
        for i = 0 to array.size(v4_coverage) - 1
            V4Coverage coverage = array.get(v4_coverage, i)
            dropped += coverage.droppedEvents + coverage.droppedRanges + coverage.droppedLevels
    for band = 0 to 2
        for card = 0 to 4
            int n = array.get(order, band * 5 + card)
            int col = array.get(cols, card)
            int span = array.get(spans, card)
            int row = 2 + band * 2
            string fieldName = array.get(labels, n)
            string fieldValue = array.get(values, n)
            color ink = not review and n == 1 ? s7c_bad : s7c_ink2
            color background = VPS_Q0
            // Restore established P-04 diagnostic salience, never profit/loss.
            if review and n == 11
                ink := vp_erTint(efficiencyRatio, TH)
                background := vp_erBg(efficiencyRatio, TH)
            if review and n >= 5 and n <= 9
                fieldName := "HISTORY " + str.tostring(card + 1) + (str.length(fieldName) > 0 ? " · " + fieldName : "")
                if card == 0
                    fieldName := (dropped > 0 ? "INCOMPLETE" : array.size(v4_coverage) < 3 ? "PARTIAL" : "HISTORY 1") + (str.length(array.get(labels, n)) > 0 ? " · " + array.get(labels, n) : "")
            v4_panelCell(t, col, row, span, fieldName, s7c_ink2, v4_sectionHead, false, v4_font)
            v4_panelCell(t, col, row + 1, span, fieldValue, ink, background, false, v4_font)
            string detail = review and n >= 5 and n <= 9 ? array.get(historyTips, n - 5) : fieldName + " · " + fieldValue
            if not review and n == 11
                detail += s7_caseActive and s7_premiseTrace ? " · PREMISE " + vp_zoneText(s7_premiseMask) : ""
            table.cell_set_tooltip(t, col, row + 1, detail)
    true

export v4_makeTopBar(Theme TH, bool s7_qOk, int s7_qPass, int s7_stripAppl, int s7_stripFlag, int v4_font, bool v4_hasObs, Obs v4_obs, int v4_topClearance, int vp_dirVal, color vp_evtBg, string vp_evtCell, color vp_evtTnt, int vp_famVal, color vp_sqzBg, string vp_sqzCell, color vp_sqzTnt, string vp_state, color vp_stateBg, string vp_stateTip, color vp_stateTnt, string vp_zoneBounds, string vp_zoneName, int vp_zoneRole) =>
    // theme prologue: re-bind palette to the parent names (body unchanged)
    color VPS_A14AMB = TH.VPS_A14AMB
    color VPS_A14RED = TH.VPS_A14RED
    color VPS_A14REF = TH.VPS_A14REF
    color VPS_A14SUP = TH.VPS_A14SUP
    color VPS_Q0 = TH.VPS_Q0
    color VPS_Q4MUT = TH.VPS_Q4MUT
    color VPS_X32AMB = TH.VPS_X32AMB
    color VPS_X32RED = TH.VPS_X32RED
    color s7c_amb = TH.s7c_amb
    color s7c_bad = TH.s7c_bad
    color s7c_card = TH.s7c_card
    color s7c_clear = TH.s7c_clear
    color s7c_grid = TH.s7c_grid
    color s7c_ink2 = TH.s7c_ink2
    color s7c_mut = TH.s7c_mut
    color s7c_ref = TH.s7c_ref
    color s7c_res = TH.s7c_res
    color s7c_sup = TH.s7c_sup
    table t = table.new(position.top_right, 14, 3, bgcolor = s7c_clear,
      frame_color = s7c_grid, frame_width = 1, border_color = s7c_grid, border_width = 1, force_overlay = true)

    string vp_entryV = v4_hasObs ? vp_entry(v4_obs.classCode) : VP_NA
    color vp_entryInk = vp_entryV == "READY" ? s7c_sup : (vp_entryV == "EARLY" or vp_entryV == "EXTENDED" or vp_entryV == "TOO LATE") ? s7c_amb : s7c_mut
    color vp_entryBg = vp_entryV == "READY" ? VPS_A14SUP : vp_entryV == "TOO LATE" ? VPS_X32AMB : (vp_entryV == "EARLY" or vp_entryV == "EXTENDED") ? VPS_A14AMB : v4_hasObs ? VPS_Q4MUT : VPS_Q0

    string vp_riskV = VP_NA
    color vp_riskInk = s7c_mut
    color vp_riskBg = VPS_Q0
    if v4_hasObs
        vp_riskV := v4_obs.riskPass ? VP_I_PASS : VP_I_FAIL
        vp_riskInk := v4_obs.riskPass ? s7c_sup : s7c_bad
        vp_riskBg := v4_obs.riskPass ? VPS_A14SUP : VPS_X32RED

    string vp_stV = VP_I_LOCALNA
    color vp_stInk = s7c_mut
    color vp_stBg = VPS_Q4MUT
    if s7_structText == "INTACT"
        vp_stV := VP_I_PASS
        vp_stInk := s7c_sup
        vp_stBg := VPS_A14SUP
    else if s7_structText == "LOST"
        vp_stV := VP_I_FAIL
        vp_stInk := s7c_bad
        vp_stBg := VPS_X32RED

    bool vp_famOn = vp_famVal != 0
    array<string> vp_v = array.from(vp_state, vp_dir(vp_dirVal), vp_famOn ? vp_fam(vp_famVal) : VP_NA, vp_entryV, vp_riskV, vp_stV, v4_eventSummary(vp_evtCell))
    array<color> vp_i = array.from(vp_stateTnt, vp_dirTint(vp_dirVal, TH), vp_famOn ? s7c_ref : s7c_mut, vp_entryInk, vp_riskInk, vp_stInk, vp_evtTnt)
    array<color> vp_b = array.from(vp_stateBg, vp_dirVal == DIR_LONG ? VPS_A14SUP : vp_dirVal == DIR_SHORT ? VPS_A14RED : VPS_Q4MUT, vp_famOn ? VPS_A14REF : VPS_Q0, vp_entryBg, vp_riskBg, vp_stBg, vp_evtBg)
    // Fixed 67% strip at the top right; the left third remains available.
    float scale = 0.67
    array<float> weights = array.from(10.0, 8.0, 9.0, 8.0, 5.0, 8.0, 15.0, 6.0, 4.0, 4.0, 4.0, 5.0, 5.0, 9.0)
    array<string> labels = array.from("STATE", "DIRECTION", "FAMILY", "ENTRY", "RISK", "STRUCTURE", "EVENT", "CHECKS", "RVOL", "MOM", "LOC", "FRESH", "VWAP", "SQZ")
    for n = 0 to 13
        table.cell(t, n, 0, "", width = array.get(weights, n) * scale / 1.08, height = math.max(0.1, v4_topClearance), bgcolor = s7c_clear)
    table.merge_cells(t, 0, 0, 13, 0)
    for n = 0 to 13
        opt_cell(t, n, 1, array.get(labels, n), s7c_ink2, s7c_card, array.get(weights, n) * scale / 1.08, v4_font)
    for vp_n = 0 to 6
        opt_cell(t, vp_n, 2, array.get(vp_v, vp_n), array.get(vp_i, vp_n), array.get(vp_b, vp_n), 0, v4_font)

    opt_cell(t, 7, 2, s7_qOk ? str.tostring(s7_qPass) + "/5" : VP_NA, s7c_ink2, VPS_Q4MUT, 0, v4_font)
    bool vp_ok = (not na(s7_stripFlag)) and (not na(s7_stripAppl)) and s7_stripFlag >= 0 and s7_stripFlag <= 31 and s7_stripAppl >= 0 and s7_stripAppl <= 31
    array<int> vp_qb = array.from(QB_Q1, QB_Q2, QB_Q3, QB_Q4, QB_Q5)
    for vp_n = 0 to 4
        int vp_bit = array.get(vp_qb, vp_n)
        string vp_qv = VP_NA
        color vp_qi = s7c_mut
        color vp_qbkg = VPS_Q4MUT
        if vp_ok
            if not hasBit(s7_stripAppl, vp_bit)
                vp_qv := VP_I_LOCALNA
            else if hasBit(s7_stripFlag, vp_bit)
                vp_qv := VP_I_PASS
                vp_qi := s7c_sup
                vp_qbkg := VPS_A14SUP
            else
                vp_qv := "NO"
                vp_qi := s7c_ink2
                vp_qbkg := VPS_Q0
        opt_cell(t, vp_n + 8, 2, vp_qv, vp_qi, vp_qbkg, 0, v4_font)
    opt_cell(t, 13, 2, str.replace_all(vp_sqzCell, "SQZ ", ""), vp_sqzTnt, vp_sqzBg, 0, v4_font)
    table.cell_set_tooltip(t, 0, 2, vp_stateTip)
    table.cell_set_tooltip(t, 4, 2, v4_hasObs ? s7_rejectText(v4_obs.rejectReason) : "No signal snapshot")
    table.cell_set_tooltip(t, 5, 2, vp_zoneName + vp_roleToken(vp_zoneRole) + " · " + vp_zoneBounds)
    table.cell_set_tooltip(t, 6, 2, vp_evtCell)
    for n = 0 to 13
        table.cell_set_width(t, n, 2, array.get(weights, n) * scale / 1.08)
    t

