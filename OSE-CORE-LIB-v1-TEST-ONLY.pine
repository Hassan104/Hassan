//@version=6
// =============================================================================
//  OSE_CORE_LIB — CANONICAL CORE LIBRARY — v1 — TEST ONLY (C1 CANDIDATE)
// 
//  Relocation host for the canonical OSE deterministic computation domain:
//    1  canonical record TYPES (Zone/Arm/Obs/V4*) so the Main and this library
//       share one type identity;
//    2  pure scalar/geometry KERNELS;
//    3  pure TEXT/vocabulary helpers;
//    4  presentation SALIENCE helpers (VP-07 bands);
//    5  presentation COMPUTATION / table-writing renderers.
// 
//  PARENT (C0 Main)  : OSE-PRE8-RF1-R6-R7-INTEGRATED-v0.1.4-LIB-TEST-ONLY.pine
//    SHA-256         : 65c1250c0563b2d8493dbe85feb7fe93db8abb924c02e5dd1b213e07cdad5e03
// 
//  EQUIVALENCE CONTRACT
//    A  Every relocated body is BYTE-IDENTICAL to the parent, except:
//         - theme colours arrive as one Theme object and are re-bound to their
//           ORIGINAL names by a destructuring prologue, so the body text is
//           unchanged;
//         - calls to relocated helpers that now take Theme/extra arguments have
//           those arguments appended;
//         - v4_workspace calls the local vp_zoneText copy instead of the
//           Companion export (identical code, avoids a library-to-library import).
//    B  No relocated function writes ANY global: verified statically.
//    C  No request.* call is relocated or duplicated. coreBundle() and
//       adxErBundle() stay in Main because they are request.security callees.
//    D  No canonical state, Observation/queue/funnel mutation, lifecycle
//       transition, alert or export was relocated.
// 
//  NOT COMPILED. TRADINGVIEW COMPILE/LOAD NOT RUN. No token count is claimed.
// =============================================================================
library("OSE_CORE_LIB", overlay = false)

