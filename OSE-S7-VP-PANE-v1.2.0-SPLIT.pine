// OSE STAGE 7 — PANE BUILD   (VP-03A · VP-03B · VP-03C · VP-06 · VP-07)
// One half of a TWO-INDICATOR PAIR. Add BOTH to the same 5-minute chart:
//     OSE IC4 PANE   — this build: the lower information pane (VP-03A live
//                      band, VP-03B signal matrix, VP-03C management, diagnostic
//                      detail, signal detail, history and review).
//     OSE IC4 CHART  — companion build: top-right Command / Status Bar,
//                      structural band geometry, far-right price-reference tags,
//                      STOP / STOP+ / TP1 / TP+ geometry, secondary S/R contract
//                      and every exact-candle event marker.
// The split exists ONLY because a single script exceeds TradingView's compiled
// token limit. No approved surface, term, icon, colour, salience level or
// unbound slot was removed to achieve it: every one of them is present in one
// half or the other, and both halves carry the identical Stage-6 engine, the
// identical Stage-7 management engine and the identical alert and export
// contracts.
//
// ALERTS: configure TradingView alerts on the CHART build only. Both halves
// contain the identical alert payload, so configuring alerts on both would
// deliver the same notification twice.
// EXPORTS: both halves publish the same 52 data-window exports by construction.
// =============================================================================
// =============================================================================
// OSE STAGE 7 — FINAL INTEGRATED VISUAL POLISH (VP-01 .. VP-07)
// Mission: OSE-S7-FINAL-INTEGRATED-UI-POLISH-MASTER-02
// Parent:  OSE-S7-DECISION-SUPPORT-UI-v1.0.0-IC4-CTR1.pine
//          SHA-256 3f74470987a72a109ecbdfdf7f9d41285b8390054ec2942789acfcebfdaacbf0
//          425,879 bytes | 7,266 LF lines  (actual-byte custody, recomputed)
//
// SCOPE: PRESENTATION ONLY. The Stage-6 engine prefix (lines 1-5016) is
// BYTE-IDENTICAL to the parent. All 52 exports keep their exact titles, order
// and meaning; all three request.security calls are unchanged; alert causality,
// membership, trigger bar, deduplication, frequency and every alert CONTRACT
// token are unchanged; no analytical formula, threshold, predicate, Risk rule,
// Direction authority, CHECK predicate, management rule, reversal rule or case
// election is touched. No new producer, request, export, alert or persistent
// state is created anywhere in this delta.
//
// WHAT THIS DELTA IS:
//   VP-01  chart price-reference / structural-label cleanup — the structural
//          band IS the statement; verbose chart-body prose is removed and the
//          far-right tags carry final terminology with a SOURCE-OWNED role
//          token (never inferred from HIGH / LOW or from price position).
//   VP-02  ONE fixed top-right Command / Status Bar, EXACTLY 2 rows x 7 cells.
//          Row 2 cells 2-6 are FROZEN signal-time CHECK components only and
//          carry no live numeric value. The old top-center main state card and
//          the old standalone lower-pane Evidence and Squeeze groups are gone.
//   VP-03A ONE full-width lower live band: one indicator row, ten adjacent
//          conceptual cells, band update time shown exactly once inside cell 10.
//   VP-03B AT SIGNAL | CHANGE | NOW signal matrix with a separate metric
//          identifier column and an immutable anchor contract.
//   VP-03C bounded lower detail / history / review area inside the lower-pane
//          row / column budget, with explicit per-fact ownership.
//   VP-04  geometry-first chart de-clutter; exact-candle event markers; every
//          persistent reference keeps its source-owned birth / update time and
//          its exact price.
//   VP-05  secondary S/R presentation contract defined; NO producer exists in
//          this build, so no line is drawn and none is invented.
//   VP-06  terminology / icon / surface grammar, applied surface-by-surface.
//          Machine / audit / provenance tokens are NOT renamed.
//   VP-07  cell salience Q0 / Q4 / A14 / X32 / X36 and the semantic palette.
//          Chart-geometry strengths are a separate scale and are not capped by
//          X36. Colour is never the only semantic carrier.
//
// UNBOUND BY DESIGN (UI implemented now, analytical producer later): RSI, RSI
// AT SIGNAL, MACD HIST, +DI / -DI, VOLUME DELTA, VOLUME PROFILE, SECONDARY S/R,
// live RVOL and MOM support states, and the live support RETURN marker. Each
// has its approved location and shows — (or the source-owned ⏳ / 🚫) and is
// never removed, redesigned, substituted or populated with an invented value.
//
// ---------------------------------------------------------------------------
// SURGICAL COMPILE-TOKEN REDUCTION + TWO BOUNDED FIXES
// Mission: OSE-S7-VP01-VP07-COMPILE-TOKEN-SURGICAL-OPT-01
// Parent:  OSE-S7-FINAL-INTEGRATED-VISUAL-POLISH-v1.1.0-VP01-VP07.pine
//          SHA-256 c282aea904c85e130f583f63a3f99317611bbf149ff2d4900d6e77cbb1d05ec3
//          458,554 bytes | 7,740 LF lines
//
// FIX 1  the Top Bar CHECKS aggregate reads exactly CHECKS n/5. The five
//        component truths, the pass mask, the applicability mask, the frozen
//        anchor, the component icons and the component colours are untouched;
//        a not-applicable component still shows its own 🚫 and is still never
//        counted as passed.
// FIX 2  every v4_panelCell() call site now matches the nine-parameter
//        signature. Fifteen sites in the live band omitted only the final
//        `heading` bool and were given `false`. The function's parameter
//        contract, argument order and rendered result are unchanged.
// FIX 3  presentation-layer compiled-token reduction ONLY. Pine inlines a user
//        function at every call site, so the reduction comes from collapsing
//        repeated render branches into bounded data-driven passes and from
//        resolving the VP-07 salience scale once instead of per cell:
//          · VP-07 Q0/Q4/A14/X32/X36 hoisted to fourteen resolved constants;
//            the composition is bit-identical to the per-call form it replaces.
//          · live band, signal matrix, management, diagnostic detail, signal
//            detail, review and the Top Bar each render through one bounded
//            pass over their own fixed cell ledger.
//          · the four price-reference boundaries and the four management
//            references collect through one pass each, in unchanged order.
//          · v4_panelCell no longer repeats the alignment setter or the
//            non-heading size setter: both are applied when the grid is built.
//          · provably dead presentation-only declarations removed
//            (s7_transText, s7_atAnchorBar/s7_cmpLive and six unused caps).
//        ZERO product delta: every approved surface, cell count, table
//        dimension, term, icon, colour, salience level, unbound slot and
//        information item is preserved exactly. The code is smaller; the
//        product is not.
//
// STATICALLY REVIEWED ONLY. NO TradingView compile, load, render or runtime
// acceptance is claimed anywhere in this source, no compiled-token count is
// claimed, and no glyph is claimed to be runtime-verified. This source carries
// no SHA-256 of itself.
// ---------------------------------------------------------------------------
// =============================================================================

// IC4.0 / G9.1 DISPLAY INPUTS — ONE interface. There is no SIMPLE or ADVANCED
// mode: no user-facing complexity switch exists anywhere in this source. Every
// input in this block is presentation-only, except the inherited, independent
// ALERT MODE with its unchanged STANDARD default. No display switch gates a
// calculation, an alert, an export or any engine truth.
const string V4_G_MAIN = "OSE · 01 Interface"
const string V4_G_STYLE = "OSE · 02 Appearance"
const string V4_G_EVENTS = "OSE · 05 Candle markers"
const string V4_G_REVIEW = "OSE · 06 Disclosure"
const string V4_G_ALERT = "OSE · 07 Alerts"

bool s7_uiEnabled = input.bool(true, "Show OSE interface", group = V4_G_MAIN,
  tooltip = "Display only. The OSE engine and the selected ALERT MODE continue when visuals are hidden.")
bool v4_showPane = input.bool(true, "Lower information pane", group = V4_G_MAIN, active = s7_uiEnabled,
  tooltip = "The native indicator pane remains allocated if its table is hidden. Resize the pane from TradingView.")
int v4_columns = input.int(3, "Lower-pane group columns", minval = 1, maxval = 3, group = V4_G_MAIN, display = display.none,
  tooltip = "Manual wrapping only: use 1 or 2 columns on a narrow screen. Group meanings and order are unchanged, and the live band always stays one row.")

string v4_theme = input.string("Auto", "Theme", options = ["Auto", "Light", "Dark"], group = V4_G_STYLE, display = display.none)
int v4_font = input.int(14, "Panel text size", minval = 12, maxval = 22, group = V4_G_STYLE, display = display.none)
int v4_fillTransparency = input.int(92, "Structural band fill", minval = 88, maxval = 92, group = V4_G_STYLE, display = display.none,
  tooltip = "Chart-geometry fill strength only (8-12%). This is not a panel cell overlay.")
color v4_green = input.color(#13856a, "Support / CALL", group = V4_G_STYLE, inline = "side")
color v4_red = input.color(#c5404b, "Resistance / PUT / STOP", group = V4_G_STYLE, inline = "side")
color v4_amber = input.color(#bd790b, "Caution", group = V4_G_STYLE, inline = "other")
color v4_blue = input.color(#317bb2, "Reference / lifecycle", group = V4_G_STYLE, inline = "other")



bool v4_showMarkers = input.bool(true, "Candle-marker group", group = V4_G_EVENTS)
bool v4_showWatch = input.bool(true, "WATCH", group = V4_G_EVENTS, inline = "op", active = v4_showMarkers)
bool v4_showSetup = input.bool(true, "SIGNAL / REJECTED", group = V4_G_EVENTS, inline = "op", active = v4_showMarkers)
bool v4_showManagement = input.bool(true, "Management / warnings", group = V4_G_EVENTS, active = v4_showMarkers)
bool v4_showRelease = input.bool(true, "SQZ RELEASE", group = V4_G_EVENTS, active = v4_showMarkers)
bool v4_showLiveChange = input.bool(true, "LIVE CHANGE MARKERS", group = V4_G_EVENTS, active = v4_showMarkers,
  tooltip = "Edge-triggered live support loss / return micro-markers. Only producers this build actually owns can raise one.")
bool v4_markVwr = input.bool(true, "VWAP RECLAIM markers", group = V4_G_EVENTS, inline = "fam1", active = v4_showMarkers)
bool v4_markLbo = input.bool(true, "BREAKOUT markers", group = V4_G_EVENTS, inline = "fam1", active = v4_showMarkers)
bool v4_markLrt = input.bool(true, "RETEST markers", group = V4_G_EVENTS, inline = "fam2", active = v4_showMarkers)
bool v4_markSqz = input.bool(true, "SQZ markers", group = V4_G_EVENTS, inline = "fam2", active = v4_showMarkers)

bool v4_showDiag = input.bool(false, "DIAGNOSTICS", group = V4_G_REVIEW,
  tooltip = "Diagnostic detail and signal-record detail in the lower pane.")
bool v4_showReview = input.bool(false, "REVIEW", group = V4_G_REVIEW,
  tooltip = "Original-record forward-research facts. REF PRICE, MFE and MAE are review facts, never profit or loss.")
bool v4_showHistory = input.bool(false, "HISTORY", group = V4_G_REVIEW,
  tooltip = "Selected records from the current RTH session and at most two completed sessions. This does not alter the active anchor or exports.")
bool v4_historyLog = input.bool(true, "Event chronology in the lower pane", group = V4_G_REVIEW, active = v4_showHistory)
int v4_historyRows = input.int(6, "Visible chronology rows", minval = 2, maxval = 12, group = V4_G_REVIEW,
  active = v4_showHistory and v4_historyLog, display = display.none)

// ALERT MODE — OFF | CORE | STANDARD | DETAILED. CORE is ONLY a presentation
// rename of the inherited ESSENTIAL membership: the membership, causality,
// timing, deduplication and the machine profile token inside the alert payload
// are all unchanged. STANDARD remains the default.
string s7_alertProfile = input.string("STANDARD", "ALERT MODE", options = ["OFF", "CORE", "STANDARD", "DETAILED"],
  group = V4_G_ALERT, display = display.none,
  tooltip = "Independent of every display switch. CORE is the inherited ESSENTIAL membership under its final name; the alert payload's machine profile token is unchanged. Recreate the TradingView alert after changing the mode or the alert-producing build/configuration.")

// --- S7.1 frozen Stage-7 constants ------------------------------------------
const string S7_BUILD            = "v1.0.0-IC4"
const int    S7_HIST_CAP         = 64
const int    S7_ROLE_SNAP_CAP    = 8
const int    S7_ALERT_LIMIT      = 4096

const int    S7_PROF_OFF = 0
const int    S7_PROF_ESS = 1
const int    S7_PROF_STD = 2
const int    S7_PROF_DET = 3

// presentation precedence ranks (Final UX §27 / §29) — display only
const int S7_PRI_REVERSED   = 90
const int S7_PRI_STOPBREAK  = 85
const int S7_PRI_SESSION    = 80
const int S7_PRI_CRITICAL   = 70
const int S7_PRI_STRUCTLOST = 60
const int S7_PRI_TP1        = 55
const int S7_PRI_ACTIVE     = 50
const int S7_PRI_WARNING    = 45
const int S7_PRI_TRAILON    = 40
const int S7_PRI_IMPULSE    = 35
const int S7_PRI_STOPTEST   = 30
const int S7_PRI_DETAIL     = 15

const string S7_NA          = "—"
const string S7_STOP_TIP    = "OSE reference only — not a broker order."
const string S7_ACTIVE_TIP  = "OSE is following this signal; no broker execution is implied."

// IC4 palette. Theme selection affects colors only.
bool v4_dark = v4_theme == "Dark" or (v4_theme == "Auto" and color.r(chart.bg_color) + color.g(chart.bg_color) + color.b(chart.bg_color) < 384)
color s7c_ink = v4_dark ? #e9edf5 : #172231
color s7c_ink2 = v4_dark ? #bcc7d6 : #516174
color s7c_mut = v4_dark ? #9eacbe : #69788b
color s7c_dim = v4_dark ? #7e90a4 : #8394a6
color s7c_sup = v4_green
color s7c_res = v4_red
color s7c_bad = v4_red
color s7c_ref = v4_blue
color s7c_trail = v4_dark ? #dfe8f5 : #24384d
color s7c_amb = v4_amber
color s7c_warnBg = v4_dark ? #382b13 : #fff1d6
color s7c_warnBd = v4_amber
color s7c_supBd = v4_green
color s7c_resBd = v4_red
color s7c_tp1 = v4_blue
color s7c_card = v4_dark ? #151e2b : #ffffff
color s7c_panel = s7c_card
color s7c_hair = v4_dark ? #36475c : #cbd6e0
color s7c_grid = v4_dark ? #202d3d : #edf3f8
color s7c_supFil = color.new(v4_green, v4_fillTransparency)
color s7c_resFil = color.new(v4_red, v4_fillTransparency)
color s7c_clear = color.new(s7c_card, 100)

// =============================================================================
// VP-G1 PRESENTATION FOUNDATION — VP-06 terminology, VP-07 salience, glyphs
// Presentation-only. Nothing below is read by any engine, trigger, Risk, CHECK,
// case-election, management, export or alert-CONTRACT consumer. No analytical
// producer, threshold or state is created here. The Stage-6 prefix and every
// machine/audit token remain untouched: the s7_* CONTRACT helpers above keep
// their exact original vocabulary and stay the sole source of record strings.
// =============================================================================

// --- VP-G1.1 approved icon grammar (§7). Static source insertion only; no
// TradingView rendering claim is made here. -----------------------------------
const string VP_I_WATCH   = "👀"
const string VP_I_SIGNAL  = "❗️"
const string VP_I_ACTIVE  = "❇️"
const string VP_I_PASS    = "✅"
const string VP_I_FAIL    = "❌"
const string VP_I_TOUCH   = "⭕️"
const string VP_I_HARD    = "🛑"
const string VP_I_MOVED   = "🔄"
const string VP_I_WARN    = "⚠️"
const string VP_I_ESC     = "‼️"
const string VP_I_WARM    = "⏳"
const string VP_I_LOCALNA = "🚫"
const string VP_I_BURST   = "💥"
const string VP_I_IMP     = "⚡"
const string VP_I_IMPX    = "⚡+"

// Readiness grammar (§G9). The four meanings never collapse into one another.
// ⛔ is never emitted on its own: it exists only inside VP_GLOBAL_NA below.
const string VP_NA        = "—"
const string VP_GLOBAL_NA = "OSE ⛔"

// --- VP-G1.2 VP-07 cell / panel salience scale --------------------------------
// These tokens govern TABLE / CELL / PANEL overlays ONLY. Chart-geometry fill,
// line and boundary strengths (G2.1, G8.1) are a separate scale and are NOT
// constrained by the X36 cap. An overlay is composited against the opaque panel
// surface, so no cell ever reaches full saturation.
vp_mix(color vp_base, color vp_tint, float vp_pct) =>
    color.rgb(color.r(vp_base) + (color.r(vp_tint) - color.r(vp_base)) * vp_pct,
      color.g(vp_base) + (color.g(vp_tint) - color.g(vp_base)) * vp_pct,
      color.b(vp_base) + (color.b(vp_tint) - color.b(vp_base)) * vp_pct, 0)

// The complete VP-07 scale, resolved ONCE here instead of being recomputed at
// every cell. Values are bit-identical to the per-call composition they replace;
// only the number of compiled composition sites changes.
//   Q0  — 0% chromatic overlay: default, inactive, ordinary diagnostic, history.
//   Q4  — 4% cool/neutral overlay: frozen snapshot, reference, unavailable slot
//         (an unavailable / unbound container NEVER exceeds Q4, §8.2).
//   A14 — 14% semantic overlay: meaningful persistent current state, no alarm.
//   X32 — 32% semantic overlay: extreme, warning, important failure/high value.
//   X36 — 36% maximum: confirmed reversal, hard termination, global OSE ⛔ only.
// s7c_bad and s7c_res are the same configured red, so one RED family serves the
// PUT / resistance / STOP / hard-failure roles without duplicating a constant.
color VPS_Q0     = s7c_card
color VPS_Q4MUT  = vp_mix(s7c_card, s7c_mut, 0.04)
color VPS_Q4RED  = vp_mix(s7c_card, s7c_res, 0.04)
color VPS_A14MUT = vp_mix(s7c_card, s7c_mut, 0.14)
color VPS_A14SUP = vp_mix(s7c_card, s7c_sup, 0.14)
color VPS_A14RED = vp_mix(s7c_card, s7c_res, 0.14)
color VPS_A14AMB = vp_mix(s7c_card, s7c_amb, 0.14)
color VPS_A14REF = vp_mix(s7c_card, s7c_ref, 0.14)
color VPS_X32MUT = vp_mix(s7c_card, s7c_mut, 0.32)
color VPS_X32SUP = vp_mix(s7c_card, s7c_sup, 0.32)
color VPS_X32RED = vp_mix(s7c_card, s7c_res, 0.32)
color VPS_X32AMB = vp_mix(s7c_card, s7c_amb, 0.32)
color VPS_X32REF = vp_mix(s7c_card, s7c_ref, 0.32)
color VPS_X36RED = vp_mix(s7c_card, s7c_res, 0.36)

// The one place a colour still has to be mapped at A14 from a value chosen at
// runtime (the history badge tone). It resolves to the SAME constants above.
vp_a14Of(color vp_t) =>
    vp_t == s7c_ref ? VPS_A14REF : vp_t == s7c_amb ? VPS_A14AMB : vp_t == s7c_sup ? VPS_A14SUP : vp_t == s7c_res ? VPS_A14RED : VPS_A14MUT

// --- VP-G1.3 VP-06 user-facing vocabulary -------------------------------------
// Surface-specific by design. The CONTRACT helpers s7_dirText / s7_famText are
// NOT redefined: they continue to compose audit/provenance record strings with
// their original machine vocabulary. These helpers serve display surfaces only.
vp_dir(int vp_d) =>
    vp_d == DIR_LONG ? "CALL" : vp_d == DIR_SHORT ? "PUT" : vp_d == DIR_NEUTRAL ? "NEUTRAL" : VP_NA

vp_fam(int vp_f) =>
    vp_f == FAM_VWR ? "VWAP RECLAIM" : vp_f == FAM_LBO ? "BREAKOUT" : vp_f == FAM_LRT ? "RETEST" : vp_f == FAM_SQZ ? "SQZ" : VP_NA

vp_entry(int vp_classCode) =>
    int vp_e = na(vp_classCode) ? na : int(math.floor(vp_classCode / 10.0)) % 10
    vp_e == EFF_EARLY ? "EARLY" : vp_e == EFF_CONFIRMED ? "READY" : vp_e == EFF_EXTENDED ? "EXTENDED" : vp_e == EFF_TOO_LATE ? "TOO LATE" : VP_NA

// Human-readable binding Risk reason. The internal R# stays available in the
// tooltip / detail surface; it is never the primary user-facing reason (G3.5).
vp_riskReason(int vp_rj) =>
    vp_rj == RJ_R4 ? "SESSION BLOCKED" : vp_rj == RJ_R5 ? "EVENT DAY BLOCK" : vp_rj == RJ_R6 ? "TOO LATE" : vp_rj == RJ_R7 ? "RISK TOO WIDE" : vp_rj == RJ_R8 ? "RISK TOO TIGHT" : vp_rj == RJ_R9 ? "NO ROOM" : vp_rj == RJ_R10 ? "STOP UNDEFINED" : vp_rj == RJ_R12 ? "STOP TOO CLOSE" : vp_rj == RJ_R13 ? "RVOL NOT READY" : VP_NA


// Source-owned structural role token for a far-right price tag (G2.2). Support
// and Resistance come from the accepted zone registry only; a neutral or
// unregistered reference receives no role token at all.
vp_roleToken(int vp_role) =>
    vp_role == ROLE_SUPPORT ? " · S" : vp_role == ROLE_RESISTANCE ? " · R" : ""


// VP-06 zone vocabulary. Identity only — a zone name never invents a role.
vp_zoneText(int vp_mask) =>
    string vp_t = VP_NA
    if not na(vp_mask)
        if vp_mask == BIT_VWAP
            vp_t := "VWAP"
        else if vp_mask > 0 and vp_mask <= STATIC_MASK_MAX
            // Same four members, same PDH / PDL / ORH / ORL order, same "+"
            // join; only the four structurally identical branches are folded
            // into one bounded pass.
            vp_t := ""
            array<int>    vp_zb = array.from(BIT_PDH, BIT_PDL, BIT_ORH, BIT_ORL)
            array<string> vp_zn = array.from("YDAY HIGH", "YDAY LOW", "OPEN HIGH", "OPEN LOW")
            for vp_i = 0 to 3
                if hasBit(vp_mask, array.get(vp_zb, vp_i))
                    vp_t := (str.length(vp_t) > 0 ? vp_t + "+" : "") + array.get(vp_zn, vp_i)
    vp_t

// --- VP-G1.5 VP-07 approved presentation bands (P-01..P-05) -------------------
// DISPLAY ONLY. None of these bands is read by Risk, Direction, Entry, CHECKS,
// case election, management, alerts or exports, and none creates a producer.
// Each band is defined ONCE here and reused by every surface that shows the
// metric, so no surface can define a second threshold for the same producer.

// P-01 ADX — trend-strength MAGNITUDE only. Never a CALL / PUT, bullish /
// bearish or GOOD / BAD inference.
vp_adxTint(float vp_v) =>
    na(vp_v) ? s7c_mut : vp_v < 20 ? s7c_amb : vp_v < 25 ? s7c_ink : s7c_ref
vp_adxBg(float vp_v) =>
    na(vp_v) ? VPS_Q4MUT : vp_v < 20 ? VPS_A14AMB : vp_v < 25 ? VPS_Q0 : vp_v < 40 ? VPS_A14REF : VPS_X32REF

// P-02 RVOL NOW · C19 exact-slot relative volume.
vp_c19Tint(float vp_v) =>
    na(vp_v) ? s7c_mut : vp_v < 0.75 ? s7c_res : vp_v < 1.25 ? s7c_ink : s7c_sup
vp_c19Bg(float vp_v) =>
    na(vp_v) ? VPS_Q4MUT : vp_v < 0.75 ? VPS_A14RED : vp_v < 1.25 ? VPS_Q0 : vp_v < 2.00 ? VPS_A14SUP : VPS_X32SUP

// P-03 SESSION RVOL · C60 cumulative. Evaluated INDEPENDENTLY of C19; its
// colour never overwrites the C19 state.
vp_c60Tint(float vp_v) =>
    na(vp_v) ? s7c_mut : vp_v < 0.75 ? s7c_res : vp_v < 1.25 ? s7c_ink2 : s7c_sup
vp_c60Bg(float vp_v) =>
    na(vp_v) ? VPS_Q4MUT : vp_v < 0.75 ? VPS_A14RED : vp_v < 1.25 ? VPS_Q0 : vp_v < 2.00 ? VPS_A14SUP : VPS_X32SUP

// P-04 ATR RATIO — existing accepted short/long ATR ratio producer. ATR and
// ATR% INHERIT this attention state; no raw ATR or ATR% cutoff exists.
vp_atrTint(float vp_v) =>
    na(vp_v) ? s7c_ink : vp_v < 0.75 ? s7c_amb : vp_v < 1.25 ? s7c_ink : s7c_ref
vp_atrBg(float vp_v) =>
    na(vp_v) ? VPS_Q0 : vp_v < 0.75 ? VPS_A14AMB : vp_v < 1.25 ? VPS_Q0 : vp_v < 1.75 ? VPS_A14REF : VPS_X32REF

// P-05 PRICE EFFICIENCY — applied only because the exact parent producer is
// mathematically bounded to 0-1 (see the campaign report scale evidence).
// Diagnostic magnitude only: never GOOD / BAD and never a trade-quality score.
vp_erTint(float vp_v) =>
    na(vp_v) ? s7c_mut : vp_v < 0.25 ? s7c_amb : vp_v < 0.55 ? s7c_ink : s7c_ref
vp_erBg(float vp_v) =>
    na(vp_v) ? VPS_Q4MUT : vp_v < 0.25 ? VPS_A14AMB : vp_v < 0.55 ? VPS_Q0 : vp_v < 0.75 ? VPS_A14REF : VPS_X32REF

// RSI presentation-only state contract (G4.1 / G5.6). Both extremes are AMBER;
// neither is a bullish or bearish reading and neither uses ⚠️.
vp_rsiTint(float vp_v) =>
    na(vp_v) ? s7c_mut : (vp_v > 70 or vp_v < 30) ? s7c_amb : s7c_ink
vp_rsiBg(float vp_v) =>
    na(vp_v) ? VPS_Q4MUT : (vp_v > 70 or vp_v < 30) ? VPS_X32AMB : VPS_Q0

s7_famText(int s7_family) =>
    s7_family == FAM_VWR ? "VWR" : s7_family == FAM_LBO ? "LBO" : s7_family == FAM_LRT ? "LRT" : s7_family == FAM_SQZ ? "SQZ" : S7_NA

s7_dirText(int s7_dir) =>
    s7_dir == DIR_LONG ? "LONG" : s7_dir == DIR_SHORT ? "SHORT" : s7_dir == DIR_NEUTRAL ? "NEUTRAL" : S7_NA

s7_zoneText(int s7_mask) =>
    string s7_t = S7_NA
    if not na(s7_mask)
        if s7_mask == BIT_VWAP
            s7_t := "VWAP"
        else if s7_mask > 0 and s7_mask <= STATIC_MASK_MAX
            s7_t := hasBit(s7_mask, BIT_PDH) ? "PDH" : ""
            s7_t := hasBit(s7_mask, BIT_PDL) ? (str.length(s7_t) > 0 ? s7_t + "+PDL" : "PDL") : s7_t
            s7_t := hasBit(s7_mask, BIT_ORH) ? (str.length(s7_t) > 0 ? s7_t + "+ORH" : "ORH") : s7_t
            s7_t := hasBit(s7_mask, BIT_ORL) ? (str.length(s7_t) > 0 ? s7_t + "+ORL" : "ORL") : s7_t
    s7_t

s7_priceText(float s7_v) =>
    na(s7_v) ? S7_NA : str.tostring(s7_v, format.mintick)

s7_numText(float s7_v, string s7_fmt) =>
    na(s7_v) ? S7_NA : str.tostring(s7_v, s7_fmt)

s7_rejectText(int s7_rj) =>
    s7_rj == RJ_R4 ? "R4 SESSION BLOCKED" : s7_rj == RJ_R5 ? "R5 EVENT DAY BLOCK" : s7_rj == RJ_R6 ? "R6 TOO LATE" : s7_rj == RJ_R7 ? "R7 RISK TOO WIDE" : s7_rj == RJ_R8 ? "R8 RISK TOO TIGHT" : s7_rj == RJ_R9 ? "R9 NO ROOM" : s7_rj == RJ_R10 ? "R10 STOP UNDEFINED" : s7_rj == RJ_R12 ? "R12 STOP TECHNICALLY TOO CLOSE" : s7_rj == RJ_R13 ? "R13 RVOL NOT READY" : S7_NA

s7_qCount(int s7_flag, int s7_appl) =>
    int  s7_ap = 0
    int  s7_ps = 0
    bool s7_ok = (not na(s7_flag)) and (not na(s7_appl)) and s7_flag >= 0 and s7_flag <= 31 and s7_appl >= 0 and s7_appl <= 31
    if s7_ok
        // Compiled-token consolidation (IC4-CTR1). The five per-bit terms of each
        // sum are structurally identical, so they are counted by one bounded
        // five-iteration pass instead of ten inlined hasBit terms. Applicable
        // count and passed count are unchanged: s7_ap still counts applicable
        // bits and s7_ps still counts applicable-AND-set bits, in the same
        // Q1..Q5 order. FALSE and NOT APPLICABLE stay distinct.
        array<int> s7_qb = array.from(QB_Q1, QB_Q2, QB_Q3, QB_Q4, QB_Q5)
        for s7_i = 0 to 4
            int s7_b = array.get(s7_qb, s7_i)
            if hasBit(s7_appl, s7_b)
                s7_ap += 1
                if hasBit(s7_flag, s7_b)
                    s7_ps += 1
    [s7_ps, s7_ap, s7_ok]

// ALERT-MODE membership. CORE is the inherited ESSENTIAL membership under its
// final user-facing name; the rank, and therefore every alert's membership, is
// byte-for-byte the inherited behaviour.
s7_profileRank(string s7_p) =>
    s7_p == "DETAILED" ? S7_PROF_DET : s7_p == "STANDARD" ? S7_PROF_STD : (s7_p == "CORE" or s7_p == "ESSENTIAL") ? S7_PROF_ESS : S7_PROF_OFF

// G0.3 / G9.2 alert-CONTRACT firewall. The profile identifier inside the alert
// payload is a stable machine/provenance token and is NOT renamed: the display
// name CORE maps back to the inherited ESSENTIAL token before the payload is
// composed. Only DISPLAY wording elsewhere in the payload adopts VP-06.
s7_profileToken(string s7_p) =>
    s7_p == "CORE" ? "ESSENTIAL" : s7_p

s7_hhmm(int s7_ms) =>
    na(s7_ms) ? S7_NA : str.format_time(s7_ms, "HH:mm", TZ)

s7_regHasMask(array<Zone> s7_reg, int s7_mask) =>
    bool s7_f = false
    int  s7_n = array.size(s7_reg)
    if s7_n > 0
        for s7_i = 0 to s7_n - 1
            Zone s7_z = array.get(s7_reg, s7_i)
            if (not s7_f) and s7_z.mask == s7_mask
                s7_f := true
    s7_f

s7_roleText(int s7_role) =>
    s7_role == ROLE_SUPPORT ? "SUPPORT" : s7_role == ROLE_RESISTANCE ? "RESISTANCE" : "NEUTRAL"

// Numeric delta between two EXISTING accepted values in the SAME unit only
// (mission §4.4). Either operand missing -> N/A. Never a synthetic change.
s7_deltaText(float s7_then, float s7_now, string s7_fmt, string s7_suffix) =>
    string s7_d = S7_NA
    if (not na(s7_then)) and (not na(s7_now))
        float s7_v = s7_now - s7_then
        s7_d := (s7_v > 0 ? "+" : "") + str.tostring(s7_v, s7_fmt) + s7_suffix
    s7_d

s7_ratioText(float s7_v) =>
    na(s7_v) ? S7_NA : str.tostring(s7_v, "0.00") + "x"

// UI alias for the accepted tri-state VWAP-slope producer. The cell is renamed
// for the trading surface; the underlying condition is not redefined.
s7_slopeText(int s7_state) =>
    s7_state == DIR_LONG ? "RISING" : s7_state == DIR_SHORT ? "FALLING" : s7_state == DIR_NEUTRAL ? "FLAT" : S7_NA

// --- S7.3 Stage-7 owned state ------------------------------------------------
// S7.3.1 immutable ACTIVE anchor (packet §6.1) — frozen once, never rewritten
var bool  s7_caseActive       = false
var int   s7_caseId           = na
var int   s7_caseFamily       = 0
var int   s7_caseDir          = 0
var int   s7_caseSignalTime   = na
var int   s7_caseSignalOrd    = na
var int   s7_caseSignalSlot   = na
var int   s7_caseObsIdxInBar  = na
var float s7_caseSignalClose  = na
var float s7_caseInitialStop  = na
var float s7_casePlannedRisk  = na
var float s7_caseTp1          = na
var int   s7_caseQFlag        = na
var int   s7_caseQAppl        = na
var bool  s7_caseRiskPass     = false
var int   s7_caseRejectReason = 0
var int   s7_caseClassCode    = na
var int   s7_caseZoneMask     = 0
var int   s7_caseConfluence   = 0
var int   s7_caseTouchCount   = 0
var float s7_caseAtrRefAtObs  = na
var float s7_caseEntryDistATR = na
var float s7_caseSigRelVol    = na
var float s7_caseSigRoc5      = na
var int   s7_caseStartOrd     = na
var int   s7_caseStartTime    = na
var Obs   s7_caseObsRef       = na
// premise lineage
var bool  s7_premiseTrace     = false
var int   s7_premiseMask      = 0
var int   s7_premiseAnchorBit = 0
var int   s7_premiseRole      = 0
var int   s7_premiseAccDir    = 0

// S7.3.2 mutable management state (packet §6.2)
var bool  s7_tp1Reached       = false
var bool  s7_trailUnlocked    = false
var float s7_trailStop        = na
var int   s7_trailVersion     = 0
var float s7_trailPrevLevel   = na
var string s7_trailReason     = ""
var bool  s7_structLost       = false
var bool  s7_warnActive       = false
var bool  s7_candLive         = false
var int   s7_candObsId        = na
var int   s7_candDir          = 0
var int   s7_candFamily       = 0
var int   s7_candTime         = na
var int   s7_candOrd          = na
var Obs   s7_candObsRef       = na
var int   s7_stopTestVer      = na
var int   s7_impulseAlertOrd  = na
var bool  s7_oppWatchPrev     = false
var bool  s7_slopeSupportPrev = false
var bool  s7_caseEndedFlag    = false
var string s7_caseEndReason   = ""

// S7.3.3 bounded current-session history ring (packet §6.4)
var array<string> s7_hist = array.new_string()

// Session and alert state remain analytical consumers, independent of visibility.
var int s7_sessionOpen = na
var int s7_sessionRight = na
var bool s7_sessionOn = false
var int s7_lastAlertBar = na
var array<int> s7_roleMasks = array.new_int()
var array<int> s7_roleVals = array.new_int()
// --- S7.4 per-bar accepted facts --------------------------------------------
int  s7_profRank      = s7_profileRank(s7_alertProfile)
bool s7_commitBar     = actualRthBar and barstate.isconfirmed
int  s7_termSlot      = sesIsEarlyCl ? ECLAST : FULLLAST
bool s7_terminalBar   = s7_commitBar and (not na(slotIdx)) and slotIdx == s7_termSlot
bool s7_termDataMiss  = s7_commitBar and na(slotIdx)
int  s7_obsCount      = rawObsSetClosed ? array.size(rawObsSet) : 0
bool s7_coreReady     = sessionDataReady
bool s7_impulseOn     = (not na(impulseExpiryOrd)) and (not na(currentOrdinal)) and currentOrdinal <= impulseExpiryOrd
bool s7_impulseEdge   = (not na(impulseExpiryOrd)) and (na(impulseExpiryOrd[1]) or impulseExpiryOrd != impulseExpiryOrd[1])
int  s7_armCount      = array.size(armStore)

// event accumulators for THIS committed bar
array<string> s7_evtText = array.new_string()
array<int>    s7_evtProf = array.new_int()
array<int>    s7_evtPri  = array.new_int()
array<string> s7_evtRec  = array.new_string()
// --- S7.4a compiled-token consolidation (IC4-CTR1) ---------------------------
// ONE writer for the four parallel per-bar event ledgers above. Every call site
// in S7.5 previously repeated the same four array.push calls AND re-composed
// the same record template inline. The template below is that exact template:
//   hh:mm · <label> · <direction> · <family> · #<id> · <tail>
// Pine-safety: this helper mutates ONLY the referenced global ARRAY OBJECTS via
// array.push. It assigns no global scalar, so it cannot raise CE10088. It holds
// no var, no history reference and no ta.* call, so it owns no per-call-site
// state and adds no temporal behaviour. Push order (text, prof, pri, rec) and
// the composed record string are byte-identical to every replaced call site.
s7_evt(string s7_head, int s7_prof, int s7_pri, string s7_lbl, string s7_dirS, string s7_famS, string s7_idS, string s7_tail) =>
    array.push(s7_evtText, s7_head)
    array.push(s7_evtProf, s7_prof)
    array.push(s7_evtPri,  s7_pri)
    array.push(s7_evtRec,  s7_hhmm(time_close) + " · " + s7_lbl + " · " + s7_dirS + " · " + s7_famS + " · #" + s7_idS + " · " + s7_tail)
    true

// R1 / R-2 — case identity as it stands BEFORE this bar's management engine
// runs. On a reversal bar the engine ends the old case and may open the
// opposite one in the same pass, so a single post-pass id would attach every
// same-bar event to the newly opened case. Recording the pre and post ids lets
// an archived group state its real case context, including a handoff.
int s7_caseIdPre = s7_caseId

// =============================================================================

int v4_caseFamilyPre = s7_caseFamily
int v4_caseDirPre = s7_caseDir
// S7.5 MANAGEMENT ENGINE — commit-bar only, exact packet §21 statement order
// =============================================================================
if s7_commitBar

    // --- S7.5.0 session boundary reset (packet §10 / Final UX §35) ----------
    bool s7_calendarAdvance = s7_sessionOn and (not na(s7_sessionOpen)) and sessionOpenMs != s7_sessionOpen
    if newRthDay or s7_calendarAdvance
        s7_caseActive       := false
        s7_caseId           := na
        s7_caseFamily       := 0
        s7_caseDir          := 0
        s7_caseSignalTime   := na
        s7_caseSignalOrd    := na
        s7_caseSignalSlot   := na
        s7_caseObsIdxInBar  := na
        s7_caseSignalClose  := na
        s7_caseInitialStop  := na
        s7_casePlannedRisk  := na
        s7_caseTp1          := na
        s7_caseQFlag        := na
        s7_caseQAppl        := na
        s7_caseRiskPass     := false
        s7_caseRejectReason := 0
        s7_caseClassCode    := na
        s7_caseZoneMask     := 0
        s7_caseConfluence   := 0
        s7_caseTouchCount   := 0
        s7_caseAtrRefAtObs  := na
        s7_caseEntryDistATR := na
        s7_caseSigRelVol    := na
        s7_caseSigRoc5      := na
        s7_caseStartOrd     := na
        s7_caseStartTime    := na
        s7_caseObsRef       := na
        s7_premiseTrace     := false
        s7_premiseMask      := 0
        s7_premiseAnchorBit := 0
        s7_premiseRole      := 0
        s7_premiseAccDir    := 0
        s7_tp1Reached       := false
        s7_trailUnlocked    := false
        s7_trailStop        := na
        s7_trailVersion     := 0
        s7_trailPrevLevel   := na
        s7_trailReason      := ""
        s7_structLost       := false
        s7_warnActive       := false
        s7_candLive         := false
        s7_candObsId        := na
        s7_candDir          := 0
        s7_candFamily       := 0
        s7_candTime         := na
        s7_candOrd          := na
        s7_candObsRef       := na
        s7_stopTestVer      := na
        s7_impulseAlertOrd  := na
        s7_oppWatchPrev     := false
        s7_slopeSupportPrev := false
        s7_caseEndedFlag    := false
        s7_caseEndReason    := ""
        array.clear(s7_hist)
        array.clear(s7_roleMasks)
        array.clear(s7_roleVals)
        s7_sessionOpen  := newRthDay ? sessionOpenMs : na
        s7_sessionRight := newRthDay ? rthTimeClose : na
        s7_sessionOn    := newRthDay and (not na(sessionOpenMs)) and (not na(rthTimeClose))
    if s7_sessionOn and (not na(rthTimeClose))
        s7_sessionRight := rthTimeClose

    // --- S7.5.1 expire invalid WATCH / candidate state ----------------------
    // WATCH mirrors the canonical arm registry; Stage 6 owns expiry/cancel, so
    // an arm absent from armStore is already expired and its marker is removed.
    bool s7_oppWatchNow = false
    if s7_caseActive and s7_armCount > 0
        for s7_i = 0 to s7_armCount - 1
            Arm s7_a = array.get(armStore, s7_i)
            if s7_a.direction == -s7_caseDir and s7_a.direction != DIR_NEUTRAL
                s7_oppWatchNow := true

    // MC-03 §9.2 continuity: the candidate lives only while C17 still equals it
    if s7_candLive
        if (not s7_caseActive) or structBias != s7_candDir
            s7_evt("REVERSAL WATCH EXPIRED · " + vp_dir(s7_candDir), S7_PROF_DET, S7_PRI_DETAIL, "CANDIDATE EXPIRED", s7_dirText(s7_candDir), s7_famText(s7_candFamily), str.tostring(s7_candObsId), "C17_CONTINUITY_LOST")
            s7_candLive   := false
            s7_candObsId  := na
            s7_candDir    := 0
            s7_candFamily := 0
            s7_candTime   := na
            s7_candOrd    := na
            s7_candObsRef := na

    // --- S7.5.2 record current SETUP / rejection events ---------------------
    if rawObsSetClosed and s7_obsCount > 0
        for s7_i = 0 to s7_obsCount - 1
            Obs s7_o = array.get(rawObsSet, s7_i)
            string s7_id  = na(s7_o.obsId) ? S7_NA : str.tostring(s7_o.obsId)
            string s7_tag = s7_famText(s7_o.family) + " · " + s7_dirText(s7_o.direction)
            // DISPLAY tag (VP-06) for the alert / panel / marker head only. The
            // CONTRACT record tag above is unchanged.
            string s7_tagUi = vp_fam(s7_o.family) + " · " + vp_dir(s7_o.direction)
            if s7_o.riskPass
                bool s7_same = s7_caseActive and s7_o.direction == s7_caseDir
                bool s7_opp  = s7_caseActive and s7_o.direction == -s7_caseDir
                s7_evt(VP_I_SIGNAL + " SIGNAL · " + s7_tagUi, S7_PROF_DET, S7_PRI_DETAIL, "SETUP" + (s7_same ? " (SAME-DIR)" : s7_opp ? " (OPPOSITE)" : ""), s7_dirText(s7_o.direction), s7_famText(s7_o.family), s7_id, "RISK_PASS")
            else
                s7_evt(VP_I_FAIL + " REJECTED · " + s7_tagUi + " · " + vp_riskReason(s7_o.rejectReason), S7_PROF_DET, S7_PRI_DETAIL, "REJECTED", s7_dirText(s7_o.direction), s7_famText(s7_o.family), s7_id, s7_rejectText(s7_o.rejectReason))

    // --- S7.5.3 MC-01 deterministic ACTIVE election -------------------------
    // First riskPass Observation in canonical retained order. No sort, no rank,
    // no tie-break. Never on the terminal RTH bar. Never a second live case.
    if (not s7_caseActive) and (not s7_terminalBar) and rawObsSetClosed and s7_obsCount > 0
        int s7_pick = -1
        for s7_i = 0 to s7_obsCount - 1
            Obs s7_o = array.get(rawObsSet, s7_i)
            if s7_pick == -1 and s7_o.riskPass
                s7_pick := s7_i
        if s7_pick >= 0
            Obs s7_a = array.get(rawObsSet, s7_pick)
            s7_caseActive       := true
            s7_caseId           := s7_a.obsId
            s7_caseFamily       := s7_a.family
            s7_caseDir          := s7_a.direction
            s7_caseSignalTime   := s7_a.obsBarTime
            s7_caseSignalOrd    := s7_a.obsOrd
            s7_caseSignalSlot   := s7_a.slotIdx
            s7_caseObsIdxInBar  := s7_a.obsIndexInBar
            s7_caseSignalClose  := s7_a.signalClose
            s7_caseInitialStop  := s7_a.plannedStop
            s7_casePlannedRisk  := s7_a.plannedRisk
            s7_caseTp1          := s7_a.plannedTp1
            s7_caseQFlag        := s7_a.qFlagMask
            s7_caseQAppl        := s7_a.qApplicabilityMask
            s7_caseRiskPass     := s7_a.riskPass
            s7_caseRejectReason := s7_a.rejectReason
            s7_caseClassCode    := s7_a.classCode
            s7_caseZoneMask     := s7_a.zoneIdMask
            s7_caseConfluence   := s7_a.confluence
            s7_caseTouchCount   := s7_a.touchCount
            s7_caseAtrRefAtObs  := s7_a.atrRefAtObs
            s7_caseEntryDistATR := s7_a.entryDistATR
            s7_caseSigRelVol    := s7_a.relVol
            s7_caseSigRoc5      := s7_a.roc5
            s7_caseStartOrd     := currentOrdinal
            s7_caseStartTime    := time_close
            s7_caseObsRef       := s7_a
            s7_tp1Reached       := false
            s7_trailUnlocked    := false
            s7_trailStop        := s7_a.plannedStop
            s7_trailVersion     := 0
            s7_trailPrevLevel   := na
            s7_trailReason      := "INIT_RINV"
            s7_structLost       := false
            s7_warnActive       := false
            s7_caseEndedFlag    := false
            s7_caseEndReason    := ""
            s7_stopTestVer      := na
            // premise resolution (packet §11.1): unique static lineage or N/A
            s7_premiseTrace     := false
            s7_premiseMask      := 0
            s7_premiseAnchorBit := 0
            s7_premiseRole      := 0
            s7_premiseAccDir    := 0
            if s7_a.family != FAM_VWR and s7_a.zoneIdMask > 0 and s7_a.zoneIdMask <= STATIC_MASK_MAX
                int s7_match = 0
                int s7_mi    = -1
                int s7_zn    = array.size(zoneReg)
                if s7_zn > 0
                    for s7_i = 0 to s7_zn - 1
                        Zone s7_z = array.get(zoneReg, s7_i)
                        if s7_z.mask == s7_a.zoneIdMask
                            s7_match += 1
                            s7_mi := s7_i
                if s7_match == 1
                    Zone s7_pz = array.get(zoneReg, s7_mi)
                    s7_premiseTrace     := true
                    s7_premiseMask      := s7_pz.mask
                    s7_premiseAnchorBit := s7_pz.anchorBit
                    s7_premiseRole      := s7_pz.structuralRole
                    s7_premiseAccDir    := s7_pz.acceptedDir
            s7_evt(VP_I_ACTIVE + " ACTIVE · " + vp_dir(s7_caseDir) + " · " + vp_fam(s7_caseFamily), S7_PROF_ESS, S7_PRI_ACTIVE, "ACTIVE STARTED", s7_dirText(s7_caseDir), s7_famText(s7_caseFamily), (na(s7_caseId) ? S7_NA : str.tostring(s7_caseId)), "ELECTION_FIRST_CANONICAL_RISK_PASS · " + S7_NA + " → " + s7_priceText(s7_caseSignalClose))

    // --- S7.5.4 evaluate existing ACTIVE facts / events ----------------------
    if s7_caseActive
        // structure (packet §11.1) — lineage identity, latched loss (F-03)
        if s7_premiseTrace and (not s7_structLost)
            bool s7_found = false
            bool s7_roleOk = false
            int  s7_zn2 = array.size(zoneReg)
            if s7_zn2 > 0
                for s7_i = 0 to s7_zn2 - 1
                    Zone s7_z = array.get(zoneReg, s7_i)
                    if (not s7_found) and s7_z.mask == s7_premiseMask and s7_z.anchorBit == s7_premiseAnchorBit
                        s7_found  := true
                        s7_roleOk := s7_z.structuralRole == s7_premiseRole and s7_z.acceptedDir == s7_premiseAccDir
            if (not s7_found) or (not s7_roleOk)
                s7_structLost := true
                s7_evt(VP_I_FAIL + " STRUCTURE LOST · الهيكل مفقود", S7_PROF_STD, S7_PRI_STRUCTLOST, "STRUCTURE LOST", s7_dirText(s7_caseDir), s7_famText(s7_caseFamily), str.tostring(s7_caseId), (s7_found ? "PREMISE_ROLE_LOST" : "PREMISE_ABSENT") + " · INTACT → LOST")

        // MC-02 DIRECTION WARNING — exact opposite C17 only, NEUTRAL clears
        bool s7_warnNow = structBias == -s7_caseDir and structBias != DIR_NEUTRAL
        if s7_warnNow and (not s7_warnActive)
            s7_warnActive := true
            s7_evt(VP_I_WARN + " AGAINST CASE", S7_PROF_STD, S7_PRI_WARNING, "DIRECTION WARNING", s7_dirText(s7_caseDir), s7_famText(s7_caseFamily), str.tostring(s7_caseId), "C17_AGAINST_CASE · " + s7_dirText(s7_caseDir) + " → " + s7_dirText(structBias))
        if (not s7_warnNow) and s7_warnActive
            s7_warnActive := false
            s7_evt(VP_I_PASS + " WITH CASE", S7_PROF_DET, S7_PRI_DETAIL, "WARNING CLEARED", s7_dirText(s7_caseDir), s7_famText(s7_caseFamily), str.tostring(s7_caseId), "C17_NOT_OPPOSITE")

        // MC-03 §9.1 CRITICAL candidate creation
        if (not s7_candLive) and rawObsSetClosed and s7_obsCount > 0
            int s7_cpick = -1
            for s7_i = 0 to s7_obsCount - 1
                Obs s7_o = array.get(rawObsSet, s7_i)
                bool s7_after = (not na(s7_o.obsOrd)) and (not na(s7_caseStartOrd)) and s7_o.obsOrd > s7_caseStartOrd and s7_o.obsId != s7_caseId
                if s7_cpick == -1 and s7_o.riskPass and s7_o.direction == -s7_caseDir and s7_o.direction != DIR_NEUTRAL and structBias == s7_o.direction and s7_after
                    s7_cpick := s7_i
            if s7_cpick >= 0
                Obs s7_c = array.get(rawObsSet, s7_cpick)
                s7_candLive   := true
                s7_candObsId  := s7_c.obsId
                s7_candDir    := s7_c.direction
                s7_candFamily := s7_c.family
                s7_candTime   := s7_c.obsBarTime
                s7_candOrd    := s7_c.obsOrd
                s7_candObsRef := s7_c
                s7_evt(VP_I_WARN + VP_I_ESC + " REVERSAL WATCH · " + vp_dir(s7_candDir), S7_PROF_ESS, S7_PRI_CRITICAL, "DIRECTION CRITICAL", s7_dirText(s7_candDir), s7_famText(s7_candFamily), (na(s7_candObsId) ? S7_NA : str.tostring(s7_candObsId)), "OPPOSITE_RISK_PASSED · case #" + str.tostring(s7_caseId) + " still ACTIVE")

        // TP1 reach (intrabar reach on the confirmed bar) — latched once
        if (not s7_tp1Reached) and (not na(s7_caseTp1))
            bool s7_hit = s7_caseDir == DIR_LONG ? ((not na(rthH)) and rthH >= s7_caseTp1) : ((not na(rthL)) and rthL <= s7_caseTp1)
            if s7_hit
                s7_tp1Reached := true
                s7_evt(VP_I_PASS + " TP1 HIT", S7_PROF_ESS, S7_PRI_TP1, "TP1 REACHED", s7_dirText(s7_caseDir), s7_famText(s7_caseFamily), str.tostring(s7_caseId), "INTRABAR_REACH · TP1 " + s7_priceText(s7_caseTp1))

        // SLOPE support-loss edge (accepted live tri-state producer only, F-02)
        bool s7_slopeSup = (not na(vwapSlopeState)) and vwapSlopeState == s7_caseDir
        if s7_slopeSupportPrev and (not s7_slopeSup)
            s7_evt("VWAP " + VP_I_FAIL, S7_PROF_DET, S7_PRI_DETAIL, "SLOPE SUPPORT LOST", s7_dirText(s7_caseDir), s7_famText(s7_caseFamily), str.tostring(s7_caseId), "VWAP_SLOPE_STATE · " + s7_dirText(s7_caseDir) + " → " + s7_dirText(vwapSlopeState))
        s7_slopeSupportPrev := s7_slopeSup

        // adverse / excessive impulse edge (packet §16 STANDARD)
        if s7_impulseEdge and s7_impulseOn and impulseDirState != DIR_NEUTRAL and impulseDirState == -s7_caseDir
            if na(s7_impulseAlertOrd) or s7_impulseAlertOrd != impulseExpiryOrd
                s7_impulseAlertOrd := impulseExpiryOrd
                string s7_impTxt = impulseExcessiveState ? "EXCESSIVE IMPULSE · ADVERSE" : "IMPULSE · ADVERSE"
                // G7.6 — the chart keeps the SQZ ⚡ / ⚡+ grammar and the impulse's
                // own directional identity; the adverse condition adds a caution
                // label and NEVER converts the marker into a hard-failure class.
                string s7_impUi = "SQZ " + (impulseExcessiveState ? VP_I_IMPX : VP_I_IMP) + (impulseDirState == DIR_LONG ? " ↑" : impulseDirState == DIR_SHORT ? " ↓" : "") + " · " + vp_dir(impulseDirState) + " · " + VP_I_WARN + " AGAINST CASE"
                s7_evt(s7_impUi, S7_PROF_STD, S7_PRI_IMPULSE, s7_impTxt, s7_dirText(impulseDirState), s7_famText(s7_caseFamily), str.tostring(s7_caseId), "IMPULSE_AGAINST_CASE")

        // opposite WATCH edge (DETAILED)
        if s7_oppWatchNow and (not s7_oppWatchPrev)
            s7_evt(VP_I_WARN + " " + VP_I_WATCH + " REVERSAL WATCH · " + vp_dir(-s7_caseDir), S7_PROF_DET, S7_PRI_DETAIL, "OPPOSITE WATCH", s7_dirText(-s7_caseDir), S7_NA, str.tostring(s7_caseId), "ARM_REGISTRY")
        s7_oppWatchPrev := s7_oppWatchNow

    // non-anchor structural role change (DETAILED) — bounded snapshot compare
    int s7_zn3 = array.size(zoneReg)
    if s7_zn3 > 0 and s7_zn3 <= S7_ROLE_SNAP_CAP
        for s7_i = 0 to s7_zn3 - 1
            Zone s7_z = array.get(zoneReg, s7_i)
            int s7_ri = array.indexof(s7_roleMasks, s7_z.mask)
            if s7_ri >= 0
                int s7_old = array.get(s7_roleVals, s7_ri)
                if s7_old != s7_z.structuralRole
                    array.set(s7_roleVals, s7_ri, s7_z.structuralRole)
                    bool s7_isAnchor = s7_caseActive and s7_premiseTrace and s7_z.mask == s7_premiseMask
                    if s7_caseActive and (not s7_isAnchor)
                        s7_evt(VP_I_MOVED + " ROLE CHANGE · " + vp_zoneText(s7_z.mask), S7_PROF_DET, S7_PRI_DETAIL, "ROLE CHANGE", S7_NA, S7_NA, (na(s7_caseId) ? S7_NA : str.tostring(s7_caseId)), "NON_ANCHOR_ROLE · " + str.tostring(s7_old) + " → " + str.tostring(s7_z.structuralRole) + " · zone " + s7_zoneText(s7_z.mask))
            else
                if array.size(s7_roleMasks) < S7_ROLE_SNAP_CAP
                    array.push(s7_roleMasks, s7_z.mask)
                    array.push(s7_roleVals, s7_z.structuralRole)
    int s7_rn = array.size(s7_roleMasks)
    if s7_rn > 0
        for s7_o2 = 0 to s7_rn - 1
            int s7_ix = s7_rn - 1 - s7_o2
            if not s7_regHasMask(zoneReg, array.get(s7_roleMasks, s7_ix))
                array.remove(s7_roleMasks, s7_ix)
                array.remove(s7_roleVals, s7_ix)

    // --- S7.5.5 STOP TEST / STOP BREAK against the PRE-RATCHET trail ---------
    bool s7_stopBreak = false
    if s7_caseActive and (not na(s7_trailStop))
        bool s7_touch = s7_caseDir == DIR_LONG ? ((not na(rthL)) and rthL <= s7_trailStop) : ((not na(rthH)) and rthH >= s7_trailStop)
        bool s7_break = s7_caseDir == DIR_LONG ? ((not na(rthC)) and rthC <= s7_trailStop) : ((not na(rthC)) and rthC >= s7_trailStop)
        if s7_break
            s7_stopBreak := true
        else if s7_touch
            if na(s7_stopTestVer) or s7_stopTestVer != s7_trailVersion
                s7_stopTestVer := s7_trailVersion
                s7_evt(VP_I_TOUCH + " STOP TOUCH — case active", S7_PROF_DET, S7_PRI_STOPTEST, "STOP TEST", s7_dirText(s7_caseDir), s7_famText(s7_caseFamily), str.tostring(s7_caseId), "TRAIL_TOUCH_v" + str.tostring(s7_trailVersion) + " · TRAIL " + s7_priceText(s7_trailStop))

    // --- S7.5.6 reversal and termination precedence (packet §15A / §9.3) ----
    bool s7_reversalConfirmed = s7_caseActive and s7_candLive and structBias == s7_candDir and s7_structLost and s7_premiseTrace
    bool s7_endedThisBar      = false

    if s7_stopBreak
        s7_endedThisBar  := true
        s7_caseEndReason := "MGMT_INV_BREACH"
        s7_evt(VP_I_HARD + " STOP BREAK · ENDED", S7_PROF_ESS, S7_PRI_STOPBREAK, "STOP BREAK / CASE ENDED", s7_dirText(s7_caseDir), s7_famText(s7_caseFamily), str.tostring(s7_caseId), "MGMT_INV_BREACH · TRAIL " + s7_priceText(s7_trailStop) + " → close " + s7_priceText(rthC))
    if s7_reversalConfirmed
        s7_evt(VP_I_HARD + " " + VP_I_WARN + " REVERSAL CONFIRMED · " + vp_dir(s7_caseDir) + " → " + vp_dir(s7_candDir), S7_PROF_ESS, S7_PRI_REVERSED, "DIRECTION REVERSED", s7_dirText(s7_candDir), s7_famText(s7_candFamily), str.tostring(s7_caseId), "REVERSAL_CONFIRMED · " + s7_dirText(s7_caseDir) + " → " + s7_dirText(s7_candDir))
        if not s7_endedThisBar
            s7_endedThisBar  := true
            s7_caseEndReason := "REVERSAL_CONFIRMED"

    // --- S7.5.7 terminal session boundary (MC-04) ---------------------------
    if s7_caseActive and (not s7_endedThisBar) and s7_terminalBar
        s7_endedThisBar  := true
        s7_caseEndReason := "SESSION_TERMINAL"
        s7_evt(VP_I_HARD + " ENDED · SESSION END", S7_PROF_ESS, S7_PRI_SESSION, "CASE ENDED · SESSION", s7_dirText(s7_caseDir), s7_famText(s7_caseFamily), str.tostring(s7_caseId), "SESSION_TERMINAL · slot " + str.tostring(slotIdx))
    if s7_termDataMiss and s7_caseActive
        s7_evt(VP_I_LOCALNA + " SESSION TERMINAL DATA MISSING", S7_PROF_DET, S7_PRI_DETAIL, "SESSION TERMINAL DATA MISSING", s7_dirText(s7_caseDir), s7_famText(s7_caseFamily), str.tostring(s7_caseId), "SLOT_UNAVAILABLE")

    // --- S7.5.8 commit case end exactly once --------------------------------
    if s7_endedThisBar and s7_caseActive
        s7_caseActive    := false
        s7_caseEndedFlag := true
        s7_warnActive    := false

    // --- S7.5.9 open the qualified opposite case (packet §9.3) --------------
    // Identity is re-verified against the frozen candidate tuple before any
    // anchor field is taken, so no substitution is possible.
    if s7_reversalConfirmed and (not s7_terminalBar) and (not na(s7_candObsRef))
        Obs s7_c2 = s7_candObsRef
        bool s7_idOk = s7_c2.obsId == s7_candObsId and s7_c2.direction == s7_candDir and s7_c2.family == s7_candFamily and s7_c2.obsBarTime == s7_candTime and s7_c2.riskPass
        if s7_idOk
            s7_caseActive       := true
            s7_caseId           := s7_c2.obsId
            s7_caseFamily       := s7_c2.family
            s7_caseDir          := s7_c2.direction
            s7_caseSignalTime   := s7_c2.obsBarTime
            s7_caseSignalOrd    := s7_c2.obsOrd
            s7_caseSignalSlot   := s7_c2.slotIdx
            s7_caseObsIdxInBar  := s7_c2.obsIndexInBar
            s7_caseSignalClose  := s7_c2.signalClose
            s7_caseInitialStop  := s7_c2.plannedStop
            s7_casePlannedRisk  := s7_c2.plannedRisk
            s7_caseTp1          := s7_c2.plannedTp1
            s7_caseQFlag        := s7_c2.qFlagMask
            s7_caseQAppl        := s7_c2.qApplicabilityMask
            s7_caseRiskPass     := s7_c2.riskPass
            s7_caseRejectReason := s7_c2.rejectReason
            s7_caseClassCode    := s7_c2.classCode
            s7_caseZoneMask     := s7_c2.zoneIdMask
            s7_caseConfluence   := s7_c2.confluence
            s7_caseTouchCount   := s7_c2.touchCount
            s7_caseAtrRefAtObs  := s7_c2.atrRefAtObs
            s7_caseEntryDistATR := s7_c2.entryDistATR
            s7_caseSigRelVol    := s7_c2.relVol
            s7_caseSigRoc5      := s7_c2.roc5
            s7_caseStartOrd     := currentOrdinal
            s7_caseStartTime    := time_close
            s7_caseObsRef       := s7_c2
            s7_tp1Reached       := false
            s7_trailUnlocked    := false
            s7_trailStop        := s7_c2.plannedStop
            s7_trailVersion     := 0
            s7_trailPrevLevel   := na
            s7_trailReason      := "INIT_RINV"
            s7_structLost       := false
            s7_warnActive       := false
            s7_caseEndedFlag    := false
            s7_caseEndReason    := ""
            s7_stopTestVer      := na
            s7_slopeSupportPrev := false
            s7_oppWatchPrev     := false
            s7_impulseAlertOrd  := na
            s7_premiseTrace     := false
            s7_premiseMask      := 0
            s7_premiseAnchorBit := 0
            s7_premiseRole      := 0
            s7_premiseAccDir    := 0
            if s7_c2.family != FAM_VWR and s7_c2.zoneIdMask > 0 and s7_c2.zoneIdMask <= STATIC_MASK_MAX
                int s7_m2 = 0
                int s7_i2 = -1
                int s7_zn4 = array.size(zoneReg)
                if s7_zn4 > 0
                    for s7_i = 0 to s7_zn4 - 1
                        Zone s7_z = array.get(zoneReg, s7_i)
                        if s7_z.mask == s7_c2.zoneIdMask
                            s7_m2 += 1
                            s7_i2 := s7_i
                if s7_m2 == 1
                    Zone s7_pz2 = array.get(zoneReg, s7_i2)
                    s7_premiseTrace     := true
                    s7_premiseMask      := s7_pz2.mask
                    s7_premiseAnchorBit := s7_pz2.anchorBit
                    s7_premiseRole      := s7_pz2.structuralRole
                    s7_premiseAccDir    := s7_pz2.acceptedDir
            s7_evt(VP_I_ACTIVE + " ACTIVE · " + vp_dir(s7_caseDir) + " · " + vp_fam(s7_caseFamily), S7_PROF_ESS, S7_PRI_ACTIVE, "ACTIVE STARTED", s7_dirText(s7_caseDir), s7_famText(s7_caseFamily), (na(s7_caseId) ? S7_NA : str.tostring(s7_caseId)), "REVERSAL_ANCHOR · " + S7_NA + " → " + s7_priceText(s7_caseSignalClose))
    if s7_reversalConfirmed
        s7_candLive   := false
        s7_candObsId  := na
        s7_candDir    := 0
        s7_candFamily := 0
        s7_candTime   := na
        s7_candOrd    := na
        s7_candObsRef := na

    // --- S7.5.10 TRAIL ON unlock and authorized ratchet (packet §14) --------
    if s7_caseActive and (not s7_trailUnlocked) and (not na(s7_caseTp1)) and (not na(rthC))
        bool s7_unlock = s7_caseDir == DIR_LONG ? rthC >= s7_caseTp1 : rthC <= s7_caseTp1
        if s7_unlock
            s7_trailUnlocked := true
            s7_evt(VP_I_ACTIVE + " STOP+ ON", S7_PROF_DET, S7_PRI_TRAILON, "TRAIL ON", s7_dirText(s7_caseDir), s7_famText(s7_caseFamily), str.tostring(s7_caseId), "TP1_UNLOCK · close " + s7_priceText(rthC))

    if s7_caseActive and s7_trailUnlocked and (not na(rthC)) and (not na(s7_trailStop))
        float s7_structCand = na
        int   s7_zn5 = array.size(zoneReg)
        if s7_zn5 > 0
            for s7_i = 0 to s7_zn5 - 1
                Zone s7_z = array.get(zoneReg, s7_i)
                bool s7_geom = (not na(s7_z.lower)) and (not na(s7_z.upper))
                if s7_caseDir == DIR_LONG and s7_geom and s7_z.structuralRole == ROLE_SUPPORT and s7_z.upper < rthC
                    if na(s7_structCand) or s7_z.lower > s7_structCand
                        s7_structCand := s7_z.lower
                if s7_caseDir == DIR_SHORT and s7_geom and s7_z.structuralRole == ROLE_RESISTANCE and s7_z.lower > rthC
                    if na(s7_structCand) or s7_z.upper < s7_structCand
                        s7_structCand := s7_z.upper
        float s7_best = s7_trailStop
        if s7_caseDir == DIR_LONG
            if (not na(s7_caseSignalClose)) and s7_caseSignalClose > s7_best
                s7_best := s7_caseSignalClose
            if (not na(s7_structCand)) and s7_structCand > s7_best
                s7_best := s7_structCand
        else
            if (not na(s7_caseSignalClose)) and s7_caseSignalClose < s7_best
                s7_best := s7_caseSignalClose
            if (not na(s7_structCand)) and s7_structCand < s7_best
                s7_best := s7_structCand
        if s7_best != s7_trailStop
            string s7_reason = ((not na(s7_structCand)) and s7_structCand == s7_best) ? "RATCHET_STRUCTURE" : "RATCHET_SIGNAL_REFERENCE"
            s7_trailPrevLevel := s7_trailStop
            s7_trailStop      := s7_best
            s7_trailVersion   += 1
            s7_trailReason    := s7_reason
            s7_evt(VP_I_MOVED + " STOP+ MOVED", S7_PROF_DET, S7_PRI_DETAIL, "TRAIL UPDATED", s7_dirText(s7_caseDir), s7_famText(s7_caseFamily), str.tostring(s7_caseId), s7_reason + " · " + s7_priceText(s7_trailPrevLevel) + " → " + s7_priceText(s7_trailStop) + " · v" + str.tostring(s7_trailVersion))

    // --- S7.5.11 append bounded current-session history ---------------------
    int s7_evn = array.size(s7_evtRec)
    if s7_evn > 0
        for s7_i = 0 to s7_evn - 1
            array.push(s7_hist, array.get(s7_evtRec, s7_i))
        int s7_over = array.size(s7_hist) - S7_HIST_CAP
        if s7_over > 0
            for s7_i = 0 to s7_over - 1
                array.shift(s7_hist)

// =============================================================================
// S7.6 CURRENT DISPLAY FACTS
// =============================================================================
// ROOM / NEXT BARRIER — lossless reproduction of the accepted C14/R9 opposing
// barrier semantics (IC1R4 lines 2935-2946) using accepted registry facts and
// the accepted PURE selectors. No threshold, buffer, ranking or new authority.
// `sameOwn` uses the anchor zoneIdMask, which for every non-VWR family is the
// arm zoneIdMask by construction (IC1R4 line 3044: vMask = fam == FAM_VWR ?
// BIT_VWAP : a.zoneIdMask). Display and history are the only consumers.
float s7_room     = na
float s7_barrier  = na
int v4_barrierRole = ROLE_NEUTRAL
if s7_caseActive and (not na(rthC)) and array.size(zoneReg) > 0
    for s7_i = 0 to array.size(zoneReg) - 1
        Zone s7_z = array.get(zoneReg, s7_i)
        bool s7_sameOwn = (s7_caseFamily != FAM_VWR) and s7_z.mask == s7_caseZoneMask
        bool s7_brokenSame = s7_caseDir == DIR_LONG ? s7_z.brokenLong : s7_z.brokenShort
        if (not s7_sameOwn) and (not s7_brokenSame)
            float s7_zn6 = zoneNearOf(s7_caseDir, s7_z.lower, s7_z.upper)
            float s7_rm  = dirDistOf(s7_zn6, rthC, s7_caseDir)
            if (not na(s7_rm)) and s7_rm > 0
                if na(s7_room) or s7_rm < s7_room
                    s7_room    := s7_rm
                    s7_barrier := s7_zn6
                    v4_barrierRole := s7_z.structuralRole

// SQUEEZE box precedence (packet §13.2)
bool s7_sqzArmed = false
int  s7_sqzArmDir = DIR_NEUTRAL
if s7_armCount > 0
    for s7_i = 0 to s7_armCount - 1
        Arm s7_a = array.get(armStore, s7_i)
        if (not s7_sqzArmed) and s7_a.family == FAM_SQZ
            s7_sqzArmed  := true
            s7_sqzArmDir := s7_a.direction
// STRUCTURE surface
string s7_structText = "N/A"
if s7_caseActive and s7_premiseTrace
    s7_structText := s7_structLost ? "LOST" : "INTACT"

// Evidence strip source: ACTIVE anchor, else the current-bar first Observation.
// The strip is the FROZEN signal-time snapshot (Final UX §11.2). The companion
// value reads below are taken from the SAME frozen record — never from a live
// producer — so live Momentum / RVOL / Slope can never rewrite the strip.
//
// A49 / C-03 — DISPLAYED-OPPORTUNITY ELECTION.
// Exactly one opportunity owns the primary card, the Evidence strip and the
// SIGNAL COMPARISON table at a time, and every column of that table is drawn
// from that one identity. Election order, highest first:
//
//   1  ACTIVE case          — the live managed case owns the surface. Case
//                             election itself is unchanged; this only decides
//                             which already-elected object is displayed.
//   2  current Observation  — a new source-owned opportunity on this bar takes
//                             the context over from any retained ended case,
//                             which then lives on in history custody only.
//   3  retained ended case  — its OWN frozen anchor, never an unrelated
//                             current-bar Observation (A49 F-03).
//
// C-02: the truthful SETUP / REJECTED classification travels with the elected
// snapshot as `s7_stripPass`, so the comparison table can never label a
// risk-rejected Observation SETUP while the primary card calls it REJECTED.
int   s7_stripFlag  = na
int   s7_stripAppl  = na
float s7_stripRvol  = na
float s7_stripRoc5  = na
int   s7_stripZone  = na
int   s7_stripTouch = na
int   s7_stripTime  = na
int   s7_stripFam   = 0
int   s7_stripDir   = 0
bool  s7_stripPass  = false
bool  s7_stripEnded = false
bool  s7_stripHas   = false
if s7_caseActive
    s7_stripFlag  := s7_caseQFlag
    s7_stripAppl  := s7_caseQAppl
    s7_stripRvol  := s7_caseSigRelVol
    s7_stripRoc5  := s7_caseSigRoc5
    s7_stripZone  := s7_caseZoneMask
    s7_stripTouch := s7_caseTouchCount
    s7_stripTime  := s7_caseSignalTime
    s7_stripFam   := s7_caseFamily
    s7_stripDir   := s7_caseDir
    s7_stripPass  := s7_caseRiskPass
    s7_stripHas   := true
else if rawObsSetClosed and s7_obsCount > 0
    Obs s7_o0 = array.get(rawObsSet, 0)
    s7_stripFlag  := s7_o0.qFlagMask
    s7_stripAppl  := s7_o0.qApplicabilityMask
    s7_stripRvol  := s7_o0.relVol
    s7_stripRoc5  := s7_o0.roc5
    s7_stripZone  := s7_o0.zoneIdMask
    s7_stripTouch := s7_o0.touchCount
    s7_stripTime  := s7_o0.obsBarTime
    s7_stripFam   := s7_o0.family
    s7_stripDir   := s7_o0.direction
    s7_stripPass  := s7_o0.riskPass
    s7_stripHas   := true
else if s7_caseEndedFlag and (not na(s7_caseSignalTime))
    s7_stripFlag  := s7_caseQFlag
    s7_stripAppl  := s7_caseQAppl
    s7_stripRvol  := s7_caseSigRelVol
    s7_stripRoc5  := s7_caseSigRoc5
    s7_stripZone  := s7_caseZoneMask
    s7_stripTouch := s7_caseTouchCount
    s7_stripTime  := s7_caseSignalTime
    s7_stripFam   := s7_caseFamily
    s7_stripDir   := s7_caseDir
    s7_stripPass  := s7_caseRiskPass
    s7_stripEnded := true
    s7_stripHas   := true
[s7_qPass, s7_qAppl, s7_qOk] = s7_qCount(s7_stripFlag, s7_stripAppl)

// A49 / C-03 §3.3-3.5 — anchor-bar timing. On the elected opportunity's own
// anchor/signal bar only AT SIGNAL is knowable: no later bar exists yet, so
// SIGNAL CHANGES and SIGNAL STATUS stay unavailable. A live value produced on
// the anchor bar must never be presented as a post-signal change merely
// because the same execution pass can reach it. From the next confirmed bar
// onward both columns populate and keep updating, and neither ever writes back
// to the frozen anchor.
// The anchor-bar timing rule above is implemented once, by v4_matrixLive.

// lifecycle headline
int    s7_watchCount = 0
int    s7_watchFam   = 0
int    s7_watchDir   = 0
if s7_armCount > 0
    for s7_i = 0 to s7_armCount - 1
        Arm s7_a = array.get(armStore, s7_i)
        s7_watchCount += 1
        if s7_watchCount == 1
            s7_watchFam := s7_a.family
            s7_watchDir := s7_a.direction
// dominant current event (display precedence, profile-independent)
string s7_domText = ""
int    s7_domPri  = -1
int    s7_domN    = array.size(s7_evtPri)
if s7_domN > 0
    for s7_i = 0 to s7_domN - 1
        int s7_p = array.get(s7_evtPri, s7_i)
        if s7_p > s7_domPri
            s7_domPri  := s7_p
            s7_domText := array.get(s7_evtText, s7_i)
    if s7_domN > 1
        s7_domText := s7_domText + "  +" + str.tostring(s7_domN - 1)
// A49 / C-01 — the reversal tuple as the source recorded it, read back from
// this bar's own event ledger. On a confirmed reversal the case is ended and,
// where Gate-4 allows, the opposite case is opened in the SAME execution pass:
// s7_caseDir is re-anchored to the NEW direction and the candidate fields are
// cleared to 0/na. Recomposing the warning from those post-handoff mutable
// fields therefore rendered "<new dir> → NEUTRAL · case ended". Reading the
// recorded event text instead keeps one coherent, source-owned event context.
// No reversal qualification, precedence, priority, termination, opposite-case
// opening, candidate lifecycle or Direction rule is touched, and no new
// persistent producer is created — this is a read of an existing ledger entry.
string s7_revEvtText = ""
if s7_domN > 0
    for s7_i = 0 to s7_domN - 1
        if array.get(s7_evtPri, s7_i) == S7_PRI_REVERSED
            s7_revEvtText := array.get(s7_evtText, s7_i)

// --- S7.6a VP-02 / VP-06 / VP-07 surface derivation ---------------------------
// Presentation composition only. Every value below is a formatting of an
// already-accepted producer read; no new producer, threshold or state.

// G3.1 STATE — mirrors the accepted election precedence exactly (ACTIVE, then a
// current source-owned Observation, then WATCH, then readiness). A risk-rejected
// Observation is NOT a SIGNAL: the RISK cell owns the failure and its reason, so
// the lifecycle vocabulary stays exactly NO SIGNAL / WATCH / SIGNAL / ACTIVE /
// ENDED. Nothing here re-elects, re-orders or re-qualifies anything.
string vp_state    = "NO SIGNAL"
color  vp_stateTnt = s7c_mut
color  vp_stateBg  = VPS_Q0
string vp_stateTip = "No current source-owned opportunity."
if s7_caseActive
    vp_state    := VP_I_ACTIVE + " ACTIVE"
    vp_stateTnt := s7c_ref
    vp_stateBg  := VPS_A14REF
    vp_stateTip := "OSE is following this case. ACTIVE is an OSE case state, not a broker position."
else if rawObsSetClosed and s7_obsCount > 0
    vp_state    := s7_stripPass ? VP_I_SIGNAL + " SIGNAL" : "NO SIGNAL"
    vp_stateTnt := s7_stripPass ? s7c_ref : s7c_mut
    vp_stateBg  := s7_stripPass ? VPS_A14REF : VPS_Q0
    vp_stateTip := s7_stripPass ? "Source-owned qualified opportunity on this confirmed bar." : "An opportunity was observed and Risk rejected it. The RISK cell states the binding reason."
else if s7_watchCount > 0
    vp_state    := VP_I_WATCH + " WATCH"
    vp_stateTnt := s7c_amb
    vp_stateBg  := VPS_A14AMB
    vp_stateTip := "Live arm registry: " + str.tostring(s7_watchCount) + " armed context(s)."
else if not s7_coreReady
    // Three distinct readiness meanings, never collapsed (G9). Outside RTH the
    // engine is simply not applicable; inside RTH a short bar history is the
    // producer's own warm-up; inside RTH with the required series missing is the
    // one genuine global interpretability failure this source owns.
    if not actualRthBar
        vp_state    := VP_I_LOCALNA + " OUTSIDE RTH"
        vp_stateBg  := VPS_Q4MUT
        vp_stateTip := "Outside the accepted RTH session. Not an error."
    else if na(rthBarsAvailable) or rthBarsAvailable < 15
        vp_state    := VP_I_WARM + " WARMING"
        vp_stateTnt := s7c_amb
        vp_stateBg  := VPS_Q4MUT
        vp_stateTip := "Accepted producer warm-up: RTH bars available " + str.tostring(rthBarsAvailable) + "."
    else
        vp_state    := VP_GLOBAL_NA
        vp_stateTnt := s7c_bad
        vp_stateBg  := VPS_X36RED
        vp_stateTip := "Global interpretability failure: required RTH / ATR series unavailable."
if s7_caseEndedFlag and (not s7_caseActive) and s7_stripEnded
    vp_state    := "ENDED"
    vp_stateTnt := s7c_mut
    vp_stateBg  := VPS_Q4MUT
    vp_stateTip := "Retained ended case · " + (s7_caseEndReason == "MGMT_INV_BREACH" ? "STOP BREAK" : s7_caseEndReason == "REVERSAL_CONFIRMED" ? "REVERSAL CONFIRMED" : s7_caseEndReason == "SESSION_TERMINAL" ? "SESSION END" : VP_NA)



// G3.6 STRUCTURE / ACTIVE ZONE — compact accepted Active Zone identifier. The
// zone name never invents a role; the role accent comes from the registry.
string vp_zoneName   = VP_NA
int    vp_zoneRole   = ROLE_NEUTRAL
string vp_zoneBounds = VP_NA
string vp_zoneTip    = "No current accepted Active Zone."
if (not na(activeZoneIdx)) and activeZoneIdx >= 0 and activeZoneIdx < array.size(zoneReg)
    Zone vp_az    = array.get(zoneReg, activeZoneIdx)
    vp_zoneName   := vp_zoneText(vp_az.mask)
    vp_zoneRole   := vp_az.structuralRole
    vp_zoneBounds := s7_priceText(vp_az.lower) + " — " + s7_priceText(vp_az.upper)
    vp_zoneTip    := s7_roleText(vp_az.structuralRole) + " · confluence " + str.tostring(vp_az.confluence) + " · bounds " + vp_zoneBounds

// G3.9 SQZ — panel grammar only. The chart-only 💥 / ⚡ symbols are never used
// as persistent panel grammar.
string vp_sqzCell = "SQZ OFF"
color  vp_sqzTnt  = s7c_mut
color  vp_sqzBg   = VPS_Q0
if not actualRthBar
    vp_sqzCell := "SQZ " + VP_I_LOCALNA
    vp_sqzBg   := VPS_Q4MUT
else if not sqzCoreReady
    vp_sqzCell := "SQZ " + VP_I_WARM
    vp_sqzTnt  := s7c_amb
    vp_sqzBg   := VPS_Q4MUT
else if squeezeRelease
    vp_sqzCell := "SQZ RELEASE"
    vp_sqzTnt  := s7c_ref
    vp_sqzBg   := VPS_X32REF
else if s7_sqzArmed
    vp_sqzCell := "SQZ READY"
    vp_sqzTnt  := s7c_amb
    vp_sqzBg   := VPS_A14AMB
else if squeezeOn
    vp_sqzCell := "SQZ ON"
    vp_sqzTnt  := s7c_sup
    vp_sqzBg   := VPS_A14SUP

// G3.7 CURRENT EVENT — the single highest-authority transient event this bar,
// read from the existing ledger. No new event, lifetime, timer or hold period.
// A separately persistent critical status (RISK ❌ / STRUCTURE ❌) keeps its own
// X salience in its own cell and is never demoted by this cell (§8.3).
string vp_evtCell = VP_NA
color  vp_evtTnt  = s7c_mut
color  vp_evtBg   = VPS_Q0
if str.length(s7_domText) > 0
    vp_evtCell := s7_domText
    if s7_domPri == S7_PRI_REVERSED or s7_domPri == S7_PRI_STOPBREAK
        vp_evtTnt := s7c_bad
        vp_evtBg  := VPS_X36RED
    else if s7_domPri == S7_PRI_SESSION
        vp_evtTnt := s7c_ref
        vp_evtBg  := VPS_A14REF
    else if s7_domPri == S7_PRI_CRITICAL
        vp_evtTnt := s7c_amb
        vp_evtBg  := VPS_X32AMB
    else if s7_domPri == S7_PRI_STRUCTLOST
        vp_evtTnt := s7c_bad
        vp_evtBg  := VPS_X32RED
    else if s7_domPri == S7_PRI_TP1
        vp_evtTnt := s7c_sup
        vp_evtBg  := VPS_X32SUP
    else if s7_domPri == S7_PRI_WARNING or s7_domPri == S7_PRI_STOPTEST
        vp_evtTnt := s7c_amb
        vp_evtBg  := VPS_A14AMB
    else if s7_domPri == S7_PRI_ACTIVE or s7_domPri == S7_PRI_TRAILON
        vp_evtTnt := s7c_ref
        vp_evtBg  := VPS_A14REF
    else if s7_domPri == S7_PRI_IMPULSE
        vp_evtTnt := s7c_amb
        vp_evtBg  := VPS_A14AMB
    else
        vp_evtTnt := s7c_ink2
        vp_evtBg  := VPS_Q0
else if s7_caseActive and s7_candLive
    vp_evtCell := VP_I_WARN + VP_I_ESC + " REVERSAL WATCH · " + vp_dir(s7_candDir)
    vp_evtTnt  := s7c_amb
    vp_evtBg   := VPS_X32AMB
else if s7_caseActive and s7_warnActive
    vp_evtCell := VP_I_WARN + " AGAINST CASE"
    vp_evtTnt  := s7c_amb
    vp_evtBg   := VPS_A14AMB

// =============================================================================
// S7.7 EXTERNAL ALERT — one dynamic stream, edge-based, one message per bar
// =============================================================================
string s7_alertMsg   = ""
int    s7_alertPri   = -1
int    s7_alertCount = 0
if s7_profRank > S7_PROF_OFF and array.size(s7_evtProf) > 0
    for s7_i = 0 to array.size(s7_evtProf) - 1
        if array.get(s7_evtProf, s7_i) <= s7_profRank
            s7_alertCount += 1
            if array.get(s7_evtPri, s7_i) > s7_alertPri
                s7_alertPri := array.get(s7_evtPri, s7_i)
                s7_alertMsg := array.get(s7_evtText, s7_i)
string s7_alertBody = ""
if s7_alertCount > 0
    s7_alertBody := "[" + s7_profileToken(s7_alertProfile) + " · " + S7_BUILD + "]\nOSE · " + syminfo.ticker + " · " + s7_hhmm(time_close) + "\n" + s7_alertMsg
    if s7_alertCount > 1
        s7_alertBody := s7_alertBody + "  +" + str.tostring(s7_alertCount - 1)
    if s7_caseActive
        s7_alertBody := s7_alertBody + "\nCASE " + vp_dir(s7_caseDir) + " · " + vp_fam(s7_caseFamily) + " · " + (s7_tp1Reached ? "AFTER TP1" : "BEFORE TP1") + " · STRUCTURE " + (s7_structText == "N/A" ? VP_I_LOCALNA : s7_structText)
        s7_alertBody := s7_alertBody + "\nSTOP " + s7_priceText(s7_caseInitialStop) + " · STOP+ " + s7_priceText(s7_trailStop) + " · TP1 " + s7_priceText(s7_caseTp1)
    if s7_alertPri == S7_PRI_ACTIVE
        s7_alertBody := s7_alertBody + "\n" + S7_ACTIVE_TIP
bool s7_alertFits    = str.length(s7_alertBody) <= S7_ALERT_LIMIT
bool s7_alertDedupOk = (not na(time_close)) and (na(s7_lastAlertBar) or s7_lastAlertBar != time_close)
bool s7_alertGo      = s7_commitBar and s7_alertCount > 0 and s7_alertFits and s7_alertDedupOk

if s7_alertGo
    alert(s7_alertBody, alert.freq_once_per_bar_close)
    s7_lastAlertBar := time_close

// =============================================================================
// IC4.1 READ-ONLY VIEW ADAPTERS AND BOUNDED PRESENTATION RECORDS
// No function below writes Stage-6 or management state. Arrays/UDTs below own
// display records only; input filters affect retention/rendering, never signals.
// =============================================================================
const int V4_EVENT_LIVE_CAP = 48
const int V4_EVENT_ARCHIVE_CAP = 16
const int V4_RANGE_CAP = 8
const int V4_LEVEL_CAP = 4
const int V4_SESSION_CAP = 3
const int V4_WATCH_CAP = 8
const int V4_CANDLE_CAP = 288

type V4Event
    int session
    int candle
    int confirmed
    int caseId
    int nextCaseId
    int family
    int direction
    int priority
    string title
    string detail
    float highPrice
    float spacing
    bool watchOnly

type V4Range
    int session
    int born
    int until
    int mask
    int anchor
    int role
    float lower
    float upper

type V4Level
    int session
    int born
    int until
    int kind
    float price

type V4Candle
    int session
    int ordinal
    int stamp
    int closeStamp
    float highPrice
    float lowPrice
    float vwapPrice
    float spacing

type V4Watch
    int session
    int ordinal
    int stamp
    int family
    int direction
    int mask
    float highPrice
    float spacing

type V4Coverage
    int session
    int events = 0
    int ranges = 0
    int levels = 0
    int droppedEvents = 0
    int droppedRanges = 0
    int droppedLevels = 0

var array<V4Event> v4_events = array.new<V4Event>()
var array<V4Range> v4_ranges = array.new<V4Range>()
var array<V4Range> v4_openRanges = array.new<V4Range>()
var array<V4Level> v4_levels = array.new<V4Level>()
var array<V4Level> v4_openLevels = array.new<V4Level>()
var array<V4Candle> v4_candles = array.new<V4Candle>()
var array<V4Watch> v4_watches = array.new<V4Watch>()
var array<V4Coverage> v4_coverage = array.new<V4Coverage>()
var int v4_recordSession = na
var int v4_lastCommitTime = na
var int v4_trailStamp = na
var int v4_trailCase = na
var int v4_trailVersionSeen = na

v4_familyVisible(int family) =>
    family == FAM_VWR ? v4_markVwr : family == FAM_LBO ? v4_markLbo : family == FAM_LRT ? v4_markLrt : family == FAM_SQZ ? v4_markSqz : true

v4_directionColor(int direction) =>
    direction == DIR_LONG ? s7c_sup : direction == DIR_SHORT ? s7c_res : s7c_mut


// Approved marker semantics. Reversal / hard termination red; session end and
// lifecycle blue; reversal candidate and caution amber; structure loss red;
// TP1 green. An excessive or adverse impulse keeps its DIRECTIONAL identity and
// is never recoloured into a hard-failure class.
v4_eventColor(int priority, int direction) =>
    priority == S7_PRI_REVERSED or priority == S7_PRI_STOPBREAK or priority == S7_PRI_STRUCTLOST ? s7c_bad : priority == S7_PRI_SESSION or priority == S7_PRI_ACTIVE or priority == S7_PRI_TRAILON ? s7c_ref : priority == S7_PRI_CRITICAL or priority == S7_PRI_WARNING or priority == S7_PRI_STOPTEST ? s7c_amb : priority == S7_PRI_TP1 ? s7c_sup : v4_directionColor(direction)


v4_eventName(string value) =>
    array<string> fields = str.split(value, " · ")
    string name = array.size(fields) > 0 ? array.get(fields, 0) : value
    name := str.replace_all(name, " — case active", "")
    name

v4_textFamily(string value, int fallback) =>
    str.contains(value, "VWR") ? FAM_VWR : str.contains(value, "LBO") ? FAM_LBO : str.contains(value, "LRT") ? FAM_LRT : str.contains(value, "SQZ") ? FAM_SQZ : fallback

v4_covFor(array<V4Coverage> rows, int session) =>
    V4Coverage result = na
    if array.size(rows) > 0
        for i = 0 to array.size(rows) - 1
            V4Coverage item = array.get(rows, i)
            if item.session == session
                result := item
    result

v4_trimEvents(array<V4Event> records, int session, int cap, array<V4Coverage> stats) =>
    int count = 0
    if array.size(records) > 0
        for i = 0 to array.size(records) - 1
            if array.get(records, i).session == session
                count += 1
    // Input-independent finite bound: at most the live cap can require trimming.
    int excess = math.max(0, count - cap)
    if excess > 0
        for pass = 0 to excess - 1
            int weakest = -1
            if array.size(records) > 0
                for i = 0 to array.size(records) - 1
                    V4Event item = array.get(records, i)
                    if item.session == session
                        if weakest == -1
                            weakest := i
                        else
                            V4Event held = array.get(records, weakest)
                            if item.priority < held.priority or (item.priority == held.priority and item.candle > held.candle)
                                weakest := i
            if weakest >= 0
                array.remove(records, weakest)
                V4Coverage cov = v4_covFor(stats, session)
                if not na(cov)
                    cov.droppedEvents += 1
    true

v4_storeRange(array<V4Range> records, V4Range item, array<V4Coverage> stats) =>
    V4Coverage cov = v4_covFor(stats, item.session)
    if not na(cov)
        cov.ranges += 1
    int count = 0
    int first = -1
    if array.size(records) > 0
        for i = 0 to array.size(records) - 1
            if array.get(records, i).session == item.session
                count += 1
                if first == -1
                    first := i
    if count >= V4_RANGE_CAP and first >= 0
        array.remove(records, first)
        if not na(cov)
            cov.droppedRanges += 1
    array.push(records, item)
    true

v4_storeLevel(array<V4Level> records, V4Level item, array<V4Coverage> stats) =>
    V4Coverage cov = v4_covFor(stats, item.session)
    if not na(cov)
        cov.levels += 1
    int count = 0
    int first = -1
    if array.size(records) > 0
        for i = 0 to array.size(records) - 1
            if array.get(records, i).session == item.session
                count += 1
                if first == -1
                    first := i
    if count >= V4_LEVEL_CAP and first >= 0
        array.remove(records, first)
        if not na(cov)
            cov.droppedLevels += 1
    array.push(records, item)
    true

v4_closeSession(array<V4Range> openRanges, array<V4Range> ranges, array<V4Level> openLevels, array<V4Level> levels, array<V4Coverage> stats) =>
    if array.size(openRanges) > 0
        for i = 0 to array.size(openRanges) - 1
            v4_storeRange(ranges, array.get(openRanges, i), stats)
    array.clear(openRanges)
    if array.size(openLevels) > 0
        for i = 0 to array.size(openLevels) - 1
            v4_storeLevel(levels, array.get(openLevels, i), stats)
    array.clear(openLevels)
    true

v4_pruneRecords(array<V4Event> events, array<V4Range> ranges, array<V4Level> levels, array<V4Candle> candles, int oldest) =>
    int ei = array.size(events) - 1
    while ei >= 0
        if array.get(events, ei).session < oldest
            array.remove(events, ei)
        ei -= 1
    int zi = array.size(ranges) - 1
    while zi >= 0
        if array.get(ranges, zi).session < oldest
            array.remove(ranges, zi)
        zi -= 1
    int li = array.size(levels) - 1
    while li >= 0
        if array.get(levels, li).session < oldest
            array.remove(levels, li)
        li -= 1
    int ci = array.size(candles) - 1
    while ci >= 0
        if array.get(candles, ci).session < oldest
            array.remove(candles, ci)
        ci -= 1
    true

v4_captureRanges(array<V4Range> live, array<V4Range> archive, array<V4Coverage> stats) =>
    int li = array.size(live) - 1
    while li >= 0
        V4Range held = array.get(live, li)
        bool matches = false
        if array.size(zoneReg) > 0
            for j = 0 to array.size(zoneReg) - 1
                Zone z = array.get(zoneReg, j)
                if z.mask == held.mask and z.anchorBit == held.anchor and z.lower == held.lower and z.upper == held.upper and z.structuralRole == held.role
                    matches := true
        if not matches
            v4_storeRange(archive, held, stats)
            array.remove(live, li)
        li -= 1
    if array.size(zoneReg) > 0
        for j = 0 to array.size(zoneReg) - 1
            Zone z = array.get(zoneReg, j)
            bool valid = z.mask > 0 and z.mask <= STATIC_MASK_MAX and not na(z.lower) and not na(z.upper) and z.lower <= z.upper
            if valid
                int index = -1
                if array.size(live) > 0
                    for i = 0 to array.size(live) - 1
                        V4Range held = array.get(live, i)
                        if held.mask == z.mask and held.anchor == z.anchorBit
                            index := i
                if index == -1
                    array.push(live, V4Range.new(sessionOpenMs, time, time_close, z.mask, z.anchorBit, z.structuralRole, z.lower, z.upper))
                else
                    V4Range held = array.get(live, index)
                    held.until := time_close
    true

v4_captureLevel(array<V4Level> live, array<V4Level> archive, array<V4Coverage> stats, int kind, float value, bool valid) =>
    int index = -1
    if array.size(live) > 0
        for i = 0 to array.size(live) - 1
            if array.get(live, i).kind == kind
                index := i
    if index >= 0
        V4Level held = array.get(live, index)
        if not valid or na(value) or value != held.price
            v4_storeLevel(archive, held, stats)
            array.remove(live, index)
            index := -1
    if valid and not na(value)
        if index == -1
            array.push(live, V4Level.new(sessionOpenMs, time, time_close, kind, value))
        else
            V4Level held = array.get(live, index)
            held.until := time_close
    true

v4_captureWatches(array<V4Watch> watches, array<V4Candle> candles) =>
    array.clear(watches)
    if array.size(armStore) > 0
        for j = 0 to array.size(armStore) - 1
            Arm a = array.get(armStore, j)
            int found = -1
            if array.size(candles) > 0
                for k = 0 to array.size(candles) - 1
                    V4Candle c = array.get(candles, k)
                    if c.session == sessionOpenMs and c.ordinal == a.armBar
                        found := k
            if found >= 0 and array.size(watches) < V4_WATCH_CAP
                V4Candle c = array.get(candles, found)
                array.push(watches, V4Watch.new(c.session, c.ordinal, c.stamp, a.family, a.direction, a.zoneIdMask, c.highPrice, c.spacing))
    true

v4_captureEvents(array<V4Event> records, array<V4Coverage> stats, float spacing) =>
    string detail = ""
    string headline = ""
    int priority = -1
    int family = s7_caseFamily
    int direction = s7_caseDir
    int owner = s7_caseId
    int count = 0
    if array.size(s7_evtText) > 0
        for i = 0 to array.size(s7_evtText) - 1
            string eventText = array.get(s7_evtText, i)
            int p = array.get(s7_evtPri, i)
            // G0.3 co-edit. These selectors read the DISPLAY head, which now
            // carries VP-06 vocabulary; the selected set, its ordering and its
            // effect are identical to the inherited behaviour.
            bool setup = str.startswith(eventText, VP_I_SIGNAL) or str.startswith(eventText, VP_I_FAIL + " REJECTED")
            int eventFamily = v4_textFamily(array.get(s7_evtRec, i), p == S7_PRI_ACTIVE ? s7_caseFamily : v4_caseFamilyPre)
            // G7.5 — the live support-change micro-marker is edge-triggered by the
            // source and owns its own disclosure control. Only the VWAP-slope
            // support producer exists in this build; a live MOM or RVOL support
            // state, and any support-RETURN event, are not owned by this source
            // and none is invented here.
            bool liveChange = str.startswith(eventText, "VWAP " + VP_I_FAIL)
            bool selected = (setup ? v4_showSetup : liveChange ? v4_showLiveChange : v4_showManagement) and v4_familyVisible(eventFamily)
            if selected
                count += 1
                detail += (str.length(detail) > 0 ? "\n" : "") + array.get(s7_evtRec, i)
                if p > priority
                    priority := p
                    headline := eventText
                    family := eventFamily
                    direction := str.contains(eventText, " · CALL") ? DIR_LONG : str.contains(eventText, " · PUT") ? DIR_SHORT : p == S7_PRI_ACTIVE ? s7_caseDir : v4_caseDirPre
                    owner := s7_caseIdPre
                    if p == S7_PRI_ACTIVE
                        owner := s7_caseId
    if v4_showRelease and v4_markSqz and sqzCoreReady and squeezeRelease
        count += 1
        detail += (str.length(detail) > 0 ? "\n" : "") + s7_hhmm(time_close) + " · SQZ RELEASE · accepted C22/C31 event"
        if priority < S7_PRI_DETAIL
            priority := S7_PRI_DETAIL
            headline := "SQZ " + VP_I_BURST
            family := FAM_SQZ
            direction := DIR_NEUTRAL
    bool watchOnly = count == 0
    if v4_showWatch and array.size(v4_watches) > 0
        for i = 0 to array.size(v4_watches) - 1
            V4Watch w = array.get(v4_watches, i)
            if w.ordinal == currentOrdinal and v4_familyVisible(w.family)
                count += 1
                string watchText = VP_I_WATCH + " WATCH · " + vp_fam(w.family) + " · " + vp_dir(w.direction)
                detail += (str.length(detail) > 0 ? "\n" : "") + s7_hhmm(time_close) + " · " + watchText + " · " + vp_zoneText(w.mask)
                if priority < 0
                    priority := 0
                    headline := watchText
                    family := w.family
                    direction := w.direction
    if count > 0
        string title = v4_eventName(headline) + (count > 1 ? "  +" + str.tostring(count - 1) : "")
        V4Coverage cov = v4_covFor(stats, sessionOpenMs)
        if not na(cov)
            cov.events += 1
        detail += "\nCase context: " + (na(s7_caseIdPre) ? "N/A" : str.tostring(s7_caseIdPre)) + " → " + (na(s7_caseId) ? "N/A" : str.tostring(s7_caseId))
        array.push(records, V4Event.new(sessionOpenMs, time, time_close, owner, s7_caseId, family, direction, priority, title, detail, rthH, spacing, watchOnly))
        v4_trimEvents(records, sessionOpenMs, V4_EVENT_LIVE_CAP, stats)
    true

// Capture once per accepted commit. Native rollback preserves exactly one
// committed record per candle; no tick timer, varip, request or alert is added.
if s7_commitBar and not na(sessionOpenMs)
    bool changedSession = na(v4_recordSession) or v4_recordSession != sessionOpenMs
    if changedSession
        v4_closeSession(v4_openRanges, v4_ranges, v4_openLevels, v4_levels, v4_coverage)
        if not na(v4_recordSession)
            v4_trimEvents(v4_events, v4_recordSession, V4_EVENT_ARCHIVE_CAP, v4_coverage)
        v4_recordSession := sessionOpenMs
        array.push(v4_coverage, V4Coverage.new(sessionOpenMs))
        if array.size(v4_coverage) > V4_SESSION_CAP
            array.shift(v4_coverage)
        v4_pruneRecords(v4_events, v4_ranges, v4_levels, v4_candles, array.get(v4_coverage, 0).session)
        array.clear(v4_watches)
    // Geometric label spacing only; it never feeds back into analytical state.
    float spacing = math.max(syminfo.mintick * 6, nz(atrLive, nz(rthH - rthL, syminfo.mintick)) * 0.45)
    array.push(v4_candles, V4Candle.new(sessionOpenMs, currentOrdinal, time, time_close, rthH, rthL, vwap, spacing))
    if array.size(v4_candles) > V4_CANDLE_CAP
        array.shift(v4_candles)
    v4_captureRanges(v4_openRanges, v4_ranges, v4_coverage)
    v4_captureLevel(v4_openLevels, v4_levels, v4_coverage, 1, orHigh, orReady)
    v4_captureLevel(v4_openLevels, v4_levels, v4_coverage, 2, orLow, orReady)
    v4_captureWatches(v4_watches, v4_candles)
    v4_captureEvents(v4_events, v4_coverage, spacing)
    v4_lastCommitTime := time
    if s7_caseActive
        bool newCase = na(v4_trailCase) or v4_trailCase != s7_caseId
        if newCase or na(v4_trailVersionSeen) or v4_trailVersionSeen != s7_trailVersion
            v4_trailStamp := newCase ? s7_caseSignalTime : time
            v4_trailCase := s7_caseId
            v4_trailVersionSeen := s7_trailVersion
    else
        v4_trailStamp := na
        v4_trailCase := na
        v4_trailVersionSeen := na

// Same-record view context. A historical snapshot appears only when review is
// explicitly enabled. Current ACTIVE Evidence is independent of history inputs.
Obs v4_obs = na
if s7_caseActive
    v4_obs := s7_caseObsRef
else if rawObsSetClosed and s7_obsCount > 0
    v4_obs := array.get(rawObsSet, 0)
else if s7_stripEnded
    v4_obs := s7_caseObsRef
bool v4_hasObs = not na(v4_obs)
bool v4_sameSession = v4_hasObs ? v4_obs.obsBarTime >= sessionOpenMs : false
// G5.2 anchor contract: CHANGE and NOW stay unavailable on the elected
// opportunity's own anchor bar and populate only from the NEXT confirmed bar of
// the same session. Neither column ever writes back to the frozen anchor.
bool v4_matrixLive = v4_hasObs and v4_sameSession and time > v4_obs.obsBarTime and barstate.isconfirmed
bool v4_historicalContext = v4_hasObs and s7_stripEnded
string v4_snapshotLabel = v4_hasObs ? (v4_historicalContext ? "ENDED SIGNAL" : "AT SIGNAL") + " · " + s7_hhmm(v4_obs.obsBarTime) : "NO SIGNAL SNAPSHOT"

// =============================================================================
// PANE BUILD — the main-chart geometry, price-reference and event-marker layer
// is owned by the companion CHART build and is absent here by construction.
// This build owns the lower information pane only.
// =============================================================================
var table v4_paneTable = na

// =============================================================================
// IC4.3 FIXED-ORDER INFORMATION GROUPS — two tables, distinct panes/anchors
// Grid width is 30 units: groups divide each occupied row into 1, 2 or 3 equal
// spans. Hidden groups leave neither an empty card nor an unused trailing slot.
// =============================================================================
// Setters preserve the explicit unit widths initialized before merging. The
// panel text size and centre alignment are already applied when the grid is
// created, so only a heading overrides the size. The parameter contract, the
// argument order and the rendered result are unchanged.
v4_panelCell(table t, int col, int row, int span, string value, color ink, color background, string tip, bool heading) =>
    if span > 1
        table.merge_cells(t, col, row, col + span - 1, row)
    table.cell_set_text(t, col, row, value)
    table.cell_set_text_color(t, col, row, ink)
    table.cell_set_bgcolor(t, col, row, background)
    table.cell_set_tooltip(t, col, row, tip)
    if heading
        table.cell_set_text_size(t, col, row, v4_font + 1)

v4_keyValue(table t, int col, int row, int span, string key, string value, color ink, string tip) =>
    int split = int(span * 3 / 5)
    v4_panelCell(t, col, row, split, key, s7c_ink2, s7c_card, tip, false)
    v4_panelCell(t, col + split, row, span - split, value, ink, s7c_card, tip, false)

// =============================================================================
// G4 / VP-03A — FULL-WIDTH LOWER LIVE INFORMATION BAND
// ONE continuous horizontal band. ONE indicator row. TEN adjacent conceptual
// cells in the exact approved order. The band is never split into two rows,
// never wrapped, never stacked, and never grows an eleventh indicator cell.
// A conceptual cell may hold its own primary and secondary sub-fields inside
// its own three grid units (G4.4, G4.8); that is still one conceptual cell.
//
// UNBOUND CONTRACT: RSI, MACD HIST, VOLUME DELTA, VOLUME PROFILE and +DI/-DI
// have NO producer in this exact parent. Their UI locations exist here now and
// show — in Q4. Nothing is calculated, estimated, synthesised or backfilled to
// populate them, and no request, export or alert is added.
// =============================================================================
v4_liveBand(table t, int row) =>
    // ---- 1 RSI — UNBOUND: UI IMPLEMENTED / PRODUCER LATER. No RSI is
    //      calculated, estimated or backfilled anywhere in this source.
    float vp_rsiNow = na

    // ---- 6 VWAP ------------------------------------------------------------
    string vp_vwapV   = "VWAP\n" + s7_priceText(vwap) + "\n" + s7_slopeText(vwapSlopeState) + " " + s7_numText(vwapSlopeRaw, "0.000")
    color  vp_vwapTnt = s7c_ink
    color  vp_vwapBg  = VPS_Q0
    string vp_vwapTip = "Confirmed RTH VWAP with the accepted tri-state slope and its normalized raw slope. Numeric reference only; no above / below rule is inferred."
    if s7_caseActive and (not na(vwapSlopeState))
        bool vp_vsup = vwapSlopeState == s7_caseDir
        vp_vwapV   := "VWAP " + (vp_vsup ? VP_I_PASS : VP_I_FAIL) + "\n" + s7_priceText(vwap) + "\n" + s7_slopeText(vwapSlopeState) + " " + s7_numText(vwapSlopeRaw, "0.000")
        vp_vwapTnt := vp_vsup ? s7c_sup : s7c_amb
        vp_vwapBg  := vp_vsup ? VPS_A14SUP : VPS_A14AMB
        vp_vwapTip := "Accepted live VWAP-slope support for the ACTIVE case. Loss is caution, never termination.\n" + vp_vwapTip

    // ---- 8 ATR — ATR and ATR% INHERIT the current ATR-RATIO attention state
    //      (P-04). No raw ATR or ATR% threshold exists.
    color vp_atrTn = vp_atrTint(atrRatioVal)
    color vp_atrBk = vp_atrBg(atrRatioVal)

    // ---- 9 IMPULSE — panel grammar; the chart-only 💥 / ⚡ symbols are never
    //      used here.
    string vp_impV   = "OFF"
    color  vp_impTnt = s7c_mut
    color  vp_impBg  = VPS_Q0
    string vp_impTip = "Accepted live impulse state. The arrows describe impulse direction only and never replace CALL / PUT."
    if not s7_coreReady
        vp_impV  := not actualRthBar ? VP_I_LOCALNA : VP_I_WARM
        vp_impBg := VPS_Q4MUT
    else if s7_impulseOn
        bool   vp_impUp = impulseDirState == DIR_LONG
        bool   vp_impDn = impulseDirState == DIR_SHORT
        vp_impV   := (impulseExcessiveState ? "IMP+" : "IMP") + (vp_impUp ? " ↑" : vp_impDn ? " ↓" : "")
        vp_impTnt := vp_impUp ? s7c_sup : vp_impDn ? s7c_res : s7c_mut
        vp_impBg  := impulseExcessiveState ? (vp_impUp ? VPS_X32SUP : vp_impDn ? VPS_X32RED : VPS_X32MUT) : (vp_impUp ? VPS_A14SUP : vp_impDn ? VPS_A14RED : VPS_A14MUT)
        // Source-owned case-relative adverse impulse: the directional identity is
        // RETAINED and an amber caution accent plus an explicit case-relative
        // label is added. An excessive or adverse impulse is never converted into
        // a hard-termination treatment.
        if s7_caseActive and impulseDirState != DIR_NEUTRAL and impulseDirState == -s7_caseDir
            vp_impV   := vp_impV + "\n" + VP_I_WARN + " AGAINST CASE"
            vp_impTnt := s7c_amb
            vp_impTip := "Accepted adverse impulse against the ACTIVE case. Directional identity is retained; this is a caution accent, not a termination.\n" + vp_impTip

    // ---- 10 DIRECTION ALERT — source-owned states only. Existing event
    //      precedence and the reversal handoff are preserved exactly.
    string vp_daV   = VP_NA
    color  vp_daTnt = s7c_mut
    color  vp_daBg  = VPS_Q0
    string vp_daTip = "No ACTIVE case, so there is no case-relative direction state."
    if str.length(s7_revEvtText) > 0
        vp_daV   := VP_I_HARD + " " + VP_I_WARN + " " + vp_dir(s7_caseActive ? s7_caseDir : structBias)
        vp_daTnt := s7c_bad
        vp_daBg  := VPS_X36RED
        vp_daTip := "Source-owned confirmed reversal on this committed bar."
    else if s7_caseActive and s7_candLive
        vp_daV   := VP_I_WARN + VP_I_ESC + " REVERSAL WATCH\n" + vp_dir(s7_candDir)
        vp_daTnt := s7c_amb
        vp_daBg  := VPS_X32AMB
        vp_daTip := "Opposite opportunity has passed Risk while the case is still ACTIVE. This is a watch, never a confirmed reversal."
    else if s7_caseActive and s7_warnActive
        vp_daV   := "AGAINST CASE"
        vp_daTnt := s7c_amb
        vp_daBg  := VPS_A14AMB
        vp_daTip := "Current structural direction " + vp_dir(structBias) + " is against case direction " + vp_dir(s7_caseDir) + ". The case remains ACTIVE."
    else if s7_caseActive
        vp_daV   := "WITH CASE"
        vp_daTnt := s7c_ink2
        vp_daTip := "Current structural direction is not against the ACTIVE case."

    // ONE render pass over the band's fixed grid geometry. The ten conceptual
    // cells keep their exact order, their exact unit spans (3,3,[2+1],[1+1+1],
    // 3,3,3,[1+1+1],3,3 = 30 units) and their exact content; only the repeated
    // render branch is consolidated. Cells 3, 4 and 8 carry their own primary
    // and secondary sub-fields inside their own units, which is still one
    // conceptual cell each. G4.0: the confirmed band update time appears EXACTLY
    // ONCE, as muted secondary metadata inside cell 10, and no eleventh cell
    // exists.
    array<int> vp_bCol = array.from(0, 3, 6, 8, 9, 10, 11, 12, 15, 18, 21, 22, 23, 24, 27)
    array<int> vp_bSpn = array.from(3, 3, 2, 1, 1,  1,  1,  3,  3,  3,  1,  1,  1,  3,  3)
    array<string> vp_bTxt = array.from(
      "RSI\n" + s7_numText(vp_rsiNow, "0.0") + "\n30 / 70",
      "MACD HIST\n" + VP_NA + "\nMACD " + VP_NA + " · SIG " + VP_NA,
      "ADX\n" + s7_numText(adxVal, "0.0"),
      "+DI " + VP_NA + "\n-DI " + VP_NA,
      "RVOL NOW\n" + s7_ratioText(relVol),
      "SESSION\n" + s7_ratioText(relVolCum),
      "RVOL\n" + VP_NA,
      "VOLUME DELTA\n" + VP_NA + "\nEST.",
      vp_vwapV,
      "VOLUME PROFILE " + VP_NA + "\nPOC " + VP_NA + " · VAH " + VP_NA + "\nVAL " + VP_NA,
      "ATR\n" + s7_numText(atrLive, format.mintick),
      "ATR%\n" + s7_numText(atrPctVal, "0.00") + "%",
      "ATR RATIO\n" + s7_numText(atrRatioVal, "0.00"),
      "IMPULSE\n" + vp_impV,
      "DIRECTION ALERT\n" + vp_daV + "\n" + s7_hhmm(time_close))
    array<color> vp_bInk = array.from(
      vp_rsiTint(vp_rsiNow), s7c_mut, vp_adxTint(adxVal), s7c_mut,
      vp_c19Tint(relVol), vp_c60Tint(relVolCum), s7c_mut, s7c_mut,
      vp_vwapTnt, s7c_mut, vp_atrTn, vp_atrTn, vp_atrTn, vp_impTnt, vp_daTnt)
    array<color> vp_bBg = array.from(
      vp_rsiBg(vp_rsiNow), VPS_Q4MUT, vp_adxBg(adxVal), VPS_Q4MUT,
      vp_c19Bg(relVol), vp_c60Bg(relVolCum), VPS_Q4MUT, VPS_Q4MUT,
      vp_vwapBg, VPS_Q4MUT, vp_atrBk, vp_atrBk, vp_atrBk, vp_impBg, vp_daBg)
    array<string> vp_bTip = array.from(
      "RSI with its 30 / 70 references. No RSI producer exists in this build, so the value slot reads —. Both extremes are amber; neither is a bullish or bearish reading.",
      "MACD histogram with its MACD and signal slots. No MACD producer exists in this build. No BUY / SELL meaning is attached to this cell.",
      "Accepted ADX producer (third value of ta.dmi(14,14)). Trend-strength magnitude only: it carries no CALL / PUT, bullish / bearish or GOOD / BAD meaning.\n<20 weak · 20-25 neutral · 25-40 strong · 40+ extreme (display bands only).",
      "+DI / -DI are not exposed by this build. Reserved slots only. When bound they may take restrained directional TEXT identity and can never write or redefine Direction authority; ADX keeps full-cell salience.",
      "C19 · exact current five-minute slot relative volume. This is NOT cumulative session participation.\nSessions warming " + str.tostring(rvolF7SessionsWarming) + " · slot sparse " + str.tostring(rvolF8SlotSparse),
      "C60 · cumulative session-to-date relative volume, evaluated independently of C19. It never overwrites the C19 state and it is not Q6.",
      "Live RVOL support / loss state. No live RVOL support producer exists in this build, so no ✅ / ❌ is inferred from magnitude.",
      "Signed estimated volume delta. No volume-delta producer exists in this build and no intrabar request is added to create one.",
      vp_vwapTip,
      "Volume profile with its POC, VAH and VAL slots. No volume-profile producer exists in this build. No bullish / bearish inference is attached.",
      "Current accepted ATR(14). Its attention state is inherited from the ATR RATIO producer; ATR itself has no threshold.",
      "ATR as a percentage of price. Inherits the ATR RATIO attention state; no ATR% cutoff is created.",
      "Accepted short / long ATR ratio.\n<0.75 compression · 0.75-1.25 normal · 1.25-1.75 expanded · 1.75+ extreme (display bands only). No bullish / bearish meaning.",
      vp_impTip,
      vp_daTip + "\nBand confirmed at " + str.format_time(time_close, "MM-dd HH:mm", TZ) + " NY. The band shows the latest accepted confirmed snapshot, not the candle under the cursor.")
    for vp_i = 0 to 14
        v4_panelCell(t, array.get(vp_bCol, vp_i), row, array.get(vp_bSpn, vp_i), array.get(vp_bTxt, vp_i),
          array.get(vp_bInk, vp_i), array.get(vp_bBg, vp_i), array.get(vp_bTip, vp_i), false)
    true

// G5 / VP-03B — SIGNAL COMPARISON MATRIX. Columns are EXACTLY
// AT SIGNAL | CHANGE | NOW; the metric label is a separate identifier column
// and is not a fourth temporal state. AT SIGNAL is immutable and cool-frozen
// (Q4), CHANGE is always neutral (Q0) whatever its sign, and only NOW follows
// the current-state contract of its own metric.
v4_matrix(table t, int col, int row, int span) =>
    int w1 = math.max(1, int(span * 8 / 30))
    int w2 = math.max(1, int(span * 7 / 30))
    int w4 = math.max(1, span - w1 - 2 * w2)
    array<int> vp_cw = array.from(w1, w2, w2, w4)
    array<int> vp_cx = array.from(0, w1, w1 + w2, w1 + 2 * w2)

    // Compact case / anchor identity and time header.
    string ident = v4_hasObs ? "#" + str.tostring(v4_obs.obsId) + " · " + vp_dir(v4_obs.direction) + " · " + vp_fam(v4_obs.family) + " · " + s7_hhmm(v4_obs.obsBarTime) : "NO SIGNAL SNAPSHOT"
    v4_panelCell(t, col, row, span, (v4_historicalContext ? "ENDED · " : "") + ident, s7c_ink2, VPS_Q4MUT,
      "Exactly one opportunity owns this matrix; every column is drawn from that one identity. A later same-direction SIGNAL never re-anchors it and an ended case never receives an unrelated current Observation as its anchor.", false)

    // Column header row: AT SIGNAL is cool-frozen, CHANGE is neutral, and only
    // NOW carries the informational identity.
    array<string> vp_hT = array.from("METRIC", "AT SIGNAL", "CHANGE", "NOW")
    array<color>  vp_hI = array.from(s7c_mut, s7c_mut, s7c_mut, s7c_ink2)
    array<color>  vp_hB = array.from(s7c_grid, VPS_Q4MUT, s7c_grid, VPS_A14REF)
    array<string> vp_hP = array.from("Same record, same identity, same unit.",
      "Immutable frozen signal-time value. It is never rewritten by a later live reading.",
      "Current minus original in the same displayed unit. A signed change never means improvement or deterioration.",
      "Latest accepted confirmed value. It starts only on the bar after the signal candle.")
    for vp_c = 0 to 3
        v4_panelCell(t, col + array.get(vp_cx, vp_c), row + 1, array.get(vp_cw, vp_c), array.get(vp_hT, vp_c),
          array.get(vp_hI, vp_c), array.get(vp_hB, vp_c), array.get(vp_hP, vp_c), false)

    bool live = v4_matrixLive
    // 5 STOP REFERENCE — AT SIGNAL is the immutable original STOP and keeps its
    // red STOP identity; CHANGE is a signed price distance, NOT profit or loss.
    bool  sameCase  = s7_caseActive and v4_hasObs and (not na(s7_caseId)) and v4_obs.obsId == s7_caseId
    float stopNow   = sameCase ? s7_trailStop : na
    bool  stopMoved = sameCase and s7_trailVersion > 0

    // The five approved rows, described as data. Row order, units, anchor
    // immutability and per-column colour ownership are exactly as before; only
    // the repeated render branch is consolidated.
    //   1 ROC5 — the NOW cell keeps a restrained signed TEXT identity. No live
    //     momentum-support producer exists, so no A / X state and no raw ROC5
    //     threshold is attached to it.
    //   2 RVOL · 5m SLOT — always C19. C60 is never substituted here.
    //   4 RSI — the row EXISTS NOW. No RSI producer and no same-case RSI anchor
    //     snapshot exist, so all three columns read —. Nothing is calculated
    //     here and no current RSI is ever attached to an old case.
    array<string> vp_rN = array.from("ROC5", "RVOL · 5m SLOT", "ADX", "RSI", "STOP REFERENCE")
    array<float>  vp_rO = array.from(v4_hasObs ? v4_obs.roc5 : na, v4_hasObs ? v4_obs.relVol : na, v4_hasObs ? v4_obs.adxVal : na, float(na), v4_hasObs ? v4_obs.plannedStop : na)
    array<float>  vp_rC = array.from(roc5, relVol, adxVal, float(na), stopNow)
    array<string> vp_rF = array.from("0.0000", "0.00", "0.00", "0.0", format.mintick)
    array<string> vp_rS = array.from("%", "x", "", "", "")
    array<string> vp_rU = array.from(" pp", "x", "", " pts", "")
    array<bool>   vp_rL = array.from(live, live, live, false, sameCase)
    array<color>  vp_rNm = array.from(s7c_ink2, s7c_ink2, s7c_ink2, s7c_ink2, s7c_bad)
    array<color>  vp_rOi = array.from(s7c_ink2, s7c_ink2, s7c_ink2, s7c_ink2, s7c_bad)
    array<color>  vp_rOb = array.from(VPS_Q4MUT, VPS_Q4MUT, VPS_Q4MUT, VPS_Q4MUT, VPS_Q4RED)
    array<color>  vp_rNi = array.from(na(roc5) ? s7c_mut : roc5 > 0 ? s7c_sup : roc5 < 0 ? s7c_res : s7c_ink, vp_c19Tint(relVol), vp_adxTint(adxVal), s7c_mut, stopMoved ? s7c_ref : s7c_bad)
    array<color>  vp_rNo = array.from(s7c_mut, s7c_mut, s7c_mut, s7c_mut, s7c_bad)
    array<color>  vp_rNb = array.from(VPS_Q0, vp_c19Bg(relVol), vp_adxBg(adxVal), VPS_Q4MUT, stopMoved ? VPS_A14REF : VPS_Q0)
    array<string> vp_rT = array.from(
      "Five-bar rate of change. Signed percent; the change column is in percentage points.",
      "C19 · exact-slot relative volume, at signal and now. Session-to-date C60 is a different fact and never appears in this row.",
      "Accepted ADX. Trend-strength magnitude only; no Direction inference.",
      "RSI at signal, change and now. No RSI producer and no frozen same-case RSI anchor exist in this build; the row is reserved, not removed.",
      "Original STOP and the current accepted STOP+. OSE reference only — not a broker order.")
    array<string> vp_rOt = array.from(v4_snapshotLabel, v4_snapshotLabel, v4_snapshotLabel, v4_snapshotLabel,
      "Immutable original STOP of this signal record.\n" + v4_snapshotLabel)
    array<string> vp_rCt = array.from("", "", "", "",
      "Signed price distance from the original STOP to the current STOP+. This is NOT profit, loss or P&L.")
    array<string> vp_rNt = array.from("", "", "", "",
      sameCase ? "Current accepted STOP+ · " + s7_trailReason + " · v" + str.tostring(s7_trailVersion) + (s7_trailUnlocked ? " · STOP+ ON" : "") : "No ACTIVE case owns a current STOP+.")
    for vp_r = 0 to 4
        string vp_f  = array.get(vp_rF, vp_r)
        float  vp_o  = array.get(vp_rO, vp_r)
        float  vp_n  = array.get(vp_rC, vp_r)
        bool   vp_lv = array.get(vp_rL, vp_r)
        string vp_tp = array.get(vp_rT, vp_r)
        string vp_ct = array.get(vp_rCt, vp_r)
        string vp_nt = array.get(vp_rNt, vp_r)
        // `live` is the accepted next-confirmed-bar gate: on the elected
        // opportunity's own anchor bar CHANGE and NOW stay unavailable, because
        // no later bar exists yet (A49 / C-03 §3.3-3.5). Neither column ever
        // writes back to the frozen anchor.
        array<string> vp_cT = array.from(array.get(vp_rN, vp_r),
          na(vp_o) ? VP_NA : str.tostring(vp_o, vp_f) + array.get(vp_rS, vp_r),
          vp_lv ? s7_deltaText(vp_o, vp_n, vp_f, array.get(vp_rU, vp_r)) : VP_NA,
          vp_lv ? (na(vp_n) ? VP_NA : str.tostring(vp_n, vp_f) + array.get(vp_rS, vp_r)) : VP_NA)
        array<color> vp_cI = array.from(array.get(vp_rNm, vp_r), array.get(vp_rOi, vp_r), s7c_ink2,
          vp_lv ? array.get(vp_rNi, vp_r) : array.get(vp_rNo, vp_r))
        array<color> vp_cB = array.from(s7c_card, array.get(vp_rOb, vp_r), VPS_Q0,
          vp_lv ? array.get(vp_rNb, vp_r) : VPS_Q4MUT)
        array<string> vp_cP = array.from(vp_tp, array.get(vp_rOt, vp_r) + "\n" + vp_tp,
          (str.length(vp_ct) > 0 ? vp_ct : (not vp_lv ? "Awaiting a later confirmed bar from the same session.\n" : na(vp_o) or na(vp_n) ? "Original / current pair unavailable.\n" : "Difference in the same displayed unit. The sign is not a verdict.\n") + vp_tp),
          str.length(vp_nt) > 0 ? vp_nt : vp_tp)
        for vp_c = 0 to 3
            v4_panelCell(t, col + array.get(vp_cx, vp_c), row + 2 + vp_r, array.get(vp_cw, vp_c),
              array.get(vp_cT, vp_c), array.get(vp_cI, vp_c), array.get(vp_cB, vp_c), array.get(vp_cP, vp_c), false)

// =============================================================================
// G6 / VP-03C — BOUNDED LOWER DETAIL / HISTORY / REVIEW AREA
// Every fact below carries its G0 ownership tag. The area is bounded by table
// ROW / COLUMN allocation and the existing bounded history-row cap — no pixel
// height is claimed anywhere. Dense content is compressed, abbreviated in VP-06
// vocabulary and grouped; the lower-pane footprint is never enlarged to fit a
// longer string.
// =============================================================================

// PRIMARY-IN-C — management geometry, plan context and price references. These
// facts have no other lower-pane owner; the chart owns their price-native
// geometry and this group owns their textual / numeric detail.
v4_manage(table t, int col, int row, int span) =>
    // The achieved marker belongs to the live case only: a retained ended case
    // must never carry a stale TP1 HIT badge against an unavailable price.
    bool tp1Hit = s7_caseActive and s7_tp1Reached
    array<string> vp_k = array.from("PHASE", "STOP", "STOP+", "TP1", "TP+", "ROOM", "ACTIVE ZONE", "YDAY HIGH / LOW", "OPEN HIGH / LOW")
    array<string> vp_v = array.from(
      s7_caseActive ? (s7_tp1Reached ? "AFTER TP1" : "BEFORE TP1") + (s7_trailUnlocked ? " · STOP+ ON" : "") : VP_NA,
      s7_priceText(s7_caseActive ? s7_caseInitialStop : na),
      s7_caseActive ? s7_priceText(s7_trailStop) + " · v" + str.tostring(s7_trailVersion) : VP_NA,
      (s7_caseActive ? s7_priceText(s7_caseTp1) : VP_NA) + (tp1Hit ? " " + VP_I_PASS : ""),
      s7_priceText(s7_barrier) + (na(s7_barrier) ? "" : vp_roleToken(v4_barrierRole)),
      s7_priceText(s7_room),
      vp_zoneName + vp_roleToken(vp_zoneRole) + "\n" + vp_zoneBounds,
      s7_priceText(pdh) + " / " + s7_priceText(pdl),
      orReady ? s7_priceText(orHigh) + " / " + s7_priceText(orLow) : VP_NA)
    array<color> vp_i = array.from(
      s7_caseActive ? s7c_ink : s7c_mut, s7c_bad, s7c_bad, tp1Hit ? s7c_sup : s7c_ref, s7c_ref, s7c_ink,
      vp_zoneRole == ROLE_SUPPORT ? s7c_sup : vp_zoneRole == ROLE_RESISTANCE ? s7c_res : s7c_mut, s7c_ink2, s7c_ink2)
    array<string> vp_p = array.from(
      "Accepted case phase. TP1 HIT and STOP+ ON are distinct source-owned events.",
      S7_STOP_TIP + "\nImmutable original signal reference.",
      S7_STOP_TIP + "\n" + (s7_caseActive ? s7_trailReason + "\nPrior " + s7_priceText(s7_trailPrevLevel) + " → current " + s7_priceText(s7_trailStop) : "No ACTIVE case.") + "\nExact update times are preserved in the event chronology.",
      "Original TP1. TP1 HIT and STOP+ ON are distinct events; the TP1 line is never re-anchored to the TP1 HIT bar.",
      "Existing next opposing structural reference. TP+ is a presentation alias for that barrier — it is NOT TP2, not an invented target and it owns no hit logic.",
      "Accepted distance to the next opposing barrier. ROOM is a distance, not another target, and it never manufactures its own warning state: a LOW-ROOM Risk failure is owned by the RISK cell.",
      vp_zoneTip,
      "Previous-day high and low. Structural role comes from the accepted zone registry, never from the words HIGH and LOW.",
      orReady ? "Opening-range high and low; exact current accepted references." : "Opening range is not yet established.")
    for vp_r = 0 to 8
        v4_keyValue(t, col, row + vp_r, span, array.get(vp_k, vp_r), array.get(vp_v, vp_r), array.get(vp_i, vp_r), array.get(vp_p, vp_r))

// PRICE EFFICIENCY is PRIMARY-IN-C. ATR RATIO and ATR% appear here only as
// DETAIL-OF-G4 TEMPORAL context — an at-signal versus now pair the live band
// does not and cannot carry. ADX is deliberately NOT repeated here: the live
// band owns its current magnitude and the matrix owns its temporal comparison.
v4_diagDetail(table t, int col, int row, int span) =>
    int w = math.max(1, int(span / 3))
    int w3 = math.max(1, span - 2 * w)
    array<int> vp_cx = array.from(0, w, 2 * w)
    array<int> vp_cw = array.from(w, w, w3)
    array<string> vp_dT = array.from(
      "DIAGNOSTIC", "AT SIGNAL", "NOW",
      "PRICE EFFICIENCY", s7_numText(v4_hasObs ? v4_obs.efficiencyRatio : na, "0.000"), s7_numText(efficiencyRatio, "0.000"),
      "ATR RATIO", s7_numText(v4_hasObs ? v4_obs.atrRatio : na, "0.00"), s7_numText(atrRatioVal, "0.00"),
      "ATR%", s7_numText(v4_hasObs ? v4_obs.atrPct : na, "0.00") + "%", s7_numText(atrPctVal, "0.00") + "%")
    array<color> vp_dI = array.from(
      s7c_mut, s7c_mut, s7c_ink2,
      s7c_ink2, s7c_ink2, vp_erTint(efficiencyRatio),
      s7c_ink2, s7c_ink2, vp_atrTint(atrRatioVal),
      s7c_ink2, s7c_ink2, vp_atrTint(atrRatioVal))
    array<color> vp_dB = array.from(
      s7c_grid, VPS_Q4MUT, VPS_A14REF,
      s7c_card, VPS_Q4MUT, vp_erBg(efficiencyRatio),
      s7c_card, VPS_Q4MUT, vp_atrBg(atrRatioVal),
      s7c_card, VPS_Q4MUT, vp_atrBg(atrRatioVal))
    array<string> vp_dP = array.from(
      "Diagnostic context. None of these values is a trade quality, confidence or probability.", "Frozen signal-time value.", "Latest accepted confirmed value.",
      "PRICE EFFICIENCY · the accepted efficiency-ratio producer, dimensionless and bounded 0-1 by construction. Diagnostic magnitude only — never GOOD or BAD and never a trade-quality inference.", v4_snapshotLabel, "<0.25 · 0.25-0.55 · 0.55-0.75 · 0.75+ display bands only.",
      "Accepted short / long ATR ratio, same producer and same P-04 bands the live band uses. This row adds the temporal at-signal pair the band cannot carry.", v4_snapshotLabel, "Same P-04 state as the live band.",
      "ATR as a percentage of price; inherits the ATR RATIO attention state. No ATR% cutoff exists.", v4_snapshotLabel, "Inherits the current ATR RATIO state.")
    for vp_n = 0 to 11
        int vp_c = vp_n % 3
        v4_panelCell(t, col + array.get(vp_cx, vp_c), row + int(vp_n / 3), array.get(vp_cw, vp_c),
          array.get(vp_dT, vp_n), array.get(vp_dI, vp_n), array.get(vp_dB, vp_n), array.get(vp_dP, vp_n), false)

// DETAIL-OF-G3 — every row adds record-level detail, a source reason or signal
// geometry that the Top Bar summary cells cannot carry. No Top Bar summary is
// reproduced verbatim here.
v4_details(table t, int col, int row, int span) =>
    float move = v4_hasObs and not na(v4_obs.plannedTp1) and not na(v4_obs.signalClose) ? math.abs(v4_obs.plannedTp1 - v4_obs.signalClose) : na
    array<string> vp_k = array.from("SIGNAL ID / TIME", "SIGNAL CLOSE", "ENTRY DETAIL", "RISK DETAIL", "TP1 MOVE", "SIGNAL LOCATION", "STRUCTURE DETAIL", "READINESS")
    array<string> vp_v = array.from(
      v4_hasObs ? "#" + str.tostring(v4_obs.obsId) + " · " + s7_hhmm(v4_obs.obsBarTime) : VP_NA,
      s7_priceText(v4_hasObs ? v4_obs.signalClose : na),
      v4_hasObs ? vp_entry(v4_obs.classCode) + " · " + s7_numText(v4_obs.entryDistATR, "0.000") + " ATR" : VP_NA,
      v4_hasObs ? (v4_obs.riskPass ? "RISK " + VP_I_PASS + " · STOP DIST " + s7_priceText(v4_obs.plannedRisk) : "RISK " + VP_I_FAIL + " · " + s7_rejectText(v4_obs.rejectReason)) : VP_NA,
      s7_priceText(move),
      v4_hasObs ? vp_zoneText(v4_obs.zoneIdMask) + " · " + str.tostring(v4_obs.confluence) + " refs" : VP_NA,
      (s7_structText == "INTACT" ? "INTACT" : s7_structText == "LOST" ? "LOST" : VP_I_LOCALNA) + " · " + (s7_caseActive and s7_premiseTrace ? vp_zoneText(s7_premiseMask) : VP_NA),
      "VWAP RECLAIM " + (commonSetupReady ? "READY" : VP_I_WARM) + " · BREAKOUT / RETEST " + (staticCoreReady ? "READY" : VP_I_WARM) + " · SQZ " + (sqzCoreReady ? "READY" : VP_I_WARM))
    array<color> vp_i = array.from(s7c_ink, s7c_ink, s7c_ink,
      v4_hasObs ? (v4_obs.riskPass ? s7c_sup : s7c_bad) : s7c_mut, s7c_ink, s7c_ink,
      s7_structText == "INTACT" ? s7c_sup : s7_structText == "LOST" ? s7c_bad : s7c_mut, s7c_ink2)
    array<string> vp_p = array.from(
      v4_hasObs ? "Signal bar " + str.tostring(v4_obs.obsOrd) + " · slot " + str.tostring(v4_obs.slotIdx) + " · within-bar index " + str.tostring(v4_obs.obsIndexInBar) : "No selected signal record.",
      "Original signal reference, not a broker fill.",
      v4_hasObs ? "Accepted Entry classification with its signal-time entry geometry. Signal-time ATR reference " + s7_priceText(v4_obs.atrRefAtObs) : "No signal reference.",
      "Binding accepted Risk verdict with its internal reason code and the same-record planned risk distance. Reason order remains R4, R5, R10, R12, R7, R8, R6, R9, R13.",
      "Lossless same-record TP1 distance. Display only.",
      v4_hasObs ? "Signal-time zone identity. Touch count " + str.tostring(v4_obs.touchCount) + "\nVWAP price touches " + str.tostring(v4_obs.vwapPriceTouchCount) + " · zone-motion touches " + str.tostring(v4_obs.vwapZoneMotionTouchCount) : "No signal location.",
      "Original traceable case premise; anchor bit " + str.tostring(s7_premiseAnchorBit) + ". A missing premise is not invented. 🚫 does not mean LOST.",
      "Family-specific readiness; not an aggregate decision gate.\nRTH bars available " + str.tostring(rthBarsAvailable))
    for vp_r = 0 to 7
        v4_keyValue(t, col, row + vp_r, span, array.get(vp_k, vp_r), array.get(vp_v, vp_r), array.get(vp_i, vp_r), array.get(vp_p, vp_r))

// HISTORY / REVIEW — C owns recorded chronology. Historical rows are ALWAYS Q0;
// a critical historical event keeps its icon inside an A14 badge and never
// competes with a live X state.
v4_history(table t, int col, int row, int span) =>
    int wA = math.max(1, int(span * 11 / 30))
    int wB = math.max(1, span - wA)
    int dropped = 0
    string coverage = ""
    if array.size(v4_coverage) > 0
        for i = 0 to array.size(v4_coverage) - 1
            V4Coverage c = array.get(v4_coverage, i)
            dropped += c.droppedEvents + c.droppedRanges + c.droppedLevels
            coverage += str.format_time(c.session, "MM-dd", TZ) + " · events omitted " + str.tostring(c.droppedEvents) + "/" + str.tostring(c.events)
            coverage += " · ranges omitted " + str.tostring(c.droppedRanges) + "/" + str.tostring(c.ranges) + " · open-range omitted " + str.tostring(c.droppedLevels) + "/" + str.tostring(c.levels) + "\n"
    int prior = math.max(0, array.size(v4_coverage) - 1)
    string status = str.tostring(prior) + "/2 PRIOR SESSIONS · SELECTED" + (prior < 2 ? " · PARTIAL" : "") + (dropped > 0 ? " · INCOMPLETE" : "")
    v4_panelCell(t, col, row, span, status, dropped > 0 ? s7c_amb : s7c_mut, VPS_Q4MUT,
      coverage + "Selected presentation records. Historical VWAP and completed-case plan geometry are not reconstructed.", false)
    if array.size(v4_events) > 0
        array<int> stamps = array.new_int()
        for i = 0 to array.size(v4_events) - 1
            array.push(stamps, array.get(v4_events, i).candle)
        array<int> indices = array.sort_indices(stamps, order.descending)
        int count = math.min(v4_historyRows, array.size(indices))
        for j = 0 to count - 1
            V4Event e = array.get(v4_events, array.get(indices, j))
            // A historical row never takes an X background. Where the recorded
            // event is critical the row keeps its icon inside an A14 badge.
            bool badge = e.priority >= S7_PRI_STRUCTLOST
            v4_panelCell(t, col, row + 1 + j, wA, str.format_time(e.candle, "MM-dd HH:mm", TZ), s7c_mut, VPS_Q0, e.detail, false)
            v4_panelCell(t, col + wA, row + 1 + j, wB, e.title, s7c_ink2, badge ? vp_a14Of(v4_eventColor(e.priority, e.direction)) : VPS_Q0, e.detail, false)
    else
        v4_panelCell(t, col, row + 1, span, "NO RETAINED EVENTS", s7c_mut, VPS_Q0, "No eligible event record has been captured.", false)

// HISTORY/REVIEW — original-record forward research. MFE is never green profit
// and MAE is never red loss; both stay review-neutral.
v4_forward(table t, int col, int row, int span) =>
    int wH = math.max(1, int(span * 6 / 30))
    int wV = math.max(1, int(span * 12 / 30))
    int wW = math.max(1, span - wH - wV)
    array<string> vp_k = array.from("REF PRICE", "REF RISK", "FORWARD BARS")
    array<string> vp_v = array.from(
      s7_priceText(v4_hasObs ? v4_obs.refPrice : na),
      s7_priceText(v4_hasObs ? v4_obs.referenceRisk : na),
      v4_hasObs ? "SEEN " + str.tostring(v4_obs.forwardBarsSeen) + " · AVAILABLE " + (na(v4_obs.forwardBarsAvailable) ? VP_NA : str.tostring(v4_obs.forwardBarsAvailable)) : VP_NA)
    array<string> vp_p = array.from(
      "Original record's forward-research reference. Not broker P&L.",
      "Accepted forward-reference denominator.",
      "Direct original-record maturity fields. No missing horizon is backfilled.")
    for vp_r = 0 to 2
        v4_keyValue(t, col, row + vp_r, span, array.get(vp_k, vp_r), array.get(vp_v, vp_r), s7c_ink2, array.get(vp_p, vp_r))
    // MFE is never green profit and MAE is never red loss: the excursion grid
    // stays review-neutral throughout.
    array<int> vp_cx = array.from(0, wH, wH + wV)
    array<int> vp_cw = array.from(wH, wV, wW)
    array<float> mfes = v4_hasObs ? array.from(v4_obs.mfeUsd1, v4_obs.mfeUsd2, v4_obs.mfeUsd4, v4_obs.mfeUsd8, v4_obs.mfeUsd12) : array.new_float(5, na)
    array<float> maes = v4_hasObs ? array.from(v4_obs.maeUsd1, v4_obs.maeUsd2, v4_obs.maeUsd4, v4_obs.maeUsd8, v4_obs.maeUsd12) : array.new_float(5, na)
    array<string> vp_gT = array.from("HORIZON", "MFE", "MAE")
    array<color>  vp_gB = array.from(s7c_grid, s7c_grid, s7c_grid)
    array<string> vp_gP = array.from("RTH bars",
      "Favorable excursion in underlying price units. Review fact only — not profit.",
      "Adverse excursion in underlying price units. Review fact only — not loss.")
    array<int> vp_hz = array.from(1, 2, 4, 8, 12)
    for vp_i = 0 to 5
        if vp_i > 0
            int vp_j = vp_i - 1
            bool vp_av = not na(array.get(mfes, vp_j)) and not na(array.get(maes, vp_j))
            string vp_tp = vp_av ? "Accepted horizon result available." : "Horizon incomplete or unavailable in the original record."
            array.set(vp_gT, 0, "@" + str.tostring(array.get(vp_hz, vp_j)))
            array.set(vp_gT, 1, s7_priceText(array.get(mfes, vp_j)))
            array.set(vp_gT, 2, s7_priceText(array.get(maes, vp_j)))
            array.set(vp_gB, 0, VPS_Q0)
            array.set(vp_gB, 1, VPS_Q0)
            array.set(vp_gB, 2, VPS_Q0)
            array.set(vp_gP, 0, vp_tp)
            array.set(vp_gP, 1, vp_tp)
            array.set(vp_gP, 2, vp_tp)
        for vp_c = 0 to 2
            v4_panelCell(t, col + array.get(vp_cx, vp_c), row + 3 + vp_i, array.get(vp_cw, vp_c),
              array.get(vp_gT, vp_c), vp_i == 0 ? s7c_mut : s7c_ink2, array.get(vp_gB, vp_c), array.get(vp_gP, vp_c), false)

// --- LOWER-PANE GROUP REGISTRY ------------------------------------------------
// Fixed order and fixed ownership. Group meanings never change with the manual
// column setting; only the wrapping does.
v4_enabledGroups() =>
    array<int> groups = array.new_int()
    array.push(groups, 1)
    array.push(groups, 2)
    if v4_showDiag
        array.push(groups, 3)
        array.push(groups, 4)
    if v4_showHistory and v4_historyLog
        array.push(groups, 5)
    if v4_showReview
        array.push(groups, 6)
    groups

v4_groupHeight(int group) =>
    switch group
        1 => 8
        2 => 10
        3 => 5
        4 => 9
        5 => 2 + math.max(1, math.min(v4_historyRows, array.size(v4_events)))
        6 => 10
        => 1

v4_groupTitle(int group) =>
    switch group
        1 => "SIGNAL MATRIX"
        2 => "MANAGEMENT & CONTEXT"
        3 => "DIAGNOSTIC DETAIL"
        4 => (v4_historicalContext ? "ENDED · " : "") + "SIGNAL DETAIL"
        5 => "HISTORY · SELECTED"
        6 => (v4_historicalContext ? "ENDED · " : "") + "REVIEW"
        => "OSE"

v4_renderGroup(table t, int group, int col, int row, int span) =>
    v4_panelCell(t, col, row, span, v4_groupTitle(group), s7c_ink, s7c_grid, "Show or hide this group from Settings → Inputs. No display switch affects the engine, an alert or an export.", true)
    switch group
        1 => v4_matrix(t, col, row + 1, span)
        2 => v4_manage(t, col, row + 1, span)
        3 => v4_diagDetail(t, col, row + 1, span)
        4 => v4_details(t, col, row + 1, span)
        5 => v4_history(t, col, row + 1, span)
        6 => v4_forward(t, col, row + 1, span)

v4_makePane() =>
    table result = na
    array<int> groups = v4_enabledGroups()
    int count = array.size(groups)
    // The live band is a full-width leading band: one heading row plus exactly
    // ONE indicator row. Groups tile below it in the existing 30-unit grid.
    int bandRows = 2
    int tiled = 0
    int index = 0
    while index < count
        int across = math.min(v4_columns, count - index)
        int tallest = 0
        for j = 0 to across - 1
            tallest := math.max(tallest, v4_groupHeight(array.get(groups, index + j)))
        tiled += tallest + 1
        index += across
    if tiled > 0
        tiled -= 1
    int rows = bandRows + (tiled > 0 ? 1 + tiled : 0)
    if rows > 0
        result := table.new(position.bottom_center, 30, rows, bgcolor = s7c_clear,
          frame_width = 0, border_width = 1, border_color = chart.bg_color, force_overlay = false)
        for r = 0 to rows - 1
            for c = 0 to 29
                table.cell(result, c, r, "", width = 100.0 / 30.0, bgcolor = s7c_clear, text_size = v4_font, text_halign = text.align_center)
        v4_panelCell(result, 0, 0, 30, "LIVE", s7c_ink, s7c_grid,
          "Continuous live information band. Ten conceptual cells in one indicator row; cells whose analytical producer does not yet exist show — and are never removed.", true)
        v4_liveBand(result, 1)
        index := 0
        int row = bandRows + 1
        while index < count
            int across = math.min(v4_columns, count - index)
            int span = int(30 / across)
            int tallest = 0
            for j = 0 to across - 1
                int group = array.get(groups, index + j)
                v4_renderGroup(result, group, j * span, row, span)
                tallest := math.max(tallest, v4_groupHeight(group))
            row += tallest + 1
            index += across
    result

// IC4.4 RENDER SCHEDULER
// Initialize from the last confirmed historical bar when a live bar exists;
// thereafter refresh only on confirmed closes. Unconfirmed ticks never replace
// a signal snapshot or create an intrabar management decision.
bool v4_refresh = barstate.islastconfirmedhistory or (barstate.islast and barstate.isconfirmed)
if v4_refresh
    if not na(v4_paneTable)
        table.delete(v4_paneTable)
        v4_paneTable := na
    if s7_uiEnabled and v4_showPane
        v4_paneTable := v4_makePane()

